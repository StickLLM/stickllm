#!/bin/bash
# Kiosk Chromium downloads follow the vault (0.5.2).
#   unlocked: downloads go straight to vault/Downloads (no Save As prompt).
#   locked:   downloads are blocked, so nothing lands in the RAM overlay.
# Chromium watches its managed policy folder and applies a changed file
# within a few seconds, so the running kiosk browser follows lock/unlock.
# Usage: stickllm-download-policy [auto|unlocked|locked]
set -u
MNT="${STICKLLM_VAULT_MNT:-/var/lib/stickllm/vault}"
DIRS="${STICKLLM_CHROMIUM_POLICY_DIRS:-/etc/chromium/policies/managed /etc/chromium-browser/policies/managed}"
OWNER="${STICKLLM_KIOSK_USER:-stickllm}"
NAME="stickllm-downloads.json"
state="${1:-auto}"

if [[ "$state" == "auto" ]]; then
  if mountpoint -q "$MNT" 2>/dev/null; then state=unlocked; else state=locked; fi
fi
case "$state" in
  unlocked)
    if ! mountpoint -q "$MNT" 2>/dev/null; then
      state=locked
    elif [[ -L "$MNT/Downloads" ]]; then
      # Never follow a symlink out of the vault.
      state=locked
    else
      mkdir -p "$MNT/Downloads" 2>/dev/null || state=locked
      if [[ "$state" == unlocked ]]; then
        chown "$OWNER:$OWNER" "$MNT/Downloads" 2>/dev/null || true
        chmod 700 "$MNT/Downloads" 2>/dev/null || true
      fi
    fi
    ;;
  locked) ;;
  *) echo "usage: stickllm-download-policy [auto|unlocked|locked]" >&2; exit 2 ;;
esac

if [[ "$state" == unlocked ]]; then
  body="{\"DownloadDirectory\":\"$MNT/Downloads\",\"PromptForDownloadLocation\":false,\"DownloadRestrictions\":0}"
else
  # 3 = block all downloads.
  body='{"DownloadRestrictions":3,"PromptForDownloadLocation":false}'
fi

rc=1
for dir in $DIRS; do
  mkdir -p "$dir" 2>/dev/null || continue
  tmp="$dir/.$NAME.$$"
  if printf '%s\n' "$body" >"$tmp" 2>/dev/null && chmod 644 "$tmp" && mv -f "$tmp" "$dir/$NAME"; then
    rc=0
  else
    rm -f "$tmp" 2>/dev/null || true
  fi
done
echo "downloads=$state"
exit "$rc"
