#!/bin/bash
# Detect VRAM + USB free space; recommend catalog model; optional countdown download.
set -euo pipefail

CATALOG="${STICKLLM_CATALOG:-/etc/stickllm/models/catalog.toml}"
MNT="${STICKLLM_DATA_MNT:-/mnt/stickllm-data}"
STATUS_DIR="${STICKLLM_RUN:-/run/stickllm}"
COUNTDOWN=0
DO_DOWNLOAD=0

for a in "$@"; do
  case "$a" in
    --countdown) COUNTDOWN=30 ;;
    --countdown=*) COUNTDOWN="${a#--countdown=}" ;;
    --download) DO_DOWNLOAD=1 ;;
    --first-boot) COUNTDOWN=30; DO_DOWNLOAD=1 ;;
    -h|--help)
      echo "Usage: stickllm-model-probe [--countdown[=N]] [--download] [--first-boot]"
      exit 0
      ;;
  esac
done

vram_gb=0
if command -v nvidia-smi >/dev/null 2>&1; then
  vram_mb="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | awk 'BEGIN{m=0}{if($1+0>m)m=$1+0} END{print m+0}')"
  vram_gb=$(( (vram_mb + 512) / 1024 ))
fi

free_gb="0"
dest="ram"
if findmnt -n "$MNT" >/dev/null 2>&1; then
  free_kb="$(df -Pk "$MNT" | awk 'NR==2{print $4}')"
  free_gb="$(awk -v k="$free_kb" 'BEGIN{printf "%.1f", k/1024/1024}')"
  dest="$MNT/models"
elif [[ -d /opt/stickllm/models ]]; then
  free_kb="$(df -Pk /opt/stickllm/models | awk 'NR==2{print $4}')"
  free_gb="$(awk -v k="$free_kb" 'BEGIN{printf "%.1f", k/1024/1024}')"
  dest="/opt/stickllm/models"
fi

mkdir -p "$STATUS_DIR"
PROBE_OUT="$STATUS_DIR/model-probe.json"
python3 - "$CATALOG" "$vram_gb" "$free_gb" "$dest" "$PROBE_OUT" <<'PY'
import json, re, sys
path, vram, free, dest, out = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4], sys.argv[5]
best = {
    "recommend_id": "qwen35-lite-q4km",
    "recommend_name": "Qwen3.5 lite (base)",
    "recommend_size_gb": 2.5,
}
try:
    text = open(path, encoding="utf-8").read()
except FileNotFoundError:
    text = ""
for b in re.split(r"\n\[\[model\]\]\n", text)[1:]:
    def g(key, default=""):
        m = re.search(rf"^{key}\s*=\s*(.+)$", b, re.M)
        if not m:
            return default
        return m.group(1).strip().strip('"')
    try:
        mid = g("id")
        name = g("name", mid)
        q = int(float(g("quality_rank", "0") or 0))
        size = float(g("approx_size_gb", "0") or 0)
        mv = float(g("min_vram_gb", "0") or 0)
        repo = g("hf_repo", "")
        files = g("hf_files", "[]")
    except Exception:
        continue
    # Only recommend pinned (downloadable) models
    if not repo or files in ("", "[]"):
        continue
    # Listed for loading (e.g. baked app-agent Qwen3.5-4B) but never auto-picked.
    if g("probe_recommend", "true").lower() == "false":
        continue
    if mv > vram:
        continue
    if free > 0 and size + 1.0 > free:
        continue
    if q >= int(best.get("_q", -1)):
        best = {
            "_q": q,
            "recommend_id": mid,
            "recommend_name": name,
            "recommend_size_gb": size,
            "pinned": True,
        }
best.pop("_q", None)
doc = {
    "vram_gb": vram,
    "free_gb": free,
    "dest": dest,
    **best,
}
open(out, "w", encoding="utf-8").write(json.dumps(doc, indent=2) + "\n")
print(json.dumps(doc))
PY

recommend="$(python3 -c 'import json;print(json.load(open("'"$PROBE_OUT"'"))["recommend_id"])')"
recommend_name="$(python3 -c 'import json;print(json.load(open("'"$PROBE_OUT"'"))["recommend_name"])')"
recommend_size="$(python3 -c 'import json;print(json.load(open("'"$PROBE_OUT"'"))["recommend_size_gb"])')"

echo "StickLLM model probe (v0.2)"
echo "  VRAM:     ${vram_gb} GB"
echo "  Free:     ${free_gb} GiB ($dest)"
echo "  Optimum:  $recommend_name ($recommend, ~${recommend_size} GB)"
echo

if [[ "$COUNTDOWN" -le 0 ]]; then
  exit 0
fi

echo "Downloading optimum in ${COUNTDOWN}s — Ctrl+C to cancel, or press Enter to start now."
for ((i=COUNTDOWN; i>0; i--)); do
  printf '\r  %2ds…  ' "$i"
  if read -r -t 1 _ 2>/dev/null; then
    break
  fi
done
printf '\n'

if [[ "$DO_DOWNLOAD" -eq 1 ]]; then
  exec stickllm-download-model --i-understand --id "$recommend"
fi
