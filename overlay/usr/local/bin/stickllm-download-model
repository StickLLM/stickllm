#!/bin/bash
# Download a catalog-pinned model onto STICKLLM-DATA (or RAM models dir). Verify SHA-256.
# Writes /run/stickllm/download-progress.json for Models UI + bootstatus.
set -euo pipefail

CATALOG="${STICKLLM_CATALOG:-/etc/stickllm/models/catalog.toml}"
MNT="${STICKLLM_DATA_MNT:-/mnt/stickllm-data}"
RUN="${STICKLLM_RUN:-/run/stickllm}"
PROGRESS_JSON="$RUN/download-progress.json"
LOCK="$RUN/download.lock"
ID=""
CONFIRM=0

usage() {
  echo "Usage: sudo stickllm-download-model --i-understand [--id MODEL_ID]"
  echo "Catalog: $CATALOG"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --i-understand) CONFIRM=1; shift ;;
    --id) ID="${2:-}"; shift 2 ;;
    --id=*) ID="${1#--id=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown: $1"; usage; exit 2 ;;
  esac
done

if [[ "$CONFIRM" -ne 1 ]]; then
  echo "Refusing without confirmation."
  usage
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run as root (sudo)."
  exit 1
fi

mkdir -p "$RUN"
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "Another stickllm-download-model is already running."
  exit 0
fi

# Session mode (header dropdown): ephemeral = no vault/SSD writes; vault = prefer vault.
SESSION_MODE="${STICKLLM_SESSION_MODE:-}"
if [[ -z "$SESSION_MODE" && -f "$RUN/session-mode.json" ]]; then
  SESSION_MODE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("mode","ephemeral"))' "$RUN/session-mode.json" 2>/dev/null || echo ephemeral)"
fi
SESSION_MODE="$(printf '%s' "${SESSION_MODE:-ephemeral}" | tr '[:upper:]' '[:lower:]')"

VAULT_MNT="${STICKLLM_VAULT_MNT:-/var/lib/stickllm/vault}"
DATA_MNT_META="${STICKLLM_VAULT_META:-}"
if [[ -z "$DATA_MNT_META" ]]; then
  if findmnt -n "$MNT" >/dev/null 2>&1; then
    DATA_MNT_META="$MNT/vault-meta"
  else
    DATA_MNT_META="/var/lib/stickllm/vault-meta"
  fi
fi
DEST_DIR=""
if [[ "$SESSION_MODE" == "vault" ]]; then
  # Prefer clear host SSD models folder (vault setup root). Chats stay in LUKS blob only.
  ROOT_DIR=""
  if [[ -f /run/stickllm/vault.json ]]; then
    ROOT_DIR="$(python3 -c 'import json,sys;print(json.load(open("/run/stickllm/vault.json")).get("root") or "")' 2>/dev/null || true)"
  fi
  if [[ -z "$ROOT_DIR" && -f "$DATA_MNT_META/root" ]]; then
    ROOT_DIR="$(tr -d '\n' <"$DATA_MNT_META/root")"
  fi
  if [[ -z "$ROOT_DIR" && -f /var/lib/stickllm/vault-meta/root ]]; then
    ROOT_DIR="$(tr -d '\n' </var/lib/stickllm/vault-meta/root)"
  fi
  if [[ -n "$ROOT_DIR" && -d "$ROOT_DIR" ]]; then
    base="$(basename -- "$ROOT_DIR")"
    if [[ "${base,,}" == "models" ]]; then
      DEST_DIR="$ROOT_DIR"
    else
      DEST_DIR="$ROOT_DIR/models"
    fi
    echo "Download target: SSD models folder ($DEST_DIR)"
  elif findmnt -n "$VAULT_MNT" >/dev/null 2>&1 && [[ -d "$VAULT_MNT/models" ]]; then
    # Fallback only when host root unknown but vault is unlocked.
    DEST_DIR="$VAULT_MNT/models"
    echo "Download target: vault-internal models ($DEST_DIR) — host root not configured"
  fi
  if [[ -z "$DEST_DIR" ]]; then
    echo "Vault mode selected but vault is locked/absent — unlock or setup in Settings → Storage."
    echo "Refusing USB/RAM fallback in vault mode (fail-closed)."
    exit 1
  fi
else
  echo "Session mode: ephemeral — not writing to SSD vault."
fi
if [[ -z "$DEST_DIR" ]]; then
  if findmnt -n "$MNT" >/dev/null 2>&1; then
    DEST_DIR="$MNT/models"
    echo "Download target: USB STICKLLM-DATA ($DEST_DIR)"
  else
    DEST_DIR="/opt/stickllm/models"
    echo "WARNING: STICKLLM-DATA not mounted — writing to live RAM ($DEST_DIR)."
    echo "Run: sudo stickllm-usb-claim --auto --yes"
  fi
fi
mkdir -p "$DEST_DIR"

# Resolve model from catalog via python
MAP="$(python3 - "$CATALOG" "$ID" <<'PY'
import json, re, sys
path, want = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
models = []
for b in re.split(r"\n\[\[model\]\]\n", text)[1:]:
    def g(key, default=None):
        m = re.search(rf"^{key}\s*=\s*(.+)$", b, re.M)
        if not m:
            return default
        raw = m.group(1).strip()
        if raw.startswith("["):
            return re.findall(r'"([^"]*)"', raw)
        return raw.strip('"')
    mid = g("id")
    if not mid:
        continue
    models.append({
        "id": mid,
        "name": g("name", mid),
        "hf_repo": g("hf_repo", "") or "",
        "hf_files": g("hf_files", []) or [],
        "sha256": [s.lower() for s in (g("sha256", []) or [])],
        "approx_size_gb": float(g("approx_size_gb", "0") or 0),
        "quality_rank": int(float(g("quality_rank", "0") or 0)),
    })
pick = None
if want:
    pick = next((m for m in models if m["id"] == want), None)
    if not pick:
        print(json.dumps({"error": f"unknown model id: {want}"}))
        sys.exit(3)
else:
    pinned = [m for m in models if m["hf_repo"] and m["hf_files"]]
    if not pinned:
        print(json.dumps({"error": "no pinned models in catalog"}))
        sys.exit(3)
    pick = max(pinned, key=lambda m: m["quality_rank"])
print(json.dumps(pick))
PY
)"

if echo "$MAP" | python3 -c 'import json,sys; d=json.load(sys.stdin); raise SystemExit(1 if d.get("error") else 0)'; then
  :
else
  echo "$MAP"
  exit 3
fi

NAME="$(echo "$MAP" | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')"
REPO="$(echo "$MAP" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hf_repo"])')"
ID="$(echo "$MAP" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"

echo "StickLLM Download model (v0.2)"
echo "  Model: $NAME ($ID)"
echo "  Dest:  $DEST_DIR"
echo "  Source: https://huggingface.co/${REPO}"
echo

if [[ -z "$REPO" ]]; then
  echo "Model not pinned with hf_repo yet — cannot download."
  exit 4
fi

FILES="$(echo "$MAP" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["hf_files"]))')"
HASHES="$(echo "$MAP" | python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["sha256"]))')"

TOTAL_BYTES="$(echo "$MAP" | python3 -c 'import json,sys; print(int(float(json.load(sys.stdin).get("approx_size_gb") or 0)*(1024**3)))')"
FILE_COUNT="$(echo "$MAP" | python3 -c 'import json,sys; print(max(len(json.load(sys.stdin).get("hf_files") or []),1))')"
PER_FILE_BYTES=$(( TOTAL_BYTES / FILE_COUNT ))
[[ "$PER_FILE_BYTES" -lt 1 ]] && PER_FILE_BYTES=0

write_progress() {
  local state="$1" file="$2" done_b="$3" total_b="$4" note="${5:-}"
  python3 - "$PROGRESS_JSON" "$state" "$ID" "$NAME" "$file" "$done_b" "$total_b" "$note" <<'PY'
import json, sys, time
path, state, mid, name, file, done, total, note = sys.argv[1:9]
done_i, total_i = int(done or 0), int(total or 0)
pct = None
if total_i > 0:
    pct = max(0.0, min(99.9, round(100.0 * done_i / total_i, 1)))
now = int(time.time())
started = now
try:
    prev = json.load(open(path, encoding="utf-8"))
    if prev.get("id") == mid and prev.get("started") and prev.get("state") not in ("done", "failed", "idle"):
        started = int(prev["started"])
except Exception:
    pass
doc = {
    "state": state,
    "id": mid,
    "name": name,
    "file": file,
    "percent": pct,
    "bytes_done": done_i,
    "bytes_total": total_i,
    "note": note,
    "started": started,
    "updated": now,
}
open(path, "w", encoding="utf-8").write(json.dumps(doc) + "\n")
PY
}

write_progress "starting" "" 0 "$TOTAL_BYTES" "starting download"

cleanup_progress() {
  local st="${1:-failed}"
  write_progress "$st" "" "${2:-0}" "$TOTAL_BYTES" "$st"
}
trap 'cleanup_progress failed 0' ERR

i=0
BYTES_BEFORE=0
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  DEST="${DEST_DIR}/${f}"
  URL="https://huggingface.co/${REPO}/resolve/main/${f}"
  expect="$(echo "$HASHES" | sed -n "$((i+1))p" | tr '[:upper:]' '[:lower:]')"
  if [[ -z "$expect" ]]; then
    echo "FATAL: no sha256 in catalog for $f — refusing unverified model"
    write_progress "failed" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "missing sha256"
    exit 5
  fi
  if [[ -f "$DEST" ]]; then
    echo "Already present: $DEST — verifying sha256"
    write_progress "verifying" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "hash check"
    got="$(sha256sum "$DEST" | awk '{print tolower($1)}')"
    if [[ "$got" != "$expect" ]]; then
      echo "HASH MISMATCH: $f"
      echo "  expected $expect"
      echo "  got      $got"
      rm -f "$DEST"
      write_progress "failed" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "hash mismatch"
      exit 5
    fi
    SZ="$(stat -c%s "$DEST" 2>/dev/null || echo 0)"
    BYTES_BEFORE=$((BYTES_BEFORE + SZ))
    echo "OK sha256 $f"
  else
    TMP="${DEST}.partial"
    echo "Fetching $f …"
    write_progress "downloading" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "fetching"
    if command -v curl >/dev/null; then
      # Resume + retry: HF / USB sticks drop connections; don't leave a frozen .partial.
      ATTEMPT=0
      MAX_ATTEMPTS=30
      CURL_RC=1
      while (( ATTEMPT < MAX_ATTEMPTS )); do
        ATTEMPT=$((ATTEMPT + 1))
        write_progress "downloading" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "fetching (try ${ATTEMPT}/${MAX_ATTEMPTS})"
        set +e
        curl -L --fail --progress-bar \
          -C - \
          --retry 8 \
          --retry-delay 3 \
          --retry-all-errors \
          --connect-timeout 30 \
          --speed-time 60 \
          --speed-limit 1000 \
          -o "$TMP" "$URL" &
        CURLPID=$!
        STALL_TICKS=0
        LAST_SZ=-1
        while kill -0 "$CURLPID" 2>/dev/null; do
          CUR="$(stat -c%s "$TMP" 2>/dev/null || echo 0)"
          write_progress "downloading" "$f" "$((BYTES_BEFORE + CUR))" "$TOTAL_BYTES" "fetching (try ${ATTEMPT}/${MAX_ATTEMPTS})"
          if [[ "$CUR" -eq "$LAST_SZ" ]]; then
            STALL_TICKS=$((STALL_TICKS + 1))
          else
            STALL_TICKS=0
            LAST_SZ=$CUR
          fi
          # If curl is alive but bytes frozen ~3 min, kill and resume.
          if (( STALL_TICKS >= 36 )); then
            echo "Stall detected on $f — restarting curl (try ${ATTEMPT})"
            kill "$CURLPID" 2>/dev/null || true
            wait "$CURLPID" 2>/dev/null || true
            break
          fi
          sleep 5
        done
        wait "$CURLPID" 2>/dev/null
        CURL_RC=$?
        set -e
        if [[ "$CURL_RC" -eq 0 ]] && [[ -f "$TMP" ]]; then
          break
        fi
        echo "curl exit ${CURL_RC} for $f — will resume (try ${ATTEMPT}/${MAX_ATTEMPTS})"
        sleep 5
      done
      if [[ ! -f "$TMP" ]]; then
        write_progress "failed" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "curl failed"
        exit 1
      fi
      CUR="$(stat -c%s "$TMP" 2>/dev/null || echo 0)"
      if [[ "$PER_FILE_BYTES" -gt 0 ]] && [[ "$CUR" -lt $((PER_FILE_BYTES * 95 / 100)) ]] && [[ "$CURL_RC" -ne 0 ]]; then
        write_progress "failed" "$f" "$((BYTES_BEFORE + CUR))" "$TOTAL_BYTES" "incomplete after retries"
        exit 1
      fi
    elif command -v wget >/dev/null; then
      wget -c -O "$TMP" "$URL"
    else
      echo "Need curl or wget."
      exit 1
    fi
    write_progress "verifying" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "hash check"
    # ISS-011: verify .partial before mv into final path.
    got="$(sha256sum "$TMP" | awk '{print tolower($1)}')"
    if [[ "$got" != "$expect" ]]; then
      echo "HASH MISMATCH: $f"
      echo "  expected $expect"
      echo "  got      $got"
      rm -f "$TMP"
      write_progress "failed" "$f" "$BYTES_BEFORE" "$TOTAL_BYTES" "hash mismatch"
      exit 5
    fi
    mv "$TMP" "$DEST"
    chmod 644 "$DEST"
    SZ="$(stat -c%s "$DEST" 2>/dev/null || echo 0)"
    BYTES_BEFORE=$((BYTES_BEFORE + SZ))
    echo "OK sha256 $f"
  fi
  i=$((i+1))
done <<<"$FILES"

# Point runtime at first file / shard
FIRST="$(echo "$FILES" | head -1)"
if [[ -n "$FIRST" ]]; then
  mkdir -p "$RUN"
  {
    printf 'STICKLLM_MODEL=%s\n' "${DEST_DIR}/${FIRST}"
    printf 'STICKLLM_MODEL_ID=%s\n' "$ID"
    printf 'STICKLLM_MODEL_NAME=%s\n' "$NAME"
  } >"$RUN/model.env"
  ln -sfn "${DEST_DIR}/${FIRST}" "$RUN/current.gguf" 2>/dev/null || true
  echo "Active model → ${DEST_DIR}/${FIRST}"
fi

systemctl daemon-reload || true
systemctl restart stickllm-llama.service || true
write_progress "done" "" "$TOTAL_BYTES" "$TOTAL_BYTES" "complete"
echo "Downloaded and verified. llama-server restart requested."
stickllm-status || true
sleep 2
write_progress "idle" "" 0 0 ""
