#!/usr/bin/env python3
"""StickLLM UI + chat gateway: web lookup, pair auth, control proxy (LAN :80).

Agent Zero is not under /agent. A second TLS listener on :5443 proxies 1:1 to
127.0.0.1:5099, including websockets, behind the same pairing check.
"""
from __future__ import annotations

import base64
import hashlib
