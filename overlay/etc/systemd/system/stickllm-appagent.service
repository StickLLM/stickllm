[Unit]
Description=StickLLM app agent (chat -> app actions, 127.0.0.1:8795 only)
# 0.5.6: not enabled at boot. The user loads it from the chat page (control
# appagent_load). It uses the shared chat llama-server; it never pulls in a model.
After=network.target

[Service]
EnvironmentFile=-/etc/stickllm/appagent.env
Type=simple
# Keeps no files: sessions, history and the ONLYOFFICE job queue live in memory.
DynamicUser=yes
ExecStart=/usr/local/bin/stickllm-appagent
Restart=on-failure
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
