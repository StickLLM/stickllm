#!/bin/bash
# Console status on tty1: Network -> UI ready -> READY with IP + URL + pair.
# Models load on demand from the UI (not at boot). Owns tty1 (conflicts getty@tty1).
# Term login: Ctrl+Alt+F2 or SSH.
# NOTE: avoid set -e - a single failed curl/systemctl must not kill the status UI.
set -uo pipefail

TTY="${STICKLLM_TTY:-/dev/tty1}"
# Probe loopback services; LAN clients use the printed URL (http/https).
API="${STICKLLM_API:-http://127.0.0.1:8080}"
UI="${STICKLLM_UI:-http://127.0.0.1/}"
UI_TLS="${STICKLLM_UI_TLS:-https://127.0.0.1/}"
RUN="${STICKLLM_RUN:-/run/stickllm}"
MODEL_PATH=""
MODEL_NAME="none — activate in UI"
LOG="$RUN/bootstatus.log"

mkdir -p "$RUN"
: >>"$LOG"
# Older builds appended the SSH password to this tmpfs log. Drop those lines.
if [[ -f "$LOG" ]] && grep -Eqi 'password:|STICKLLM_SSH_PASS' "$LOG" 2>/dev/null; then
  grep -Eiv 'password:|STICKLLM_SSH_PASS' "$LOG" >"$LOG.redacted" 2>/dev/null || true
  mv -f "$LOG.redacted" "$LOG" 2>/dev/null || true
fi

# Headless/QEMU: tty1 may be unusable - fall back to serial/console.
if [[ ! -c "$TTY" ]] || ! ( : >>"$TTY" ) 2>/dev/null; then
  for cand in /dev/ttyS0 /dev/console; do
    if [[ -c "$cand" ]] && ( : >>"$cand" ) 2>/dev/null; then
      TTY="$cand"
      break
    fi
  done
fi
printf 'STICKLLM_BOOTSTATUS_START tty=%s\n' "$TTY" >>"$LOG"
# Serial breadcrumb once. Never /dev/console - with console=tty0 it aliases HDMI/tty1.
serial_only() {
  [[ -w /dev/ttyS0 ]] || return 0
  # Skip if primary paint target is already the serial device.
  local rp_t rp_s
  rp_t="$(readlink -f "$TTY" 2>/dev/null || printf '%s' "$TTY")"
  rp_s="$(readlink -f /dev/ttyS0 2>/dev/null || printf '%s' /dev/ttyS0)"
  [[ "$rp_t" == "$rp_s" ]] && return 0
  printf '%s\n' "$*" >/dev/ttyS0 2>/dev/null || true
}
serial_only "STICKLLM_BOOTSTATUS_START tty=$TTY"

refresh_model_label() {
  local envf="$RUN/model.env"
  MODEL_PATH=""
  MODEL_NAME="none — activate in UI"
  if [[ -f "$envf" ]]; then
    # shellcheck disable=SC1090
    set -a
    # shellcheck source=/dev/null
    . "$envf" 2>/dev/null || true
    set +a
    if [[ -n "${STICKLLM_MODEL_NAME:-}" ]]; then
      MODEL_NAME="$STICKLLM_MODEL_NAME"
    fi
    if [[ -n "${STICKLLM_MODEL:-}" && -f "${STICKLLM_MODEL}" ]]; then
      MODEL_PATH="$STICKLLM_MODEL"
    fi
  fi
  # Persist for kiosk / gateway status (activated model only — never invent a default).
  printf '%s\n' "${MODEL_NAME:-}" >"$RUN/model-label.txt" 2>/dev/null || true
}
refresh_model_label

mkdir -p "$RUN"
touch "$LOG"
# Local: paint loading on tty1 until READY, then yield to stickllm-local-chat
# (direct AI on this PC - no LAN browser / pair flow).
LOCAL_YIELD=0
# Chat: on-stick kiosk when display present + LAN UI. local/kiosk = aliases.
if grep -Eqw 'stickllm\.(chat|kiosk|local)' /proc/cmdline 2>/dev/null; then
  LOCAL_YIELD=1
  echo "bootstatus: chat - loading then yield to on-stick browser" >>"$LOG"
fi
# Prefer VT1 (product screen). Never paint /dev/tty0 or /dev/console -
# with console=tty0 those alias the same HDMI and double every line.
chvt 1 2>/dev/null || true
echo "bootstatus: starting pid=$$" >>"$LOG" 2>/dev/null || true

clear_tty() {
  # Reset only the primary product tty once (not tty0/console aliases).
  local seq=$'\033c\033[H\033[2J\033[3J'
  chvt 1 2>/dev/null || true
  printf '%s' "$seq" >"$TTY" 2>/dev/null || true
}

mode="chat"
mode_label="Server / Local"
SSH_ON=0
# Default menu is Server / Local (stickllm.chat). local/kiosk remain aliases.
# Test menu uses stickllm.chat + stickllm.ssh — keep Chat UI; do not switch to Terminal.
grep -Eqw 'stickllm\.(chat|local|kiosk)' /proc/cmdline 2>/dev/null && {
  mode="chat"
  mode_label="Server / Local"
}
grep -qw 'stickllm.ssh' /proc/cmdline 2>/dev/null && SSH_ON=1
if [[ "$SSH_ON" -eq 1 ]] && ! grep -Eqw 'stickllm\.(chat|local|kiosk)' /proc/cmdline 2>/dev/null; then
  mode="ssh"
  mode_label="Terminal (SSH + console; no browser)"
elif [[ "$mode" == "chat" && "$SSH_ON" -eq 1 ]]; then
  mode_label="Test (chat UI + SSH)"
fi
grep -qw 'stickllm.client' /proc/cmdline 2>/dev/null && {
  mode="client"
  mode_label="Secure Client (coming soon)"
}

say_screen() {
  # tty1 only. say() also appends to /run/stickllm/bootstatus.log — never put the
  # SSH password on that path or on the serial line.
  printf '%s\n' "$*" >>"$TTY" 2>/dev/null || true
}

ssh_password_line() {
  # Print SSH credentials when menu enabled SSH (Terminal or Test).
  # Kept visually loud — READY can hand off to the browser quickly.
  [[ "$SSH_ON" -eq 1 ]] || return 0
  local ip="${1:-}" pass=""
  pass="$(tr -d '[:space:]' <"$RUN/ssh-password.txt" 2>/dev/null || true)"
  if [[ -n "${pass:-}" ]]; then
    say "  ----------------------------------------"
    say "  SSH (copy now — also in Settings → System on this screen)"
    say "  user: stickllm"
    say "  host: ${ip:-<lan-ip>}   (or 127.0.0.1 from the stick)"
    say_screen "  password: ${pass}"
    say "  ----------------------------------------"
  else
    say "  SSH: stickllm@${ip:-<lan-ip>}  (password is on this screen when the file is readable)"
  fi
}

PAIR_STATE="none" # none | code | paired | waiting_ui
PAIR_CODE=""
SCHEME="http"
FP=""
last_failed=""
ui_ok=0
api_ok=0
gw_ok=0

url_scheme() {
  # Only advertise https if something actually answers on 443 (v0.2 gateway is :80 http).
  SCHEME="http"
  FP=""
  if curl -fkS --max-time 1 "https://127.0.0.1/" >/dev/null 2>&1 || \
     curl -fkS --max-time 1 "https://127.0.0.1/api/health" >/dev/null 2>&1; then
    SCHEME="https"
    if [[ -f /var/lib/stickllm/tls/cert.pem ]] && command -v openssl >/dev/null 2>&1; then
      FP="$(openssl x509 -in /var/lib/stickllm/tls/cert.pem -noout -fingerprint -sha256 2>/dev/null | awk -F= '{print $2}' | tr -d ':' | cut -c1-16 || true)"
    fi
  fi
}

lan_ip() {
  # Prefer shared helper (skips link-local; refreshes /run/stickllm/lan-ip.txt).
  local ip=""
  if [[ -x /usr/local/bin/stickllm-lan-ip ]]; then
    ip="$(/usr/local/bin/stickllm-lan-ip 2>/dev/null | tr -d '[:space:]' || true)"
    printf '%s' "${ip:-}"
    return 0
  fi
  # Prefer a global IPv4 on a real NIC (works for QEMU 10.0.2.x and LAN DHCP).
  ip="$(ip -4 -o addr show scope global 2>/dev/null \
    | awk '!/[[:space:]]lo[[:space:]]/ && $4 !~ /^169\.254\./ {print $4; exit}' | cut -d/ -f1)"
  if [[ -z "$ip" ]]; then
    ip="$(hostname -I 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $i !~ /^127\./ && $i !~ /^169\.254\./){print $i; exit}}')"
  fi
  if [[ -z "$ip" ]]; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
    case "${ip:-}" in
      127.*|169.254.*) ip="" ;;
    esac
  fi
  if [[ -n "$ip" ]]; then
    printf '%s\n' "$ip" >"$RUN/lan-ip.txt" 2>/dev/null || true
  fi
  printf '%s' "${ip:-}"
}

ensure_network() {
  # Kick NM/DHCP while stuck on Network Loading - never block the status loop.
  # nmcli device connect / connection up can hang ~90–120s on missing PHY; always timeout.
  systemctl start --no-block NetworkManager.service 2>/dev/null || true
  if command -v nmcli >/dev/null 2>&1; then
    timeout 3 nmcli networking on >/dev/null 2>&1 || true
    local have_ip=0
    [[ -n "$(lan_ip)" ]] && have_ip=1
    # Only attempt blocking connects when we still need an address.
    if [[ "$have_ip" -eq 0 ]]; then
      local eth
      eth="$(timeout 3 nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null \
        | awk -F: '$2=="ethernet" && $3!="connected"{print $1; exit}' || true)"
      if [[ -n "${eth:-}" ]]; then
        timeout 8 nmcli device connect "$eth" >/dev/null 2>&1 || true
      fi
      while IFS=: read -r dev typ state; do
        [[ "$typ" == "ethernet" ]] || continue
        [[ "$state" == "connected" ]] && continue
        timeout 3 nmcli device set "$dev" managed yes >/dev/null 2>&1 || true
        timeout 8 nmcli device connect "$dev" >/dev/null 2>&1 || true
      done < <(timeout 3 nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null || true)
    fi
    # Restore WiFi profile persisted on STICKLLM-DATA (Local Web / WiFi P0).
    if [[ -d /mnt/stickllm-data/network ]]; then
      for f in /mnt/stickllm-data/network/*.nmconnection; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        install -d -m 755 /etc/NetworkManager/system-connections
        install -m 600 "$f" "/etc/NetworkManager/system-connections/${base}" 2>/dev/null || true
      done
      timeout 3 nmcli connection reload >/dev/null 2>&1 || true
      if [[ "$have_ip" -eq 0 ]]; then
        timeout 8 nmcli connection up stickllm-wifi >/dev/null 2>&1 || true
      fi
    fi
    while IFS=: read -r dev typ state; do
      [[ "$typ" == "wifi" ]] || continue
      [[ "$state" == "connected" ]] && continue
      timeout 3 nmcli device set "$dev" managed yes >/dev/null 2>&1 || true
    done < <(timeout 3 nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null || true)
  fi
}

emit_net_probe() {
  local ip="$1"
  local listen80=0 nm_state="?"
  ss -lntp 2>/dev/null | grep -qE ':80\b' && listen80=1
  if command -v nmcli >/dev/null 2>&1; then
    nm_state="$(nmcli -t -f STATE g 2>/dev/null | head -1 || echo '?')"
  fi
  serial_only "STICKLLM_NET_PROBE ip=${ip:-none} nm=${nm_state:-?} listen80=$listen80"
  printf 'STICKLLM_NET_PROBE ip=%s nm=%s listen80=%s\n' \
    "${ip:-none}" "${nm_state:-?}" "$listen80" >>"$LOG" 2>/dev/null || true
}

ensure_pair() {
  PAIR_CODE=""
  PAIR_STATE="none"
  local pair_out=""
  mkdir -p "$RUN"
  # Never mint a new code once a browser has paired - that used to wipe the session
  # every READY redraw (pair-code.txt is deleted on successful pair).
  if [[ -f "$RUN/auth.json" ]] && python3 -c 'import json,sys;d=json.load(open("'"$RUN"'/auth.json"));sys.exit(0 if d.get("paired") else 1)' 2>/dev/null; then
    PAIR_STATE="paired"
    return
  fi
  sed -i 's/\r$//' /usr/local/bin/stickllm-pair 2>/dev/null || true
  chmod 755 /usr/local/bin/stickllm-pair 2>/dev/null || true
  # stickllm-pair keeps a fresh code or remints when TTL elapsed so HDMI + auth.json stay in sync.
  pair_out="$(/usr/bin/env python3 /usr/local/bin/stickllm-pair 2>&1)" || \
    pair_out="$(/usr/local/bin/stickllm-pair 2>&1)" || true
  if [[ "${pair_out:-}" == "PAIRED" ]]; then
    PAIR_STATE="paired"
    return
  fi
  PAIR_CODE="$(tr -d '\r\n\t ' <"$RUN/pair-code.txt" 2>/dev/null || true)"
  if [[ ! "${PAIR_CODE:-}" =~ ^[0-9]{4,8}$ ]]; then
    if [[ "${pair_out:-}" =~ ^[0-9]{4,8}$ ]]; then
      PAIR_CODE="$pair_out"
      printf '%s\n' "$PAIR_CODE" >"$RUN/pair-code.txt" 2>/dev/null || true
    else
      rm -f "$RUN/pair-code.txt"
      pair_out="$(/usr/bin/env python3 /usr/local/bin/stickllm-pair --force 2>&1)" || \
        pair_out="$(/usr/local/bin/stickllm-pair --force 2>&1)" || true
      PAIR_CODE="$(tr -d '\r\n\t ' <"$RUN/pair-code.txt" 2>/dev/null || true)"
      if [[ ! "${PAIR_CODE:-}" =~ ^[0-9]{4,8}$ ]]; then
        if [[ "${pair_out:-}" =~ ^[0-9]{4,8}$ ]]; then
          PAIR_CODE="$pair_out"
          printf '%s\n' "$PAIR_CODE" >"$RUN/pair-code.txt" 2>/dev/null || true
        else
          serial_only "STICKLLM_PAIR_FAIL ${pair_out:-no_output}"
          printf 'STICKLLM_PAIR_FAIL %s\n' "${pair_out:-no_output}" >>"$LOG" 2>/dev/null || true
          PAIR_CODE=""
        fi
      fi
    fi
  fi
  if [[ "${PAIR_CODE:-}" =~ ^[0-9]{4,8}$ ]]; then
    PAIR_STATE="code"
    serial_only "STICKLLM_PAIR_MINTED $PAIR_CODE"
  fi
}

say() {
  local line="$*"
  printf '%s\n' "$line" >>"$LOG" 2>/dev/null || true
  # HDMI/product: exactly once on $TTY (normally /dev/tty1).
  # Never /dev/console or /dev/tty0 - console=tty0 makes them the same screen.
  printf '%s\n' "$line" >>"$TTY" 2>/dev/null || true
  # QEMU/headless proof: mirror to serial only when distinct from $TTY.
  serial_only "$line"
}

refresh_failed() {
  # Ignore optional/noisy units - do not scare users with nvidia/USB DATA soft-fails.
  local u
  u="$(systemctl --failed --no-legend --no-pager --plain 2>/dev/null \
    | awk 'NF && $1 !~ /^UNIT$/ \
      && $1 !~ /nvidia-persistenced/ \
      && $1 !~ /stickllm-usb/ \
      && $1 !~ /plymouth/ \
      && $1 !~ /ModemManager/ \
      && $1 !~ /systemd-modules-load/ \
      { print $1; exit }')"
  if [[ -n "$u" ]]; then
    last_failed="$u"
  else
    last_failed=""
  fi
  # Clear sticky optional/noisy failed units so the console stays product-focused.
  systemctl reset-failed nvidia-persistenced.service 2>/dev/null || true
  systemctl reset-failed systemd-modules-load.service 2>/dev/null || true
  # USB DATA claim is best-effort - never dominate the product loading screen.
  systemctl reset-failed stickllm-usb.service 2>/dev/null || true
}

probe_services() {
  ui_ok=0
  api_ok=0
  gw_ok=0
  # Static UI / gateway health (works even while llama is still loading).
  curl -fsS --max-time 1 "$UI" >/dev/null 2>&1 && ui_ok=1
  [[ "$ui_ok" -eq 0 ]] && curl -fkS --max-time 1 "$UI_TLS" >/dev/null 2>&1 && ui_ok=1
  curl -fsS --max-time 1 "http://127.0.0.1/api/pair/status" >/dev/null 2>&1 && gw_ok=1
  [[ "$gw_ok" -eq 0 ]] && curl -fkS --max-time 1 "https://127.0.0.1/api/pair/status" >/dev/null 2>&1 && gw_ok=1
  [[ "$gw_ok" -eq 0 ]] && curl -fsS --max-time 1 "http://127.0.0.1/api/health" >/dev/null 2>&1 && gw_ok=1
  [[ "$ui_ok" -eq 1 || "$gw_ok" -eq 1 ]] && ui_ok=1
  # Model readiness = llama :8080 /health (not gateway - /api/health is always HTTP 200).
  curl -fsS --max-time 2 "http://127.0.0.1:8080/health" >/dev/null 2>&1 && api_ok=1
  [[ "$api_ok" -eq 0 ]] && curl -fsS --max-time 2 "$API/health" >/dev/null 2>&1 && api_ok=1
  # After API-kill, never treat OpenAI /v1 as readiness - only llama_ok on gateway.
  if [[ "$api_ok" -eq 0 ]]; then
    local gw_body
    gw_body="$(curl -fsS --max-time 2 "http://127.0.0.1/api/health" 2>/dev/null || true)"
    if printf '%s' "$gw_body" | grep -Eq '"llama_ok"[[:space:]]*:[[:space:]]*true'; then
      api_ok=1
    fi
  fi
}

handoff_local_chat() {
  # Stop fighting over tty1: bootstatus exits; kiosk (browser) owns the console.
  # Fallback path (no cage/cog) is stickllm-local-chat inside stickllm-kiosk.
  # Do not start stickllm-llama — models load on demand via UI Activate.
  mkdir -p "$RUN"
  touch "$RUN/allow-local-chat"
  touch "$RUN/local-mode"
  dump_svc_diag
  serial_only "STICKLLM_LOCAL_HANDOFF"
  printf 'STICKLLM_LOCAL_HANDOFF\n' >>"$LOG" 2>/dev/null || true
  # Prefer on-stick browser kiosk; do not start tty local-chat in parallel (blank fight).
  if systemctl start --no-block stickllm-kiosk.service 2>/dev/null; then
    serial_only "STICKLLM_LOCAL_KIOSK_QUEUED"
  else
    serial_only "STICKLLM_LOCAL_KIOSK_MISSING_FALLBACK_TTY"
    touch "$RUN/allow-local-chat-fallback"
    systemctl start --no-block stickllm-local.service 2>/dev/null || true
  fi
}

# Human-readable download line for tty1 (percent / MB) while curl/.partial runs.
download_phase_msg() {
  python3 - "$RUN" <<'PY' 2>/dev/null || true
import json, os, glob, sys
run = sys.argv[1]
prog = {}
try:
    prog = json.load(open(os.path.join(run, "download-progress.json"), encoding="utf-8"))
except Exception:
    pass
state = prog.get("state") or ""
name = prog.get("name") or prog.get("id") or "model"
pct = prog.get("percent")
done = int(prog.get("bytes_done") or 0)
total = int(prog.get("bytes_total") or 0)

def fmt(n):
    if n >= 1024**3:
        return f"{n/(1024**3):.2f} GB"
    return f"{n/(1024**2):.0f} MB"

partials = []
for pattern in ("/mnt/stickllm-data/models/*.partial", "/opt/stickllm/models/*.partial"):
    for p in glob.glob(pattern):
        try:
            partials.append(os.path.getsize(p))
        except OSError:
            pass
if partials and done < max(partials):
    done = max(partials)
if state in ("downloading", "starting", "verifying", "failed") or partials:
    if state == "verifying":
        print(f"Downloading model… verifying {name}")
    elif state == "failed":
        print(f"Download failed: {name}")
    elif pct is not None:
        print(f"Downloading model… {pct}% ({fmt(done)}" + (f" / {fmt(total)}" if total else "") + ")")
    elif done > 0:
        print(f"Downloading model… {fmt(done)}" + (f" / {fmt(total)}" if total else ""))
    else:
        print("Downloading model…")
    raise SystemExit(0)
# Process running but no progress file yet
import subprocess
try:
    r = subprocess.run(
        ["pgrep", "-f", "stickllm-download-model|curl.*huggingface|wget.*gguf"],
        capture_output=True, timeout=3,
    )
    if r.returncode == 0:
        print("Downloading model…")
except Exception:
    pass
PY
}

# Progressive product phases for Term/Server (and Local loading before yield).
# READY no longer waits on llama /health — models load on demand from the UI.
detect_phase() {
  local ui_ok="$1" api_ok="$2" ip="$3"
  local dl=""

  refresh_model_label

  dl="$(download_phase_msg)"
  if [[ -n "${dl:-}" ]]; then
    echo "$dl"
    return
  fi

  # Local/Chat: gateway UI is enough — do not block on llama /health.
  if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
    if [[ "$ui_ok" -eq 1 ]]; then
      echo "READY"
      return
    fi
    echo "STICKLLM UI Loading"
    return
  fi

  # Term/Server: Network first - never claim READY / useful pair without a LAN path.
  if [[ -z "${ip:-}" ]]; then
    echo "STICKLLM Network Loading"
    return
  fi

  # READY when UI/gateway answers — pair alone is never success; model is on-demand.
  if [[ "$ui_ok" -eq 1 ]]; then
    echo "READY"
    return
  fi

  # Keep "STICKLLM Model" string for smoke UX grep; rare path if Activate raced boot.
  if [[ -f "$RUN/model.env" && "$api_ok" -eq 0 ]]; then
    echo "STICKLLM Model (${MODEL_NAME}) Loading"
    return
  fi

  echo "STICKLLM UI Loading"
}

usb_line() {
  if [[ -f "$RUN/storage.json" ]]; then
    python3 -c 'import json;d=json.load(open("'"$RUN"'/storage.json"));print("USB DATA: mounted, "+str(d.get("free_gb","?"))+" GiB free" if d.get("mounted") else "USB DATA: "+str(d.get("note","not claimed")))' 2>/dev/null \
      || echo "USB DATA: ?"
  else
    echo "USB DATA: (checking…)"
  fi
}

draw_header() {
  local title="$1"
  refresh_model_label
  say ""
  say "========================================"
  say "  ${title}"
  say "========================================"
  say ""
  say "  Mode:   $mode_label"
  say "  Model:  $MODEL_NAME"
  say "  $(usb_line)"
  say ""
}

draw_connect_steps() {
  local ip="$1" ui_ok="$2" ready="$3"
  url_scheme
  if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
    say "  How to connect (Chat = this screen + LAN):"
    say "    This screen: http://127.0.0.1/  (no pair)"
    if [[ -n "${ip:-}" ]]; then
      say "    >>> LAN IP:  ${ip}"
      if [[ "$ready" == "1" ]]; then
        say "    Phone/LAN:   ${SCHEME}://${ip}/  (enter PAIR CODE below)"
      else
        say "    Phone/LAN:   ${SCHEME}://${ip}/  (PAIR CODE on READY screen)"
      fi
    else
      say "    >>> LAN IP:  (waiting - Ethernet or stickllm-wifi-setup)"
      say "    Phone/LAN:   ${SCHEME}://<lan-ip>/  (PAIR CODE on READY)"
    fi
    say "    Models / Settings in the StickLLM web UI"
    if [[ "$SSH_ON" -eq 1 ]]; then
      ssh_password_line "${ip:-}"
      say "    Keyboard:   Ctrl+Alt+F2 -> stickllm / (same password)"
    fi
    return
  fi
  say "  How to connect (same LAN; WiFi: Settings or stickllm-wifi-setup):"
  if [[ -n "${ip:-}" ]]; then
    say "    >>> LAN IP:  ${ip}"
    say "    Browser:     ${SCHEME}://${ip}/"
    say "    URL:         ${SCHEME}://${ip}/"
  else
    say "    >>> LAN IP:  (waiting for network…)"
    say "    Browser:     ${SCHEME}://<lan-ip>/"
    say "    Status:      STICKLLM Network Loading - waiting for IP"
  fi
  if [[ "$SCHEME" == "https" ]]; then
    say "    TLS:        accept the browser warning once (self-signed)"
    if [[ -n "${FP:-}" ]]; then
      say "               fingerprint ${FP}…"
    fi
  fi
  if [[ "$ready" == "1" ]]; then
    say "    Then:       enter PAIR CODE below"
  else
    say "    Pair code:  shown on the READY screen (not while loading)"
  fi
  if [[ "$mode" == "ssh" || "$SSH_ON" -eq 1 ]]; then
    ssh_password_line "${ip:-}"
    say "    Keyboard:   Ctrl+Alt+F2 -> stickllm / (same password)"
  fi
}

draw_pair_box() {
  local ui_ok="${1:-0}"
  # READY-only: never show a placeholder "(UI starting)" box on loading.
  # Callers must only invoke this from draw_ready (or equivalent READY paint).
  if [[ "$ui_ok" -ne 1 ]]; then
    PAIR_STATE="waiting_ui"
    return
  fi
  ensure_pair
  if [[ "$PAIR_STATE" != "code" && "$PAIR_STATE" != "paired" ]]; then
    serial_only "STICKLLM_PAIR_RECOVER"
    rm -f "$RUN/pair-code.txt"
    /usr/bin/env python3 /usr/local/bin/stickllm-pair --force >/dev/null 2>&1 || \
      /usr/local/bin/stickllm-pair --force >/dev/null 2>&1 || true
    ensure_pair
  fi
  case "$PAIR_STATE" in
    paired)
      say "  +-------------------------+"
      say "  |  PAIRED - browser OK    |"
      say "  +-------------------------+"
      say "  StickLLM web UI unlocked until reboot"
      ;;
    code)
      say "  +-------------------------+"
      say "  |  PAIR CODE:  ${PAIR_CODE}     |"
      say "  +-------------------------+"
      say "  Enter this code in the browser Pair screen"
      ;;
    *)
      say "  PAIR CODE: generating..."
      serial_only "STICKLLM_PAIR_STILL_EMPTY hex=$(od -An -tx1 "$RUN/pair-code.txt" 2>/dev/null | tr -s ' ' | head -c 80)"
      ;;
  esac
}

emit_health_breadcrumb() {
  local ip="$1" ui_ok="$2" api_ok="$3" phase="$4"
  # Serial evidence for VM proof (pair alone is never enough).
  serial_only "STICKLLM_HEALTH phase=$phase ui=$ui_ok api=$api_ok ip=${ip:-none}"
  printf 'STICKLLM_HEALTH phase=%s ui=%s api=%s ip=%s\n' \
    "$phase" "$ui_ok" "$api_ok" "${ip:-none}" >>"$LOG" 2>/dev/null || true
  if [[ -n "${ip:-}" ]]; then
    url_scheme
    serial_only "STICKLLM_LAN_URL ${SCHEME}://${ip}/"
  fi
  if [[ "$ui_ok" -eq 1 && -n "${PAIR_CODE:-}" && "$PAIR_STATE" == "code" ]]; then
    serial_only "STICKLLM_PAIR_USABLE $PAIR_CODE"
  elif [[ "$ui_ok" -eq 1 && "$PAIR_STATE" == "paired" ]]; then
    serial_only "STICKLLM_PAIR_USABLE paired"
  fi
}

# Rough cold-load budget (seconds) for TIMER ETA - RTX 3090 class, baked GGUF.
ETA_PHASE=""
ETA_PHASE_START=0
ETA_LINE=""
eta_budget_secs() {
  local phase="$1"
  case "$phase" in
    "STICKLLM Network Loading") echo 45 ;;
    Downloading*)
      # HF model fetch - keep TIMER ticking; ETA is soft.
      echo 600
      ;;
    *"Model"*"Loading"*)
      if [[ "$MODEL_NAME" == *3B* ]] || [[ "$MODEL_PATH" == *3b* ]]; then
        # Cold CUDA load on 3090 often ~3–5 min (v0.3.1 HW: READY ~307s).
        echo 240
      else
        # Qwen2.5-7B Q5_K_M cold VRAM load often ~1-3 min on 3090
        echo 180
      fi
      ;;
    *) echo 0 ;;
  esac
}

# Sets global ETA_LINE (must not run in $(...) — ETA_PHASE state would be lost).
format_eta_line() {
  local elapsed="$1" phase="$2"
  local budget left mins secs phase_elapsed eta_key
  ETA_LINE=""
  # Stabilize ETA key so percent ticks don't reset the countdown (ISS-005).
  case "$phase" in
    Downloading*) eta_key="Downloading" ;;
    *) eta_key="$phase" ;;
  esac
  budget="$(eta_budget_secs "$phase")"
  if [[ -z "$budget" || "$budget" -le 0 ]]; then
    return
  fi
  # Prefer bytes-based ETA from download-progress.json when available.
  if [[ "$eta_key" == "Downloading" ]]; then
    local bytes_eta
    bytes_eta="$(python3 - "$RUN" <<'PY' 2>/dev/null || true
import json,sys,time
p=sys.argv[1]+"/download-progress.json"
try:
 d=json.load(open(p))
 done=float(d.get("bytes_done") or 0); total=float(d.get("bytes_total") or 0)
 t0=float(d.get("started") or d.get("updated") or 0)
 if total>0 and done>0 and t0>0:
  rate=done/max(1.0,time.time()-t0)
  if rate>1: print(int(max(0,(total-done)/rate)))
except Exception: pass
PY
)"
    if [[ -n "${bytes_eta:-}" && "$bytes_eta" =~ ^[0-9]+$ ]]; then
      left="$bytes_eta"
      mins=$(( left / 60 ))
      if (( mins >= 1 )); then
        ETA_LINE="$(printf '  |  ETA ~%sm left' "$mins")"
      else
        ETA_LINE="$(printf '  |  ETA ~%ss left' "$left")"
      fi
      return
    fi
  fi
  if [[ "$eta_key" != "$ETA_PHASE" ]]; then
    ETA_PHASE="$eta_key"
    ETA_PHASE_START=$elapsed
  fi
  phase_elapsed=$(( elapsed - ETA_PHASE_START ))
  (( phase_elapsed < 0 )) && phase_elapsed=0
  left=$(( budget - phase_elapsed ))
  if (( left <= 0 )); then
    ETA_LINE='  |  almost ready…'
    return
  fi
  if (( left >= 60 )); then
    mins=$(( (left + 30) / 60 ))
    ETA_LINE="$(printf '  |  ETA ~%sm left' "$mins")"
  else
    secs=$(( (left + 4) / 5 * 5 ))
    (( secs < 5 )) && secs=5
    ETA_LINE="$(printf '  |  ~%ss left' "$secs")"
  fi
}

draw() {
  local elapsed="$1" phase="$2" ip="$3" ui_ok="$4" api_ok="$5"

  printf '%s\n' "$phase" >"$RUN/boot-phase.txt"
  printf '%s\n' "$elapsed" >"$RUN/boot-elapsed.txt"
  printf '%s\n' "${ip:-}" >"$RUN/lan-ip.txt"

  clear_tty
  draw_header "StickLLM - loading"
  say "  Status: $phase"
  ETA_LINE=""
  format_eta_line "$elapsed" "$phase"
  say "  TIMER: ${elapsed}s${ETA_LINE}"
  refresh_failed
  if [[ -n "${last_failed:-}" ]]; then say "  FAILED: $last_failed"; fi
  say ""
  say "  UI/gateway: $([[ "$ui_ok" -eq 1 ]] && echo up || echo starting…)"
  say "  Model API:  $([[ "$api_ok" -eq 1 ]] && echo up || echo starting…)"
  say ""
  draw_connect_steps "$ip" "$ui_ok" 0
  say ""
  # No PAIR CODE box on the first/loading screen — only on READY (draw_ready).
  if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
    say "  Loading… console AI chat starts when READY."
  elif [[ "$phase" == "STICKLLM Network Loading" ]]; then
    say "  Network Loading - waiting for LAN IP (cable / DHCP)."
    say "  Chat UI will show as http://<lan-ip>/ once network is up."
  else
    say "  Leave this screen up - TIMER ticks every few seconds."
    say "  PAIR CODE appears on the READY screen (next)."
  fi
  say ""
  emit_health_breadcrumb "$ip" "$ui_ok" "$api_ok" "$phase"
  emit_net_probe "${ip:-}"
}

draw_ready() {
  local elapsed="$1" ip="$2" ui_ok="${3:-1}" api_ok="${4:-1}"

  printf 'READY\n' >"$RUN/boot-phase.txt"
  printf '%s\n' "${ip:-}" >"$RUN/lan-ip.txt"
  url_scheme
  if [[ "$ui_ok" -eq 1 ]]; then
    ensure_pair
  fi
  clear_tty
  # Compact READY: URL + pair near top so they always fit on HDMI (no scroll-off).
  say "========================================"
  say "  StickLLM - READY"
  say "========================================"
  say "  Mode: $mode_label"
  say "  Model: $MODEL_NAME"
  say "  Boot: ${elapsed}s  |  $(usb_line)"
  say ""
  if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
    # Chat: show pair/IP/model for LAN; on-stick browser skips pair (loopback).
    ensure_pair
    refresh_model_label
    say "  Model: $MODEL_NAME"
    if [[ -n "${ip:-}" ]]; then
      say "  >>> LAN IP:  ${ip}"
      say "  Browser:    ${SCHEME}://${ip}/  (phone/LAN - pair required)"
      say "  URL:        ${SCHEME}://${ip}/"
    else
      say "  >>> LAN IP:  (waiting - Ethernet, or Term: stickllm-wifi-setup)"
      say "  Browser:    ${SCHEME}://<lan-ip>/"
      say "  URL:        ${SCHEME}://<lan-ip>/"
    fi
    say "  Local UI: http://127.0.0.1/  (this screen - no pair)"
    say ""
    draw_pair_box "$ui_ok"
    say ""
    if [[ "$SSH_ON" -eq 1 ]]; then
      ssh_password_line "${ip:-}"
      say "  (SSH stays up after browser takes this screen; Ctrl+Alt+F2 for console)"
      say ""
    fi
    say "  On-stick browser starting on this screen..."
    say "  (falls back to console chat if browser packages missing)"
    emit_health_breadcrumb "$ip" 1 "$api_ok" "READY"
    return
  fi

  # Always show IP + URL + pair on READY (required connect path).
  if [[ -n "${ip:-}" ]]; then
    say "  >>> LAN IP:  ${ip}"
    say "  Browser:    ${SCHEME}://${ip}/"
    say "  URL:        ${SCHEME}://${ip}/"
  else
    say "  >>> LAN IP:  (waiting - Ethernet DHCP, or WiFi bootstrap below)"
    say "  Browser:    ${SCHEME}://<lan-ip>/"
    say "  URL:        ${SCHEME}://<lan-ip>/"
  fi
  [[ "$SCHEME" == "https" ]] && say "  TLS:      accept browser warning once"
  say ""
  draw_pair_box "$ui_ok"
  say ""
  if [[ -z "${ip:-}" ]]; then
    say "  No network yet (browser Settings cannot reach the stick):"
    say "    Ctrl+Alt+F2 -> login user / stickllm -> stickllm-wifi-setup"
    say "    Or: Local once to save WiFi on DATA, then reboot Server"
    say "    Or: plug Ethernet once, then Settings -> Network in the UI"
  else
    say "  How to connect:"
    say "    1. Open Browser/URL above on same WiFi/LAN"
    say "    2. Enter PAIR CODE (or already paired)"
    say "    3. Chat / Models / Settings (WiFi) in the StickLLM web UI"
  fi
  if [[ "$mode" == "ssh" || "$SSH_ON" -eq 1 ]]; then
    ssh_password_line "${ip:-}"
  fi
  say "  Idle - reboot clears the pair."
  emit_health_breadcrumb "$ip" "$ui_ok" "$api_ok" "READY"
}

# Client USB product - later release placeholder (no Chromium).
if [[ "$mode" == "client" ]]; then
  clear_tty
  say "========================================"
  say "  StickLLM Client - coming soon"
  say "========================================"
  say "  Mode: $mode_label"
  say ""
  say "  Later: boot this USB on a laptop to pair with"
  say "  the Chat stick (not the host OS browser)."
  say "  Not implemented in this release."
  say ""
  say "  Reboot and choose 1 Server / Local, 3 Terminal, or 4 Test."
  printf 'CLIENT_SOON\n' >"$RUN/boot-phase.txt" 2>/dev/null || true
  while true; do sleep 3600; done
fi

# Mint pair for Chat/Term LAN clients (loopback kiosk skips pair in gateway).
ensure_pair

LAST_SIG=""
LAST_FORCE=-999
paint_loading() {
  local elapsed="$1" phase="$2" ip="$3" ui_ok="$4" api_ok="$5"
  local ssh_sig=""
  [[ "$SSH_ON" -eq 1 ]] && ssh_sig="$(tr -d '[:space:]' <"$RUN/ssh-password.txt" 2>/dev/null || true)"
  local sig="${phase}|${ip:-}|${ui_ok}|${api_ok}|${PAIR_STATE:-none}|${PAIR_CODE:-}|${mode}|${SCHEME:-http}|${ssh_sig}"
  # Full redraw on change, or every ~10s (ISS-002).
  if [[ "$sig" != "$LAST_SIG" ]] || (( elapsed - LAST_FORCE >= 10 )); then
    LAST_SIG="$sig"
    LAST_FORCE=$elapsed
    draw "$elapsed" "$phase" "$ip" "$ui_ok" "$api_ok"
  else
    printf '%s\n' "$elapsed" >"$RUN/boot-elapsed.txt"
  fi
}

# Immediate first paint (don't wait for network/GPU/model).
if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
  paint_loading 0 "STICKLLM UI Loading" "" 0 0
else
  paint_loading 0 "STICKLLM Network Loading" "" 0 0
fi

deadline=$((SECONDS + 900))
ready_drawn=0
ui_ok=0
api_ok=0
gw_ok=0
_svc_diag_dumped=0
dump_svc_diag() {
  [[ -w /dev/ttyS0 ]] || return 0
  {
    printf '\n===== STICKLLM_SVC_DIAG BEGIN =====\n'
    printf 'elapsed=%s ui=%s api=%s\n' "${SECONDS}" "${ui_ok}" "${api_ok}"
    printf 'passwd stickllm-llama: '; getent passwd stickllm-llama || echo MISSING
    ls -la /usr/local/bin/stickllm-llama-start 2>&1 || true
    ls -lad /var/lib/stickllm /mnt/stickllm-data 2>&1 || true
    ls -la /opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf 2>&1 || true
    systemctl status stickllm-ui.service --no-pager -l 2>&1 | head -50 || true
    systemctl status stickllm-llama.service --no-pager -l 2>&1 | head -50 || true
    journalctl -b -u stickllm-ui.service --no-pager -n 50 2>&1 || true
    journalctl -b -u stickllm-llama.service --no-pager -n 50 2>&1 || true
    printf '===== STICKLLM_SVC_DIAG END =====\n'
  } >/dev/ttyS0 2>/dev/null || true
}
while (( SECONDS < deadline )); do
  ip="$(lan_ip)"
  # Local also needs uplink for Web lookup (ISS-001) - kick ETH/WiFi NM.
  if [[ -z "${ip:-}" ]]; then
    ensure_network
    ip="$(lan_ip)"
  elif [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
    # Still nudge NM so WiFi profiles from DATA can come up.
    ensure_network
  fi
  # Keep gateway/control up even while waiting for DHCP. Do not start llama at boot.
  systemctl start --no-block stickllm-control.service stickllm-ui.service 2>/dev/null || true
  probe_services
  # Delayed serial dump if UI still down (captures 226/NAMESPACE / ui fail).
  if [[ "$_svc_diag_dumped" -eq 0 && "$SECONDS" -ge 45 && "$ui_ok" -eq 0 ]]; then
    _svc_diag_dumped=1
    dump_svc_diag
  fi

  phase="$(detect_phase "$ui_ok" "$api_ok" "${ip:-}")"
  if [[ "$ui_ok" -eq 1 ]]; then
    ensure_pair
  fi
  if [[ "$phase" == "READY" ]]; then
    if [[ "$mode" == "chat" || "$mode" == "local" || "$LOCAL_YIELD" -eq 1 ]]; then
      # Local/Test: UI required (detect_phase); model is on-demand via Activate.
      # Test: linger so SSH password on READY is readable before browser takes tty1.
      # (No model load at boot — READY arrives too fast to catch otherwise.)
      draw_ready "$SECONDS" "${ip:-}" "$ui_ok" "$api_ok"
      ready_drawn=1
      if [[ "$SSH_ON" -eq 1 ]]; then
        # Repaint once mid-linger in case the first paint scrolled off.
        sleep 12
        draw_ready "$SECONDS" "${ip:-}" "$ui_ok" "$api_ok"
        sleep 18
      else
        sleep 2
      fi
      handoff_local_chat
      exit 0
    fi
    # Term/Server: refuse READY without UI - pair-only is not success.
    if [[ "$ui_ok" -ne 1 ]]; then
      phase="STICKLLM UI Loading"
      paint_loading "$SECONDS" "$phase" "${ip:-}" "$ui_ok" "$api_ok"
      sleep 10
      continue
    fi
    # Term/Server: also require a LAN IP on READY (how-to-connect must be real).
    if [[ -z "${ip:-}" ]]; then
      ensure_network
      phase="STICKLLM Network Loading"
      paint_loading "$SECONDS" "$phase" "" "$ui_ok" "$api_ok"
      # Poll faster while waiting on DHCP after WiFi bootstrap.
      sleep 3
      continue
    fi
    draw_ready "$SECONDS" "${ip:-}" "$ui_ok" "$api_ok"
    ready_drawn=1
    # Stay put - repaint if IP, pair, reachability, or an in-flight model download changes.
    SSH_SIG="$(cat "$RUN/ssh-password.txt" 2>/dev/null | tr -d '[:space:]' || true)"
    ready_sig="${ip:-}|${PAIR_STATE:-none}|${PAIR_CODE:-}|${ui_ok}|${api_ok}|${SCHEME:-http}|${SSH_SIG}"
    while true; do
      sleep 5
      ip="$(lan_ip)"
      [[ -z "${ip:-}" ]] && ensure_network
      probe_services
      if [[ "$ui_ok" -eq 1 ]]; then
        ensure_pair
      fi
      # Leave READY to paint download progress + ticking TIMER.
      dl="$(download_phase_msg)"
      if [[ -n "${dl:-}" ]]; then
        ready_drawn=0
        paint_loading "$SECONDS" "$dl" "${ip:-}" "$ui_ok" "$api_ok"
        break
      fi
      # If UI drops, leave READY and show loading again.
      if [[ "$ui_ok" -ne 1 || "$api_ok" -ne 1 ]]; then
        ready_drawn=0
        break
      fi
      # Dropped off WiFi / DHCP — leave READY and show Network Loading.
      if [[ -z "${ip:-}" ]]; then
        ready_drawn=0
        break
      fi
      SSH_SIG="$(cat "$RUN/ssh-password.txt" 2>/dev/null | tr -d '[:space:]' || true)"
      sig="${ip:-}|${PAIR_STATE:-none}|${PAIR_CODE:-}|${ui_ok}|${api_ok}|${SCHEME:-http}|${SSH_SIG}"
      if [[ "$sig" != "$ready_sig" ]]; then
        ready_sig="$sig"
        draw_ready "$SECONDS" "${ip:-}" "$ui_ok" "$api_ok"
      else
        emit_health_breadcrumb "$ip" "$ui_ok" "$api_ok" "READY"
      fi
    done
    continue
  fi
  paint_loading "$SECONDS" "$phase" "${ip:-}" "$ui_ok" "$api_ok"
  if [[ "$phase" == "STICKLLM Network Loading" ]]; then
    sleep 3
  else
    sleep 10
  fi
done

clear_tty
say ""
say "StickLLM timed out waiting for UI/LLM (${SECONDS}s)."
say "Last phase: $(cat "$RUN/boot-phase.txt" 2>/dev/null || echo unknown)"
say "Run: stickllm-status"
ip="$(lan_ip)"
probe_services
draw_connect_steps "${ip:-}" "$ui_ok" 0
draw_pair_box "$ui_ok"
exit 1
