[Unit]
Description=StickLLM KittenTTS (resident)
After=local-fs.target

[Service]
Type=simple
User=stickllm
Group=stickllm
RuntimeDirectory=stickllm-kitten
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/bin/stickllm-speech kitten
Restart=on-failure
RestartSec=2
PrivateNetwork=yes
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
MemoryMax=2G
LimitCORE=0
UMask=0077
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=HOME=/nonexistent
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=STICKLLM_SPEECH_DIR=/opt/stickllm/speech
Environment=PYTHONPATH=/opt/stickllm/speech/py

[Install]
WantedBy=multi-user.target
