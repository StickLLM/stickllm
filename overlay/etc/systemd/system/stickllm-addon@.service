[Unit]
Description=StickLLM add-on %i (host SSD image, vault-only data, loopback only)
After=local-fs.target stickllm-dockerd.service stickllm-ui.service
# Shutdown order is the reverse: the add-on stops before the gateway,
# dockerd and the vault mount go away.
RequiresMountsFor=/var/lib/stickllm/vault
# The unit is skipped until the server vault is actually mounted.
ConditionPathIsMountPoint=/var/lib/stickllm/vault

[Service]
Type=simple
ExecStart=/usr/local/bin/stickllm-addon %i run
ExecStop=/usr/local/bin/stickllm-addon %i stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
# Started by vault unlock (when installed) or by stickllm-addon-install@%i.
# Not enabled: never at boot without an unlocked vault.
