#!/bin/sh
# StickLLM app agent: turns a chat request into app actions (ONLYOFFICE slides, Node-RED) with its own
# small model (stickllm-appagent-llm, Qwen3.5-4B on 127.0.0.1:8796). Loopback only; browsers reach it
# through the gateway at /appagent/. STICKLLM_APPAGENT_LLM_URL can point it at another llama-server.
set -eu
exec /usr/bin/python3 /usr/local/lib/stickllm_appagent/service.py \
  --host 127.0.0.1 \
  --port "${STICKLLM_APPAGENT_PORT:-8795}" \
  --llm-url "${STICKLLM_APPAGENT_LLM_URL:-http://127.0.0.1:${STICKLLM_APPAGENT_LLM_PORT:-8796}}" \
  --nodered-url "${STICKLLM_APPAGENT_NODERED:-http://127.0.0.1:8105}" \
  --docs-url "/docs-server" \
  --self-url "/appagent" \
  --apps "${STICKLLM_APPAGENT_APPS:-onlyoffice,nodered}"
