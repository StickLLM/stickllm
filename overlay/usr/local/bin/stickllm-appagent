#!/bin/sh
# StickLLM app agent: turns a chat request into app actions (ONLYOFFICE slides, Node-RED,
# Notepad, Calculator, Solitaire). 0.5.6: it uses the SHARED chat llama-server (one
# Qwen3.5-4B by default, 127.0.0.1:8080); it never starts or loads a model itself.
# The user loads/unloads both the model (Models page) and this agent (chat > App agent).
# Loopback only; browsers reach it through the gateway at /appagent/.
# STICKLLM_APPAGENT_LLM_URL can point it at another llama-server (e.g. the optional
# stickllm-appagent-llm helper on 8796, disabled by default).
set -eu
exec /usr/bin/python3 /usr/local/lib/stickllm_appagent/service.py \
  --host 127.0.0.1 \
  --port "${STICKLLM_APPAGENT_PORT:-8795}" \
  --llm-url "${STICKLLM_APPAGENT_LLM_URL:-http://127.0.0.1:${STICKLLM_LLAMA_PORT:-8080}}" \
  --nodered-url "${STICKLLM_APPAGENT_NODERED:-http://127.0.0.1:8105}" \
  --docs-url "/docs-server" \
  --self-url "/appagent" \
  --apps "${STICKLLM_APPAGENT_APPS:-onlyoffice,nodered,notepad,calculator,solitaire}"
