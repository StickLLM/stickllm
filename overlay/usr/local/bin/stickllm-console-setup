#!/bin/bash
# Live user + quiet console. Never daemon-reload (cancels pending bootstatus).
set -uo pipefail
# Note: not using set -e — optional systemctl/useradd must not fail the oneshot.

if ! getent passwd user >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo,video,render user 2>/dev/null || true
fi

if getent passwd user >/dev/null 2>&1; then
  echo 'user:stickllm' | chpasswd || true
  usermod -aG sudo,video,render user 2>/dev/null || true
fi

cat >/etc/sudoers.d/stickllm-user <<'EOF'
user ALL=(ALL) NOPASSWD:ALL
EOF
chmod 440 /etc/sudoers.d/stickllm-user || true

cat >/etc/motd <<'EOF'

  StickLLM v0.3.1
  tty1 = loading + LAN URL + PAIR CODE
  tty2 = login (Ctrl+Alt+F2)   SSH = Term menu only
  No LAN?  stickllm-wifi-setup
  user / stickllm

EOF

sysctl -w kernel.printk="3 4 1 3" >/dev/null 2>&1 || true
dmesg -n err >/dev/null 2>&1 || true
plymouth quit --wait >/dev/null 2>&1 || true

if [[ -w /dev/ttyS0 ]]; then
  printf '%s\n' "STICKLLM_CONSOLE_SETUP_OK" >/dev/ttyS0 2>/dev/null || true
fi

rm -f /run/stickllm/allow-getty-tty1 2>/dev/null || true
systemctl enable getty@tty2.service 2>/dev/null || true
systemctl start --no-block getty@tty2.service 2>/dev/null || true
systemctl stop --no-block getty@tty1.service 2>/dev/null || true
systemctl reset-failed stickllm-bootstatus.service 2>/dev/null || true
systemctl start --no-block stickllm-bootstatus.service 2>/dev/null || true
chvt 1 2>/dev/null || true

mkdir -p /run/stickllm /var/lib/stickllm
# Invoke via python3 so a CRLF shebang (Windows checkout) cannot cause exec 127.
# Do not sed -i the squashfs path (read-only root).
rm -f /run/stickllm/pair-code.txt
/usr/bin/env python3 /usr/local/bin/stickllm-pair --force \
  >/run/stickllm/pair-mint.out 2>/run/stickllm/pair-mint.err \
  || true
_code="$(tr -d '\r\n\t ' </run/stickllm/pair-code.txt 2>/dev/null || true)"
if [[ ! "$_code" =~ ^[0-9]{4,8}$ ]]; then
  _code="$(tr -d '\r\n\t ' </run/stickllm/pair-mint.out 2>/dev/null || true)"
  if [[ "$_code" =~ ^[0-9]{4,8}$ ]]; then
    printf '%s\n' "$_code" >/run/stickllm/pair-code.txt
  fi
fi
if [[ -w /dev/ttyS0 ]]; then
  printf 'STICKLLM_BOOTSTATUS_REQUEUED\n' >/dev/ttyS0 2>/dev/null || true
  if [[ "$_code" =~ ^[0-9]{4,8}$ ]]; then
    printf 'STICKLLM_PAIR_MINTED %s (usable when UI up)\n' "$_code" >/dev/ttyS0 2>/dev/null || true
  else
    printf 'STICKLLM_PAIR_FAIL out=%s err=%s\n' \
      "$(tr -d '\r\n' </run/stickllm/pair-mint.out 2>/dev/null | head -c 80)" \
      "$(tr -d '\r\n' </run/stickllm/pair-mint.err 2>/dev/null | head -c 80)" \
      >/dev/ttyS0 2>/dev/null || true
  fi
  if grep -Eqw 'stickllm\.(chat|local|kiosk)' /proc/cmdline 2>/dev/null; then
    printf 'STICKLLM_CHAT_OR_LOCAL\n' >/dev/ttyS0 2>/dev/null || true
  fi
fi
exit 0
