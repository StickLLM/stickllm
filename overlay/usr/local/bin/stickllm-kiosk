#!/usr/bin/env bash
# Local-mode product path: minimal browser on HDMI → http://127.0.0.1/ (no pair).
# Hybrid AMD iGPU + NVIDIA CUDA: compositor on non-NVIDIA DRM; llama keeps the dGPU.
# Writes /run/stickllm/kiosk-fail.log for Term-boot diagnosis (Local has no SSH).
set -uo pipefail

TTY="${STICKLLM_TTY:-/dev/tty1}"
RUN="${STICKLLM_RUN:-/run/stickllm}"
LOG="$RUN/kiosk.log"
FAIL_LOG="$RUN/kiosk-fail.log"
URL="${STICKLLM_KIOSK_URL:-http://127.0.0.1/}"
WAIT_UI_SECS="${STICKLLM_KIOSK_WAIT_SECS:-180}"
# Brief only — long waits left users on tty "Waiting for model" then a retry loop.
WAIT_LLAMA_SECS="${STICKLLM_KIOSK_WAIT_LLAMA_SECS:-8}"
FAIL_FILE="$RUN/kiosk-fail-count"
PROFILE="$RUN/kiosk-profile"
WESTON_INI="$RUN/weston.ini"
# cage refuses to start as root ("Unable to drop root"); run compositor as live user.
KIOSK_USER="${STICKLLM_KIOSK_USER:-user}"

mkdir -p "$RUN" "$PROFILE"
chmod 700 "$PROFILE"
: >"$LOG"
: >"$FAIL_LOG"

serial_note() {
  # Never write diagnostics to stdout — command substitution (e.g. renderer
  # order) must receive only the intended payload.
  printf '%s\n' "$*" >>"$LOG" 2>/dev/null || true
  printf '%s\n' "$*" >/dev/ttyS0 2>/dev/null || true
}

fail_note() {
  printf '%s\n' "$*" >>"$FAIL_LOG" 2>/dev/null || true
  serial_note "$*"
}

paint() {
  printf '%s\n' "$*" >>"$TTY" 2>/dev/null || true
  printf '%s\n' "$*" >>"$LOG" 2>/dev/null || true
}

fail_count() {
  local n=0
  if [[ -f "$FAIL_FILE" ]]; then
    n="$(tr -cd '0-9' <"$FAIL_FILE" 2>/dev/null || true)"
  fi
  [[ -n "$n" ]] || n=0
  printf '%s' "$n"
}

bump_fails() {
  local n
  n="$(fail_count)"
  n=$((n + 1))
  printf '%s\n' "$n" >"$FAIL_FILE" 2>/dev/null || true
  printf '%s' "$n"
}

http_code() {
  curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$1" 2>/dev/null || printf '000'
}

collect_drm_diag() {
  {
    echo "=== $(date -Is 2>/dev/null || date) kiosk DRM diag ==="
    echo "cmdline: $(tr '\0' ' ' </proc/cmdline 2>/dev/null || true)"
    echo "--- dri ---"
    ls -la /dev/dri 2>&1 || true
    echo "--- drm connectors (connected?) ---"
    for conn in /sys/class/drm/card*-*/status; do
      [[ -f "$conn" ]] || continue
      echo "$(basename "$(dirname "$conn")")=$(cat "$conn" 2>/dev/null) path=$conn"
    done
    echo "--- drivers ---"
    for card in /sys/class/drm/card[0-9]; do
      [[ -d "$card" ]] || continue
      d="$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)" 2>/dev/null || echo '?')"
      echo "$(basename "$card") driver=$d"
    done
    echo "--- seatd ---"
    systemctl is-active seatd.service 2>&1 || true
    id -a 2>&1 || true
    echo "--- packages ---"
    command -v cage; command -v cog; command -v weston; command -v chromium; command -v chromium-browser
  } >>"$FAIL_LOG" 2>/dev/null || true
}

is_nvidia_path() {
  local p="$1" base driver
  base="$(basename "$p")"
  driver="$(basename "$(readlink -f "/sys/class/drm/${base}/device/driver" 2>/dev/null)" 2>/dev/null || true)"
  case "$driver" in
    nvidia|nvidia-current|nvidia_drm|nvidia-drm) return 0 ;;
  esac
  return 1
}

# simpledrm/efifb can own the console after nvidia-drm modeset=0, but cage/weston
# need a real KMS driver (amdgpu/i915/virtio) to keep a browser on HDMI.
is_weak_drm() {
  local p="$1" driver
  driver="$(drm_driver_name "$p")"
  case "$driver" in
    simpledrm|efi-framebuffer|efifb|bochs-drm|cirrus) return 0 ;;
  esac
  return 1
}

has_nvidia_drm() {
  local c path
  for c in /sys/class/drm/card[0-9]; do
    [[ -d "$c" ]] || continue
    path="/dev/dri/$(basename "$c")"
    [[ -e "$path" ]] || continue
    is_nvidia_path "$path" && return 0
  done
  return 1
}

# DRM card that already owns the Linux console (efifb/simpledrm/amdgpu fbcon).
# Informational + fallback only — never beat a connected amdgpu/i915 HDMI.
pick_console_drm() {
  local fb link card path driver
  for fb in /sys/class/graphics/fb[0-9]; do
    [[ -e "$fb/device" ]] || continue
    link="$(readlink -f "$fb/device" 2>/dev/null || true)"
    [[ -n "$link" ]] || continue
    card=""
    if [[ "$link" =~ /drm/card[0-9]+ ]]; then
      card="$(basename "$(echo "$link" | grep -oE 'card[0-9]+' | head -1)")"
    else
      # PCI device → matching DRM card
      for c in /sys/class/drm/card[0-9]; do
        [[ -d "$c" ]] || continue
        if [[ "$(readlink -f "$c/device" 2>/dev/null)" == "$link" ]]; then
          card="$(basename "$c")"
          break
        fi
      done
    fi
    [[ -n "$card" ]] || continue
    path="/dev/dri/$card"
    [[ -e "$path" ]] || continue
    if is_nvidia_path "$path"; then
      fail_note "STICKLLM_KIOSK_CONSOLE_DRM_SKIP_NVIDIA $path"
      continue
    fi
    fail_note "STICKLLM_KIOSK_CONSOLE_DRM $path fb=$(basename "$fb") driver=$(drm_driver_name "$path")"
    printf '%s' "$path"
    return 0
  done
  # boot_vga non-NVIDIA
  for c in /sys/class/drm/card[0-9]; do
    [[ -d "$c" ]] || continue
    [[ "$(tr -d '[:space:]' <"$c/device/boot_vga" 2>/dev/null || true)" == "1" ]] || continue
    path="/dev/dri/$(basename "$c")"
    [[ -e "$path" ]] || continue
    is_nvidia_path "$path" && continue
    fail_note "STICKLLM_KIOSK_CONSOLE_DRM_BOOTVGA $path"
    printf '%s' "$path"
    return 0
  done
  return 1
}

# Prefer DRM card with a connected connector → exported as WLR_DRM_DEVICES.
# Order:
#   1) connected AMD/Intel iGPU
#   2) connected NVIDIA (monitor on dGPU / 3090 HDMI — needs nvidia-drm modeset=1)
#   3) virtio (QEMU), console DRM, simpledrm fallbacks
pick_display_drm() {
  local card driver path conn status
  local connected_igpu="" best_igpu="" connected_virtio="" best_virtio=""
  local connected_other="" best_other="" connected_simple="" best_simple=""
  local connected_nvidia="" best_nvidia=""
  local console_drm="" pick=""
  console_drm="$(pick_console_drm || true)"
  for card in /sys/class/drm/card[0-9]; do
    [[ -d "$card" ]] || continue
    driver="$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)" 2>/dev/null || true)"
    path="/dev/dri/$(basename "$card")"
    [[ -e "$path" ]] || continue
    local has_connected=0
    for conn in "$card"-*/status; do
      [[ -f "$conn" ]] || continue
      status="$(tr -d '[:space:]' <"$conn" 2>/dev/null || true)"
      if [[ "$status" == "connected" ]]; then
        has_connected=1
        break
      fi
    done
    case "$driver" in
      nvidia|nvidia-current|nvidia_drm|nvidia-drm)
        [[ -z "$best_nvidia" ]] && best_nvidia="$path"
        if [[ "$has_connected" -eq 1 && -z "$connected_nvidia" ]]; then
          connected_nvidia="$path"
          fail_note "STICKLLM_KIOSK_DRM_NVIDIA_CONNECTED $path"
        else
          fail_note "STICKLLM_KIOSK_DRM_NVIDIA_SEEN $path connected=$has_connected"
        fi
        ;;
      amdgpu|i915|xe)
        [[ -z "$best_igpu" ]] && best_igpu="$path"
        [[ "$has_connected" -eq 1 && -z "$connected_igpu" ]] && connected_igpu="$path"
        ;;
      virtio_gpu|virtio-gpu|virtio-pci)
        [[ -z "$best_virtio" ]] && best_virtio="$path"
        [[ "$has_connected" -eq 1 && -z "$connected_virtio" ]] && connected_virtio="$path"
        ;;
      simpledrm|efi-framebuffer|efifb)
        [[ -z "$best_simple" ]] && best_simple="$path"
        [[ "$has_connected" -eq 1 && -z "$connected_simple" ]] && connected_simple="$path"
        ;;
      *)
        [[ -z "$best_other" ]] && best_other="$path"
        [[ "$has_connected" -eq 1 && -z "$connected_other" ]] && connected_other="$path"
        ;;
    esac
  done
  if [[ -n "$connected_igpu" ]]; then pick="$connected_igpu"
  elif [[ -n "$connected_nvidia" ]]; then pick="$connected_nvidia"
  elif [[ -n "$best_igpu" ]]; then pick="$best_igpu"
  elif [[ -n "$console_drm" ]] && ! is_weak_drm "$console_drm"; then pick="$console_drm"
  elif [[ -n "$connected_virtio" ]]; then pick="$connected_virtio"
  elif [[ -n "$best_virtio" ]]; then pick="$best_virtio"
  elif [[ -n "$connected_simple" ]]; then pick="$connected_simple"
  elif [[ -n "$best_simple" ]]; then pick="$best_simple"
  elif [[ -n "$connected_other" ]]; then pick="$connected_other"
  elif [[ -n "$best_other" ]]; then pick="$best_other"
  elif [[ -n "$best_nvidia" ]]; then pick="$best_nvidia"
  elif [[ -n "$console_drm" ]]; then pick="$console_drm"
  else
    return 1
  fi
  if [[ -n "$console_drm" && "$pick" != "$console_drm" ]]; then
    fail_note "STICKLLM_KIOSK_DRM_OVERRIDE console=$console_drm pick=$pick"
    serial_note "STICKLLM_KIOSK_DRM_OVERRIDE console=$console_drm pick=$pick"
  fi
  fail_note "STICKLLM_KIOSK_DRM_PICK_FINAL $pick driver=$(drm_driver_name "$pick")"
  printf '%s' "$pick"
  return 0
}

# Cage/Weston need KMS connectors. hdmi-recovery boots modeset=0 so text console
# survives; when the monitor is on a 3090, reload nvidia-drm with modeset=1 so
# the connected HDMI/DP connector appears before we pick/launch.
ensure_nvidia_kms() {
  local modeset="" has_conn=0
  has_nvidia_drm || return 0
  for s in /sys/class/drm/card*-*/status; do
    [[ -f "$s" ]] || continue
    if [[ "$(tr -d '[:space:]' <"$s" 2>/dev/null || true)" == "connected" ]]; then
      has_conn=1
      break
    fi
  done
  [[ "$has_conn" -eq 1 ]] && return 0
  modeset="$(tr -d '[:space:]' </sys/module/nvidia_drm/parameters/modeset 2>/dev/null || true)"
  if [[ "$modeset" == "Y" || "$modeset" == "1" ]]; then
    fail_note "STICKLLM_KIOSK_NVIDIA_MODESET_ON_BUT_NO_CONN"
    return 0
  fi
  fail_note "STICKLLM_KIOSK_NVIDIA_MODESET_RELOAD"
  serial_note "STICKLLM_KIOSK_NVIDIA_MODESET_RELOAD"
  paint "  Enabling NVIDIA KMS for display…"
  # llama holds the driver; briefly stop so nvidia_drm can reload.
  systemctl stop stickllm-llama.service 2>/dev/null || true
  sleep 1
  rmmod nvidia_drm 2>/dev/null || true
  if modprobe nvidia_drm modeset=1 2>>"$FAIL_LOG"; then
    sleep 2
    fail_note "STICKLLM_KIOSK_NVIDIA_MODESET_OK now=$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || true)"
    serial_note "STICKLLM_KIOSK_NVIDIA_MODESET_OK"
    systemctl start --no-block stickllm-llama.service 2>/dev/null || true
    return 0
  fi
  fail_note "STICKLLM_KIOSK_NVIDIA_MODESET_FAIL"
  serial_note "STICKLLM_KIOSK_NVIDIA_MODESET_FAIL"
  modprobe nvidia_drm 2>/dev/null || true
  systemctl start --no-block stickllm-llama.service 2>/dev/null || true
  return 1
}

# Kill compositors and force tty1/fbcon back so HDMI signal returns after a failed modeset.
restore_display_console() {
  local reason="${1:-kiosk-fail}"
  fail_note "STICKLLM_KIOSK_RESTORE_CONSOLE reason=$reason"
  serial_note "STICKLLM_KIOSK_RESTORE_CONSOLE reason=$reason"
  # Drop DRM master: do not leave cage/weston holding CRTCs off.
  pkill -x cage 2>/dev/null || true
  pkill -x weston 2>/dev/null || true
  pkill -x cog 2>/dev/null || true
  pkill -x chromium 2>/dev/null || true
  pkill -x chromium-browser 2>/dev/null || true
  sleep 0.4
  chvt 1 2>/dev/null || true
  # Re-bind framebuffer consoles (simpledrm/efifb/amdgpu).
  local vtcon
  for vtcon in /sys/class/vtconsole/vtcon*; do
    [[ -w "$vtcon/bind" ]] || continue
    echo 1 >"$vtcon/bind" 2>/dev/null || true
  done
  # Touch connector status (hotplug kick on some drivers).
  local conn
  for conn in /sys/class/drm/card*-*/status; do
    [[ -f "$conn" ]] || continue
    cat "$conn" >/dev/null 2>&1 || true
  done
  # SysRq 'v' = forcefully restore framebuffer console (when enabled).
  if [[ -w /proc/sysrq-trigger ]]; then
    echo v >/proc/sysrq-trigger 2>/dev/null || true
  fi
  printf '\033c' >"$TTY" 2>/dev/null || true
}

# Unbind fbcon so cage/weston can become DRM master on the iGPU.
# Call immediately before compositor start (inverse of restore_display_console).
release_display_for_compositor() {
  local vtcon name
  fail_note "STICKLLM_KIOSK_RELEASE_FOR_COMP"
  serial_note "STICKLLM_KIOSK_RELEASE_FOR_COMP"
  chvt 1 2>/dev/null || true
  for vtcon in /sys/class/vtconsole/vtcon*; do
    [[ -w "$vtcon/bind" ]] || continue
    name="$(tr -d '[:space:]' <"$vtcon/name" 2>/dev/null || true)"
    # Unbind framebuffer consoles only (keep VGA text vtcon0 if present).
    if printf '%s' "$name" | grep -qiE 'frame|dummy|drm'; then
      echo 0 >"$vtcon/bind" 2>/dev/null || true
      fail_note "STICKLLM_KIOSK_VTCON_UNBIND $(basename "$vtcon") name=$name"
    fi
  done
  sleep 0.2
}

prepare_kiosk_user() {
  # Prefer Debian live default account; fall back to root only if missing.
  if ! id "$KIOSK_USER" >/dev/null 2>&1; then
    if id user >/dev/null 2>&1; then
      KIOSK_USER=user
    else
      KIOSK_USER=root
    fi
  fi
  if [[ "$KIOSK_USER" != "root" ]]; then
    usermod -aG video,render,input "$KIOSK_USER" 2>/dev/null || true
  fi
  KIOSK_UID="$(id -u "$KIOSK_USER")"
  export XDG_RUNTIME_DIR="/run/user/${KIOSK_UID}"
  mkdir -p "$XDG_RUNTIME_DIR" "$PROFILE" "$PROFILE/cache"
  chmod 700 "$XDG_RUNTIME_DIR"
  if [[ "$KIOSK_USER" != "root" ]]; then
    chown -R "${KIOSK_USER}:${KIOSK_USER}" "$XDG_RUNTIME_DIR" "$PROFILE" 2>/dev/null || true
    # Allow the kiosk user to write fail/diag logs owned by the unit (root).
    chmod 777 "$RUN" 2>/dev/null || true
    touch "$LOG" "$FAIL_LOG" 2>/dev/null || true
    chmod 666 "$LOG" "$FAIL_LOG" 2>/dev/null || true
  fi
  fail_note "STICKLLM_KIOSK_USER $KIOSK_USER uid=$KIOSK_UID XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
  serial_note "STICKLLM_KIOSK_USER $KIOSK_USER uid=$KIOSK_UID"
}

ensure_xdg_runtime() {
  if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    prepare_kiosk_user
  fi
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
}

# Run compositor/browser as KIOSK_USER — cage hard-refuses uid 0.
run_kiosk_cmd() {
  if [[ "$(id -u)" -eq 0 && "$KIOSK_USER" != "root" ]] && command -v runuser >/dev/null 2>&1; then
    runuser -u "$KIOSK_USER" -- env \
      "HOME=/home/${KIOSK_USER}" \
      "USER=${KIOSK_USER}" \
      "LOGNAME=${KIOSK_USER}" \
      "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
      "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}" \
      "LIBSEAT_BACKEND=${LIBSEAT_BACKEND:-seatd}" \
      "WLR_NO_HARDWARE_CURSORS=${WLR_NO_HARDWARE_CURSORS:-1}" \
      "WLR_BACKENDS=${WLR_BACKENDS:-drm,libinput}" \
      "WLR_RENDERER=${WLR_RENDERER}" \
      "WLR_DRM_DEVICES=${WLR_DRM_DEVICES}" \
      "WLR_LIBINPUT_NO_DEVICES=${WLR_LIBINPUT_NO_DEVICES:-}" \
      "LIBGL_ALWAYS_SOFTWARE=${LIBGL_ALWAYS_SOFTWARE:-}" \
      "GALLIUM_DRIVER=${GALLIUM_DRIVER:-}" \
      "MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-}" \
      "GBM_BACKEND=${GBM_BACKEND:-}" \
      "__GLX_VENDOR_LIBRARY_NAME=${__GLX_VENDOR_LIBRARY_NAME:-}" \
      "__EGL_VENDOR_LIBRARY_FILENAMES=${__EGL_VENDOR_LIBRARY_FILENAMES:-}" \
      "$@"
  else
    "$@"
  fi
}

# Force Mesa EGL/GLX so NVIDIA GLVND ICDs (modeset=0) cannot steal the compositor.
force_mesa_glvnd() {
  local mesa_egl="" f
  unset GBM_BACKEND 2>/dev/null || true
  export __GLX_VENDOR_LIBRARY_NAME=mesa
  for f in \
    /usr/share/glvnd/egl_vendor.d/50_mesa.json \
    /usr/share/glvnd/egl_vendor.d/*mesa*.json; do
    [[ -f "$f" ]] || continue
    mesa_egl="$f"
    break
  done
  if [[ -n "$mesa_egl" ]]; then
    export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa_egl"
    fail_note "STICKLLM_KIOSK_FORCE_MESA egl=$mesa_egl"
  else
    unset __EGL_VENDOR_LIBRARY_FILENAMES 2>/dev/null || true
    fail_note "STICKLLM_KIOSK_FORCE_MESA egl=missing"
  fi
}

apply_env_for_drm() {
  local drm="$1" renderer="$2"
  ensure_xdg_runtime
  export XDG_SESSION_TYPE=wayland
  export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-seatd}"
  export WLR_NO_HARDWARE_CURSORS=1
  # drm alone disables libinput → no keyboard/VT. Always include libinput on HW.
  export WLR_BACKENDS="${WLR_BACKENDS:-drm,libinput}"
  export WLR_RENDERER="$renderer"
  export WLR_DRM_DEVICES="$drm"
  # QEMU often has no keyboard — allow start without devices there only.
  # On real USB keyboards, WLR_LIBINPUT_NO_DEVICES=1 can leave cage with zero
  # input (keys never reach Chromium). Default off unless virtio/QEMU.
  unset WLR_LIBINPUT_NO_DEVICES 2>/dev/null || true
  if is_virtio_or_qemu_drm "$drm"; then
    export WLR_LIBINPUT_NO_DEVICES="${WLR_LIBINPUT_NO_DEVICES:-1}"
  elif [[ -n "${STICKLLM_KIOSK_LIBINPUT_NO_DEVICES:-}" ]]; then
    export WLR_LIBINPUT_NO_DEVICES="$STICKLLM_KIOSK_LIBINPUT_NO_DEVICES"
  fi
  unset GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME __EGL_VENDOR_LIBRARY_FILENAMES 2>/dev/null || true
  unset WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
  unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE 2>/dev/null || true
  if is_nvidia_path "$drm"; then
    # Proprietary GLX/EGL; avoid forcing GBM_BACKEND=nvidia-drm when the
    # nvidia-drm_gbm.so shim is missing (Debian 535 often lacks it) — pixman still works.
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    if [[ -e /usr/lib/x86_64-linux-gnu/gbm/nvidia-drm_gbm.so ]]; then
      export GBM_BACKEND=nvidia-drm
    fi
  elif is_virtio_or_qemu_drm "$drm"; then
    # virtio-vga often has no host GL — force Mesa software so WPE/cog can paint.
    force_mesa_glvnd
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
    export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-llvmpipe}"
  else
    # Hybrid AMD+NVIDIA with nvidia-drm modeset=0: GLVND still prefers NVIDIA EGL
    # which fails without KMS — pin Mesa so cage/weston gles2/pixman use amdgpu.
    force_mesa_glvnd
  fi
}

write_weston_ini() {
  local app="$1"
  cat >"$WESTON_INI" <<EOF
[core]
backend=drm-backend.so
shell=kiosk-shell.so
idle-time=0
require-input=false

[shell]
locking=false
panel-position=none

[kiosk-shell]
exec=${app}
EOF
}

ensure_seatd() {
  local ok=0
  systemctl unmask seatd.service 2>/dev/null || true
  systemctl enable --now seatd.service 2>/dev/null || true
  systemctl start seatd.service 2>/dev/null || true
  sleep 1
  if systemctl is-active --quiet seatd.service 2>/dev/null || pgrep -x seatd >/dev/null 2>&1; then
    ok=1
  elif command -v seatd >/dev/null 2>&1; then
    # Last-ditch: run seatd in background for this session
    seatd -g video -n 1 >>"$FAIL_LOG" 2>&1 &
    sleep 1
    pgrep -x seatd >/dev/null 2>&1 && ok=1
  fi
  if [[ "$ok" -eq 1 ]]; then
    fail_note "STICKLLM_KIOSK_SEATD_OK"
    return 0
  fi
  fail_note "STICKLLM_KIOSK_SEATD_FAIL"
  return 1
}

pick_browser_bin() {
  local prefer_chromium=0
  # WPE/cog is flaky on virtio soft-GL and on hybrid NVIDIA GLVND (modeset=0).
  # Chromium+ozone+--disable-gpu is the product-stable path for Local.
  if [[ -e /dev/dri/card0 ]] && is_virtio_or_qemu_drm /dev/dri/card0; then
    prefer_chromium=1
  fi
  if has_nvidia_drm; then
    prefer_chromium=1
  fi
  if [[ "$prefer_chromium" -eq 1 ]]; then
    if command -v chromium >/dev/null 2>&1; then
      printf 'chromium'; return 0
    fi
    if command -v chromium-browser >/dev/null 2>&1; then
      printf 'chromium-browser'; return 0
    fi
  fi
  if command -v chromium >/dev/null 2>&1; then
    printf 'chromium'
  elif command -v chromium-browser >/dev/null 2>&1; then
    printf 'chromium-browser'
  elif command -v cog >/dev/null 2>&1; then
    printf 'cog'
  else
    return 1
  fi
}

cog_cmd() {
  printf 'cog -P --enable-mediasource %q' "$URL"
}

chromium_args() {
  local bin="$1"
  printf '%q' "$bin"
  printf ' --kiosk --ozone-platform=wayland --no-first-run --disable-infobars'
  printf ' --disable-session-crashed-bubble --check-for-update-interval=31536000'
  printf ' --user-data-dir=%q --disk-cache-dir=%q %q' "$PROFILE" "$PROFILE/cache" "$URL"
}

drm_driver_name() {
  local p="$1" base
  base="$(basename "$p")"
  basename "$(readlink -f "/sys/class/drm/${base}/device/driver" 2>/dev/null)" 2>/dev/null || true
}

is_virtio_or_qemu_drm() {
  local drm="$1" driver base
  driver="$(drm_driver_name "$drm")"
  # QEMU virtio-vga often binds as virtio-pci (not virtio-gpu) in sysfs.
  case "$driver" in
    virtio*|virtio_gpu|virtio-gpu|virtio-pci) return 0 ;;
  esac
  base="$(basename "$drm")"
  if grep -qi virtio "/sys/class/drm/${base}/device/uevent" 2>/dev/null; then
    return 0
  fi
  if grep -Eiq 'qemu|bochs|virtio' /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    return 0
  fi
  return 1
}

# Renderer order: virtio/QEMU is pixman-only (gles2 hangs).
# NVIDIA-as-display: pixman first (GBM/EGLStreams varies by driver/cage).
# Clean amdgpu/i915 alone: gles2 then pixman.
# stdout MUST be only the renderer tokens (no serial_note here).
renderer_order_for_drm() {
  local drm="$1" driver
  driver="$(drm_driver_name "$drm")"
  fail_note "STICKLLM_KIOSK_DRM_DRIVER $drm driver=${driver:-unknown}"
  if is_virtio_or_qemu_drm "$drm" || is_weak_drm "$drm"; then
    printf '%s' "pixman"
  elif is_nvidia_path "$drm"; then
    printf '%s' "pixman gles2"
  elif has_nvidia_drm; then
    printf '%s' "pixman gles2"
  else
    printf '%s' "gles2 pixman vulkan"
  fi
}

# Run one compositor+browser combo in foreground; return its exit code.
try_launch() {
  local label="$1" drm="$2" renderer="$3" comp="$4" browser="$5"
  local rc=0 app run_timeout=0
  apply_env_for_drm "$drm" "$renderer"
  # QEMU virtio often hangs in gles/pixman without painting — bound tries so ladder advances.
  if is_virtio_or_qemu_drm "$drm"; then
    # Chromium cold-start on software GL needs >40s before first paint in QEMU.
    run_timeout="${STICKLLM_KIOSK_VIRTIO_TRY_SECS:-90}"
  fi
  chvt 1 2>/dev/null || true
  release_display_for_compositor
  fail_note "STICKLLM_KIOSK_TRY label=$label drm=$drm renderer=$renderer comp=$comp browser=$browser timeout=$run_timeout"
  paint "  Trying $label…"

  if [[ "$browser" == "cog" ]]; then
    app="cog -P --enable-mediasource $URL"
  else
    app="$browser --kiosk --ozone-platform=wayland --no-first-run --disable-infobars --disable-session-crashed-bubble --check-for-update-interval=31536000 --user-data-dir=$PROFILE --disk-cache-dir=$PROFILE/cache $URL"
  fi

  # drop_root=1 → runuser as KIOSK_USER (required for cage).
  # drop_root=0 → stay root (weston drm-backend needs root/logind; user path fails).
  _run() {
    local drop_root="${1:-0}"
    shift
    local -a prefix=()
    if [[ "$run_timeout" -gt 0 ]] && command -v timeout >/dev/null 2>&1; then
      prefix=(timeout "$run_timeout")
    fi
    if [[ "$drop_root" -eq 1 && "$(id -u)" -eq 0 && "$KIOSK_USER" != "root" ]] \
      && command -v runuser >/dev/null 2>&1; then
      "${prefix[@]}" runuser -u "$KIOSK_USER" -- env \
        "HOME=/home/${KIOSK_USER}" \
        "USER=${KIOSK_USER}" \
        "LOGNAME=${KIOSK_USER}" \
        "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
        "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}" \
        "LIBSEAT_BACKEND=${LIBSEAT_BACKEND:-seatd}" \
        "WLR_NO_HARDWARE_CURSORS=${WLR_NO_HARDWARE_CURSORS:-1}" \
        "WLR_BACKENDS=${WLR_BACKENDS:-drm,libinput}" \
        "WLR_RENDERER=${WLR_RENDERER}" \
        "WLR_DRM_DEVICES=${WLR_DRM_DEVICES}" \
        "WLR_LIBINPUT_NO_DEVICES=${WLR_LIBINPUT_NO_DEVICES:-}" \
        "LIBGL_ALWAYS_SOFTWARE=${LIBGL_ALWAYS_SOFTWARE:-}" \
        "GALLIUM_DRIVER=${GALLIUM_DRIVER:-}" \
        "MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-}" \
        "GBM_BACKEND=${GBM_BACKEND:-}" \
        "__GLX_VENDOR_LIBRARY_NAME=${__GLX_VENDOR_LIBRARY_NAME:-}" \
        "__EGL_VENDOR_LIBRARY_FILENAMES=${__EGL_VENDOR_LIBRARY_FILENAMES:-}" \
        "$@"
    else
      # Root weston path: use root XDG runtime (seatd/logind-friendly).
      if [[ "$drop_root" -eq 0 && "$(id -u)" -eq 0 ]]; then
        export XDG_RUNTIME_DIR=/run/user/0
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 700 "$XDG_RUNTIME_DIR"
      fi
      "${prefix[@]}" "$@"
    fi
  }

  set +e
  case "$comp" in
    cage)
      {
        echo "=== cage launch $(date -Is 2>/dev/null || date) renderer=$renderer user=$KIOSK_USER ==="
        echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WLR_RENDERER=$WLR_RENDERER WLR_DRM_DEVICES=$WLR_DRM_DEVICES"
        command -v cage; command -v seatd; ls -la /run/seatd.sock /var/run/seatd.sock 2>&1 || true
      } >>"$FAIL_LOG" 2>&1 || true
      # cage refuses uid 0 → drop_root=1. Bookworm cage also needs Xwayland installed.
      if [[ "$browser" == "cog" ]]; then
        # stderr must land in kiosk-fail.log for Term-boot diagnosis
        _run 1 cage -s -- cog -P --enable-mediasource "$URL" >>"$FAIL_LOG" 2>&1
        rc=$?
      else
        # shellcheck disable=SC2086
        _run 1 cage -s -- $browser \
          --kiosk \
          --ozone-platform=wayland \
          --disable-gpu \
          --no-sandbox \
          --no-first-run \
          --disable-infobars \
          --disable-session-crashed-bubble \
          --check-for-update-interval=31536000 \
          --user-data-dir="$PROFILE" \
          --disk-cache-dir="$PROFILE/cache" \
          "$URL" >>"$FAIL_LOG" 2>&1
        rc=$?
      fi
      # On fail: retry once with WLR_RENDERER=pixman (explicit product contract).
      if [[ "$rc" -ne 0 && "$renderer" != "pixman" ]]; then
        fail_note "STICKLLM_KIOSK_PIXMAN_RETRY label=$label prev_rc=$rc"
        serial_note "STICKLLM_KIOSK_PIXMAN_RETRY label=$label"
        export WLR_RENDERER=pixman
        if [[ "$browser" == "cog" ]]; then
          _run 1 cage -s -- cog -P --enable-mediasource "$URL" >>"$FAIL_LOG" 2>&1
          rc=$?
        else
          # shellcheck disable=SC2086
          _run 1 cage -s -- $browser \
            --kiosk \
            --ozone-platform=wayland \
            --disable-gpu \
            --no-sandbox \
            --no-first-run \
            --disable-infobars \
            --disable-session-crashed-bubble \
            --check-for-update-interval=31536000 \
            --user-data-dir="$PROFILE" \
            --disk-cache-dir="$PROFILE/cache" \
            "$URL" >>"$FAIL_LOG" 2>&1
          rc=$?
        fi
        label="${label}+pixman-retry"
      fi
      ;;
    weston)
      # Absolute binary path — kiosk-shell exec is picky about PATH.
      if [[ "$browser" == "cog" ]]; then
        _cog_bin="$(command -v cog)"
        app="${_cog_bin} -P --enable-mediasource ${URL}"
      else
        _br_bin="$(command -v "$browser" || true)"
        [[ -n "$_br_bin" ]] || _br_bin="$browser"
        app="${_br_bin} --kiosk --ozone-platform=wayland --disable-gpu --no-sandbox --no-first-run --disable-infobars --disable-session-crashed-bubble --check-for-update-interval=31536000 --user-data-dir=${PROFILE} --disk-cache-dir=${PROFILE}/cache ${URL}"
      fi
      write_weston_ini "$app"
      chown "${KIOSK_USER}:${KIOSK_USER}" "$WESTON_INI" 2>/dev/null || true
      # bookworm weston 10: --drm-device=cardN, optional --use-pixman
      _card_base="$(basename "$drm")"
      _wargs=(--backend=drm-backend.so --shell=kiosk-shell.so --tty=1 --drm-device="$_card_base" -c "$WESTON_INI")
      if [[ "$renderer" == "pixman" ]]; then
        _wargs+=(--use-pixman)
      fi
      {
        echo "=== weston launch $(date -Is 2>/dev/null || date) renderer=$renderer user=$KIOSK_USER ==="
        echo "ini=$WESTON_INI exec=$app"
        cat "$WESTON_INI" 2>/dev/null || true
      } >>"$FAIL_LOG" 2>&1 || true
      # weston drm-backend as non-root needs logind; stay root (drop_root=0).
      _run 0 weston "${_wargs[@]}" >>"$FAIL_LOG" 2>&1
      rc=$?
      ;;
    *)
      rc=127
      ;;
  esac
  set -u
  # timeout(1) => 124: on virtio treat as failure so ladder can continue / unit restart.
  if [[ "$rc" -eq 124 ]]; then
    fail_note "STICKLLM_KIOSK_TRY_TIMEOUT label=$label"
    serial_note "STICKLLM_KIOSK_TRY_TIMEOUT label=$label"
  fi
  fail_note "STICKLLM_KIOSK_TRY_EXIT label=$label rc=$rc"
  serial_note "STICKLLM_KIOSK_EXIT label=$label rc=$rc"
  # Surface compositor errors on serial (Local has no SSH in product path).
  if [[ "$rc" -ne 0 ]]; then
    serial_note "STICKLLM_KIOSK_FAIL_TAIL label=$label"
    # Avoid pipe-subshell loss of serial writes
    local _line _n=0
    while IFS= read -r _line && [[ "$_n" -lt 40 ]]; do
      serial_note "FAIL| $_line"
      _n=$((_n + 1))
    done < <(tail -n 40 "$FAIL_LOG" 2>/dev/null || true)
    # Never leave a dead DRM master / blank HDMI after a failed try.
    restore_display_console "try-fail:$label:rc=$rc"
  fi
  return "$rc"
}

hold_error() {
  local reason="${1:-unknown}"
  restore_display_console "hold_error"
  printf '\033c' >"$TTY" 2>/dev/null || true
  paint "========================================"
  if grep -Eqw 'stickllm\.chat' /proc/cmdline 2>/dev/null; then
    paint "  StickLLM Chat - browser deferred"
  else
    paint "  StickLLM LOCAL - browser failed"
  fi
  paint "========================================"
  paint ""
  paint "  $reason"
  paint "  Target: $URL"
  _ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  _pair="$(tr -d '\r\n\t ' <"$RUN/pair-code.txt" 2>/dev/null || true)"
  _model="$(tr -d '\r\n' <"$RUN/model-label.txt" 2>/dev/null || true)"
  [[ -n "$_model" ]] || _model="(loading / see Models)"
  paint "  Model:     $_model"
  if [[ -n "$_ip" ]]; then
    paint "  LAN IP:    $_ip"
    paint "  How to:    http://${_ip}/  (phone/LAN - enter PAIR CODE)"
  else
    paint "  LAN IP:    (waiting - Ethernet or stickllm-wifi-setup)"
  fi
  paint "  Local UI:  $URL  (this screen - no pair)"
  if [[ -n "$_pair" && "$_pair" =~ ^[0-9]{4,8}$ ]]; then
    paint "  +-------------------------+"
    paint "  |  PAIR CODE:  $_pair     |"
    paint "  +-------------------------+"
  fi
  paint "  Diag:      $FAIL_LOG"
  paint "  Retrying browser stack in 45s..."
  paint ""
  sleep 45
  exit 1
}


# --- main ---
# Chat (stickllm.chat) shares the on-stick browser; local/kiosk are aliases.
CHAT_MODE=0
if grep -Eqw 'stickllm\.chat' /proc/cmdline 2>/dev/null; then
  CHAT_MODE=1
elif ! grep -Eqw 'stickllm\.(local|kiosk)' /proc/cmdline 2>/dev/null; then
  hold_error "not chat/local/kiosk mode"
fi

mkdir -p "$RUN"
prepare_kiosk_user
touch "$RUN/local-mode"
serial_note "STICKLLM_KIOSK_START chat=$CHAT_MODE fails=$(fail_count)"
collect_drm_diag

if ! command -v cage >/dev/null 2>&1 && ! command -v weston >/dev/null 2>&1; then
  hold_error "neither cage nor weston installed"
fi

BROWSER="$(pick_browser_bin || true)"
[[ -n "${BROWSER:-}" ]] || hold_error "no cog/chromium installed"

# seatd before UI wait so the socket is warm when we launch cage/weston
ensure_seatd || fail_note "STICKLLM_KIOSK_SEATD_WARN seatd not confirmed"

printf '\033c' >"$TTY" 2>/dev/null || true
paint "========================================"
if [[ "$CHAT_MODE" -eq 1 ]]; then
  paint "  StickLLM Chat — starting browser"
else
  paint "  StickLLM LOCAL"
fi
paint "========================================"
paint ""
paint "  On-stick browser → $URL"
if [[ "$CHAT_MODE" -eq 1 ]]; then
  # Keep LAN join info visible while the compositor comes up.
  _ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  _pair="$(tr -d '\r\n\t ' <"$RUN/pair-code.txt" 2>/dev/null || true)"
  _model="$(tr -d '\r\n' <"$RUN/model-label.txt" 2>/dev/null || true)"
  [[ -n "$_model" ]] || _model="(see Models in UI)"
  paint "  Mode:     Chat (this screen + LAN)"
  paint "  Model:    $_model"
  [[ -n "$_ip" ]] && paint "  LAN IP:   $_ip" && paint "  Browser:  http://${_ip}/  (LAN needs PAIR CODE)"
  [[ -n "$_pair" ]] && paint "  PAIR CODE: $_pair"
  paint "  Local:    $URL  (this screen — no pair)"
else
  paint "  (no pair code)"
fi
paint ""
# If an SSD vault blob is configured, offer unlock (skip → stay ephemeral).
# Never formats disks; never unlocks host BitLocker/LUKS volumes.
if [[ -x /usr/local/bin/stickllm-vault-boot ]]; then
  /usr/local/bin/stickllm-vault-boot || true
  if findmnt -n /var/lib/stickllm/vault >/dev/null 2>&1; then
    printf '%s\n' '{"mode":"vault","note":"unlocked at boot"}' >"$RUN/session-mode.json" 2>/dev/null || true
    serial_note "STICKLLM_VAULT_BOOT unlocked → session_mode=vault"
    paint "  Vault: unlocked (Mode → Vault)"
  else
    serial_note "STICKLLM_VAULT_BOOT skipped_or_absent"
  fi
  paint ""
fi
paint "  Waiting for UI HTTP 200…"
ui_ready=0
code="000"
for i in $(seq 1 "$WAIT_UI_SECS"); do
  code="$(http_code "$URL")"
  if [[ "$code" == "200" ]]; then
    ui_ready=1
    serial_note "STICKLLM_KIOSK_UI_READY after=${i}s"
    break
  fi
  if (( i == 1 || i % 10 == 0 )); then
    paint "  Waiting for UI… ${i}s (HTTP ${code})"
  fi
  sleep 1
done
[[ "$ui_ready" -eq 1 ]] || hold_error "UI never returned HTTP 200 (last=$code)"

# Product = browser chat UI. Nudge llama but do not block on tty for minutes —
# the page can show model-loading state. Long waits left users stuck on
# "Waiting for model" then a clear+retry loop when the compositor failed.
llama_ready=0
_llama_en="$(systemctl is-enabled stickllm-llama.service 2>&1 || true)"
_llama_st="$(systemctl status stickllm-llama.service 2>&1 || true)"
if printf '%s\n%s\n' "$_llama_en" "$_llama_st" | grep -qi masked; then
  paint "  Model unit masked — opening browser without llama wait."
  serial_note "STICKLLM_KIOSK_LLAMA_SKIPPED_MASKED"
else
  systemctl start --no-block stickllm-llama.service 2>/dev/null || true
  # Brief poll only (default 8s); never the old 90–120s tty hold.
  _brief_llama="${STICKLLM_KIOSK_WAIT_LLAMA_SECS:-8}"
  [[ "$_brief_llama" -gt 20 ]] && _brief_llama=8
  paint "  Checking model (up to ${_brief_llama}s)…"
  for i in $(seq 1 "$_brief_llama"); do
    if [[ "$(http_code "http://127.0.0.1:8080/health")" == "200" ]]; then
      llama_ready=1
      serial_note "STICKLLM_KIOSK_LLAMA_READY after=${i}s"
      break
    fi
    sleep 1
  done
  if [[ "$llama_ready" -ne 1 ]]; then
    paint "  Model still loading — opening browser now."
    serial_note "STICKLLM_KIOSK_LLAMA_WAIT_SHORT_TIMEOUT"
  fi
fi

# Re-confirm seatd immediately before compositor launch
ensure_seatd || fail_note "STICKLLM_KIOSK_SEATD_WARN seatd not confirmed at launch"

# Ensure DRM nodes exist: amdgpu/i915 on stick HDMI; virtio_gpu in QEMU Local proof.
modprobe amdgpu 2>/dev/null || true
modprobe i915 2>/dev/null || true
modprobe virtio_gpu 2>/dev/null || true
# Monitor on 3090: modeset=0 hides connectors — enable KMS before pick.
ensure_nvidia_kms || fail_note "STICKLLM_KIOSK_NVIDIA_KMS_WARN"
sleep 1

# Restore fbcon so status text is visible while we pick DRM, then release in try_launch.
restore_display_console "pre-launch"
paint "  Console restored — selecting display DRM…"

DISPLAY_DRM="$(pick_display_drm || true)"
if [[ -z "${DISPLAY_DRM:-}" ]]; then
  hold_error "no /dev/dri/card* with a usable display found — see $FAIL_LOG"
fi
fail_note "STICKLLM_KIOSK_DRM_PICK $DISPLAY_DRM"
serial_note "STICKLLM_KIOSK_BROWSER $BROWSER $URL drm=$DISPLAY_DRM driver=$(drm_driver_name "$DISPLAY_DRM")"
paint "  Display DRM: $DISPLAY_DRM ($(drm_driver_name "$DISPLAY_DRM"))"
paint "  Launching browser…"

# Keep a working stack forever: rc=0 (clean browser exit) relaunches SAME combo.
# Do not advance the ladder on success — that caused clear+retry loops.
run_stack_forever() {
  local label="$1" drm="$2" renderer="$3" comp="$4" browser="$5"
  local rc=1
  while true; do
    try_launch "$label" "$drm" "$renderer" "$comp" "$browser"
    rc=$?
    if [[ "$rc" -ne 0 ]]; then
      return "$rc"
    fi
    serial_note "STICKLLM_KIOSK_BROWSER_EXIT_CLEAN relaunch_same label=$label"
    restore_display_console "browser-clean-exit"
    paint "  Browser exited — relaunching $label…"
    sleep 1
  done
}

# Strategy ladder — first long-running success is the product.
# Include the picked card even when it is NVIDIA (3090-as-display).
drm_list=("$DISPLAY_DRM")
for _c in /dev/dri/card[0-9]; do
  [[ -e "$_c" ]] || continue
  [[ "$_c" == "$DISPLAY_DRM" ]] && continue
  # Skip other NVIDIA cards when display is already a specific nvidia card.
  if is_nvidia_path "$_c" && is_nvidia_path "$DISPLAY_DRM"; then
    continue
  fi
  if is_nvidia_path "$_c" && ! is_nvidia_path "$DISPLAY_DRM"; then
    continue
  fi
  is_weak_drm "$_c" && continue
  drm_list+=("$_c")
done
for _c in /dev/dri/card[0-9]; do
  [[ -e "$_c" ]] || continue
  [[ "$_c" == "$DISPLAY_DRM" ]] && continue
  is_nvidia_path "$_c" && continue
  is_weak_drm "$_c" || continue
  drm_list+=("$_c")
done

for drm in "${drm_list[@]}"; do
  # shellcheck disable=SC2206
  renderers=( $(renderer_order_for_drm "$drm") )
  for renderer in "${renderers[@]}"; do
    if command -v cage >/dev/null 2>&1; then
      run_stack_forever "cage+$BROWSER/$renderer@$(basename "$drm")" "$drm" "$renderer" cage "$BROWSER" \
        && exit 0
    fi
    if command -v weston >/dev/null 2>&1; then
      run_stack_forever "weston+$BROWSER/$renderer@$(basename "$drm")" "$drm" "$renderer" weston "$BROWSER" \
        && exit 0
    fi
  done
done

# If primary browser failed everywhere, try the other engine once per DRM in list.
alt=""
if [[ "$BROWSER" == "cog" ]]; then
  command -v chromium >/dev/null 2>&1 && alt=chromium
  command -v chromium-browser >/dev/null 2>&1 && alt=chromium-browser
else
  command -v cog >/dev/null 2>&1 && alt=cog
fi
if [[ -n "$alt" ]]; then
  for drm in "${drm_list[@]}"; do
    is_weak_drm "$drm" && continue
    run_stack_forever "cage+$alt/pixman@$(basename "$drm")" "$drm" pixman cage "$alt" && exit 0
    run_stack_forever "cage+$alt/gles2@$(basename "$drm")" "$drm" gles2 cage "$alt" && exit 0
    if command -v weston >/dev/null 2>&1; then
      run_stack_forever "weston+$alt/pixman@$(basename "$drm")" "$drm" pixman weston "$alt" && exit 0
    fi
  done
fi

n="$(bump_fails)"
collect_drm_diag
restore_display_console "all-backends-failed"
hold_error "All browser backends failed (rc≠0). See $FAIL_LOG (attempt $n)."
