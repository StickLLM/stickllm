# StickLLM Radicale config. Shipped read-only in the image; mounted at
# /config. Collections live in vault/addons/radicale/data only.
# auth none: the StickLLM gateway is the only way in (paired browsers on the
# LAN, the console on 127.0.0.1). Port 5232 is never published on the LAN.
[server]
hosts = 0.0.0.0:5232
max_connections = 8
max_content_length = 50000000

[auth]
type = none

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[web]
type = internal

[logging]
level = warning
mask_passwords = True
