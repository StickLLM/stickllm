# StickLLM amd-rtx3090 — single source of truth for live-build packages (ISS-010).
live-boot
live-config
live-config-systemd
systemd-sysv
# Wall clock: Debian live images often omit timesyncd → clock never NTP-syncs
# after Wi-Fi comes up (timedatectl: NTP service n/a). Required for TLS + logs.
systemd-timesyncd
sudo
curl
wget
ca-certificates
# Experimental unlock helpers prefer git clone; curl+tar archive fallback still works.
git
pciutils
usbutils
network-manager
openssh-client
openssh-server
parted
e2fsprogs
fdisk
util-linux
python3
# Scanned PDF pages for a vision model (pdftoppm). Not downloaded at runtime.
poppler-utils
# Offline read-aloud. espeak-ng and python3-numpy are in Debian.
# whisper.cpp still baked from pin; python3-onnxruntime is in trixie (also vendored wheel).
espeak-ng
python3-numpy
python3-onnxruntime
jq
iproute2
iputils-ping
libgomp1
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
# 0.6.0 (B2): Polaris (RX 570/580) and other Radeon cards need these blobs or
# amdgpu fails after taking the console from simpledrm (black screen).
# firmware-linux-nonfree pulls it in already; listed so it can never drop out.
firmware-amd-graphics
firmware-iwlwifi
firmware-realtek
firmware-atheros
# MediaTek mt7921/mt7922/mt7925 Wi-Fi + BT (common on AMD laptops). Not pulled
# by firmware-misc-nonfree on trixie; missing → mt7921e "hardware init failed"
# and BT firmware request errno -2 (ENOENT).
firmware-mediatek
wpasupplicant
wireless-tools
# 0.8.0: proprietary nvidia-kernel-dkms for a reliable live-build chroot bake.
# nvidia-open-kernel-dkms DKMS failed to compile against 6.12.117+deb13 in lb
# (module build exit 2) — reopen when a working open-DKMS chroot recipe exists.
# Do not bake NVIDIA .run / firmware blobs into the public tree.
nvidia-driver
nvidia-driver-libs
nvidia-kernel-dkms
nvidia-smi
libcuda1
nvidia-persistenced
# 0.5.6 on-stick desktop: stock Debian Xfce (GPL/LGPL, unmodified, configured
# only through settings) on Xorg (MIT). No terminal, no application menu, no
# file manager; Recommends stay off. 0.5.7: Xfce is the only desktop (no
# sway/cage/weston). wmctrl + xdotool + x11-utils (MIT-style) let
# stickllm-control move/minimise the Browser windows on Xorg.
xserver-xorg-core
xserver-xorg-input-libinput
x11-xserver-utils
x11-utils
wmctrl
xdotool
dbus-x11
xfwm4
xfce4-panel
xfce4-session
xfce4-settings
xfdesktop4
xfconf
adwaita-icon-theme
chromium
seatd
# 0.5.8: fallback full-screen kiosk when Xfce fails (cage, MIT, on wlroots MIT)
cage
xwayland
# 0.5.8: Terminus console font for the loading-screen banner (setfont)
kbd
console-setup-linux
libinput-bin
libinput10
fonts-dejavu-core
# Vulkan (AMD/Intel llama path + Mesa ICD; loader required for llama-server-vulkan)
mesa-vulkan-drivers
libvulkan1
vulkan-tools
# Encrypted vault (Phase C feature; LUKS2 tools present for SSH-tested vault work)
cryptsetup
cryptsetup-bin
# Agent Zero runtime. The agent image is pulled onto the host SSD, not baked here.
# Debian trixie splits the CLI out of docker.io; both are required (dockerd + docker).
docker.io
docker-cli
# apparmor_parser so Docker can load the docker-default profile.
apparmor
# stickllm-agent installs its own nftables rules. dockerd is started with --iptables=false.
nftables
# 0.6.11: on-demand Tor for stick Chromium (Web mode). Not enabled at boot.
tor
# StickLink (0.7.1): sticklinkd needs these on the host Python, not only in tests.
# v0.7.0 shipped sticklinkd without them → ModuleNotFoundError: cryptography.
python3-cryptography
python3-nacl
python3-websockets
# Method C peer venv (Milestone A): create venv + native libs for aiortc/av.
# Python packages themselves are NOT apt — they come from vendored wheelhouse
# (Debian 13 / Python 3.13 cp313 wheels).
python3-venv
python3-pip
libavformat61
libavcodec61
libavdevice61
libavutil59
libavfilter10
libswscale8
libswresample5
libopus0
libsrtp2-1
libvpx9
libffi8
libssl3

