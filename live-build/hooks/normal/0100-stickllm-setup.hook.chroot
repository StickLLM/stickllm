#!/bin/bash
set -euo pipefail

echo "[stickllm] chroot hook: setup"

chmod 755 /usr/local/bin/stickllm-status \
          /usr/local/bin/stickllm-persist \
          /usr/local/bin/stickllm-download-model \
          /usr/local/bin/stickllm-bootstatus \
          /usr/local/bin/stickllm-local-chat \
          /usr/local/bin/stickllm-kiosk \
          /usr/local/bin/stickllm-console-setup \
          /usr/local/bin/stickllm-gateway \
          /usr/local/bin/stickllm-control \
          /usr/local/bin/stickllm-pair \
          /usr/local/bin/stickllm-llama-start \
          /usr/local/bin/stickllm-ssh-bootstrap \
          /usr/local/bin/stickllm-lan-ip \
          /usr/local/bin/stickllm-wifi-apply \
          /usr/local/bin/stickllm-wifi-setup \
          /usr/local/bin/stickllm-nvidia-prep \
          /usr/local/bin/stickllm-pick-gpus \
          /usr/local/bin/stickllm-vault \
          /usr/local/bin/stickllm-vault-boot \
          /usr/local/bin/stickllm-agent \
          /usr/local/bin/stickllm-agent-entrypoint \
          /usr/local/bin/stickllm-dockerd \
          /usr/local/bin/stickllm-docs \
          /usr/local/bin/stickllm-docs-entrypoint \
          /usr/local/bin/stickllm-addon \
          /usr/local/bin/stickllm-files \
          /usr/local/bin/stickllm-appagent \
          /usr/local/bin/stickllm-appagent-llm \
          /usr/local/bin/stickllm-methodc-peer \
          /usr/local/bin/stickllm-sticklink-lab-grant \
          /usr/local/bin/stickllm-sticklink-join-publish || true

# Force LF — CRLF in sudoers breaks ALL rules on the stick
if [[ -f /etc/sudoers.d/stickllm ]]; then
  sed -i 's/\r$//' /etc/sudoers.d/stickllm
  chmod 440 /etc/sudoers.d/stickllm
fi
if [[ -f /etc/sudoers.d/stickllm-user ]]; then
  # Legacy broad sudoers — remove so ISS-008 narrow file is authoritative.
  rm -f /etc/sudoers.d/stickllm-user
fi
sed -i 's/\r$//' /etc/modprobe.d/stickllm-nvidia*.conf 2>/dev/null || true
sed -i 's/\r$//' /etc/modules-load.d/stickllm-nvidia.conf 2>/dev/null || true

# ISS-016: single nvidia-drm modprobe conf (v0.2 behavior).
rm -f /etc/modprobe.d/nvidia-drm.conf 2>/dev/null || true
if [[ -f /etc/modprobe.d/stickllm-nvidia-drm.conf ]]; then
  sed -i 's/\r$//' /etc/modprobe.d/stickllm-nvidia-drm.conf
fi

if [[ -x /opt/stickllm/bin/llama-server ]]; then
  chmod 755 /opt/stickllm/bin/llama-server
fi
if [[ -x /opt/stickllm/bin/llama-server-cpu ]]; then
  chmod 755 /opt/stickllm/bin/llama-server-cpu
fi

find /etc/systemd/system -name 'stickllm*.service' -exec chmod 644 {} + 2>/dev/null || true
# Drop-ins must not be executable either (systemd warns on every boot).
find /etc/systemd/system -path '*.d/*' -name '*.conf' -exec chmod 644 {} + 2>/dev/null || true
# Add-on config is bind-mounted read-only into non-root containers (uid 2999/1000).
chmod -R u=rwX,go=rX /usr/local/share/stickllm/addons 2>/dev/null || true
find /etc/ssh/sshd_config.d -type f -exec chmod 644 {} + 2>/dev/null || true

# Prefer NVIDIA proprietary over nouveau
mkdir -p /etc/modprobe.d
cat >/etc/modprobe.d/stickllm-nvidia.conf <<'EOF'
blacklist nouveau
options nouveau modeset=0
EOF

# Hostname (idempotent hosts line)
echo "stickllm" > /etc/hostname
if ! grep -qE '[[:space:]]stickllm([[:space:]]|$)' /etc/hosts 2>/dev/null; then
  echo "10.0.0.1 stickllm" >> /etc/hosts
fi

# Dedicated llama runtime user (unprivileged; video/render for CUDA) — ISS-006
if ! getent passwd stickllm-llama >/dev/null 2>&1; then
  useradd --system --home /nonexistent --shell /usr/sbin/nologin \
    --comment "StickLLM llama-server" stickllm-llama || true
fi
usermod -aG video,render stickllm-llama 2>/dev/null || true

# Interactive SSH/console user — NOT in sudo group (ISS-007/008)
if ! getent passwd stickllm >/dev/null 2>&1; then
  useradd -m -s /bin/bash stickllm || true
fi
usermod -aG video,render stickllm 2>/dev/null || true
gpasswd -d stickllm sudo 2>/dev/null || true
# Password is randomized per SSH boot by stickllm-ssh-bootstrap (not baked).
passwd -l stickllm 2>/dev/null || true

# Live user "user" (created by live-config at boot): no password, no root.
if getent passwd user >/dev/null 2>&1; then
  usermod -aG video,render user || true
  gpasswd -d user sudo 2>/dev/null || true
  passwd -l user 2>/dev/null || true
fi
# live-config's sudo component writes "user ALL=(ALL) NOPASSWD: ALL" on every boot.
rm -f /lib/live/config/0040-sudo
# 0.6.0 (B1): live-config's xinit component makes every tty1 login run startx
# in a loop, which took the Terminal-mode console away. StickLLM's desktop
# starts only from stickllm-kiosk.service. (overlay ships a placeholder
# /etc/profile.d/zz-live-config_xinit.sh too, which the component honours.)
rm -f /lib/live/config/0140-xinit
# 0.6.0 (B2): RX 570 (Polaris) firmware must be in the image (and so in the
# initramfs, which update-initramfs fills from /lib/firmware for amdgpu).
if ! ls /lib/firmware/amdgpu/polaris10_mc.bin* >/dev/null 2>&1; then
  echo "STICKLLM WARN: amdgpu Polaris firmware missing (firmware-amd-graphics)" >&2
fi

# Do not auto-start SSH on every boot — only menu 2 Terminal / 3 Test (stickllm.ssh)
systemctl disable ssh.service 2>/dev/null || true
systemctl disable sshd.service 2>/dev/null || true

# Enable StickLLM services for live boot
systemctl enable stickllm-console-setup.service || true
systemctl enable stickllm-nvidia.service || true
systemctl enable stickllm-llama.service || true
# Experimental NInfer/Strata — starts only when exp-engine.enabled exists (Set default).
systemctl enable stickllm-exp-engine.service || true
systemctl enable stickllm-ui.service || true
systemctl enable stickllm-control.service || true
systemctl enable stickllm-usb.service || true
systemctl enable stickllm-bootstatus.service || true
systemctl enable stickllm-local.service || true
systemctl enable stickllm-kiosk.service || true
systemctl enable stickllm-web-mode.service || true
systemctl enable seatd.service 2>/dev/null || true
systemctl enable stickllm-ssh.service || true
systemctl enable NetworkManager.service || true
systemctl enable nvidia-persistenced.service || true
# Docker must not start at boot. stickllm-agent starts dockerd after the vault unlocks.
systemctl disable docker.service 2>/dev/null || true
systemctl disable docker.socket 2>/dev/null || true
systemctl mask docker.service 2>/dev/null || true
systemctl mask docker.socket 2>/dev/null || true
# Tor only while Web mode is Tor (stickllm-web-mode starts/stops it).
systemctl disable tor.service 2>/dev/null || true
systemctl disable tor@default.service 2>/dev/null || true
systemctl enable stickllm-agent.service || true
systemctl enable stickllm-files.service || true
# 0.6.3: persist journal snapshots to STICKLLM-DATA; skip GPUs whose amdgpu init fails
systemctl enable stickllm-journal-persist.service || true
systemctl enable stickllm-journal-persist.timer || true
systemctl enable stickllm-gpu-skip.service || true
# 0.5.6: nothing auto-loads. The app agent and its (shared chat) model are loaded by
# the user, so neither app agent unit is enabled at boot.
systemctl disable stickllm-appagent.service 2>/dev/null || true
systemctl disable stickllm-appagent-llm.service 2>/dev/null || true
# Baked /opt/stickllm must be readable by stickllm-llama (not root).
# 0.7.8 Lexar / 0.8.0: umask 077 during factory-token bake left GGUFs 600/700 →
# Permission denied / "model missing". Dirs 755, models 644, bins/libs 755.
mkdir -p /opt/stickllm /opt/stickllm/models /opt/stickllm/models/appagent /opt/stickllm/lib
if [[ -d /opt/stickllm ]]; then
  find /opt/stickllm -type d -exec chmod 755 {} + 2>/dev/null || true
  find /opt/stickllm -type f -exec chmod 644 {} + 2>/dev/null || true
  find /opt/stickllm/bin -type f -exec chmod 755 {} + 2>/dev/null || true
  for d in /opt/stickllm/lib /opt/stickllm/lib-cpu /opt/stickllm/lib-vulkan; do
    [[ -d "$d" ]] || continue
    find "$d" -type f \( -name '*.so' -o -name '*.so.*' \) -exec chmod 755 {} + 2>/dev/null || true
  done
fi
# CUDA backend register preload must be executable by stickllm-llama (LD_PRELOAD).
if [[ -f /opt/stickllm/lib/stickllm-cuda-register.so ]]; then
  chmod 755 /opt/stickllm/lib/stickllm-cuda-register.so
fi
# Refuse a stale 4B-only chmod path: 7B split must be present for this ship.
test -f /opt/stickllm/models/appagent/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
test -f /opt/stickllm/models/appagent/qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf
# default-model.env must name the baked 7B (assignments only — ignore comments).
if [[ -f /etc/stickllm/default-model.env ]]; then
  grep -E '^STICKLLM_MODEL=' /etc/stickllm/default-model.env | grep -q 'qwen2.5-7b-instruct-q4_k_m' \
    || { echo "ERROR: default-model.env STICKLLM_MODEL must point at baked Qwen2.5-7B" >&2; exit 1; }
  grep -E '^STICKLLM_MODEL_ID=' /etc/stickllm/default-model.env | grep -q 'qwen25-7b-q4km' \
    || { echo "ERROR: default-model.env STICKLLM_MODEL_ID must be qwen25-7b-q4km" >&2; exit 1; }
  if grep -E '^STICKLLM_' /etc/stickllm/default-model.env | grep -Eq 'Qwen3\.5-4B|qwen35-4b'; then
    echo "ERROR: default-model.env still assigns the legacy 4B model" >&2
    exit 1
  fi
fi


# NM system-connections must be 600
if [[ -d /etc/NetworkManager/system-connections ]]; then
  find /etc/NetworkManager/system-connections -type f -name '*.nmconnection' -exec chmod 600 {} + 2>/dev/null || true
fi

cat >/etc/motd <<'EOF'

  StickLLM v0.8.0 — local Privacy AI (Debian 13 / amd-rtx3090)
  Ephemeral by default. Run: stickllm-status
  No LAN?  stickllm-wifi-setup   (scan SSID + password; same profile as Settings → Network)
  SSH password (Term menu) is random per boot — see console /run/stickllm/ssh-password.txt

EOF

mkdir -p /opt/stickllm/models
mkdir -p /opt/stickllm/ui
mkdir -p /etc/ssh/sshd_config.d
mkdir -p /run/stickllm

# Verify kiosk + StickLink helpers landed (0.7.8 Lexar: sudoers aliases without binaries)
test -x /usr/local/bin/stickllm-kiosk
test -f /etc/systemd/system/stickllm-kiosk.service
test -x /usr/local/bin/stickllm-sticklink-enable
test -x /usr/local/bin/stickllm-sticklink-stop
test -x /usr/local/bin/stickllm-pair-force
test -x /usr/local/bin/stickllm-methodc-peer

echo "[stickllm] chroot hook: done"
