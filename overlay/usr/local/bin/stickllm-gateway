class _LlamaCancel:
    """Close the in-flight llama HTTP connection so one question can replace another.

    Each chat snapshots the stop counter when it starts. Stop bumps that counter
    and closes the llama socket. A chat that started earlier does not call llama.
    The next question starts only after the cancelled one has left.
    """

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._conn: http.client.HTTPConnection | None = None
        self._epoch = 0
        self._stop_id = 0
        self._born: dict[int, int] = {}
        self._llama_epoch = 0
        self._inflight = 0
        self._idle = threading.Event()
        self._idle.set()

    def enter(self) -> int:
        with self._lock:
            self._epoch += 1
            epoch = self._epoch
            self._born[epoch] = self._stop_id
            self._inflight += 1
            self._idle.clear()
            if len(self._born) > 8:
                for old in [k for k in self._born if k < epoch - 4]:
                    self._born.pop(old, None)
            return epoch

    def leave(self) -> None:
        with self._lock:
            self._inflight = max(0, self._inflight - 1)
            if self._inflight == 0:
                self._conn = None
                self._idle.set()

    def superseded(self, epoch: int) -> bool:
        with self._lock:
            born = self._born.get(epoch)
            return born is None or born != self._stop_id

    def arm(self, epoch: int) -> None:
        with self._lock:
            self._llama_epoch = epoch
            self._conn = None

    def is_cancelled(self) -> bool:
        with self._lock:
            born = self._born.get(self._llama_epoch)
            return born is not None and born != self._stop_id

    def bind(self, conn: http.client.HTTPConnection) -> None:
        with self._lock:
            self._conn = conn
            born = self._born.get(self._llama_epoch)
            kill = born is not None and born != self._stop_id
        if kill:
            _close_http_conn(conn)

    def cancel(self) -> bool:
        with self._lock:
            self._stop_id += 1
            conn = self._conn
        if conn is None:
            return False
        _close_http_conn(conn)
        return True

    def take_cancelled(self) -> bool:
        return self.is_cancelled()

    def wait_idle(self, timeout: float = 8.0) -> bool:
        return self._idle.wait(timeout)


def _close_http_conn(conn: http.client.HTTPConnection) -> None:
    sock = getattr(conn, "sock", None)
    if sock is not None:
        try:
            sock.shutdown(socket.SHUT_RDWR)
        except Exception:
            pass
        try:
            sock.close()
        except Exception:
            pass
    try:
        conn.close()
    except Exception:
        pass


LLAMA_CANCEL = _LlamaCancel()
_CHAT_GATE = threading.Lock()


class _TrackHTTPConnection(http.client.HTTPConnection):
    def connect(self) -> None:
        super().connect()
        LLAMA_CANCEL.bind(self)


class _TrackHTTPHandler(urllib.request.HTTPHandler):
    def http_open(self, req):  # noqa: ANN001
        return self.do_open(_TrackHTTPConnection, req)


def http_json(url: str, payload: dict | None = None, timeout: int = 300, headers: dict | None = None) -> dict:
    data = None if payload is None else json.dumps(payload).encode()
    hdrs = {"Content-Type": "application/json", "User-Agent": UA}
    if headers:
        hdrs.update(headers)
    req = urllib.request.Request(
        url,
        data=data,
        headers=hdrs,
        method="GET" if data is None else "POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def http_json_llama(url: str, payload: dict, timeout: int = 300) -> dict:
    """POST to llama-server. Stop closes this connection so the slot is released."""
    if LLAMA_CANCEL.is_cancelled():
        raise InterruptedError("stopped")
    opener = urllib.request.build_opener(_TrackHTTPHandler)
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "User-Agent": UA},
        method="POST",
    )
    try:
        with opener.open(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    finally:
        pass


def log_stt_stats(result: dict) -> None:
    """Journal the clip size only. Never the transcript and never the audio."""
    if not isinstance(result, dict):
        return
    if "webm_bytes" not in result and "pcm_bytes" not in result:
        return
    try:
        webm_bytes = int(result.get("webm_bytes") or 0)
        pcm_bytes = int(result.get("pcm_bytes") or 0)
        rate = int(result.get("rate") or 0)
        duration_s = float(result.get("duration_s") or 0)
        rms = float(result.get("rms") or 0)
    except (TypeError, ValueError):
        return
    msg = (
        "stickllm-speech stt webm_bytes=%d pcm_bytes=%d rate=%d duration_s=%.3f rms=%.5f"
        % (webm_bytes, pcm_bytes, rate, duration_s, rms)
    )
    try:
        import syslog
        syslog.syslog(syslog.LOG_INFO, msg)
    except Exception:
        pass
    for key in ("webm_bytes", "pcm_bytes", "rate", "duration_s", "rms"):
        result.pop(key, None)


def http_text(url: str, timeout: int = 12) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read(200_000)
    return raw.decode("utf-8", errors="replace")


def load_auth() -> dict:
    try:
        return json.loads(AUTH_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {"require_pair": False, "paired": False}


def save_auth(doc: dict) -> None:
    AUTH_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    try:
        os.chmod(AUTH_PATH, 0o600)
    except Exception:
        pass


_AGENT_LIB = None


def _agent_port_open(port: int = 5099) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return True
    except OSError:
        return False


def agent_lib():
    """Load the vault/docker gate beside this script. Tests and the unit share it."""
    global _AGENT_LIB
    if _AGENT_LIB is not None:
        return _AGENT_LIB
    path = Path(__file__).resolve().parent.parent / "lib" / "stickllm_agent.py"
    loader = importlib.machinery.SourceFileLoader("stickllm_agent", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("stickllm_agent helper is missing")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _AGENT_LIB = mod
    return mod


_APPS_LIB = None


def apps_lib():
    """Catalog and install/uninstall gate. Shared with the Apps page tests."""
    global _APPS_LIB
    if _APPS_LIB is not None:
        return _APPS_LIB
    path = Path(__file__).resolve().parent.parent / "lib" / "stickllm_apps.py"
    loader = importlib.machinery.SourceFileLoader("stickllm_apps", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("stickllm_apps helper is missing")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _APPS_LIB = mod
    return mod


_FILES_LIB = None
_SYSTEM_LIB = None


def _load_sibling(cache_name: str, filename: str):
    path = Path(__file__).resolve().parent.parent / "lib" / filename
    loader = importlib.machinery.SourceFileLoader(cache_name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"{filename} is missing")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def files_lib():
    global _FILES_LIB
    if _FILES_LIB is None:
        _FILES_LIB = _load_sibling("stickllm_files", "stickllm_files.py")
    return _FILES_LIB


def system_lib():
    global _SYSTEM_LIB
    if _SYSTEM_LIB is None:
        _SYSTEM_LIB = _load_sibling("stickllm_system", "stickllm_system.py")
    return _SYSTEM_LIB


def token_ok(header: str | None, doc: dict) -> bool:
    if not header:
        return False
    parts = header.split()
    if len(parts) != 2 or parts[0].lower() != "bearer":
        return False
    th = hashlib.sha256(parts[1].encode()).hexdigest()
    stored = str(doc.get("token_hash") or "")
    if not stored or not doc.get("paired"):
        return False
    return hmac.compare_digest(th, stored)



def read_text_safe(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except Exception:
        return ""


def _parse_env_kv(text: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def resolve_model() -> tuple[str, str, str, str]:
    """Return (display_name, requested_path, model_id, running_path).

    requested_path / model_id come only from Activate's model.env.
    running_path is the file the live llama process was started with.
    A missing display name becomes that file's basename — never the baked 3B.
    """
    model_name = ""
    model_path = ""
    model_id = ""
    envf = RUN_DIR / "model.env"
    if envf.is_file():
        kv = _parse_env_kv(read_text_safe(envf))
        model_name = kv.get("STICKLLM_MODEL_NAME") or ""
        model_path = kv.get("STICKLLM_MODEL") or ""
        model_id = kv.get("STICKLLM_MODEL_ID") or ""
    running = ""
    rt = RUN_DIR / "llama-runtime.env"
    if rt.is_file():
        rtkv = _parse_env_kv(read_text_safe(rt))
        running = rtkv.get("model") or rtkv.get("STICKLLM_MODEL") or ""
    if not model_path:
        model_path = running
    if not model_name and model_path:
        model_name = Path(model_path).name
    return model_name, model_path, model_id, running


def llama_load_info() -> dict:
    """Fit caption + last CUDA error written under /run/stickllm. No secrets."""
    plan = _parse_env_kv(read_text_safe(RUN_DIR / "llama-plan.env"))
    fail = ""
    try:
        raw = (RUN_DIR / "llama-fail.txt").read_text(encoding="utf-8", errors="replace")
    except OSError:
        raw = ""
    for line in raw.splitlines():
        if re.search(r"password|STICKLLM_SSH_PASS", line, re.I):
            continue
        if line.strip():
            fail = line.strip()[:220]
    n_fail = 0
    try:
        n_fail = int(read_text_safe(RUN_DIR / "llama-fail-count") or "0")
    except ValueError:
        n_fail = 0
    gpu_count = 0
    ngl = 0
    try:
        gpu_count = int(plan.get("STICKLLM_PLAN_GPU_COUNT") or 0)
    except ValueError:
        gpu_count = 0
    try:
        ngl = int(plan.get("STICKLLM_PLAN_NGL") or 0)
    except ValueError:
        ngl = 0
    fit_doc = read_json_safe(RUN_DIR / "llama-fit.json") or {}
    return {
        "caption": plan.get("STICKLLM_PLAN_CAPTION") or "",
        "fit": plan.get("STICKLLM_PLAN_FIT") or "",
        "gpu_count": gpu_count,
        "n_gpu_layers": ngl,
        "devices": plan.get("STICKLLM_PLAN_DEVICES") or "",
        "error": fail,
        "fail_count": n_fail,
        "model": str(fit_doc.get("model") or ""),
    }


def llama_unit_state() -> dict:
    """Whether stickllm-llama is actually starting or running. No secrets."""
    snap = {"active_state": "", "sub_state": "", "process_alive": False}
    try:
        proc = subprocess.run(
            [
                "systemctl",
                "show",
                "stickllm-llama.service",
                "-p",
                "ActiveState",
                "-p",
                "SubState",
                "--no-pager",
            ],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        vals: dict[str, str] = {}
        for line in (proc.stdout or "").splitlines():
            if "=" not in line:
                continue
            key, val = line.split("=", 1)
            vals[key.strip()] = val.strip()
        snap["active_state"] = vals.get("ActiveState") or ""
        snap["sub_state"] = vals.get("SubState") or ""
    except (OSError, subprocess.SubprocessError):
        pass
    snap["process_alive"] = (
        snap["active_state"] == "active" and snap["sub_state"] == "running"
    )
    return snap


def detect_backend() -> str:
    for name in ("llama-runtime.env", "cuda.env"):
        text = read_text_safe(RUN_DIR / name)
        if not text:
            continue
        for line in text.splitlines():
            line = line.strip()
            if line.startswith("backend="):
                b = line.split("=", 1)[1].strip().lower()
                if b in ("cuda", "vulkan", "cpu"):
                    return b
            if line.startswith("STICKLLM_BACKEND="):
                b = line.split("=", 1)[1].strip().lower()
                if b in ("cuda", "vulkan", "cpu"):
                    return b
    return "cpu"


def discover_lan_ip() -> str:
    """Fresh LAN IPv4 for connect banner; refresh lan-ip.txt after late WiFi DHCP."""
    probed = ""
    helper = Path("/usr/local/bin/stickllm-lan-ip")
    if helper.is_file():
        try:
            r = subprocess.run(
                [str(helper)],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            probed = (r.stdout or "").strip().splitlines()[0].strip() if r.stdout else ""
        except (OSError, subprocess.SubprocessError, IndexError):
            probed = ""
    cached = read_text_safe(RUN_DIR / "lan-ip.txt")
    ip = probed or cached
    if probed and probed != cached:
        try:
            RUN_DIR.mkdir(parents=True, exist_ok=True)
            (RUN_DIR / "lan-ip.txt").write_text(probed + "\n", encoding="utf-8")
        except OSError:
            pass
    return ip


def ssh_enabled() -> bool:
    """True when boot menu enabled SSH (Term/Test) — never invent a password."""
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8", errors="ignore")
    except Exception:
        cmdline = ""
    if "stickllm.ssh" in cmdline.split():
        return True
    return (RUN_DIR / "ssh-password.txt").is_file()


def ssh_password_for_loopback() -> dict:
    """SSH credentials for on-stick UI only. Never include in LAN responses."""
    if not ssh_enabled():
        return {"ssh_enabled": False}
    passwd = read_text_safe(RUN_DIR / "ssh-password.txt").strip()
    ip = discover_lan_ip()
    out = {
        "ssh_enabled": True,
        "ssh_user": "stickllm",
        "ssh_host": ip or "127.0.0.1",
        "ssh_note": "Random per boot. Shown only on this stick (loopback). Not sent to LAN clients.",
    }
    if passwd:
        out["ssh_password"] = passwd
    return out


def active_ctx_size() -> int | None:
    envf = RUN_DIR / "model.env"
    if not envf.is_file():
        return None
    kv = _parse_env_kv(read_text_safe(envf))
    raw = kv.get("STICKLLM_CTX_SIZE") or ""
    try:
        n = int(raw)
        return n if n > 0 else None
    except (TypeError, ValueError):
        return None


def connect_info(loopback: bool, llama_ok: bool = False) -> dict:
    """IP / model / URL (+ pair code / SSH password on loopback only)."""
    ip = discover_lan_ip()
    model_name, model_path, model_id, running_model = resolve_model()
    if not model_name:
        # No Activate yet — do not imply a boot-time load is in progress,
        # and do not substitute the baked 3B for a missing name.
        model_name = "ready" if llama_ok else "none"
    elif model_name.lower().startswith("loading") and llama_ok:
        model_name = Path(model_path).name if model_path else "ready"
    # Prefer a short display label (never dump the full path into UI chrome).
    display = model_name
    if display and ("/" in display or "\\" in display):
        display = Path(display).name
    if display.lower().endswith(".gguf"):
        display = display[: -len(".gguf")]
    scheme = "https" if (RUN_DIR / "tls.enabled").is_file() else "http"
    url = f"{scheme}://{ip}/" if ip else f"{scheme}://<lan-ip>/"
    local_url = "http://127.0.0.1/"
    out: dict = {
        "ip": ip or "",
        "model": display,
        "model_id": model_id,
        "model_path": model_path,
        "running_model": running_model,
        "ctx_size": active_ctx_size(),
        "vision": bool(active_mmproj()),
        "url": url,
        "local_url": local_url,
        "backend": detect_backend(),
    }
    if loopback:
        out["how"] = (
            f"This screen: {local_url} (no pair). "
            f"Phone/LAN: {url} + PAIR CODE below."
        )
        code = read_text_safe(RUN_DIR / "pair-code.txt")
        auth = load_auth()
        remint = read_json_safe(PAIR_REMINT_PATH) or {}
        remint_code = str(remint.get("code") or "").strip()
        # The file is what F9 should show. A stuck "paired" flag must not hide
        # a code that New code just wrote (pair success deletes the file).
        if re.fullmatch(r"[0-9]{4,8}", code):
            out["pair_code"] = code
            out["pair_state"] = "code"
        elif re.fullmatch(r"[0-9]{4,8}", remint_code) and not auth.get("paired"):
            out["pair_code"] = remint_code
            out["pair_state"] = "code"
        elif auth.get("paired"):
            out["pair_code"] = "(paired — Pair remints)"
            out["pair_state"] = "paired"
        else:
            out["pair_code"] = "(starting…)"
            out["pair_state"] = "waiting"
        rid = str(remint.get("id") or "").strip()
        if rid:
            out["remint_id"] = rid
        if re.fullmatch(r"[0-9]{4,8}", remint_code):
            out["remint_code"] = remint_code
        # Test/Term: surface SSH password in Settings on the stick only.
        out.update(ssh_password_for_loopback())
    else:
        out["how"] = f"Open {url} and enter the PAIR CODE from the stick screen."
        # Explicitly omit credentials on LAN (even for paired browsers).
        out["ssh_enabled"] = ssh_enabled()
        out["ssh_password"] = None
        out["ssh_note"] = "SSH password is only shown on the stick screen / Settings (loopback)."
    return out


def active_mmproj() -> str:
    env = RUN_DIR / "model.env"
    if not env.is_file():
        return ""
    path = ""
    try:
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MMPROJ="):
                path = line.split("=", 1)[1].strip()
    except Exception:
        return ""
    return path if path and Path(path).is_file() else ""


def stickllm_ui_client(headers) -> bool:
    """StickLLM web UI only — external OpenAI clients are rejected (ISS-004)."""
    marker = (headers.get("X-StickLLM-Client") or "").strip().lower()
    if marker == "ui":
        return True
    # Loopback Local chat may omit the header; still StickLLM-controlled.
    return False


def read_json_safe(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def get_session_mode() -> str:
    """Default boot: ephemeral — no SSD/vault writes until user selects Vault."""
    doc = read_json_safe(SESSION_MODE_PATH) or {}
    mode = str(doc.get("mode") or "ephemeral").strip().lower()
    return mode if mode in SESSION_MODES else "ephemeral"


def set_session_mode(mode: str) -> dict:
    mode = str(mode or "").strip().lower()
    if mode not in SESSION_MODES:
        return {"ok": False, "error": "mode must be ephemeral or vault"}
    prev = get_session_mode()
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    doc = {
        "mode": mode,
        "updated": int(time.time()),
        "note": (
            "Vault mode: models may use clear SSD folder; chats/settings only in LUKS blob."
            if mode == "vault"
            else "Ephemeral: do not write to SSD/vault; RAM/USB-DATA only as before."
        ),
    }
    # Ephemeral → unload model then lock/unmount LUKS. Mode write still succeeds;
    # report lock errors so UI can surface them.
    if mode == "ephemeral" and (prev == "vault" or vault_unlocked()):
        try:
            subprocess.run(
                ["systemctl", "stop", "stickllm-llama.service"],
                capture_output=True,
                text=True,
                timeout=60,
                check=False,
            )
            p = subprocess.run(
                ["/usr/local/bin/stickllm-vault", "lock"],
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
            )
            doc["vault_locked"] = p.returncode == 0
            if p.returncode != 0:
                doc["vault_lock_error"] = (p.stderr or p.stdout or "lock failed")[-500:]
        except Exception as e:
            doc["vault_locked"] = False
            doc["vault_lock_error"] = str(e)[:300]
    SESSION_MODE_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    try:
        os.chmod(SESSION_MODE_PATH, 0o644)
    except Exception:
        pass
    return {"ok": True, **doc}


VAULT_MNT = Path(os.environ.get("STICKLLM_VAULT_MNT", "/var/lib/stickllm/vault"))
CHATS_DIR = VAULT_MNT / "chats"


def vault_unlocked() -> bool:
    """True when the LUKS vault is mounted in *this* process mount namespace."""
    try:
        if os.path.ismount(str(VAULT_MNT)):
            return True
    except Exception:
        pass
    # Fallback: ismount can lag behind /proc after late mounts into ProtectSystem NS.
    try:
        mnt = str(VAULT_MNT)
        with open("/proc/self/mounts", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) >= 2 and parts[1] == mnt:
                    return True
    except Exception:
        pass
    return False


def chats_available() -> tuple[bool, str]:
    if get_session_mode() != "vault":
        return False, "switch Mode to Vault to save chats (ephemeral never writes chats to disk)"
    if not vault_unlocked():
        return False, "vault locked — unlock in Settings → Storage first"
    return True, ""


def list_vault_chats() -> dict:
    ok, err = chats_available()
    if not ok:
        return {"ok": False, "error": err, "chats": []}
    out = []
    for p in sorted(CHATS_DIR.glob("*.json")):
        try:
            doc = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        out.append(
            {
                "id": doc.get("id") or p.stem,
                "title": doc.get("title") or p.stem,
                "updated": doc.get("updated") or int(p.stat().st_mtime),
                "messages": len(doc.get("messages") or []),
            }
        )
    out.sort(key=lambda x: int(x.get("updated") or 0), reverse=True)
    return {"ok": True, "chats": out}


def load_vault_chat(chat_id: str) -> dict:
    ok, err = chats_available()
    if not ok:
        return {"ok": False, "error": err}
    cid = re.sub(r"[^a-zA-Z0-9_-]", "", chat_id or "")[:64]
    if not cid:
        return {"ok": False, "error": "id required"}
    path = CHATS_DIR / f"{cid}.json"
    if not path.is_file():
        return {"ok": False, "error": "not found"}
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
        doc["ok"] = True
        return doc
    except Exception as e:
        return {"ok": False, "error": str(e)}


def save_vault_chat(title: str, messages: list, chat_id: str | None = None) -> dict:
    ok, err = chats_available()
    if not ok:
        return {"ok": False, "error": err}
    # Never write chats outside the vault mount (encrypted blob only).
    if not str(CHATS_DIR).startswith(str(VAULT_MNT)):
        return {"ok": False, "error": "refuse: chats path outside vault"}
    if not os.path.ismount(str(VAULT_MNT)):
        return {"ok": False, "error": "vault not mounted — refuse plaintext chat write"}
    CHATS_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CHATS_DIR, 0o700)
    except Exception:
        pass
    cid = re.sub(r"[^a-zA-Z0-9_-]", "", chat_id or "")[:64]
    if not cid:
        cid = secrets.token_hex(8)
    # Strip system prompt noise optional — store user/assistant only + keep system if present
    clean = []
    for m in messages or []:
        if not isinstance(m, dict):
            continue
        role = str(m.get("role") or "")
        content = str(m.get("content") or "")
        if role in ("user", "assistant", "system") and content:
            clean.append({"role": role, "content": content[:100_000]})
    title = (title or "Chat").strip()[:120] or "Chat"
    doc = {
        "id": cid,
        "title": title,
        "updated": int(time.time()),
        "messages": clean,
    }
    path = CHATS_DIR / f"{cid}.json"
    path.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    try:
        os.chmod(path, 0o600)
    except Exception:
        pass
    return {"ok": True, "id": cid, "title": title, "updated": doc["updated"]}


def delete_vault_chat(chat_id: str) -> dict:
    ok, err = chats_available()
    if not ok:
        return {"ok": False, "error": err}
    cid = re.sub(r"[^a-zA-Z0-9_-]", "", chat_id or "")[:64]
    if not cid:
        return {"ok": False, "error": "id required"}
    path = CHATS_DIR / f"{cid}.json"
    if path.is_file():
        path.unlink()
    # Converted files live beside the chat, only inside the vault mount.
    folder = CHATS_DIR / cid
    if folder.is_dir() and str(folder).startswith(str(CHATS_DIR)):
        shutil.rmtree(folder, ignore_errors=True)
    return {"ok": True, "deleted": cid}


_CONVERT_MOD = None
_SPEECH_MOD = None


def convert_mod():
    """Sibling converter. Parsers run in a child; this import is for budgeting text."""
    global _CONVERT_MOD
    if _CONVERT_MOD is not None:
        return _CONVERT_MOD
    path = Path(__file__).resolve().with_name("stickllm-convert")
    loader = importlib.machinery.SourceFileLoader("stickllm_convert", str(path))
    spec = importlib.util.spec_from_loader("stickllm_convert", loader)
    if spec is None:
        raise RuntimeError("stickllm-convert is not installed")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _CONVERT_MOD = mod
    return mod


def _safe_chat_id(chat_id: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_-]", "", chat_id or "")[:64]


def persist_attachment(chat_id: str, name: str, raw: bytes, plain: str) -> None:
    """Write the upload only when the encrypted vault is mounted. Never /tmp."""
    if get_session_mode() != "vault" or not vault_unlocked():
        return
    if not os.path.ismount(str(VAULT_MNT)):
        return
    cid = _safe_chat_id(chat_id)
    if not cid:
        return
    dest = CHATS_DIR / cid / "files"
    if not str(dest).startswith(str(VAULT_MNT)):
        return
    dest.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CHATS_DIR / cid, 0o700)
        os.chmod(dest, 0o700)
    except Exception:
        pass
    safe = re.sub(r"[^A-Za-z0-9._-]+", "_", Path(name or "file").name)[:80] or "file"
    stem = f"{secrets.token_hex(4)}-{safe}"
    blob = dest / stem
    text = dest / f"{stem}.txt"
    blob.write_bytes(raw)
    text.write_text(plain or "", encoding="utf-8")
    try:
        os.chmod(blob, 0o600)
        os.chmod(text, 0o600)
    except Exception:
        pass


def run_attachment_convert(data: bytes, name: str, vision: bool) -> dict:
    """Convert in a short-lived child: no network, 60s, memory cap, not as root."""
    mod = convert_mod()
    if len(data) > mod.MAX_BYTES:
        mb = mod.MAX_BYTES // (1024 * 1024)
        return {"ok": False, "error": f"{name} is over the {mb} MB limit."}
    script = str(Path(__file__).resolve().with_name("stickllm-convert"))
    argv = mod.sandbox_argv(script)
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "HOME": "/nonexistent",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "STICKLLM_ATTACH_NAME": Path(name or "file").name[:180],
        "STICKLLM_ATTACH_VISION": "1" if vision else "0",
    }
    kwargs = {
        "input": data,
        "capture_output": True,
        "timeout": mod.CONVERT_TIMEOUT_SECS,
        "env": env,
        "check": False,
    }
    if os.name == "posix":
        kwargs["preexec_fn"] = mod.limit_child
    try:
        proc = subprocess.run(argv, **kwargs)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Conversion took too long (60 second limit)."}
    except OSError:
        if argv[:3] == ["unshare", "--net", "--"]:
            # Drop the net namespace wrapper and try once more as the unprivileged user.
            argv = argv[3:]
            try:
                proc = subprocess.run(argv, **kwargs)
            except (OSError, subprocess.TimeoutExpired):
                return {"ok": False, "error": "Could not start the file converter."}
        else:
            return {"ok": False, "error": "Could not start the file converter."}
    raw = proc.stdout.decode("utf-8", "replace").strip()
    try:
        result = json.loads(raw or "{}")
    except Exception:
        return {"ok": False, "error": "The converter returned nothing readable."}
    if not isinstance(result, dict):
        return {"ok": False, "error": "The converter returned nothing readable."}
    return result


def speech_mod():
    """Sibling speech runner. whisper.cpp and KittenTTS run in a child, not in this process."""
    global _SPEECH_MOD
    if _SPEECH_MOD is not None:
        return _SPEECH_MOD
    path = Path(__file__).resolve().with_name("stickllm-speech")
    loader = importlib.machinery.SourceFileLoader("stickllm_speech", str(path))
    spec = importlib.util.spec_from_loader("stickllm_speech", loader)
    if spec is None:
        raise RuntimeError("stickllm-speech is not installed")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _SPEECH_MOD = mod
    return mod


def run_speech(command: str, payload: bytes) -> dict:
    """One shot: no network namespace, unprivileged when we are root, hard timeout.

    payload is audio or a short JSON request. It is not logged. The child
    stdout is parsed and not logged (it may be a transcript or wav).
    """
    try:
        mod = speech_mod()
    except Exception:
        return {"ok": False, "error": "Speech support is not installed."}
    script = str(Path(__file__).resolve().with_name("stickllm-speech"))
    return mod.run_sandboxed(script, command, payload)


def llama_token_count(text: str) -> int:
    rough = convert_mod().rough_tokens(text)
    try:
        data = http_json_llama(LLAMA + "/tokenize", {"content": text}, timeout=20)
        toks = data.get("tokens")
        if isinstance(toks, list) and toks:
            return len(toks)
    except Exception:
        pass
    return rough


def fit_chat_messages(messages, ctx, counter):
    """Apply the attachment budget. A failure must not forward the original attachment."""
    mod = convert_mod()
    try:
        fitted, meta = mod.budget_for_chat(messages, ctx, counter)
        return fitted, meta, ""
    except Exception:
        if mod.messages_have_attachment(messages):
            return None, {}, "Could not fit the attachment into the context window."
        return messages, {"used": False, "truncated": False, "note": ""}, ""


def pair_rate_load() -> dict:
    try:
        return json.loads(PAIR_RATE_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {"fails": [], "locked_until": 0}


def pair_rate_save(doc: dict) -> None:
    try:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        PAIR_RATE_PATH.write_text(json.dumps(doc) + "\n", encoding="utf-8")
        os.chmod(PAIR_RATE_PATH, 0o600)
    except Exception:
        pass


def pair_rate_blocked() -> tuple[bool, str]:
    doc = pair_rate_load()
    now = time.time()
    locked = float(doc.get("locked_until") or 0)
    if locked > now:
        return True, f"Too many pair attempts — wait {int(locked - now)}s"
    fails = [t for t in doc.get("fails") or [] if now - float(t) < PAIR_WINDOW_SECS]
    doc["fails"] = fails
    pair_rate_save(doc)
    if len(fails) >= PAIR_MAX_ATTEMPTS:
        doc["locked_until"] = now + PAIR_WINDOW_SECS
        pair_rate_save(doc)
        return True, f"Too many pair attempts — wait {PAIR_WINDOW_SECS}s"
    return False, ""


def pair_rate_fail() -> None:
    doc = pair_rate_load()
    fails = [t for t in doc.get("fails") or [] if time.time() - float(t) < PAIR_WINDOW_SECS]
    fails.append(time.time())
    doc["fails"] = fails
    if len(fails) >= PAIR_MAX_ATTEMPTS:
        doc["locked_until"] = time.time() + PAIR_WINDOW_SECS
    pair_rate_save(doc)


def pair_rate_ok() -> None:
    pair_rate_save({"fails": [], "locked_until": 0})


def code_expired(auth: dict) -> bool:
    created = int(auth.get("created") or 0)
    if created <= 0:
        return False
    return (time.time() - created) > PAIR_CODE_TTL_SECS


def note_pair_remint(code: str) -> str:
    """Record remint so the on-stick chat UI can announce the new code."""
    rid = secrets.token_hex(8)
    doc = {"id": rid, "code": code, "at": int(time.time())}
    try:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        PAIR_REMINT_PATH.write_text(json.dumps(doc) + "\n", encoding="utf-8")
        os.chmod(PAIR_REMINT_PATH, 0o644)
    except Exception:
        pass
    return rid


def remint_rate_blocked() -> tuple[bool, str]:
    try:
        doc = json.loads(REMINT_RATE_PATH.read_text(encoding="utf-8"))
    except Exception:
        doc = {"at": []}
    now = time.time()
    recent = [t for t in doc.get("at") or [] if now - float(t) < REMINT_WINDOW_SECS]
    if len(recent) >= REMINT_MAX:
        oldest = min(recent) if recent else now
        wait = max(1, int(REMINT_WINDOW_SECS - (now - oldest)))
        return True, f"Too many pair remints — wait {wait}s"
    return False, ""


def remint_rate_mark() -> None:
    try:
        doc = json.loads(REMINT_RATE_PATH.read_text(encoding="utf-8"))
    except Exception:
        doc = {"at": []}
    now = time.time()
    recent = [t for t in doc.get("at") or [] if now - float(t) < REMINT_WINDOW_SECS]
    recent.append(now)
    try:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        REMINT_RATE_PATH.write_text(json.dumps({"at": recent}) + "\n", encoding="utf-8")
        os.chmod(REMINT_RATE_PATH, 0o600)
    except Exception:
        pass


def remint_pair_code() -> tuple[str, str]:
    """Invalidate any paired LAN session and mint a fresh pair code.

    Returns (code, remint_id). remint_id is for the stick chat to announce.
    """
    code = ""
    pair_bin = Path("/usr/local/bin/stickllm-pair")
    if pair_bin.is_file():
        try:
            out = subprocess.check_output(
                [str(pair_bin), "--force"],
                text=True,
                timeout=10,
                env={**os.environ, "STICKLLM_RUN": str(RUN_DIR)},
            )
            code = (out.strip().splitlines() or [""])[-1].strip()
            if not re.fullmatch(r"[0-9]{4,8}", code):
                code = ""
        except Exception:
            code = ""
    if not code:
        # Inline fallback (same shape as stickllm-pair --force).
        code = f"{secrets.randbelow(1_000_000):06d}"
        doc = {
            "version": 2,
            "created": int(time.time()),
            "code_hash": hashlib.sha256(code.encode()).hexdigest(),
            "token_hash": "",
            "paired": False,
            "require_pair": True,
        }
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        save_auth(doc)
        (RUN_DIR / "pair-code.txt").write_text(code + "\n", encoding="utf-8")
        try:
            os.chmod(RUN_DIR / "pair-code.txt", 0o644)
        except Exception:
            pass
        for stale in ("api-key.txt", "pair-rate.json"):
            try:
                (RUN_DIR / stale).unlink(missing_ok=True)
            except Exception:
                pass
    rid = note_pair_remint(code)
    return code, rid


def uplink_ok() -> bool:
    """Best-effort: can we reach the public internet (Web / downloads)?"""
    try:
        req = urllib.request.Request(
            "https://connectivitycheck.gstatic.com/generate_204",
            method="GET",
            headers={"User-Agent": UA},
        )
        with urllib.request.urlopen(req, timeout=3) as r:
            return int(getattr(r, "status", 0) or 0) in (204, 200)
    except Exception:
        try:
            req = urllib.request.Request("https://1.1.1.1", headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=3) as r:
                return True
        except Exception:
            return False


def duckduckgo_search(query: str, n: int = 5) -> list[dict]:
    if not uplink_ok():
        return [{
            "title": "no uplink",
            "url": "",
            "snippet": "StickLLM has no internet route yet. Connect Ethernet or set WiFi in Models → Network.",
        }]
    body = urllib.parse.urlencode({"q": query, "kl": "us-en"}).encode()
    req = urllib.request.Request(
        "https://html.duckduckgo.com/html/",
        data=body,
        headers={"User-Agent": UA, "Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            html = r.read(400_000).decode("utf-8", errors="replace")
    except Exception as e:
        return [{"title": "search error", "url": "", "snippet": f"Web lookup failed: {e}"}]

    results: list[dict] = []
    for m in re.finditer(
        r'class="result__a"[^>]*href="(?P<href>[^"]+)"[^>]*>(?P<title>.*?)</a>'
        r'.*?(?:class="result__snippet"[^>]*>(?P<snip>.*?)</(?:a|td)|$)',
        html,
        re.I | re.S,
    ):
        title = re.sub(r"<[^>]+>", "", m.group("title")).strip()
        snip = re.sub(r"<[^>]+>", "", m.group("snip") or "").strip()
        href = m.group("href")
        um = re.search(r"uddg=([^&]+)", href)
        if um:
            href = urllib.parse.unquote(um.group(1))
        if not title:
            continue
        results.append({"title": title, "url": href, "snippet": snip[:400]})
        if len(results) >= n:
            break
    if not results:
        results.append({"title": "no results", "url": "", "snippet": "Web search returned nothing useful."})
    return results


def fetch_url(url: str) -> str:
    if not url.startswith(("http://", "https://")):
        return "invalid url"
    try:
        text = http_text(url, timeout=12)
    except Exception as e:
        return f"fetch failed: {e}"
    text = re.sub(r"(?is)<script.*?>.*?</script>", " ", text)
    text = re.sub(r"(?is)<style.*?>.*?</style>", " ", text)
    text = re.sub(r"(?is)<[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text[:6000]


def message_text(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        bits = []
        for part in content:
            if isinstance(part, dict) and part.get("type") == "text":
                bits.append(str(part.get("text") or ""))
        return "\n".join(b for b in bits if b)
    return ""


def _chat_image_cap() -> int:
    """3 paperclip photos, plus scanned document pages (8)."""
    try:
        pages = int(convert_mod().MAX_PAGE_IMAGES)
    except Exception:
        pages = 8
    return 3 + max(0, pages)


def sanitize_chat_messages(messages: list) -> list[dict]:
    """Keep text, and image data-URLs only. Drop remote image URLs."""
    out: list[dict] = []
    images = 0
    for m in messages or []:
        if not isinstance(m, dict):
            continue
        role = str(m.get("role") or "")
        if role not in ("system", "user", "assistant"):
            continue
        content = m.get("content")
        if isinstance(content, list) and role == "user":
            parts = []
            for part in content:
                if not isinstance(part, dict):
                    continue
                if part.get("type") == "text":
                    text = str(part.get("text") or "")[:100_000]
                    if text:
                        parts.append({"type": "text", "text": text})
                elif part.get("type") == "image_url" and images < _chat_image_cap():
                    iu = part.get("image_url")
                    url = iu.get("url") if isinstance(iu, dict) else iu
                    url = str(url or "")
                    if url.startswith("data:image/") and len(url) <= 180_000:
                        parts.append({"type": "image_url", "image_url": {"url": url}})
                        images += 1
            if parts:
                out.append({"role": role, "content": parts})
            continue
        text = message_text(content)[:100_000]
        if text:
            out.append({"role": role, "content": text})
    return out


def _content_has_image(content) -> bool:
    if not isinstance(content, list):
        return False
    return any(isinstance(p, dict) and p.get("type") == "image_url" for p in content)


def needs_web(text: str) -> bool:
    t = text.lower()
    keys = (
        "http://", "https://", "www.", "search", "look up", "lookup", "look it up",
        "latest", "today", "news", "current", "who is", "what is the price",
        "whats the price", "what's the price", "price of", "how much", "weather",
        "stock", "bitcoin", "btc", "according to", "on the internet", "online",
        "live", "right now",
    )
    return any(k in t for k in keys) or bool(re.search(r"\b20\d{2}\b", t))


def augment_with_web(messages: list[dict], force: bool) -> tuple[list[dict], list[dict]]:
    user_text = ""
    for m in reversed(messages):
        if m.get("role") == "user":
            user_text = message_text(m.get("content"))
            break
    if not user_text:
        return messages, []
    if not force and not needs_web(user_text):
        return messages, []

    hits = duckduckgo_search(user_text, n=5)
    page = ""
    if hits and hits[0].get("url"):
        page = fetch_url(hits[0]["url"])

    block_lines = ["Live web results (fetched just now for this answer):"]
    for i, h in enumerate(hits, 1):
        block_lines.append(f"{i}. {h['title']}\n   {h['url']}\n   {h['snippet']}")
    if page:
        block_lines.append("\nTop-page excerpt:\n" + page)
    block = "\n".join(block_lines)

    sys = {
        "role": "system",
        "content": (
            "You are StickLLM with optional live web lookup. "
            "Use the provided web results when relevant. "
            "Cite URLs briefly. If results are weak, say so. Be concise."
        ),
    }
    rest = [m for m in messages if m.get("role") != "system"]
    # Keep an image message intact. A text-only replacement would drop the picture.
    if rest and rest[-1].get("role") == "user" and _content_has_image(rest[-1].get("content")):
        rest = [{"role": "user", "content": block}] + rest
    else:
        web_note = {"role": "user", "content": block + "\n\nUser question:\n" + user_text}
        if rest and rest[-1].get("role") == "user":
            rest = rest[:-1] + [web_note]
        else:
            rest = rest + [web_note]
    return [sys] + rest, hits


def friendly_llama_error(exc: BaseException) -> str:
    msg = str(exc)
    low = msg.lower()
    if "connection refused" in low or "errno 111" in low:
        return (
            "Model is not ready yet (llama not answering on 127.0.0.1:8080). "
            "Wait for load to finish, or check Models — on CPU-only hosts the first load can take longer."
        )
    if "timed out" in low or "timeout" in low:
        return "Model timed out answering. Try a shorter prompt, or wait and retry."
    if "111" in low or "actively refused" in low:
        return "Model server is down. Open Models to confirm a model is loaded."
    return f"Model error: {msg}"


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(UI_ROOT), **kwargs)

    def log_message(self, fmt: str, *args) -> None:
        import sys

        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def end_headers(self) -> None:
        # Proxied Agent Zero responses keep their own headers. StickLLM's CSP
        # would block that UI's inline startup script.
        if not getattr(self, "_skip_stick_headers", False):
            self.send_header("Content-Security-Policy", CSP)
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            path = urllib.parse.urlparse(self.path).path
            if path.endswith((".js", ".css", ".html")) or path in ("/", ""):
                self.send_header("Cache-Control", "no-store, max-age=0")
                self.send_header("Pragma", "no-cache")
        super().end_headers()

    def _send(self, code: int, body: bytes, ctype: str = "application/json") -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", CSP)
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code: int, obj: dict) -> None:
        self._send(code, json.dumps(obj).encode())

    def _agent_refused(self) -> bool:
        doc, ok = self._auth()
        try:
            allowed = agent_lib().agent_http_allowed(bool(doc.get("require_pair")), ok)
        except Exception:
            allowed = ok or not bool(doc.get("require_pair"))
        if allowed:
            return False
        self._json(
            401,
            {
                "error": "pair_required",
                "message": "Pair this browser using the code on the stick screen.",
            },
        )
        return True

    def _agent_status(self) -> None:
        if self._agent_refused():
            return
        try:
            mod = agent_lib()
            doc = mod.status_document(
                vault_open=vault_unlocked(),
                settings_open=mod.settings_mounted(),
                upstream_up=_agent_port_open(),
                saved=mod.read_status(),
            )
            doc["agent_url"] = self._agent_public_url()
            doc["gateway_port"] = AGENT_TLS_PORT
        except Exception:
            self._json(500, {"ok": False, "error": "agent status failed"})
            return
        self._json(200, doc)

    def _agent_public_url(self) -> str:
        # Console browsers are already on the stick. Open the loopback HTTP UI
        # so they do not handshake the self-signed :5443 certificate. 5099 is
        # published on 127.0.0.1 only. LAN clients keep the paired TLS port.
        if self._is_loopback():
            try:
                port = int(agent_lib().AGENT_PORT)
            except Exception:
                port = 5099
            return f"http://127.0.0.1:{port}/"
        host = (self.headers.get("Host") or "").split(":")[0].strip()
        if not host or host == "0.0.0.0":
            host = discover_lan_ip() or "127.0.0.1"
        return f"https://{host}:{AGENT_TLS_PORT}/"

    def _stickllm_home_url(self) -> str:
        """UI origin for interstitial back links. Never this Agent port."""
        try:
            mod = agent_lib()
        except Exception:
            return "https://127.0.0.1/"
        fallback = discover_lan_ip() or "127.0.0.1"
        return mod.stickllm_home_url(self.headers.get("Host") or "", fallback)

    def _is_agent_server(self) -> bool:
        return bool(getattr(self.server, "stickllm_agent_gateway", False))

    def _agent_install(self) -> None:
        n = int(self.headers.get("Content-Length") or 0)
        if n:
            self.rfile.read(min(n, 1024 * 1024))
        if self._agent_refused():
            return
        if not vault_unlocked():
            self._json(403, {"ok": False, "error": "Unlock vault to use Agent"})
            return
        try:
            subprocess.Popen(
                ["/usr/local/bin/stickllm-agent", "install"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            self._json(500, {"ok": False, "error": "Could not start the installer"})
            return
        if self._is_agent_server():
            try:
                mod = agent_lib()
                page = mod.status_document(
                    vault_open=vault_unlocked(),
                    settings_open=mod.settings_mounted(),
                    upstream_up=_agent_port_open(),
                    saved=mod.read_status(),
                )
                page["state"] = "installing"
                page["message"] = "Installing Agent Zero"
                body = mod.status_html(page, home=self._stickllm_home_url()).encode("utf-8")
            except Exception:
                body = b"Installing Agent Zero\n"
            self._send(200, body, "text/html; charset=utf-8")
            return
        self._json(200, {"ok": True, "message": "Install started. The image is pulled onto the host drive."})

    def _apps_allowed(self) -> bool:
        if not stickllm_ui_client(self.headers) and not self._is_loopback():
            self._json(403, {"ok": False, "error": "ui_only", "message": "Apps are StickLLM UI only."})
            return False
        doc, ok = self._auth()
        if doc.get("require_pair") and not ok:
            self._json(401, {"ok": False, "error": "pair_required"})
            return False
        return True

    def _apps_catalog(self) -> None:
        if not self._apps_allowed():
            return
        try:
            self._json(200, apps_lib().catalog_document())
        except Exception:
            self._json(500, {"ok": False, "error": "apps catalog failed"})

    def _apps_mutate(self, action: str, req: dict) -> None:
        if not self._apps_allowed():
            return
        app_id = str((req or {}).get("id") or "")
        try:
            mod = apps_lib()
            if action == "install":
                result = mod.install_app(app_id)
            else:
                result = mod.uninstall_app(app_id)
        except Exception:
            self._json(
                500,
                {
                    "ok": False,
                    "installed": False,
                    "error": "apps action failed",
                    "message": "Nothing was changed.",
                    "deleted": [],
                },
            )
            return
        self._json(200 if result.get("ok") else 409, result)

    def _desktop_allowed(self) -> bool:
        """Loopback, or a browser that already paired. New tabs send the cookie."""
        doc, ok = self._auth()
        if doc.get("require_pair") and not ok:
            self._json(401, {"ok": False, "error": "pair_required"})
            return False
        return True

    def _serve_desktop(self, path: str) -> None:
        if not self._desktop_allowed():
            return
        parts = [part for part in path.split("/") if part]
        if not parts or parts[0] != "apps" or any(part in {".", ".."} for part in parts):
            self._json(400, {"ok": False, "error": "bad_path"})
            return
        try:
            root = UI_ROOT.resolve()
            target = root.joinpath(*parts).resolve()
        except OSError:
            self._json(404, {"ok": False, "error": "not_found"})
            return
        if target != root and root not in target.parents:
            self._json(400, {"ok": False, "error": "bad_path"})
            return
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            self._json(404, {"ok": False, "error": "not_found", "message": "That app is not on this stick."})
            return
        data = target.read_bytes()
        suffix = target.suffix.lower()
        ctype = {
            ".html": "text/html; charset=utf-8",
            ".js": "text/javascript; charset=utf-8",
            ".css": "text/css; charset=utf-8",
            ".svg": "image/svg+xml",
            ".txt": "text/plain; charset=utf-8",
        }.get(suffix, "application/octet-stream")
        self._send(200, data, ctype)

    def _proxy_files(self, method: str) -> None:
        if not self._desktop_allowed():
            length = int(self.headers.get("Content-Length") or 0)
            if length:
                self.rfile.read(min(length, 1024 * 1024))
            return
        parsed = urllib.parse.urlparse(self.path)
        upstream = parsed.path[len("/api/files") :] or "/"
        if not upstream.startswith("/"):
            upstream = "/" + upstream
        target = upstream + (("?" + parsed.query) if parsed.query else "")
        length = int(self.headers.get("Content-Length") or 0)
        if length > 33 * 1024 * 1024:
            self.close_connection = True
            self._json(413, {"ok": False, "error": "too_large", "message": "That file is over the 32 MB limit."})
            return
        body = self.rfile.read(length) if length else None
        conn = http.client.HTTPConnection("127.0.0.1", FILES_PORT, timeout=120)
        try:
            headers = {"Host": f"127.0.0.1:{FILES_PORT}"}
            if body is not None:
                headers["Content-Length"] = str(len(body))
            ctype = self.headers.get("Content-Type")
            if ctype:
                headers["Content-Type"] = ctype
            conn.request(method, target, body=body, headers=headers)
            resp = conn.getresponse()
            self.send_response(resp.status)
            for key, value in resp.getheaders():
                low = key.lower()
                if low in ("transfer-encoding", "connection", "content-length"):
                    continue
                self.send_header(key, value)
            self.send_header("Cache-Control", "no-store")
            size = resp.getheader("Content-Length")
            if size and size.isdigit():
                self.send_header("Content-Length", size)
                self.end_headers()
                remaining = int(size)
                while remaining > 0:
                    chunk = resp.read(min(65536, remaining))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    remaining -= len(chunk)
            else:
                data = resp.read()
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                if data:
                    self.wfile.write(data)
        except Exception:
            self._json(503, {"ok": False, "error": "files_down", "message": "The file helper is not running."})
        finally:
            conn.close()

    def _system_status(self) -> None:
        if not self._desktop_allowed():
            return
        try:
            self._json(200, system_lib().snapshot())
        except Exception:
            self._json(500, {"ok": False, "error": "system status failed"})

    def _agent_status_doc(self) -> dict:
        mod = agent_lib()
        return mod.status_document(
            vault_open=vault_unlocked(),
            settings_open=mod.settings_mounted(),
            upstream_up=_agent_port_open(),
            saved=mod.read_status(),
        )

    def _serve_agent_gateway(self, method: str) -> None:
        """1:1 proxy to the loopback UI. No path or body rewriting."""
        if self._agent_refused():
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path or "/"
        upgrade = (self.headers.get("Upgrade") or "").lower() == "websocket"
        try:
            mod = agent_lib()
            status = self._agent_status_doc()
        except Exception:
            self._json(500, {"ok": False, "error": "agent helper missing"})
            return
        if method == "POST" and path in ("/install", "/api/agent/install"):
            self._agent_install()
            return
        if not status.get("running"):
            if method == "GET" and not upgrade:
                body = mod.status_html(status, home=self._stickllm_home_url()).encode("utf-8")
                self._send(200, body, "text/html; charset=utf-8")
                return
            self._json(503, {"ok": False, "error": status.get("message") or "Agent is not running"})
            return
        if upgrade and method == "GET":
            self._relay_websocket(path, parsed.query)
            return
        self._relay_http(method, path, parsed.query)

    def _relay_http(self, method: str, upstream: str, query: str) -> None:
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        target = upstream + (("?" + query) if query else "")
        headers = {"Host": "127.0.0.1:5099"}
        for key, value in self.headers.items():
            if key.lower() in ("host", "content-length", "connection", "transfer-encoding"):
                continue
            headers[key] = value
        conn = http.client.HTTPConnection("127.0.0.1", 5099, timeout=300)
        try:
            conn.request(method, target, body=body, headers=headers)
            resp = conn.getresponse()
            data = resp.read()
        except Exception:
            self._json(502, {"ok": False, "error": "Agent is not running"})
            return
        finally:
            conn.close()
        self._skip_stick_headers = True
        self.send_response(resp.status)
        for key, value in resp.getheaders():
            low = key.lower()
            if low in ("transfer-encoding", "connection", "content-length"):
                continue
            self.send_header(key, value)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if method != "HEAD" and data:
            self.wfile.write(data)

    def _relay_websocket(self, upstream: str, query: str) -> None:
        target = upstream + (("?" + query) if query else "")
        try:
            sock = socket.create_connection(("127.0.0.1", 5099), timeout=10)
        except OSError:
            self._json(502, {"ok": False, "error": "Agent is not running"})
            return
        lines = [f"GET {target} HTTP/1.1", "Host: 127.0.0.1:5099"]
        for key, value in self.headers.items():
            if key.lower() in ("host", "content-length"):
                continue
            lines.append(f"{key}: {value}")
        try:
            sock.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("iso-8859-1", errors="replace"))
            header = b""
            while b"\r\n\r\n" not in header and len(header) < 65536:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                header += chunk
            marker = header.find(b"\r\n\r\n")
            if marker < 0:
                sock.close()
                self._json(502, {"ok": False, "error": "Agent did not accept the socket"})
                return
            head = header[: marker + 4]
            rest = header[marker + 4 :]
            self.connection.sendall(head)
            if rest:
                self.connection.sendall(rest)
        except OSError:
            sock.close()
            return
        self.close_connection = True

        def _pump(src, dst) -> None:
            try:
                while True:
                    data = src.recv(65536)
                    if not data:
                        break
                    dst.sendall(data)
            except OSError:
                pass
            try:
                dst.shutdown(socket.SHUT_WR)
            except OSError:
                pass

        left = threading.Thread(target=_pump, args=(self.connection, sock), daemon=True)
        right = threading.Thread(target=_pump, args=(sock, self.connection), daemon=True)
        left.start()
        right.start()
        left.join()
        right.join()
        try:
            sock.close()
        except OSError:
            pass

    def do_HEAD(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("HEAD")
            return
        super().do_HEAD()

    def do_PUT(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("PUT")
            return
        self._json(405, {"error": "method not allowed"})

    def do_DELETE(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("DELETE")
            return
        self._json(405, {"error": "method not allowed"})

    def do_PATCH(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("PATCH")
            return
        self._json(405, {"error": "method not allowed"})

    def do_OPTIONS(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("OPTIONS")
            return
        self._json(405, {"error": "method not allowed"})

    def _is_loopback(self) -> bool:
        host = (self.client_address[0] if self.client_address else "") or ""
        return host in ("127.0.0.1", "::1", "localhost")

    def _may_show_secrets(self) -> bool:
        """Stick screen, or a browser that has already paired with this UI."""
        if self._is_loopback():
            return True
        if not stickllm_ui_client(self.headers):
            return False
        _doc, ok = self._auth()
        return ok

    def _presented_token(self) -> str | None:
        header = self.headers.get("Authorization")
        if header:
            return header
        # Page loads cannot send the localStorage bearer. The UI copies it
        # into this cookie after pairing. An unpaired browser has neither.
        cookie = self.headers.get("Cookie") or ""
        for bit in cookie.split(";"):
            name, _, value = bit.strip().partition("=")
            if name == "stickllm_pair" and value:
                return "Bearer " + urllib.parse.unquote(value.strip())
        return None

    def _auth(self) -> tuple[dict, bool]:
        doc = load_auth()
        if self._is_loopback():
            return doc, True
        ok = token_ok(self._presented_token(), doc)
        return doc, ok

    def _speech_block(self) -> bool:
        """Loopback or StickLLM UI, plus the pair token when require_pair is set."""
        try:
            mod = speech_mod()
        except Exception:
            self._json(500, {"ok": False, "error": "Speech support is not installed."})
            return True
        doc, ok = self._auth()
        denied = mod.speech_denied(
            self._is_loopback(),
            stickllm_ui_client(self.headers),
            bool(doc.get("require_pair")),
            ok,
        )
        if not denied:
            return False
        code, message = denied
        if code == 401:
            self._json(401, {"ok": False, "error": "pair_required", "message": message})
        else:
            self._json(code, {"ok": False, "error": "external_api_removed", "message": message})
        return True

    def do_GET(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("GET")
            return
        path = urllib.parse.urlparse(self.path).path
        if path in ("/health", "/api/health"):
            auth = load_auth()
            # Pair skip is loopback-only; Chat serves LAN with pair.
            local_mode = self._is_loopback()
            if local_mode:
                pair = {"require_pair": False, "paired": True, "local": True}
            else:
                pair = {
                    "require_pair": bool(auth.get("require_pair", True)),
                    "paired": bool(auth.get("paired")),
                }
            llama: dict = {}
            llama_ok = False
            try:
                # Probe llama.cpp /health only (never /v1 — external API surface is killed).
                llama = http_json(LLAMA + "/health", timeout=3)
                st = str(llama.get("status") or "").lower()
                # Require explicit healthy status — empty/missing must not count as ready.
                llama_ok = st in ("ok", "healthy")
                if llama.get("error"):
                    llama_ok = False
            except Exception as e:
                llama = {"status": "down", "error": friendly_llama_error(e)}
            online = uplink_ok()
            backend = detect_backend()
            session_mode = get_session_mode()
            data = {
                "gateway": "ok",
                "web": online,
                "online": online,
                "version": "0.3.2",
                "bind": f"{HOST}:{PORT}",
                "llama": llama,
                "llama_ok": llama_ok,
                "backend": backend,
                "pair": pair,
                "external_api": False,
                "session_mode": session_mode,
                "connect": connect_info(self._may_show_secrets(), llama_ok=llama_ok),
                "llama_load": llama_load_info(),
                "llama_service": llama_unit_state(),
            }
            if path == "/api/health":
                self._json(200, data)
            elif llama_ok:
                data.update(llama if isinstance(llama, dict) else {})
                data["gateway"] = "ok"
                data["pair"] = pair
                self._json(200, data)
            else:
                self._json(503, data)
            return
        if path == "/api/pair/status":
            auth = load_auth()
            # Pair skip is loopback-only; Chat serves LAN with pair.
            local_mode = self._is_loopback()
            if local_mode:
                self._json(
                    200,
                    {
                        "require_pair": False,
                        "paired": True,
                        "local": True,
                        "hint": "On-stick browser — no pair for this screen. LAN clients still pair.",
                        "session_mode": get_session_mode(),
                    },
                )
                return
            self._json(
                200,
                {
                    "require_pair": bool(auth.get("require_pair", True)),
                    "paired": bool(auth.get("paired")),
                    "session_mode": get_session_mode(),
                },
            )
            return
        if path == "/api/session-mode":
            self._json(
                200,
                {
                    "ok": True,
                    "mode": get_session_mode(),
                    "modes": sorted(SESSION_MODES),
                    "default": "ephemeral",
                    "vault_unlocked": vault_unlocked(),
                },
            )
            return
        if path == "/api/chats":
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            self._json(200, list_vault_chats())
            return
        if path.startswith("/api/chats/"):
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            cid = path.rsplit("/", 1)[-1]
            self._json(200, load_vault_chat(cid))
            return
        if path in ("/api/storage", "/api/models/status"):
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            storage = read_json_safe(RUN_DIR / "storage.json") or {
                "mounted": False,
                "note": "USB data not claimed yet",
            }
            probe = read_json_safe(RUN_DIR / "model-probe.json") or {}
            self._json(200, {"version": "0.3", "storage": storage, "probe": probe})
            return
        if path == "/api/speech/power":
            if self._speech_block():
                return
            try:
                on = bool(speech_mod().voice_power_on())
            except Exception:
                on = False
            self._json(200, {"ok": True, "on": on})
            return
        if path == "/api/web/search":
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("q", [""])[0]
            hits = duckduckgo_search(q or "StickLLM", n=5)
            self._json(200, {"results": hits, "online": uplink_ok()})
            return
        if path == "/api/agent/status":
            self._agent_status()
            return
        if path == "/api/apps":
            self._apps_catalog()
            return
        if path == "/api/system":
            self._system_status()
            return
        if path.startswith("/api/files"):
            self._proxy_files("GET")
            return
        if path == "/apps" or path.startswith("/apps/"):
            self._serve_desktop(path)
            return
        return super().do_GET()

    def do_POST(self) -> None:  # noqa: N802
        if self._is_agent_server():
            self._serve_agent_gateway("POST")
            return
        path = urllib.parse.urlparse(self.path).path
        if path.startswith("/api/files"):
            self._proxy_files("POST")
            return
        if path == "/api/agent/install":
            self._agent_install()
            return
        n = int(self.headers.get("Content-Length") or 0)
        # Base64 of a 50 MB file is about 67 MB. Refuse anything larger up front.
        if path == "/api/attachments/convert" and n > 70 * 1024 * 1024:
            self.close_connection = True
            self._json(413, {"ok": False, "error": "That file is over the 50 MB limit."})
            return
        if path == "/api/speech/transcribe" and n > 4 * 1024 * 1024:
            self.close_connection = True
            self._json(413, {"ok": False, "error": "That recording is too long."})
            return
        if path == "/api/speech/speak" and n > 64 * 1024:
            self.close_connection = True
            self._json(413, {"ok": False, "error": "That reply is too long to read aloud."})
            return
        raw = self.rfile.read(n) if n else b"{}"
        try:
            req = json.loads(raw.decode() or "{}")
        except Exception:
            self._json(400, {"error": "bad json"})
            return

        if path in ("/api/apps/install", "/api/apps/uninstall"):
            action = "install" if path.endswith("/install") else "uninstall"
            self._apps_mutate(action, req if isinstance(req, dict) else {})
            return

        if path == "/api/session-mode":
            if not stickllm_ui_client(self.headers):
                self._json(403, {"error": "ui_only", "message": "Session mode is StickLLM UI only."})
                return
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok and not self._is_loopback():
                self._json(401, {"error": "pair_required"})
                return
            result = set_session_mode(str(req.get("mode") or ""))
            code = 200 if result.get("ok") else 400
            self._json(code, result)
            return

        if path == "/api/chats":
            if not stickllm_ui_client(self.headers):
                self._json(403, {"error": "ui_only"})
                return
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            if req.get("delete"):
                result = delete_vault_chat(str(req.get("id") or ""))
                self._json(200 if result.get("ok") else 400, result)
                return
            result = save_vault_chat(
                str(req.get("title") or ""),
                list(req.get("messages") or []),
                str(req.get("id") or "") or None,
            )
            self._json(200 if result.get("ok") else 400, result)
            return

        if path == "/api/pair/remint":
            # StickLLM UI only (stick or LAN). Code itself is never returned over LAN —
            # the stick/kiosk chat announces it via remint_id + pair banner.
            if not stickllm_ui_client(self.headers):
                self._json(
                    403,
                    {
                        "error": "ui_only",
                        "message": "Pair remint is only available from the StickLLM UI.",
                    },
                )
                return
            blocked, reason = remint_rate_blocked()
            if blocked:
                self._json(429, {"error": "rate_limited", "message": reason})
                return
            # Decide before remint. Remint clears the bearer, so a check after
            # it always hides the new digits from the browser that asked.
            show_code = self._may_show_secrets()
            try:
                code, remint_id = remint_pair_code()
            except Exception as e:
                self._json(500, {"error": "remint_failed", "message": str(e)})
                return
            remint_rate_mark()
            body: dict = {
                "ok": True,
                "remint_id": remint_id,
                "message": (
                    "Unpaired LAN browsers and minted a new pair code. "
                    "Read the code on the stick screen chat, then enter it here."
                    if not self._is_loopback()
                    else (
                        "Unpaired LAN browsers and minted a new pair code. "
                        "Enter it on phone/desktop at the LAN URL."
                    )
                ),
            }
            # Plaintext code for this StickLLM UI (stick screen or a paired browser).
            if show_code:
                body["pair_code"] = code
            self._json(200, body)
            return

        if path == "/api/pair":
            blocked, reason = pair_rate_blocked()
            if blocked:
                self._json(429, {"error": "rate_limited", "message": reason})
                return
            code = str(req.get("code") or "").strip().replace(" ", "")
            auth = load_auth()
            if not auth.get("code_hash"):
                self._json(503, {"error": "pairing not initialized — reboot stick"})
                return
            expect = str(auth.get("code_hash") or "")
            got = hashlib.sha256(code.encode()).hexdigest()
            # Accept the code currently shown on the stick even after TTL.
            # TTL only drives remint (stickllm-pair / bootstatus); rejecting a
            # still-displayed matching code caused "expired" while the HDMI code worked.
            if expect and hmac.compare_digest(got, expect):
                pass
            elif code_expired(auth):
                pair_rate_fail()
                self._json(
                    403,
                    {
                        "error": "code_expired",
                        "message": "PAIR CODE expired — wait for a new code on the stick screen.",
                    },
                )
                return
            elif not expect or not hmac.compare_digest(got, expect):
                pair_rate_fail()
                self._json(403, {"error": "bad_code", "message": "Wrong code — check the stick screen."})
                return
            # Mint session token once; never store plaintext on disk (ISS-009).
            token = secrets.token_urlsafe(32)
            auth["token_hash"] = hashlib.sha256(token.encode()).hexdigest()
            auth["paired"] = True
            auth.pop("pending_token", None)
            auth["code_hash"] = hashlib.sha256(secrets.token_bytes(16).hex().encode()).hexdigest()
            auth["paired_at"] = int(time.time())
            try:
                (RUN_DIR / "pair-code.txt").unlink(missing_ok=True)
            except Exception:
                pass
            try:
                (RUN_DIR / "api-key.txt").unlink(missing_ok=True)
            except Exception:
                pass
            save_auth(auth)
            pair_rate_ok()
            self._json(
                200,
                {
                    "ok": True,
                    "token": token,
                    "message": "Paired. This StickLLM browser can chat until reboot.",
                },
            )
            return

        if path == "/api/control":
            doc, ok = self._auth()
            if not ok:
                self._json(401, {"error": "pair_required"})
                return
            action = str(req.get("action") or "")
            params = req.get("params") if isinstance(req.get("params"), dict) else {}
            try:
                timeout = 7200 if action == "model_download" else 180
                data = http_json(
                    CONTROL + "/action",
                    {"action": action, "params": params},
                    timeout=timeout,
                )
                self._json(200, data)
            except urllib.error.HTTPError as e:
                # Forward control JSON (vault_mount, etc.) — never label as "Model error".
                body = e.read()[:4000]
                try:
                    err = json.loads(body.decode() or "{}")
                    if isinstance(err, dict):
                        if not err.get("error"):
                            err["error"] = (
                                err.get("stderr")
                                or err.get("message")
                                or f"Control HTTP {e.code}"
                            )
                        err.setdefault("ok", False)
                        self._json(e.code if e.code >= 400 else 502, err)
                        return
                except Exception:
                    pass
                self._json(
                    e.code if e.code >= 400 else 502,
                    {"ok": False, "error": f"Control error: HTTP {e.code}"},
                )
            except Exception as e:
                self._json(502, {"ok": False, "error": f"Control error: {e}"})
            return

        # ISS-004: external OpenAI-compatible LAN API removed. StickLLM UI only.
        if path == "/v1/chat/completions":
            if not (self._is_loopback() or stickllm_ui_client(self.headers)):
                self._json(
                    410,
                    {
                        "error": "external_api_removed",
                        "message": (
                            "StickLLM no longer exposes an OpenAI-compatible LAN API for third-party clients. "
                            "Use the StickLLM web UI on this stick (pair if prompted)."
                        ),
                    },
                )
                return
            path = "/api/chat"

        if path == "/api/attachments/convert":
            if not (self._is_loopback() or stickllm_ui_client(self.headers)):
                self._json(410, {"ok": False, "error": "external_api_removed", "message": "Use the StickLLM web UI only."})
                return
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"ok": False, "error": "pair_required", "message": "Pair this browser using the code on the stick screen."})
                return
            try:
                payload = base64.b64decode(req.get("data_base64") or "", validate=False)
            except Exception:
                self._json(400, {"ok": False, "error": "Attachment data is not valid."})
                return
            name = str(req.get("name") or "file")
            vision = bool(req.get("vision"))
            result = run_attachment_convert(payload, name, vision)
            if result.get("ok") and get_session_mode() == "vault":
                try:
                    persist_attachment(str(req.get("chat_id") or ""), name, payload, str(result.get("plain") or ""))
                except Exception:
                    pass
            code = 200 if result.get("ok") else 400
            # Never echo the raw upload back. plain text is what the model will see.
            result.pop("plain_bytes", None)
            self._json(code, result)
            return

        if path == "/api/speech/power":
            if self._speech_block():
                return
            try:
                result = speech_mod().set_voice_power(bool(req.get("on")))
            except Exception:
                result = {"ok": False, "on": False, "error": "Voice is not ready."}
            code = 200 if result.get("ok") else 500
            self._json(code, {
                "ok": bool(result.get("ok")),
                "on": bool(result.get("on")),
                "error": result.get("error") or "",
            })
            return

        if path == "/api/speech/transcribe":
            if self._speech_block():
                return
            try:
                audio = base64.b64decode(req.get("audio_base64") or "", validate=False)
            except Exception:
                self._json(400, {"ok": False, "error": "The recording could not be read."})
                return
            result = run_speech("stt", audio)
            log_stt_stats(result)
            if result.get("ok"):
                self._json(200, {"ok": True, "text": str(result.get("text") or "")})
            else:
                self._json(400, {"ok": False, "error": result.get("error") or "Speech recognition failed."})
            return

        if path == "/api/speech/speak":
            if self._speech_block():
                return
            voice = str(req.get("voice") or "Bella")
            body = json.dumps({"text": str(req.get("text") or ""), "voice": voice}).encode("utf-8")
            result = run_speech("tts", body)
            if result.get("ok") and result.get("audio_base64"):
                self._json(200, {"ok": True, "audio_base64": result["audio_base64"], "mime": "audio/wav"})
            else:
                self._json(400, {"ok": False, "error": result.get("error") or "Text to speech failed."})
            return

        if path == "/api/chat/stop":
            if not (self._is_loopback() or stickllm_ui_client(self.headers)):
                self._json(410, {"error": "external_api_removed", "message": "Use the StickLLM web UI only."})
                return
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required", "message": "Pair this browser using the code on the stick screen."})
                return
            stopped = LLAMA_CANCEL.cancel()
            # The cancelled chat closes its llama socket and leaves. Do not
            # start another generation until that handler is gone.
            idle = LLAMA_CANCEL.wait_idle(8)
            self._json(200, {"ok": True, "stopped": bool(stopped or idle)})
            return

        if path != "/api/chat":
            self._json(404, {"error": "not found"})
            return

        if not (self._is_loopback() or stickllm_ui_client(self.headers)):
            self._json(
                410,
                {
                    "error": "external_api_removed",
                    "message": "Use the StickLLM web UI only.",
                },
            )
            return

        doc, ok = self._auth()
        if doc.get("require_pair") and not ok:
            self._json(
                401,
                {
                    "error": "pair_required",
                    "message": "Pair this browser using the code on the stick screen.",
                },
            )
            return

        chat_epoch = LLAMA_CANCEL.enter()
        try:
            self._finish_chat(req, messages_in=req.get("messages") or [], chat_epoch=chat_epoch)
        finally:
            LLAMA_CANCEL.leave()
        return

    def _relay_chat_stream(self, upstream: dict, hits: list, attach_meta: dict, chat_epoch: int) -> None:
        """Stream llama tokens to the browser. Speech is the client's job."""
        opener = urllib.request.build_opener(_TrackHTTPHandler)
        req = urllib.request.Request(
            LLAMA + "/v1/chat/completions",
            data=json.dumps(upstream).encode(),
            headers={"Content-Type": "application/json", "User-Agent": UA},
            method="POST",
        )
        try:
            resp = opener.open(req, timeout=300)
        except urllib.error.HTTPError as e:
            if LLAMA_CANCEL.take_cancelled() or LLAMA_CANCEL.superseded(chat_epoch):
                self._json(200, {"stopped": True, "choices": []})
                return
            body = e.read()[:2000]
            try:
                err = json.loads(body.decode())
                if isinstance(err, dict):
                    err["error"] = friendly_llama_error(Exception(str(err.get("error") or e)))
                    self._json(e.code, err)
                    return
            except Exception:
                pass
            self._json(e.code, {"error": friendly_llama_error(e)})
            return
        except Exception as e:
            if LLAMA_CANCEL.take_cancelled() or LLAMA_CANCEL.superseded(chat_epoch):
                self._json(200, {"stopped": True, "choices": []})
                return
            self._json(502, {"error": friendly_llama_error(e)})
            return

        content_parts: list[str] = []
        reason_parts: list[str] = []
        usage = None
        headers_sent = False
        chunks_closed = False

        def send_raw(payload: bytes) -> None:
            self.wfile.write(payload)
            self.wfile.flush()

        def send_chunk(payload: bytes) -> None:
            # One HTTP chunk per SSE event. Flush past the socket buffer so a
            # browser paint is not held until the reply ends. No gzip.
            send_raw(b"%X\r\n" % len(payload) + payload + b"\r\n")

        def send_obj(obj: dict) -> None:
            send_chunk(b"data: " + json.dumps(obj, ensure_ascii=True).encode("ascii") + b"\n\n")

        def end_chunks() -> None:
            nonlocal chunks_closed
            if not headers_sent or chunks_closed:
                return
            chunks_closed = True
            try:
                send_raw(b"0\r\n\r\n")
            except Exception:
                pass

        try:
            try:
                self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            except OSError:
                pass
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Accel-Buffering", "no")
            self.send_header("Content-Encoding", "identity")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            self.wfile.flush()
            headers_sent = True
            meta: dict = {"stickllm_web": {"used": bool(hits), "results": hits or []}}
            if attach_meta.get("used"):
                meta["stickllm_attachments"] = {
                    "truncated": bool(attach_meta.get("truncated")),
                    "budget_tokens": attach_meta.get("budget_tokens"),
                    "included_tokens": attach_meta.get("included_tokens"),
                    "note": attach_meta.get("note") or "",
                }
            send_obj(meta)
            while True:
                if LLAMA_CANCEL.superseded(chat_epoch):
                    send_obj({
                        "done": True,
                        "stopped": True,
                        "content": "".join(content_parts),
                        "reasoning": "".join(reason_parts),
                    })
                    return
                line = resp.readline()
                if not line:
                    break
                text = line.decode("utf-8", "replace").strip()
                if not text.startswith("data:"):
                    continue
                payload = text[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    ev = json.loads(payload)
                except Exception:
                    continue
                if isinstance(ev.get("usage"), dict):
                    usage = ev["usage"]
                choices = ev.get("choices") or []
                delta = choices[0].get("delta") if choices and isinstance(choices[0], dict) else None
                if not isinstance(delta, dict):
                    delta = {}
                piece = delta.get("content")
                think = delta.get("reasoning_content")
                if think is None:
                    think = delta.get("reasoning")
                if piece:
                    content_parts.append(str(piece))
                    send_obj({"content": str(piece)})
                if think:
                    reason_parts.append(str(think))
                    send_obj({"reasoning": str(think)})
            done = {
                "done": True,
                "stopped": LLAMA_CANCEL.superseded(chat_epoch),
                "content": "".join(content_parts),
                "reasoning": "".join(reason_parts),
            }
            if usage:
                done["usage"] = usage
            send_obj(done)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            return
        except Exception:
            try:
                if headers_sent:
                    send_obj({
                        "done": True,
                        "error": "The model did not answer.",
                        "content": "".join(content_parts),
                        "reasoning": "".join(reason_parts),
                    })
            except Exception:
                pass
        finally:
            end_chunks()
            try:
                resp.close()
            except Exception:
                pass

    def _finish_chat(self, req: dict, messages_in, chat_epoch: int) -> None:
        messages = sanitize_chat_messages(messages_in)
        attach_meta = {"used": False, "truncated": False, "note": ""}
        try:
            mod = convert_mod()
            if messages and sum(
                (m.get("content") or "").count("<attachment ")
                if isinstance(m.get("content"), str)
                else sum(str(p.get("text") or "").count("<attachment ") for p in m.get("content") if isinstance(p, dict))
                if isinstance(m.get("content"), list)
                else 0
                for m in messages
            ) > mod.MAX_FILES:
                self._json(400, {"error": "too_many_files", "message": f"{mod.MAX_FILES} files per message."})
                return
            ctx = active_ctx_size() or 8192
            fitted, attach_meta, budget_err = fit_chat_messages(messages, ctx, llama_token_count)
            if budget_err:
                self._json(400, {"error": "attachment_budget", "message": budget_err})
                return
            messages = fitted
        except Exception:
            raw = json.dumps(messages, default=str)
            if "<attachment " in raw or '"image_url"' in raw:
                self._json(
                    400,
                    {
                        "error": "attachment_budget",
                        "message": "Could not fit the attachment into the context window.",
                    },
                )
                return
            attach_meta = {"used": False, "truncated": False, "note": ""}
        web_mode = req.get("web", "auto")
        if web_mode is True or web_mode == "on":
            force, use = True, True
        elif web_mode is False or web_mode == "off":
            force, use = False, False
        else:
            force, use = False, True

        hits: list[dict] = []
        out_messages = messages
        if use:
            out_messages, hits = augment_with_web(messages, force=force)

        try:
            max_tokens = int(req.get("max_tokens") or 1024)
        except (TypeError, ValueError):
            max_tokens = 1024
        # Room for a Qwen think block plus an answer. Not an unbounded generation.
        if max_tokens < 1:
            max_tokens = 1
        if max_tokens > 4096:
            max_tokens = 4096
        want_stream = req.get("stream") is True
        upstream = {
            "model": req.get("model") or "stickllm",
            "messages": out_messages,
            "temperature": req.get("temperature", 0.7),
            "stream": want_stream,
            "max_tokens": max_tokens,
        }
        think = req.get("chat_template_kwargs")
        if isinstance(think, dict) and "enable_thinking" in think:
            upstream["chat_template_kwargs"] = {"enable_thinking": bool(think.get("enable_thinking"))}
        if LLAMA_CANCEL.superseded(chat_epoch):
            self._json(200, {"stopped": True, "choices": []})
            return
        if not _CHAT_GATE.acquire(blocking=False):
            self._json(409, {"error": "busy", "message": "Still answering. Press Stop first."})
            return
        LLAMA_CANCEL.arm(chat_epoch)
        try:
            try:
                if LLAMA_CANCEL.superseded(chat_epoch):
                    self._json(200, {"stopped": True, "choices": []})
                    return
                if want_stream:
                    self._relay_chat_stream(upstream, hits, attach_meta, chat_epoch)
                    return
                data = http_json_llama(LLAMA + "/v1/chat/completions", upstream, timeout=300)
                if LLAMA_CANCEL.superseded(chat_epoch):
                    self._json(200, {"stopped": True, "choices": []})
                    return
                if hits:
                    data["stickllm_web"] = {"used": True, "results": hits}
                else:
                    data["stickllm_web"] = {"used": False, "results": []}
                if attach_meta.get("used"):
                    data["stickllm_attachments"] = {
                        "truncated": bool(attach_meta.get("truncated")),
                        "budget_tokens": attach_meta.get("budget_tokens"),
                        "included_tokens": attach_meta.get("included_tokens"),
                        "note": attach_meta.get("note") or "",
                    }
                self._json(200, data)
            except urllib.error.HTTPError as e:
                if LLAMA_CANCEL.take_cancelled():
                    self._json(200, {"stopped": True, "choices": []})
                    return
                body = e.read()[:2000]
                try:
                    err = json.loads(body.decode())
                    if isinstance(err, dict):
                        err["error"] = friendly_llama_error(Exception(str(err.get("error") or e)))
                        self._json(e.code, err)
                        return
                except Exception:
                    pass
                self._json(e.code, {"error": friendly_llama_error(e)})
            except Exception as e:
                if LLAMA_CANCEL.take_cancelled():
                    self._json(200, {"stopped": True, "choices": []})
                    return
                self._json(502, {"error": friendly_llama_error(e)})
        finally:
            _CHAT_GATE.release()


class _ReuseHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True


def _tls_ips() -> list[str]:
    """IPv4 addresses to put on the self-signed cert. Loopback always included."""
    found: list[str] = []
    try:
        probed = subprocess.run(
            ["ip", "-4", "-o", "addr", "show"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        for line in (probed.stdout or "").splitlines():
            parts = line.split()
            if "inet" not in parts:
                continue
            addr = parts[parts.index("inet") + 1].split("/", 1)[0]
            if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", addr) and addr not in found:
                found.append(addr)
    except (OSError, subprocess.SubprocessError, IndexError, ValueError):
        found = []
    lan = discover_lan_ip()
    if lan and lan not in found:
        found.append(lan)
    if "127.0.0.1" not in found:
        found.insert(0, "127.0.0.1")
    return found


def _set_tls_enabled(on: bool) -> None:
    """connect_info already switches the banner to https when this file exists."""
    flag = RUN_DIR / "tls.enabled"
    try:
        if on:
            RUN_DIR.mkdir(parents=True, exist_ok=True)
            flag.write_text("1\n", encoding="utf-8")
        elif flag.is_file():
            flag.unlink()
    except OSError:
        pass


def _ensure_tls_cert(ips: list[str]) -> tuple[Path, Path]:
    """Self-signed server cert in /run (regenerated when addresses change)."""
    tls_dir = RUN_DIR / "tls"
    cert = tls_dir / "cert.pem"
    key = tls_dir / "key.pem"
    stamp = tls_dir / "sans.txt"
    want = ",".join(ips)
    if cert.is_file() and key.is_file() and read_text_safe(stamp).strip() == want:
        return cert, key
    if not shutil.which("openssl"):
        raise RuntimeError("openssl is not installed")
    tls_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(tls_dir, 0o700)
    san = ",".join(["DNS:localhost"] + [f"IP:{ip}" for ip in ips])
    cnf = tls_dir / "openssl.cnf"
    cnf.write_text(
        "[req]\n"
        "distinguished_name=dn\n"
        "x509_extensions=v3_req\n"
        "prompt=no\n"
        "[dn]\n"
        "CN=stickllm\n"
        "[v3_req]\n"
        "basicConstraints=CA:FALSE\n"
        "keyUsage=digitalSignature,keyEncipherment\n"
        "extendedKeyUsage=serverAuth\n"
        f"subjectAltName={san}\n",
        encoding="utf-8",
    )
    proc = subprocess.run(
        [
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "30",
            "-config", str(cnf), "-extensions", "v3_req",
        ],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if proc.returncode != 0 or not cert.is_file() or not key.is_file():
        for path in (cert, key):
            try:
                path.unlink()
            except OSError:
                pass
        err = (proc.stderr or proc.stdout or "openssl failed").strip().splitlines()
        raise RuntimeError(err[-1] if err else "openssl failed")
    os.chmod(key, 0o600)
    os.chmod(cert, 0o644)
    stamp.write_text(want + "\n", encoding="utf-8")
    return cert, key


def start_tls_server() -> int | None:
    """Serve the same UI and /api/speech/* on HTTPS. Leave HTTP :80 alone."""
    httpd = None
    try:
        ips = _tls_ips()
        cert, key = _ensure_tls_cert(ips)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(certfile=str(cert), keyfile=str(key))
        httpd = _ReuseHTTPServer((HOST, TLS_PORT), Handler)
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        threading.Thread(target=httpd.serve_forever, name="stickllm-tls", daemon=True).start()
        _set_tls_enabled(True)
        lan = discover_lan_ip() or next((ip for ip in ips if not ip.startswith("127.")), "")
        shown = f"https://{lan}/" if lan else f"https://127.0.0.1:{TLS_PORT}/"
        print(f"stickllm-gateway TLS on {shown}", flush=True)
        return TLS_PORT
    except Exception as exc:
        if httpd is not None:
            try:
                httpd.server_close()
            except Exception:
                pass
        _set_tls_enabled(False)
        print(f"stickllm-gateway TLS off ({exc})", flush=True)
        return None


def start_agent_tls_server() -> int | None:
    """Paired TLS proxy for Agent Zero. Does not publish 5099 on the LAN."""
    httpd = None
    try:
        ips = _tls_ips()
        cert, key = _ensure_tls_cert(ips)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(certfile=str(cert), keyfile=str(key))
        httpd = _ReuseHTTPServer((HOST, AGENT_TLS_PORT), Handler)
        httpd.stickllm_agent_gateway = True
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        threading.Thread(target=httpd.serve_forever, name="stickllm-agent-tls", daemon=True).start()
        lan = discover_lan_ip() or next((ip for ip in ips if not ip.startswith("127.")), "")
        shown = f"https://{lan}:{AGENT_TLS_PORT}/" if lan else f"https://127.0.0.1:{AGENT_TLS_PORT}/"
        print(f"stickllm-gateway agent TLS on {shown}", flush=True)
        return AGENT_TLS_PORT
    except Exception as exc:
        if httpd is not None:
            try:
                httpd.server_close()
            except Exception:
                pass
        print(f"stickllm-gateway agent TLS off ({exc})", flush=True)
        return None


def main() -> int:
    os.chdir(UI_ROOT)
    try:
        speech_mod().reconcile_voice_power()
    except Exception:
        pass
    start_tls_server()
    start_agent_tls_server()
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"stickllm-gateway on http://{HOST}:{PORT} → {LLAMA} control={CONTROL}", flush=True)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
