#!/bin/bash
# Start Agent Zero only after the server vault is mounted.
# The image is pulled onto the mounted host SSD, next to models. It is not
# part of the ISO and it is not stored in the vault.
# Do not print API keys, vault passcodes, or chat text.
set -euo pipefail

PYBIN="$(command -v python3 || command -v python || true)"
LIB="/usr/local/lib/stickllm_agent.py"
VAULT="${STICKLLM_VAULT_MNT:-/var/lib/stickllm/vault}"
ADDON="${VAULT}/addons/agent-zero"
SOCK="/run/stickllm/agent-docker.sock"
PIDFILE="/run/stickllm/agent-dockerd.pid"
RELAY_PIDFILE="/run/stickllm/agent-llama-relay.pid"
APPS_PIDFILE="/run/stickllm/agent-apps-bridge.pid"
OPEN_APP_PIDFILE="/run/stickllm/agent-open-app.pid"
PULL_LOG="/run/stickllm/agent-pull.log"
CONTAINER="stickllm-agent-zero"
NETWORK="stickllm-agent"
ENTRY="/usr/local/bin/stickllm-agent-entrypoint"
DOCKER_DIR=""

if [[ -z "${PYBIN}" || ! -f "$LIB" ]]; then
  echo "stickllm-agent: python helper missing" >&2
  exit 1
fi

docker_cli() {
  DOCKER_HOST="unix://${SOCK}" docker "$@"
}

refuse_locked() {
  "$PYBIN" "$LIB" write-status --state locked --image_present false >/dev/null || true
  echo "vault locked: docker not started" >&2
}

resolve_docker_dir() {
  local dir
  if ! dir="$("$PYBIN" "$LIB" docker-dir)"; then
    "$PYBIN" "$LIB" write-status --state no_ssd --image_present false --low_space false >/dev/null || true
    echo "Mount a drive for Agent Zero" >&2
    return 1
  fi
  DOCKER_DIR="$dir"
  mkdir -p "$DOCKER_DIR"
}

cmd_gate() {
  if "$PYBIN" "$LIB" docker-may-start; then
    exit 0
  fi
  refuse_locked
  exit 2
}

ensure_dockerd() {
  # Gate again immediately before the daemon. A locked vault never reaches dockerd.
  if ! "$PYBIN" "$LIB" docker-may-start; then
    refuse_locked
    exit 0
  fi
  if [[ -z "${DOCKER_DIR}" ]]; then
    echo "Mount a drive for Agent Zero" >&2
    exit 0
  fi
  "$PYBIN" "$LIB" prepare-vault
  mkdir -p /run/stickllm "$DOCKER_DIR"
  if [[ -S "$SOCK" ]] && docker_cli info >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v dockerd >/dev/null 2>&1; then
    echo "stickllm-agent: dockerd is not installed" >&2
    exit 1
  fi
  # data-root is the host SSD folder. iptables stay off; nftables rules are ours.
  # This dockerd is not the docker.service unit, so journalctl -u docker stays
  # empty. Keep its stdout on the stickllm runtime log instead.
  mkdir -p /run/stickllm
  dockerd \
    --data-root "${DOCKER_DIR}" \
    --host "unix://${SOCK}" \
    --pidfile "$PIDFILE" \
    --iptables=false \
    --ip6tables=false \
    --live-restore=false \
    >>/run/stickllm/agent-dockerd.log 2>&1 &
  local i
  for i in $(seq 1 60); do
    if docker_cli info >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  echo "stickllm-agent: dockerd did not become ready" >&2
  exit 1
}

image_present() {
  local ref
  ref="$("$PYBIN" "$LIB" image-ref)"
  docker_cli image inspect "$ref" >/dev/null 2>&1
}

ensure_network() {
  local sub
  if docker_cli network inspect "$NETWORK" >/dev/null 2>&1; then
    sub="$(docker_cli network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$NETWORK" 2>/dev/null || true)"
    if [[ "$sub" == "172.30.0.0/24" ]]; then
      return 0
    fi
    docker_cli network rm "$NETWORK" >/dev/null 2>&1 || true
  fi
  docker_cli network create \
    --driver bridge \
    --subnet 172.30.0.0/24 \
    --gateway 172.30.0.1 \
    -o com.docker.network.bridge.name=stickllm-a0 \
    "$NETWORK" >/dev/null
}

stop_relay() {
  if [[ -f "$RELAY_PIDFILE" ]]; then
    local pid
    pid="$(tr -cd '0-9' <"$RELAY_PIDFILE" || true)"
    if [[ -n "${pid}" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$RELAY_PIDFILE"
  fi
}

stop_apps() {
  if [[ -f "$APPS_PIDFILE" ]]; then
    local pid
    pid="$(tr -cd '0-9' <"$APPS_PIDFILE" || true)"
    if [[ -n "${pid}" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$APPS_PIDFILE"
  fi
}

stop_open_app() {
  if [[ -f "$OPEN_APP_PIDFILE" ]]; then
    local pid
    pid="$(tr -cd '0-9' <"$OPEN_APP_PIDFILE" || true)"
    if [[ -n "${pid}" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$OPEN_APP_PIDFILE"
  fi
}

ensure_relay() {
  # Bridge address only. llama-server stays on 127.0.0.1:8080.
  local i
  for i in $(seq 1 25); do
    local pid=""
    if [[ -f "$RELAY_PIDFILE" ]]; then
      pid="$(tr -cd '0-9' <"$RELAY_PIDFILE" || true)"
    fi
    if [[ -z "${pid}" ]] || ! kill -0 "$pid" >/dev/null 2>&1; then
      "$PYBIN" "$LIB" llama-relay >/var/log/stickllm-agent-relay.log 2>&1 &
      echo $! >"$RELAY_PIDFILE"
    fi
    if "$PYBIN" - <<'PY'
import socket
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("172.30.0.1", 8080))
except OSError:
    raise SystemExit(1)
finally:
    s.close()
PY
    then
      return 0
    fi
    sleep 0.2
  done
  echo "stickllm-agent: llama relay did not bind 172.30.0.1:8080" >&2
  "$PYBIN" "$LIB" write-status --state error --image_present true --message "llama relay did not bind 172.30.0.1:8080" >/dev/null || true
  return 1
}

ensure_apps() {
  # Static ui/apps only, on the bridge address. Not 0.0.0.0 and not the LAN.
  local i
  for i in $(seq 1 25); do
    local pid=""
    if [[ -f "$APPS_PIDFILE" ]]; then
      pid="$(tr -cd '0-9' <"$APPS_PIDFILE" || true)"
    fi
    if [[ -z "${pid}" ]] || ! kill -0 "$pid" >/dev/null 2>&1; then
      "$PYBIN" "$LIB" apps-bridge >/var/log/stickllm-agent-apps.log 2>&1 &
      echo $! >"$APPS_PIDFILE"
    fi
    if "$PYBIN" - <<'PY'
import socket
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("172.30.0.1", 8081))
except OSError:
    raise SystemExit(1)
finally:
    s.close()
PY
    then
      return 0
    fi
    sleep 0.2
  done
  echo "stickllm-agent: apps bridge did not bind 172.30.0.1:8081" >&2
  "$PYBIN" "$LIB" write-status --state error --image_present true --message "apps bridge did not bind 172.30.0.1:8081" >/dev/null || true
  return 1
}

ensure_open_app() {
  # Control port on the bridge and on loopback. Not 0.0.0.0 and not the LAN.
  "$PYBIN" "$LIB" ensure-open-app-token >/dev/null
  local i
  for i in $(seq 1 25); do
    local pid=""
    if [[ -f "$OPEN_APP_PIDFILE" ]]; then
      pid="$(tr -cd '0-9' <"$OPEN_APP_PIDFILE" || true)"
    fi
    if [[ -z "${pid}" ]] || ! kill -0 "$pid" >/dev/null 2>&1; then
      "$PYBIN" "$LIB" open-app-bridge >/var/log/stickllm-agent-open-app.log 2>&1 &
      echo $! >"$OPEN_APP_PIDFILE"
    fi
    if "$PYBIN" - <<'PY'
import socket
s = socket.socket()
s.settimeout(0.2)
try:
    s.connect(("172.30.0.1", 8082))
except OSError:
    raise SystemExit(1)
finally:
    s.close()
PY
    then
      return 0
    fi
    sleep 0.2
  done
  echo "stickllm-agent: open app control did not bind 172.30.0.1:8082" >&2
  "$PYBIN" "$LIB" write-status --state error --image_present true --message "open app control did not bind 172.30.0.1:8082" >/dev/null || true
  return 1
}

cache_embedding() {
  # MiniLM is the Agent Zero memory embedder. Cache it before the container
  # is marked offline, so the first question cannot block on Hugging Face.
  if "$PYBIN" "$LIB" embedding-cached; then
    return 0
  fi
  if ! image_present; then
    return 1
  fi
  local ref
  ref="$("$PYBIN" "$LIB" image-ref)"
  mkdir -p "${ADDON}/state/.cache"
  docker_cli run --rm \
    --network "$NETWORK" \
    -e HF_HUB_OFFLINE=0 \
    -e HF_HUB_DISABLE_TELEMETRY=1 \
    -e HF_HOME=/a0/usr/.cache/huggingface \
    -e SENTENCE_TRANSFORMERS_HOME=/a0/usr/.cache/sentence-transformers \
    -v "${ADDON}/state:/a0/usr" \
    --entrypoint /opt/venv-a0/bin/python3 \
    "$ref" -c 'from sentence_transformers import SentenceTransformer; SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2", device="cpu")'
}

ensure_nft() {
  local err
  err="$("$PYBIN" "$LIB" nft-apply 2>&1)" || {
    printf '%s\n' "stickllm-agent: nftables rules were not installed" "$err" >&2
    if [[ -z "${err//[[:space:]]/}" ]]; then
      err="nftables rules were not installed"
    fi
    # image_present stays true so the Agent tile remains and shows this
    # instead of "Agent is starting" while systemd restarts the unit.
    "$PYBIN" "$LIB" write-status --state error --image_present true --message "$err" >/dev/null || true
    exit 1
  }
}

cmd_install() {
  if ! "$PYBIN" "$LIB" docker-may-start; then
    refuse_locked
    exit 0
  fi
  mkdir -p /run/stickllm
  exec 9>/run/stickllm/agent-install.lock
  if ! flock -n 9; then
    echo "install already running" >&2
    exit 0
  fi
  if ! resolve_docker_dir; then
    exit 0
  fi
  if ! "$PYBIN" "$LIB" pull-allowed >/dev/null; then
    "$PYBIN" "$LIB" write-status --state low_space --low_space true --image_present false >/dev/null || true
    echo "host SSD has under 12 GB free: image pull stopped" >&2
    exit 0
  fi
  ensure_dockerd
  local ref
  ref="$("$PYBIN" "$LIB" image-ref)"
  mkdir -p /run/stickllm
  : >"$PULL_LOG"
  "$PYBIN" "$LIB" write-status --state installing --image_present false --low_space false >/dev/null || true
  if image_present; then
    echo "image already present" | tee -a "$PULL_LOG"
  else
    if ! docker_cli pull "$ref" 2>&1 | tee -a "$PULL_LOG"; then
      "$PYBIN" "$LIB" write-status --state pull_failed --image_present false --low_space false >/dev/null || true
      echo "agent image pull failed" >&2
      exit 1
    fi
  fi
  "$PYBIN" "$LIB" write-status --state pulled --image_present true --low_space false >/dev/null || true
  cmd_run_container
}

stop_container() {
  if [[ -S "$SOCK" ]]; then
    docker_cli rm -f "$CONTAINER" >/dev/null 2>&1 || true
  fi
}

cmd_run_container() {
  if ! "$PYBIN" "$LIB" docker-may-start; then
    refuse_locked
    exit 0
  fi
  # Secrets live on the encrypted settings partition. Do not start without it.
  if ! "$PYBIN" "$LIB" settings-mounted; then
    "$PYBIN" "$LIB" write-status --state settings_missing --image_present false >/dev/null || true
    echo "USB settings partition is not mounted: agent not started" >&2
    exit 0
  fi
  if ! resolve_docker_dir; then
    exit 0
  fi
  ensure_dockerd
  if ! image_present; then
    "$PYBIN" "$LIB" write-status --state needs_install --image_present false --low_space false >/dev/null || true
    echo "agent image is not installed" >&2
    exit 0
  fi
  "$PYBIN" "$LIB" prepare-portable
  ensure_network
  STICKLLM_HF_OFFLINE=0
  if "$PYBIN" "$LIB" embedding-cached || cache_embedding; then
    STICKLLM_HF_OFFLINE=1
  fi
  export STICKLLM_HF_OFFLINE
  ensure_nft
  ensure_relay
  ensure_apps
  ensure_open_app
  local ref origins
  ref="$("$PYBIN" "$LIB" image-ref)"
  origins="$("$PYBIN" "$LIB" allowed-origins)"
  "$PYBIN" "$LIB" write-status --state running --image_present true --low_space false >/dev/null || true
  stop_container
  # Own bridge: llama relay and the internet only. UI is published on loopback.
  # Kokoro and Whisper stay at the image defaults. No host disks except the
  # vault addon and the portable settings dir.
  docker_cli run --name "$CONTAINER" \
    --network "$NETWORK" \
    --add-host llama:host-gateway \
    --dns 1.1.1.1 \
    --dns 9.9.9.9 \
    -p 127.0.0.1:5099:5099 \
    --cap-drop ALL \
    --cap-add CHOWN \
    --cap-add DAC_OVERRIDE \
    --cap-add FOWNER \
    --cap-add SETUID \
    --cap-add SETGID \
    --cap-add KILL \
    --security-opt no-new-privileges=true \
    --pids-limit 1024 \
    -e NVIDIA_VISIBLE_DEVICES=void \
    -e CUDA_VISIBLE_DEVICES= \
    -e "ALLOWED_ORIGINS=${origins}" \
    -e HF_HOME=/a0/usr/.cache/huggingface \
    -e SENTENCE_TRANSFORMERS_HOME=/a0/usr/.cache/sentence-transformers \
    -e HF_HUB_DISABLE_TELEMETRY=1 \
    -e HF_HUB_OFFLINE="${STICKLLM_HF_OFFLINE:-0}" \
    -e TRANSFORMERS_OFFLINE="${STICKLLM_HF_OFFLINE:-0}" \
    -e HF_DATASETS_OFFLINE="${STICKLLM_HF_OFFLINE:-0}" \
    -e A0_SET_update_check_enabled=false \
    -e A0_SET_rfc_auto_docker=false \
    -e A0_SET_a2a_server_enabled=false \
    -e A0_SET_mcp_server_enabled=false \
    -e A0_SET_workdir_path=/a0/usr/workdir \
    --tmpfs /tmp:rw,nosuid,nodev,size=256m \
    -v "${ADDON}/state:/a0/usr" \
    -v "${ADDON}/work:/a0/usr/workdir" \
    -v "${ADDON}/memory:/a0/usr/memory" \
    -v "${ADDON}/logs:/a0/usr/logs" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/.env:/a0/usr/.env" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/settings.json:/a0/usr/settings.json" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/prompts:/a0/usr/prompts" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/instruments:/a0/usr/instruments" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/skills:/a0/usr/skills" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/model-config:/a0/usr/plugins/_model_config" \
    -v "${STICKLLM_SETTINGS_MNT:-/mnt/stickllm-settings}/agent-zero/open-app.token:/stickllm-open-app.token:ro" \
    -v "${ENTRY}:/stickllm-entrypoint.sh:ro" \
    --entrypoint /bin/bash \
    "$ref" \
    /stickllm-entrypoint.sh
}

cmd_run() {
  if ! "$PYBIN" "$LIB" docker-may-start; then
    refuse_locked
    exit 0
  fi
  # Unlock starts a container that is already installed. It does not pull.
  cmd_run_container
}

cmd_stop() {
  stop_container || true
  stop_relay || true
  stop_apps || true
  stop_open_app || true
  "$PYBIN" "$LIB" nft-delete >/dev/null 2>&1 || true
  if [[ -f "$PIDFILE" ]]; then
    local pid
    pid="$(tr -cd '0-9' <"$PIDFILE" || true)"
    if [[ -n "${pid}" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$PIDFILE"
  fi
  if [[ -S "$SOCK" ]]; then
    rm -f "$SOCK" || true
  fi
  "$PYBIN" "$LIB" write-status --state stopped >/dev/null || true
}

cmd_start() {
  if ! "$PYBIN" "$LIB" docker-may-start; then
    refuse_locked
    exit 0
  fi
  if [[ -z "${STICKLLM_AGENT_NO_SYSTEMD:-}" ]] && command -v systemctl >/dev/null 2>&1; then
    systemctl start stickllm-agent.service
    exit 0
  fi
  cmd_run
}

usage() {
  echo "usage: stickllm-agent {gate|start|run|stop|install}" >&2
  exit 1
}

case "${1:-}" in
  gate) cmd_gate ;;
  start) cmd_start ;;
  run) cmd_run ;;
  stop) cmd_stop ;;
  install) cmd_install ;;
  *) usage ;;
esac
