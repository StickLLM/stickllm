#!/bin/bash
# SSH-iterate helper: install overlay scripts/units from /tmp/stickllm-hotfix/, then restart.
# Intended: scp files into /tmp/stickllm-hotfix/... then: sudo stickllm-hotfix [unit...]
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run as root: sudo stickllm-hotfix" >&2
  exit 1
fi

SRC="${STICKLLM_HOTFIX_SRC:-/tmp/stickllm-hotfix}"
if [[ ! -d "$SRC" ]]; then
  echo "Missing $SRC — copy overlay paths under it first." >&2
  exit 1
fi

installed=0
if [[ -d "$SRC/usr/local/bin" ]]; then
  shopt -s nullglob
  for f in "$SRC/usr/local/bin"/stickllm-*; do
    [[ -f "$f" ]] || continue
    # Normalize CRLF from Windows scp.
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 755 "$f" "/usr/local/bin/$(basename "$f")"
    echo "installed /usr/local/bin/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
fi

if [[ -d "$SRC/usr/local/lib" ]]; then
  mkdir -p /usr/local/lib
  shopt -s nullglob
  for f in "$SRC/usr/local/lib"/stickllm_*.py; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/usr/local/lib/$(basename "$f")"
    echo "installed /usr/local/lib/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
fi

# StickLink Python package (Method C peer + libs).
if [[ -d "$SRC/usr/local/lib/sticklink" ]]; then
  mkdir -p /usr/local/lib/sticklink
  shopt -s nullglob
  for f in "$SRC/usr/local/lib/sticklink"/*.py; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/usr/local/lib/sticklink/$(basename "$f")"
    echo "installed /usr/local/lib/sticklink/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
fi

# ELF binary. Do not run sed on it: stripping CR would corrupt the file.
if [[ -f "$SRC/usr/local/bin/whisper-server" ]]; then
  install -m 755 "$SRC/usr/local/bin/whisper-server" /usr/local/bin/whisper-server
  echo "installed /usr/local/bin/whisper-server"
  installed=1
fi

units_changed=0
if [[ -d "$SRC/etc/systemd/system" ]]; then
  shopt -s nullglob
  for f in "$SRC/etc/systemd/system"/stickllm-*.service; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/etc/systemd/system/$(basename "$f")"
    echo "installed /etc/systemd/system/$(basename "$f")"
    units_changed=1
    installed=1
  done
  shopt -u nullglob
fi

# systemd EnvironmentFile= drops any line it cannot parse, and a UTF-8 BOM makes
# the first assignment unparseable — strip it along with CRLF.
if [[ -d "$SRC/etc/stickllm" ]]; then
  install -d -m 755 /etc/stickllm
  shopt -s nullglob
  for f in "$SRC/etc/stickllm"/*.env; do
    [[ -f "$f" ]] || continue
    sed -i '1s/^\xEF\xBB\xBF//; s/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/etc/stickllm/$(basename "$f")"
    echo "installed /etc/stickllm/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
fi

# Pinned model catalog (HF allow-list + hashes). Lab hotfix path for Models page.
if [[ -f "$SRC/etc/stickllm/models/catalog.toml" ]]; then
  install -d -m 755 /etc/stickllm/models
  sed -i '1s/^\xEF\xBB\xBF//; s/\r$//' "$SRC/etc/stickllm/models/catalog.toml" 2>/dev/null || true
  install -m 644 "$SRC/etc/stickllm/models/catalog.toml" /etc/stickllm/models/catalog.toml
  echo "installed /etc/stickllm/models/catalog.toml"
  installed=1
fi

if [[ -f "$SRC/etc/sudoers.d/stickllm" ]]; then
  sed -i 's/\r$//' "$SRC/etc/sudoers.d/stickllm" 2>/dev/null || true
  install -m 440 "$SRC/etc/sudoers.d/stickllm" /etc/sudoers.d/stickllm
  if visudo -cf /etc/sudoers.d/stickllm >/dev/null 2>&1; then
    echo "installed /etc/sudoers.d/stickllm"
    installed=1
  else
    echo "WARNING: sudoers.d/stickllm failed visudo -cf; left previous file" >&2
  fi
fi

# NetworkManager profiles / drop-ins (ethernet DHCP retries, etc.).
if [[ -d "$SRC/etc/NetworkManager/system-connections" ]]; then
  install -d -m 755 /etc/NetworkManager/system-connections
  shopt -s nullglob
  for f in "$SRC/etc/NetworkManager/system-connections"/*.nmconnection; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 600 "$f" "/etc/NetworkManager/system-connections/$(basename "$f")"
    echo "installed /etc/NetworkManager/system-connections/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
  nmcli connection reload >/dev/null 2>&1 || true
fi
if [[ -d "$SRC/etc/systemd/system/NetworkManager.service.d" ]]; then
  install -d -m 755 /etc/systemd/system/NetworkManager.service.d
  shopt -s nullglob
  for f in "$SRC/etc/systemd/system/NetworkManager.service.d"/*.conf; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/etc/systemd/system/NetworkManager.service.d/$(basename "$f")"
    echo "installed /etc/systemd/system/NetworkManager.service.d/$(basename "$f")"
    units_changed=1
    installed=1
  done
  shopt -u nullglob
fi
# NTP: systemd-timesyncd drop-ins (network-online wait after Wi-Fi).
if [[ -d "$SRC/etc/systemd/system/systemd-timesyncd.service.d" ]]; then
  install -d -m 755 /etc/systemd/system/systemd-timesyncd.service.d
  shopt -s nullglob
  for f in "$SRC/etc/systemd/system/systemd-timesyncd.service.d"/*.conf; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/etc/systemd/system/systemd-timesyncd.service.d/$(basename "$f")"
    echo "installed /etc/systemd/system/systemd-timesyncd.service.d/$(basename "$f")"
    units_changed=1
    installed=1
  done
  shopt -u nullglob
fi

# Chromium enterprise policies (tabs, downloads, media auto-grant, proxy/web-mode).
if [[ -d "$SRC/etc/chromium/policies/managed" ]]; then
  mkdir -p /etc/chromium/policies/managed /etc/chromium-browser/policies/managed
  shopt -s nullglob
  for f in "$SRC/etc/chromium/policies/managed"/stickllm-*.json; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    base="$(basename "$f")"
    install -m 644 "$f" "/etc/chromium/policies/managed/$base"
    install -m 644 "$f" "/etc/chromium-browser/policies/managed/$base"
    echo "installed /etc/chromium/policies/managed/$base"
    installed=1
  done
  shopt -u nullglob
fi

# CUDA/Vulkan/CPU llama-server + shared libs (lab hotfix; backs up previous tree).
if [[ -d "$SRC/opt/stickllm/bin" ]] || [[ -d "$SRC/opt/stickllm/lib" ]]; then
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  bak="/var/lib/stickllm/llama-bak-$ts"
  mkdir -p "$bak"
  if [[ -d /opt/stickllm/bin ]]; then
    cp -a /opt/stickllm/bin "$bak/bin" 2>/dev/null || true
  fi
  if [[ -d /opt/stickllm/lib ]]; then
    cp -a /opt/stickllm/lib "$bak/lib" 2>/dev/null || true
  fi
  echo "backed up previous llama tree → $bak"
  if [[ -d "$SRC/opt/stickllm/bin" ]]; then
    mkdir -p /opt/stickllm/bin
    shopt -s nullglob
    for f in "$SRC/opt/stickllm/bin"/llama-server*; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      rm -f "/opt/stickllm/bin/$base"
      install -m 755 "$f" "/opt/stickllm/bin/$base"
      echo "installed /opt/stickllm/bin/$base"
      installed=1
    done
    shopt -u nullglob
  fi
  if [[ -d "$SRC/opt/stickllm/lib" ]]; then
    mkdir -p /opt/stickllm/lib
    # Drop stale StickLLM sonames (e.g. libggml-cpu.so.0.29.0) that shadow the
    # upstream CUDA tree and cause "no CPU backend found" on load.
    echo "purge stale ggml/llama sonames in /opt/stickllm/lib"
    shopt -s nullglob
    for stale in /opt/stickllm/lib/libggml*.so.0* \
                 /opt/stickllm/lib/libllama*.so.0* \
                 /opt/stickllm/lib/libmtmd*.so.0* \
                 /opt/stickllm/lib/libllama-server-impl.so \
                 /opt/stickllm/lib/libggml-cpu.so \
                 /opt/stickllm/lib/libggml-base.so \
                 /opt/stickllm/lib/libggml.so \
                 /opt/stickllm/lib/libllama.so \
                 /opt/stickllm/lib/libmtmd.so \
                 /opt/stickllm/lib/libllama-common.so; do
      [[ -e "$stale" || -L "$stale" ]] || continue
      rm -f "$stale"
      echo "purged $stale"
    done
    shopt -u nullglob
    # Replace shipped llama/ggml/mtmd/cuda runtime objects; keep unrelated files.
    shopt -s nullglob
    for f in "$SRC/opt/stickllm/lib"/*; do
      [[ -e "$f" ]] || continue
      base="$(basename "$f")"
      case "$base" in
        libggml*|libllama*|libmtmd*|libcudart*|libcublas*|libcublasLt*|libnccl*|stickllm-cuda-register.*)
          rm -f "/opt/stickllm/lib/$base"
          cp -a "$f" "/opt/stickllm/lib/$base"
          # Symlinks keep mode from source; regular files need +x for .so
          if [[ -f "/opt/stickllm/lib/$base" && ! -L "/opt/stickllm/lib/$base" ]]; then
            chmod 755 "/opt/stickllm/lib/$base" 2>/dev/null || true
          fi
          echo "installed /opt/stickllm/lib/$base"
          installed=1
          ;;
        *)
          echo "skipping non-llama lib: $base" >&2
          ;;
      esac
    done
    shopt -u nullglob
    # Upstream CUDA builds ship arch-specific libggml-cpu-*.so but no default
    # libggml-cpu.so; without it llama-server fails: "no CPU backend found".
    if [[ ! -e /opt/stickllm/lib/libggml-cpu.so ]]; then
      for cand in libggml-cpu-x64.so libggml-cpu-haswell.so libggml-cpu-zen4.so libggml-cpu-sse42.so; do
        if [[ -f "/opt/stickllm/lib/$cand" ]]; then
          ln -sfn "$cand" /opt/stickllm/lib/libggml-cpu.so
          echo "linked /opt/stickllm/lib/libggml-cpu.so -> $cand"
          installed=1
          break
        fi
      done
    fi
    # b12617 ships lib*.so.1.0.0 without SONAME symlinks; without .so.1 the CUDA
    # llama-server fails to load and pick-gpus falls back to Vulkan.
    link_soname() {
      local ver="$1" link="$2"
      if [[ -f "/opt/stickllm/lib/$ver" ]]; then
        ln -sfn "$ver" "/opt/stickllm/lib/$link"
        echo "linked /opt/stickllm/lib/$link -> $ver"
        installed=1
      fi
    }
    link_soname libllama.so.1.0.0 libllama.so.1
    link_soname libllama-common.so.1.0.0 libllama-common.so.1
    link_soname libggml.so.1.0.0 libggml.so.1
    link_soname libggml-base.so.1.0.0 libggml-base.so.1
    link_soname libmtmd.so.1.0.0 libmtmd.so.1
    link_soname libllama.so.1.0.0 libllama.so
    link_soname libllama-common.so.1.0.0 libllama-common.so
    link_soname libggml.so.1.0.0 libggml.so
    link_soname libggml-base.so.1.0.0 libggml-base.so
    link_soname libmtmd.so.1.0.0 libmtmd.so
  fi
fi

if [[ -d "$SRC/opt/stickllm/ui" ]]; then
  mkdir -p /opt/stickllm/ui
  shopt -s nullglob
  for f in "$SRC/opt/stickllm/ui"/*; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    case "$base" in
      agent-zero.png)
        # Raster logo. Do not run sed: stripping CR would corrupt the PNG.
        install -m 644 "$f" "/opt/stickllm/ui/$base"
        echo "installed /opt/stickllm/ui/$base"
        installed=1
        continue
        ;;
      agent-zero.svg|favicon.svg)
        sed -i 's/\r$//' "$f" 2>/dev/null || true
        install -m 644 "$f" "/opt/stickllm/ui/$base"
        echo "installed /opt/stickllm/ui/$base"
        installed=1
        continue
        ;;
      app.js|index.html|style.css|stickllm.json|desktop.js|desktop-core.js|desktop.css|browser-home.html|browser-home.js) ;;
      *) echo "skipping non-UI file: $base" >&2; continue ;;
    esac
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/opt/stickllm/ui/$base"
    echo "installed /opt/stickllm/ui/$base"
    installed=1
  done
  shopt -u nullglob
  for tree in apps vendor; do
    if [[ -d "$SRC/opt/stickllm/ui/$tree" ]]; then
      mkdir -p "/opt/stickllm/ui/$tree"
      while IFS= read -r -d '' f; do
        rel="${f#"$SRC/opt/stickllm/ui/"}"
        dest="/opt/stickllm/ui/$rel"
        mkdir -p "$(dirname "$dest")"
        case "$rel" in
          *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.woff|*.woff2|*.wasm)
            install -m 644 "$f" "$dest"
            ;;
          *.html|*.js|*.css|*.svg|*.json|*.txt|*.webmanifest|LICENSE|*/LICENSE)
            sed -i 's/\r$//' "$f" 2>/dev/null || true
            install -m 644 "$f" "$dest"
            ;;
          *) echo "skipping non-ui file: $rel" >&2; continue ;;
        esac
        echo "installed $dest"
        installed=1
      done < <(find "$SRC/opt/stickllm/ui/$tree" -type f -print0)
    fi
  done
  # Homemade starters replaced by the vendored trees.
  rm -f /opt/stickllm/ui/apps/minesweeper/game.js \
        /opt/stickllm/ui/apps/notepad/notepad.js
fi

if [[ -f "$SRC/etc/sudoers.d/stickllm" ]]; then
  sed -i 's/\r$//' "$SRC/etc/sudoers.d/stickllm" 2>/dev/null || true
  install -m 440 "$SRC/etc/sudoers.d/stickllm" /etc/sudoers.d/stickllm
  if ! visudo -cf /etc/sudoers.d/stickllm >/dev/null 2>&1; then
    echo "ERROR: invalid sudoers after install" >&2
    exit 1
  fi
  echo "installed /etc/sudoers.d/stickllm"
  installed=1
fi

# Method C peer env (join base / build stamp). No secrets.
# sticklink-factory.env carries lab provision token (mode 600) when staged.
if [[ -d "$SRC/etc/stickllm" ]]; then
  mkdir -p /etc/stickllm
  shopt -s nullglob
  for f in "$SRC/etc/stickllm"/methodc-*.env; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/etc/stickllm/$(basename "$f")"
    echo "installed /etc/stickllm/$(basename "$f")"
    installed=1
  done
  if [[ -f "$SRC/etc/stickllm/sticklink-factory.env" ]]; then
    sed -i 's/\r$//' "$SRC/etc/stickllm/sticklink-factory.env" 2>/dev/null || true
    install -m 600 "$SRC/etc/stickllm/sticklink-factory.env" /etc/stickllm/sticklink-factory.env
    echo "installed /etc/stickllm/sticklink-factory.env"
    installed=1
  fi
  shopt -u nullglob
fi

# Agent Zero egress extension / shared helpers (ISO overlay under share/stickllm).
if [[ -d "$SRC/usr/local/share/stickllm" ]]; then
  mkdir -p /usr/local/share/stickllm
  shopt -s nullglob
  for f in "$SRC/usr/local/share/stickllm"/*.py \
           "$SRC/usr/local/share/stickllm"/agent-zero-*.py; do
    [[ -f "$f" ]] || continue
    sed -i 's/\r$//' "$f" 2>/dev/null || true
    install -m 644 "$f" "/usr/local/share/stickllm/$(basename "$f")"
    echo "installed /usr/local/share/stickllm/$(basename "$f")"
    installed=1
  done
  shopt -u nullglob
  if [[ -f "$SRC/usr/local/share/stickllm/verified.json" ]]; then
    sed -i 's/\r$//' "$SRC/usr/local/share/stickllm/verified.json" 2>/dev/null || true
    install -m 644 "$SRC/usr/local/share/stickllm/verified.json" /usr/local/share/stickllm/verified.json
    echo "installed /usr/local/share/stickllm/verified.json"
    installed=1
  fi
  # 0.8.3: XFCE Desktop Terminal launcher (share + kiosk ~/Desktop).
  if [[ -d "$SRC/usr/local/share/stickllm/desktop" ]]; then
    mkdir -p /usr/local/share/stickllm/desktop
    shopt -s nullglob
    for f in "$SRC/usr/local/share/stickllm/desktop"/*.desktop; do
      [[ -f "$f" ]] || continue
      sed -i 's/\r$//' "$f" 2>/dev/null || true
      install -m 755 "$f" "/usr/local/share/stickllm/desktop/$(basename "$f")"
      echo "installed /usr/local/share/stickllm/desktop/$(basename "$f")"
      installed=1
    done
    shopt -u nullglob
    if [[ -f /usr/local/share/stickllm/desktop/Terminal.desktop ]] && id stickllm >/dev/null 2>&1; then
      home="$(getent passwd stickllm | awk -F: '{print $6}')"
      [[ -n "$home" ]] || home=/home/stickllm
      mkdir -p "$home/Desktop"
      install -m 755 -o stickllm -g stickllm \
        /usr/local/share/stickllm/desktop/Terminal.desktop \
        "$home/Desktop/Terminal.desktop"
      sudo -u stickllm gio set "$home/Desktop/Terminal.desktop" metadata::trusted true \
        2>/dev/null || true
      echo "installed $home/Desktop/Terminal.desktop"
      installed=1
    fi
  fi
fi

# Baked Agent Zero stickllm-apps skill seed (ISO + settings open).
if [[ -d "$SRC/usr/local/share/stickllm/agent-zero-skills" ]]; then
  while IFS= read -r -d '' f; do
    rel="${f#"$SRC/"}"
    dest="/$rel"
    mkdir -p "$(dirname "$dest")"
    case "$rel" in
      *.md|*.txt|*.json)
        sed -i 's/\r$//' "$f" 2>/dev/null || true
        install -m 644 "$f" "$dest"
        ;;
      *) echo "skipping non-skill file: $rel" >&2; continue ;;
    esac
    echo "installed $dest"
    installed=1
  done < <(find "$SRC/usr/local/share/stickllm/agent-zero-skills" -type f -print0)
fi

# Optional .deb drops (lab hotfix). Used to restore docker-cli on sticks built
# before the Debian trixie docker.io / docker-cli split was listed in the ISO.
if [[ -d "$SRC/debs" ]]; then
  shopt -s nullglob
  for deb in "$SRC/debs"/*.deb; do
    [[ -f "$deb" ]] || continue
    if dpkg -i "$deb"; then
      echo "installed deb $(basename "$deb")"
      installed=1
    else
      echo "WARNING: dpkg -i failed for $(basename "$deb")" >&2
      apt-get -y -f install >/dev/null 2>&1 || true
      if dpkg -i "$deb"; then
        echo "installed deb $(basename "$deb") after fix"
        installed=1
      else
        echo "ERROR: could not install $(basename "$deb")" >&2
        exit 1
      fi
    fi
  done
  shopt -u nullglob
fi

if [[ "$installed" -eq 0 ]]; then
  echo "Nothing to install under $SRC" >&2
  exit 1
fi

# Retired lab-only force-activate helper — never leave it on the stick.
if [[ -e /usr/local/bin/stickllm-lab-ctx32 ]]; then
  rm -f /usr/local/bin/stickllm-lab-ctx32
  echo "removed /usr/local/bin/stickllm-lab-ctx32"
fi

if [[ "$units_changed" -eq 1 ]]; then
  systemctl daemon-reload
fi
if [[ -f "$SRC/etc/systemd/system/stickllm-files.service" ]]; then
  systemctl enable stickllm-files.service
  echo "enabled stickllm-files.service"
fi

if [[ "$#" -gt 0 ]]; then
  for u in "$@"; do
    case "$u" in
      stickllm-*.service|stickllm-*) ;;
      *) echo "refusing non-stickllm unit: $u" >&2; exit 1 ;;
    esac
    systemctl reset-failed "$u" 2>/dev/null || true
    systemctl restart "$u"
    echo "restarted $u"
  done
else
  echo "Installed; pass unit names to restart (e.g. stickllm-kiosk.service)."
fi
