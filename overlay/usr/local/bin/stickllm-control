#!/usr/bin/env python3
"""Root control daemon — USB claim, model probe/download/activate, status."""
from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from socketserver import ThreadingMixIn

RUN = Path(os.environ.get("STICKLLM_RUN", "/run/stickllm"))
CATALOG = Path(os.environ.get("STICKLLM_CATALOG", "/etc/stickllm/models/catalog.toml"))
MNT = Path(os.environ.get("STICKLLM_DATA_MNT", "/mnt/stickllm-data"))
SESSION_MODE_PATH = RUN / "session-mode.json"
HOST = "127.0.0.1"
PORT = int(os.environ.get("STICKLLM_CONTROL_PORT", "8091"))
BAKED_3B = Path("/opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf")
BAKED_7B = Path("/opt/stickllm/models/qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf")
SESSION_MODES = frozenset({"ephemeral", "vault"})
# One download runs at a time. Extra clicks wait, then earlier partials resume.
QUEUE_PATH = RUN / "download-queue.json"
QUEUE_LOCK = threading.Lock()
# Keep this much free on the models disk after every queued file.
DOWNLOAD_SPARE_BYTES = 2 * 1024 ** 3
DOWNLOAD_QUEUE_MAX = 32


def session_mode() -> str:
    """UI header mode: ephemeral (default) or vault. Gates SSD/vault writes."""
    doc = read_json(SESSION_MODE_PATH)
    mode = str(doc.get("mode") or "ephemeral").strip().lower()
    return mode if mode in SESSION_MODES else "ephemeral"


def set_session_mode(mode: str) -> dict:
    mode = str(mode or "").strip().lower()
    if mode not in SESSION_MODES:
        return {"ok": False, "error": "mode must be ephemeral or vault"}
    prev = session_mode()
    RUN.mkdir(parents=True, exist_ok=True)
    doc = {
        "ok": True,
        "mode": mode,
        "updated": int(time.time()),
    }
    # Switching to Ephemeral locks the vault (unload model + unmount LUKS).
    if mode == "ephemeral" and (
        prev == "vault" or os.path.ismount("/var/lib/stickllm/vault")
    ):
        lock_r = vault_action("lock", {})
        doc["vault_locked"] = bool(lock_r.get("ok"))
        if not lock_r.get("ok"):
            doc["vault_lock_error"] = (
                lock_r.get("error") or lock_r.get("stderr") or "lock failed"
            )
    SESSION_MODE_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    return doc


def vault_host_root() -> str:
    """Vault setup folder on the host SSD (may hold stickllm-vault.img)."""
    st = read_json(RUN / "vault.json")
    root = str(st.get("root") or "").strip()
    if root and not root.startswith("/dev/") and Path(root).is_dir():
        return root
    for meta in (Path("/var/lib/stickllm/vault-meta"), MNT / "vault-meta"):
        root_file = meta / "root"
        if not root_file.is_file():
            continue
        try:
            root = root_file.read_text(encoding="utf-8").strip()
        except Exception:
            continue
        if root and not root.startswith("/dev/") and Path(root).is_dir():
            return root
    return ""


def vault_clear_models_dirs() -> list[Path]:
    """Clear-text host model folders to list/load in Vault mode (never chats)."""
    root = vault_host_root()
    if not root:
        return []
    rp = Path(root)
    dirs: list[Path] = []
    # User often chooses …/models as vault root; GGUFs sit beside the blob.
    if rp.is_dir():
        dirs.append(rp)
    nested = rp / "models"
    if nested.is_dir() and nested not in dirs:
        dirs.append(nested)
    # Common host library beside …/home/<user>/models (list/load only).
    sibling_lm = rp.parent / ".lmstudio" / "models"
    if sibling_lm.is_dir() and sibling_lm not in dirs:
        dirs.append(sibling_lm)
    return dirs


MODELS_DIR_PATH = RUN / "models-dir.json"
DISCOVERED_MODELS_PATH = RUN / "discovered-models.json"


def _safe_models_dir(path: str) -> Path | None:
    """Accept only directories under /mnt or /var/lib/stickllm (never /dev)."""
    raw = str(path or "").strip()
    if not raw or raw.startswith("/dev/") or ".." in Path(raw).parts:
        return None
    p = Path(raw)
    try:
        p = p.resolve(strict=False)
    except Exception:
        return None
    ps = str(p)
    if not (ps.startswith("/mnt/") or ps.startswith("/var/lib/stickllm/")):
        return None
    return p


def get_preferred_models_dir() -> Path | None:
    """User-selected models folder (Models › Change…), if still valid."""
    doc = read_json(MODELS_DIR_PATH)
    p = _safe_models_dir(str(doc.get("path") or ""))
    if p is not None and p.is_dir():
        return p
    return None


def set_preferred_models_dir(path: str) -> dict:
    """Set download/write target only — does not replace discovered load roots."""
    p = _safe_models_dir(path)
    if p is None:
        return {"ok": False, "error": "invalid models folder path"}
    try:
        p.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        return {"ok": False, "error": f"cannot create folder: {e}"}
    if not p.is_dir():
        return {"ok": False, "error": "path is not a directory"}
    RUN.mkdir(parents=True, exist_ok=True)
    doc = {"ok": True, "path": str(p), "updated": int(time.time())}
    MODELS_DIR_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    return {"ok": True, "path": str(p), "download_dir": str(p)}


def get_discovered_model_dirs() -> list[Path]:
    """Session-remembered library roots from Search for models (load only)."""
    doc = read_json(DISCOVERED_MODELS_PATH)
    out: list[Path] = []
    for raw in doc.get("dirs") or []:
        p = _safe_models_dir(str(raw))
        if p is not None and p.is_dir() and p not in out:
            out.append(p)
    return out


def remember_discovered_models(hits: list) -> list[str]:
    """Merge find-models roots into session store for catalog load/list."""
    existing = {str(p): p for p in get_discovered_model_dirs()}
    for h in hits or []:
        if not isinstance(h, dict):
            continue
        raw = str(h.get("path") or h.get("dir") or "").strip()
        p = _safe_models_dir(raw)
        if p is None or not p.is_dir():
            continue
        existing[str(p)] = p
    dirs = sorted(existing.values(), key=lambda p: str(p))
    RUN.mkdir(parents=True, exist_ok=True)
    payload = {
        "ok": True,
        "updated": int(time.time()),
        "dirs": [str(p) for p in dirs],
    }
    DISCOVERED_MODELS_PATH.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    return [str(p) for p in dirs]


def vault_download_models_dir() -> Path | None:
    """Where catalog downloads land (user pick only → vault SSD → USB DATA).

    Discovered Search-for-models roots are never used as download destinations.
    """
    preferred = get_preferred_models_dir()
    if preferred is not None:
        return preferred
    root = vault_host_root()
    if not root:
        return None
    rp = Path(root)
    # Prefer the folder they chose when it is already a models directory.
    if rp.is_dir() and rp.name.lower() == "models":
        return rp
    nested = rp / "models"
    return nested


def sh(cmd: list[str], timeout: int = 600) -> dict:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return {
            "ok": p.returncode == 0,
            "code": p.returncode,
            "stdout": (p.stdout or "")[-8000:],
            "stderr": (p.stderr or "")[-4000:],
        }
    except Exception as e:
        return {"ok": False, "error": str(e)}


def parse_vault_json(cmd: list[str], timeout: int = 60, *, parse_error: str) -> dict:
    """Run a stickllm-vault JSON subcommand with full stdout (sh() truncates at 8k)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except Exception as e:
        return {"ok": False, "error": str(e)}
    full_out = p.stdout or ""
    try:
        lines = [ln for ln in full_out.strip().splitlines() if ln.strip()]
        return json.loads(lines[-1] if lines else "{}")
    except Exception:
        return {
            "ok": False,
            "code": p.returncode,
            "error": parse_error,
            "stdout": full_out[-8000:],
            "stderr": (p.stderr or "")[-4000:],
        }


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def merge_vault_run(r: dict) -> dict:
    """Merge /run vault.json without letting status ok=True hide a failed command."""
    cmd_ok = bool(r.get("ok"))
    prior_err = str(r.get("error") or "").strip()
    prior_stderr = str(r.get("stderr") or "").strip()
    st = read_json(RUN / "vault.json")
    st.pop("ok", None)
    r.update(st)
    r["ok"] = cmd_ok
    if not cmd_ok and not str(r.get("error") or "").strip():
        r["error"] = prior_err or prior_stderr or "vault command failed"
    return r


def model_dirs() -> list[Path]:
    """Directories scanned for Load / installed list (not download targets)."""
    dirs: list[Path] = []
    preferred = get_preferred_models_dir()
    if preferred is not None and preferred not in dirs:
        dirs.append(preferred)
    # Search-for-models roots: load/list only; downloads never use these alone.
    for d in get_discovered_model_dirs():
        if d not in dirs:
            dirs.append(d)
    # Vault / SSD models only when user consciously selected Vault mode.
    if session_mode() == "vault":
        vault_mnt = Path("/var/lib/stickllm/vault")
        vault_models = vault_mnt / "models"
        if vault_models.is_dir() and os.path.ismount(str(vault_mnt)):
            if vault_models not in dirs:
                dirs.append(vault_models)
        for d in vault_clear_models_dirs():
            if d not in dirs:
                dirs.append(d)
    # USB DATA models: ephemeral listing/download; also visible as fallback.
    if session_mode() != "vault":
        data = MNT / "models"
        if data.is_dir() and data not in dirs:
            dirs.append(data)
    baked = Path("/opt/stickllm/models")
    if baked.is_dir() and baked not in dirs:
        dirs.append(baked)
    return dirs


def _gguf_search_roots() -> list[Path]:
    """Dirs to search for GGUF files (shallow recurse under host trees)."""
    return model_dirs()


# --- Bounded GGUF index (0.5.2) ---------------------------------------------
# Path.rglob() walked whole trees (e.g. the vault host root /home/<user> holding
# stickllm-docker/overlay2 with hundreds of thousands of files) once per catalog
# file on every status call, hanging the control daemon. Walk at most
# GGUF_MAX_DEPTH levels, prune heavy/system dirs, cap entries, cache briefly
# and let only one thread scan at a time.
GGUF_MAX_DEPTH = 4
GGUF_MAX_ENTRIES = 200_000
GGUF_INDEX_TTL = 20.0
_GGUF_PRUNE = {
    "stickllm-docker", "docker", "overlay2", "containerd", "node_modules",
    "__pycache__", "site-packages", "proc", "sys", "dev", "snap", "flatpak",
    "Windows", "$Recycle.Bin", "System Volume Information", "Program Files",
    "Program Files (x86)", "ProgramData", "AppData", "lost+found", "venv",
    ".venv", ".git",
}
_GGUF_HIDDEN_OK = {".lmstudio", ".cache", "huggingface", ".ollama"}
_gguf_index_lock = threading.Lock()
_gguf_index_cache: dict[str, tuple[float, list[Path]]] = {}


def _walk_ggufs(root: Path) -> list[Path]:
    out: list[Path] = []
    try:
        base = str(root)
        if not os.path.isdir(base):
            return out
    except OSError:
        return out
    seen = 0
    stack: list[tuple[str, int]] = [(base, 0)]
    while stack:
        cur, depth = stack.pop()
        try:
            with os.scandir(cur) as it:
                for ent in it:
                    seen += 1
                    if seen > GGUF_MAX_ENTRIES:
                        return out
                    name = ent.name
                    try:
                        if ent.is_dir(follow_symlinks=False):
                            if depth + 1 >= GGUF_MAX_DEPTH:
                                continue
                            if name in _GGUF_PRUNE:
                                continue
                            if name.startswith(".") and name not in _GGUF_HIDDEN_OK:
                                continue
                            stack.append((ent.path, depth + 1))
                        elif name.lower().endswith(".gguf") and ent.is_file():
                            out.append(Path(ent.path))
                    except OSError:
                        continue
        except OSError:
            continue
    return out


def gguf_index(roots: list[Path] | None = None) -> dict[Path, list[Path]]:
    """Cached {root: [gguf paths]} for model dirs (depth-bounded, single-flight)."""
    if roots is None:
        roots = _gguf_search_roots()
    res: dict[Path, list[Path]] = {}
    with _gguf_index_lock:
        now = time.monotonic()
        for r in roots:
            key = str(r)
            hit = _gguf_index_cache.get(key)
            if hit and now - hit[0] < GGUF_INDEX_TTL:
                res[r] = hit[1]
                continue
            files = _walk_ggufs(r)
            _gguf_index_cache[key] = (time.monotonic(), files)
            res[r] = files
    return res


def gguf_index_invalidate() -> None:
    with _gguf_index_lock:
        _gguf_index_cache.clear()


def find_file(name: str) -> Path | None:
    want = name
    want_low = os.path.basename(want).lower()
    idx = gguf_index()
    for d in _gguf_search_roots():
        p = d / want
        try:
            if p.is_file() and p.stat().st_size > 1_000_000:
                return p
        except OSError:
            pass
        # Shallow recurse (LM Studio / HF layout: vendor/model/*.gguf), bounded.
        for p in idx.get(d, []):
            if p.name.lower() != want_low:
                continue
            try:
                if p.is_file() and p.stat().st_size > 1_000_000:
                    return p
            except OSError:
                continue
    return None


def discover_local_ggufs() -> list[dict]:
    """Surface on-disk GGUFs not already represented by catalog filenames.

    Scans preferred + Search-for-models discovered roots (any session mode),
    plus vault/host clear dirs when in Vault mode (via model_dirs()).
    """
    catalog_files: set[str] = set()
    for m in parse_catalog():
        for f in m.get("hf_files") or []:
            catalog_files.add(os.path.basename(f).lower())
    # Also treat baked names as catalog-covered
    catalog_files.add(BAKED_3B.name.lower())
    catalog_files.add(BAKED_7B.name.lower())

    roots = [d for d in _gguf_search_roots() if not str(d).startswith("/opt/stickllm/models")]
    # Ephemeral: only preferred + discovered (skip baking USB DATA noise unless preferred).
    if session_mode() != "vault":
        allow = set()
        pref = get_preferred_models_dir()
        if pref is not None:
            allow.add(pref)
        allow.update(get_discovered_model_dirs())
        data = MNT / "models"
        if data.is_dir():
            allow.add(data)
        roots = [d for d in roots if d in allow]
        if not roots:
            return []

    found: dict[str, Path] = {}
    for d in roots:
        try:
            for p in gguf_index([d]).get(d, []):
                if not p.is_file():
                    continue
                try:
                    if p.stat().st_size < 1_000_000:
                        continue
                    rel = p.relative_to(d)
                except (OSError, ValueError):
                    continue
                if len(rel.parts) > 4:
                    continue
                name = p.name
                # Skip projector / mmproj helpers as standalone "models"
                low = name.lower()
                if low.startswith("mmproj") or "mmproj-" in low:
                    continue
                if low in catalog_files:
                    continue
                # Multipart: keep shard 00001 (or unsharded)
                m = re.search(r"-(\d{5})-of-(\d{5})\.gguf$", low)
                if m and m.group(1) != "00001":
                    continue
                key = low
                prev = found.get(key)
                if prev is None or p.stat().st_size > prev.stat().st_size:
                    found[key] = p
        except OSError:
            pass

    out: list[dict] = []
    for low, path in sorted(found.items(), key=lambda kv: kv[0]):
        stem = path.name
        if re.search(r"-\d{5}-of-\d{5}\.gguf$", stem, re.I):
            stem = re.sub(r"-\d{5}-of-\d{5}\.gguf$", "", stem, flags=re.I)
        else:
            stem = stem[: -len(".gguf")] if stem.lower().endswith(".gguf") else stem
        mid = "local-" + re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")[:80]
        size_gb = round(gguf_weight_bytes(path) / (1024**3), 2)
        out.append(
            {
                "id": mid,
                "name": stem.replace("-", " ").replace("_", " "),
                "tier": "local",
                "approx_size_gb": size_gb,
                "min_vram_gb": 0,
                "quality_rank": 10,
                "vision": False,
                "pinned": False,
                "hf_repo": "",
                "hf_files": [path.name],
                "notes": f"On disk: {path}",
                "local_path": str(path),
                "source": "host_ssd",
            }
        )
    return out


def _short_gpu_name(name: str) -> str:
    s = str(name or "").strip()
    for prefix in ("NVIDIA GeForce ", "NVIDIA ", "GeForce "):
        if s.startswith(prefix):
            s = s[len(prefix):]
    return s.strip() or "GPU"


def gpu_inventory() -> dict:
    """Usable VRAM pool. Cards under 16 GB (the display GPU) are left out."""
    rows = nvidia_gpu_rows()
    suitable = suitable_gpus(rows)
    use = suitable if suitable else rows
    total_mib = sum(int(g.get("total_mib") or 0) for g in use)
    gpus = []
    names: list[str] = []
    each: list[float] = []
    for g in use:
        gb = int(g.get("total_mib") or 0) / 1024.0
        short = _short_gpu_name(str(g.get("name") or ""))
        names.append(short)
        each.append(gb)
        gpus.append({"index": int(g.get("index") or 0), "name": short, "total_gb": round(gb, 1)})
    uniq = list(dict.fromkeys(names))
    if len(uniq) == 1:
        label = uniq[0]
    else:
        label = " + ".join(uniq)
    same = bool(each) and all(abs(x - each[0]) < 0.6 for x in each)
    return {
        "vram_gb": (total_mib / 1024.0) if use else 0.0,
        "each_gb": each[0] if same else 0.0,
        "count": len(use),
        "name": label,
        "gpus": gpus,
    }


def detect_vram_gb() -> float:
    """Combined VRAM of every GPU large enough to hold weights."""
    try:
        return float(gpu_inventory()["vram_gb"])
    except Exception:
        return 0.0


def detect_ram_gb() -> float:
    try:
        meminfo = Path("/proc/meminfo").read_text(encoding="utf-8")
        for line in meminfo.splitlines():
            if line.startswith("MemAvailable:"):
                kb = float(line.split()[1])
                return kb / (1024.0 * 1024.0)
            if line.startswith("MemTotal:"):
                kb = float(line.split()[1])
                # Prefer Available; fall back to ~85% of total.
                return (kb / (1024.0 * 1024.0)) * 0.85
    except Exception:
        pass
    return 0.0


def has_nvidia() -> bool:
    if detect_vram_gb() > 0.5:
        return True
    return Path("/dev/nvidia0").exists() or Path("/dev/nvidiactl").exists()


def _gguf_read_string(f) -> str:
    (n,) = struct.unpack("<Q", f.read(8))
    if n > 1_000_000:
        raise ValueError("gguf string too large")
    return f.read(n).decode("utf-8", errors="replace")


def read_gguf_meta(path: str | Path, max_keys: int = 256) -> dict:
    """Read scalar/string KV metadata from a GGUF header (skips tensors/arrays)."""
    p = Path(path)
    if not p.is_file():
        return {}
    out: dict = {}
    try:
        with p.open("rb") as f:
            magic = f.read(4)
            if magic != b"GGUF":
                return {}
            (version,) = struct.unpack("<I", f.read(4))
            if version not in (2, 3):
                return {}
            _tensor_count, kv_count = struct.unpack("<QQ", f.read(16))
            kv_count = min(int(kv_count), max_keys)
            for _ in range(kv_count):
                key = _gguf_read_string(f)
                (vtype,) = struct.unpack("<I", f.read(4))
                if vtype == 0:  # UINT8
                    (val,) = struct.unpack("<B", f.read(1))
                elif vtype == 1:  # INT8
                    (val,) = struct.unpack("<b", f.read(1))
                elif vtype == 2:  # UINT16
                    (val,) = struct.unpack("<H", f.read(2))
                elif vtype == 3:  # INT16
                    (val,) = struct.unpack("<h", f.read(2))
                elif vtype == 4:  # UINT32
                    (val,) = struct.unpack("<I", f.read(4))
                elif vtype == 5:  # INT32
                    (val,) = struct.unpack("<i", f.read(4))
                elif vtype == 6:  # FLOAT32
                    (val,) = struct.unpack("<f", f.read(4))
                elif vtype == 7:  # BOOL
                    (val,) = struct.unpack("<?", f.read(1))
                elif vtype == 8:  # STRING
                    val = _gguf_read_string(f)
                elif vtype == 9:  # ARRAY — skip
                    (atype,) = struct.unpack("<I", f.read(4))
                    (alen,) = struct.unpack("<Q", f.read(8))
                    sizes = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
                    if atype == 8:
                        for _a in range(int(alen)):
                            _gguf_read_string(f)
                    else:
                        esz = sizes.get(atype)
                        if esz is None:
                            return out
                        f.seek(int(alen) * esz, os.SEEK_CUR)
                    continue
                elif vtype == 10:  # UINT64
                    (val,) = struct.unpack("<Q", f.read(8))
                elif vtype == 11:  # INT64
                    (val,) = struct.unpack("<q", f.read(8))
                elif vtype == 12:  # FLOAT64
                    (val,) = struct.unpack("<d", f.read(8))
                else:
                    return out
                out[key] = val
    except Exception:
        return out
    return out


def gguf_arch_dims(meta: dict) -> dict:
    """Pull architecture dims used for KV-cache sizing from GGUF metadata."""
    arch = str(meta.get("general.architecture") or "").strip()
    if not arch:
        return {}
    def num(*keys: str) -> int:
        for k in keys:
            v = meta.get(k)
            if isinstance(v, (int, float)) and v > 0:
                return int(v)
        return 0

    n_layer = num(f"{arch}.block_count")
    n_ctx = num(f"{arch}.context_length")
    n_embd = num(f"{arch}.embedding_length")
    n_head = num(f"{arch}.attention.head_count")
    n_kv = num(f"{arch}.attention.head_count_kv", f"{arch}.attention.head_count")
    head_dim = num(f"{arch}.attention.key_length")
    if not head_dim and n_embd and n_head:
        head_dim = max(1, n_embd // n_head)
    # Hybrid models (Qwen3.5 / Qwen3.8) run full attention every Nth layer.
    # The other layers are recurrent and do not grow a KV cache with context.
    interval = num(f"{arch}.full_attention_interval")
    n_kv_layer = n_layer
    if interval > 1 and n_layer > 0:
        n_kv_layer = max(1, n_layer // interval)
    return {
        "architecture": arch,
        "n_layer": n_layer,
        "n_kv_layer": n_kv_layer,
        "n_ctx_train": n_ctx,
        "n_embd": n_embd,
        "n_head": n_head,
        "n_kv_head": n_kv,
        "head_dim": head_dim,
    }


# GPUs smaller than this are display/auxiliary (the 8GB card next to a pair of
# 3090s). Both 24GB 3090s are included.
GPU_SUITABLE_MIB = 16000
# CUDA context + compute buffers held back before layer weights.
GPU_BUFFER_BYTES = int(1.5 * (1024**3))
_MOE_ARCH = frozenset(
    {"mixtral", "qwen2moe", "qwen3moe", "deepseek2", "phi3moe", "grok", "olmoe"}
)
_SECRET_LINE = re.compile(r"password|STICKLLM_SSH_PASS", re.I)
_CUDA_ERR_LINE = re.compile(
    r"cuda|cublas|out of memory|outofmemory|ggml_cuda|failed to allocate|"
    r"unable to allocate|allocation failed|ggml_backend",
    re.I,
)


def nvidia_gpu_rows() -> list[dict]:
    """nvidia-smi rows. Empty when the driver is missing (CPU/Vulkan hosts)."""
    try:
        p = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=index,name,memory.total,memory.free,memory.used",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if p.returncode != 0:
        return []
    rows: list[dict] = []
    for line in (p.stdout or "").splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) < 5:
            continue
        try:
            idx = int(parts[0])
            total = int(float(parts[2]))
            free = int(float(parts[3]))
            used = int(float(parts[4]))
        except ValueError:
            continue
        rows.append(
            {
                "index": idx,
                "name": parts[1],
                "total_mib": total,
                "free_mib": max(0, free),
                "used_mib": max(0, used),
            }
        )
    return rows


def suitable_gpus(rows: list[dict] | None = None) -> list[dict]:
    """Every GPU large enough to hold weights. Skips tiny/display cards."""
    rows = nvidia_gpu_rows() if rows is None else rows
    return [g for g in rows if int(g.get("total_mib") or 0) >= GPU_SUITABLE_MIB]


_SPLIT_GGUF = re.compile(
    r"^(?P<stem>.+)-(?P<idx>\d{5})-of-(?P<total>\d{5})\.gguf$",
    re.I,
)


def gguf_weight_bytes(path: Path) -> int:
    """Bytes of the whole model. Split GGUFs are name-00001-of-00003 plus siblings."""
    path = Path(path)
    try:
        own = int(path.stat().st_size)
    except OSError:
        return 0
    m = _SPLIT_GGUF.match(path.name)
    if not m:
        return own
    total = int(m.group("total"))
    parent = path.parent
    nbytes = 0
    found = 0
    for i in range(1, total + 1):
        part = parent / f"{m.group('stem')}-{i:05d}-of-{m.group('total')}.gguf"
        try:
            if part.is_file():
                nbytes += int(part.stat().st_size)
                found += 1
        except OSError:
            continue
    return nbytes if found else own


def estimate_n_layer(dims: dict, file_bytes: int) -> tuple[int, str]:
    """Layer count from GGUF, else a documented size bucket.

    Llama-3.3-70B-Instruct-Q4 (~40 GiB) is 80 transformer blocks when the
    header does not yield block_count. Smaller buckets are conservative.
    """
    n = int(dims.get("n_layer") or 0)
    if n > 0:
        return n, "gguf"
    gib = file_bytes / (1024**3)
    if gib >= 30:
        return 80, "estimate:>=30GiB→80 (70B-class)"
    if gib >= 16:
        return 64, "estimate:16-30GiB→64"
    if gib >= 8:
        return 40, "estimate:8-16GiB→40"
    if gib >= 4:
        return 32, "estimate:4-8GiB→32"
    return 24, "estimate:<4GiB→24"


def moe_expert_count(meta: dict, dims: dict) -> int:
    arch = str(dims.get("architecture") or "")
    for key in (f"{arch}.expert_count", f"{arch}.expert_used_count"):
        v = meta.get(key)
        if isinstance(v, (int, float)) and int(v) > 1:
            return int(v)
    for k, v in meta.items():
        if str(k).endswith(".expert_count") and isinstance(v, (int, float)) and int(v) > 1:
            return int(v)
    if arch in _MOE_ARCH:
        return 8
    return 0


def kv_bytes_per_token(dims: dict, n_layer: int, file_bytes: int) -> int:
    """K+V f16 bytes per token. Uses GGUF dims, else a 70B GQA ballpark."""
    n_kv = int(dims.get("n_kv_head") or 0)
    head = int(dims.get("head_dim") or 0)
    n_kv_layer = int(dims.get("n_kv_layer") or n_layer or 0)
    if n_kv_layer > 0 and n_kv > 0 and head > 0:
        return 2 * n_kv_layer * n_kv * head * 2
    gib = file_bytes / (1024**3)
    if gib >= 30:
        # Llama-3 70B: 80 layers * 8 kv heads * 128 * 2 bytes * K and V.
        return 320 * 1024
    return max(8192, int(56000 * (max(gib, 0.1) / 5.1)))


def estimate_tok_s(file_bytes: int, gpu_count: int, offload_fraction: float) -> int:
    """UI ballpark only. Anchored near 28 tok/s for ~40GB on 2×3090, full offload."""
    gb = max(1.0, file_bytes / 1e9)
    frac = min(1.0, max(0.05, float(offload_fraction)))
    gpus = max(1, int(gpu_count))
    return max(1, int(round(28.0 * (40.0 / gb) * (gpus / 2.0) * frac)))


def _shell_quote(value: str) -> str:
    return "'" + str(value).replace("'", "'\"'\"'") + "'"


def read_ngl_override() -> int | None:
    envf = RUN / "ngl.env"
    if not envf.is_file():
        return None
    try:
        for line in envf.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_N_GPU_LAYERS="):
                n = int(line.split("=", 1)[1].strip())
                return n if n > 0 else None
    except (OSError, ValueError):
        return None
    return None


def plan_gpu_fit(
    *,
    file_bytes: int,
    ctx: int,
    meta: dict | None = None,
    gpus: list[dict] | None = None,
    ngl_override: int | None = None,
) -> dict:
    """Choose -ngl / tensor-split for the GPUs we will actually use.

    Preference:
      1. Every suitable GPU (total >= 16 GiB). CUDA_VISIBLE_DEVICES lists them all.
      2. --tensor-split proportional to free VRAM so every card is used.
      3. Dense -ngl = floor( (free VRAM - KV(ctx) - 1.5 GiB buffers) / per-layer weight ).
         Cap at n_layer+1 when that is a full offload. Never the sentinel 99.
         The same formula is used for one GPU with the rest of the weights in RAM.
         mmap stays at the llama.cpp default (callers must not pass --no-mmap).
      4. MoE: when spilling experts with --n-cpu-moe keeps attention on GPU and
         that fits better than dropping whole layers, use -ngl 99 and --n-cpu-moe.
         Still across every suitable GPU.
    """
    meta = meta or {}
    dims = gguf_arch_dims(meta)
    n_layer, layer_src = estimate_n_layer(dims, file_bytes)
    ctx = max(256, int(ctx or 8192))
    kv_bpt = kv_bytes_per_token(dims, n_layer, file_bytes)
    kv = kv_bpt * ctx
    weights = max(1, int(file_bytes))
    cards = suitable_gpus(gpus)
    gpu_count = len(cards)
    devices = ",".join(str(g["index"]) for g in cards)
    # Proportions follow free VRAM. A card reporting 0 free still gets its total
    # so tensor-split does not drop it.
    shares = []
    free_sum = 0
    for g in cards:
        share = int(g.get("free_mib") or 0) or int(g.get("total_mib") or 0)
        share = max(1, share)
        shares.append(share)
        free_sum += int(g.get("free_mib") or 0) or int(g.get("total_mib") or 0)
    tensor_split = ",".join(str(s) for s in shares) if gpu_count > 1 else ""
    budget = free_sum * 1024 * 1024
    need = weights + kv + GPU_BUFFER_BYTES
    # Per-layer size is the weight share. KV and the 1.5 GiB buffer are subtracted
    # once from free VRAM, not folded into the per-layer divisor.
    weight_per_layer = weights / n_layer

    def layers_that_fit(budget_bytes: int) -> int:
        usable = budget_bytes - kv - GPU_BUFFER_BYTES
        if usable <= 0 or weight_per_layer <= 0:
            return 0
        return max(0, int(usable // weight_per_layer))

    n_exp = moe_expert_count(meta, dims)
    is_moe = n_exp > 1
    n_cpu_moe = 0
    # llama.cpp treats one extra slot as the output layer. 99 stays MoE-only.
    full_ngl = n_layer + 1
    if gpu_count == 0:
        ngl = 0
        fit = "cpu"
        offload_frac = 0.0
    elif not is_moe and need <= budget:
        ngl = full_ngl
        fit = "full"
        offload_frac = 1.0
    elif is_moe and need <= budget:
        ngl = full_ngl
        fit = "full"
        offload_frac = 1.0
    elif is_moe:
        # Expert tensors dominate. ~15% dense/attention is the documented
        # stand-in when the tensor table is not parsed. Keeping those on GPU
        # with -ngl 99 and moving expert blocks via --n-cpu-moe beats dropping
        # whole layers, when the dense slice itself fits.
        non_expert = int(weights * 0.15)
        expert_bytes = max(1, weights - non_expert)
        per_expert = expert_bytes / n_layer
        left = budget - GPU_BUFFER_BYTES - kv - non_expert
        if left >= 0:
            on_gpu = int(left // per_expert) if per_expert else n_layer
            on_gpu = max(0, min(n_layer, on_gpu))
            n_cpu_moe = n_layer - on_gpu
            ngl = 99
            fit = "moe"
            offload_frac = min(1.0, 0.15 + 0.85 * (on_gpu / n_layer))
        else:
            ngl = min(layers_that_fit(budget), n_layer)
            n_cpu_moe = 0
            fit = "partial" if ngl < n_layer else "full"
            offload_frac = ngl / full_ngl
    else:
        # Cap at the transformer blocks. Output stays in RAM unless the whole
        # file fit (handled above). Never emit 99 for a dense model.
        ngl = min(layers_that_fit(budget), n_layer)
        fit = "partial"
        offload_frac = min(1.0, ngl / full_ngl)

    if ngl_override is not None and gpu_count > 0:
        ngl = max(1, min(int(ngl), int(ngl_override)))
        n_cpu_moe = 0
        fit = "full" if ngl >= full_ngl else "partial"
        offload_frac = min(1.0, ngl / full_ngl)

    tok_s = estimate_tok_s(weights, max(1, gpu_count), offload_frac if gpu_count else 0.05)
    if gpu_count == 0:
        caption = "CPU"
    elif fit == "full":
        caption = (
            f"{gpu_count} GPUs, full offload, about {tok_s} tok/s"
            if gpu_count > 1
            else f"1 GPU, full offload, about {tok_s} tok/s"
        )
    elif fit == "moe":
        caption = (
            f"{gpu_count} GPUs, MoE offload, about {tok_s} tok/s"
            if gpu_count > 1
            else f"1 GPU, MoE offload, about {tok_s} tok/s"
        )
    else:
        caption = (
            f"{gpu_count} GPUs, partial offload, about {tok_s} tok/s"
            if gpu_count > 1
            else f"1 GPU, partial offload, about {tok_s} tok/s"
        )
    gpu_bytes = 0
    if gpu_count and ngl > 0 and fit != "cpu":
        if fit == "full":
            gpu_bytes = weights + kv
        elif fit == "moe":
            gpu_bytes = int(weights * offload_frac) + kv
        else:
            gpu_bytes = int(weight_per_layer * min(ngl, n_layer)) + kv
    return {
        "ok": True,
        "n_gpu_layers": int(ngl),
        "n_layer": n_layer,
        "layer_source": layer_src,
        "n_cpu_moe": int(n_cpu_moe),
        "fit": fit,
        "moe": is_moe,
        "gpu_count": gpu_count,
        "devices": devices,
        "tensor_split": tensor_split,
        "caption": caption,
        "tok_s": tok_s,
        "ctx": ctx,
        "vram_free_mib": int(free_sum),
        "need_mib": int(need / (1024 * 1024)),
        "budget_mib": int(budget / (1024 * 1024)),
        "expected_gpu_mib": int(gpu_bytes / (1024 * 1024)),
        "kv_bytes_per_token": kv_bpt,
    }


def _model_ctx_and_path() -> tuple[str, int]:
    path = ""
    ctx = 8192
    envf = RUN / "model.env"
    if envf.is_file():
        try:
            for line in envf.read_text(encoding="utf-8").splitlines():
                if line.startswith("STICKLLM_MODEL="):
                    path = line.split("=", 1)[1].strip()
                elif line.startswith("STICKLLM_CTX_SIZE="):
                    ctx = int(line.split("=", 1)[1].strip())
        except (OSError, ValueError):
            pass
    if not path:
        path = os.environ.get("STICKLLM_MODEL", "")
    if os.environ.get("STICKLLM_CTX_SIZE"):
        try:
            ctx = int(os.environ["STICKLLM_CTX_SIZE"])
        except ValueError:
            pass
    return path, ctx


def build_offload_plan(*, honor_override: bool = True) -> dict:
    path, ctx = _model_ctx_and_path()
    if not path or not Path(path).is_file():
        return {"ok": False, "error": "model file missing", "n_gpu_layers": 0, "gpu_count": 0}
    try:
        file_bytes = gguf_weight_bytes(Path(path))
    except OSError as e:
        return {"ok": False, "error": str(e), "n_gpu_layers": 0, "gpu_count": 0}
    meta = read_gguf_meta(path, max_keys=800)
    override = read_ngl_override() if honor_override else None
    plan = plan_gpu_fit(
        file_bytes=file_bytes,
        ctx=ctx,
        meta=meta,
        ngl_override=override,
    )
    plan["model"] = path
    return plan


def write_offload_plan(plan: dict) -> dict:
    """Persist the plan for llama-start, the UI, and a shell `eval`."""
    try:
        RUN.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    ngl = int(plan.get("n_gpu_layers") or 0)
    lines = [
        f"STICKLLM_PLAN_NGL={ngl}",
        f"STICKLLM_PLAN_N_LAYER={int(plan.get('n_layer') or 0)}",
        f"STICKLLM_PLAN_N_CPU_MOE={int(plan.get('n_cpu_moe') or 0)}",
        f"STICKLLM_PLAN_FIT={plan.get('fit') or 'cpu'}",
        f"STICKLLM_PLAN_GPU_COUNT={int(plan.get('gpu_count') or 0)}",
        f"STICKLLM_PLAN_DEVICES={plan.get('devices') or ''}",
        f"STICKLLM_PLAN_TENSOR_SPLIT={plan.get('tensor_split') or ''}",
        "STICKLLM_PLAN_CAPTION=" + _shell_quote(str(plan.get("caption") or "")),
        f"STICKLLM_PLAN_TOK_S={int(plan.get('tok_s') or 0)}",
        f"STICKLLM_PLAN_EXPECTED_GPU_MIB={int(plan.get('expected_gpu_mib') or 0)}",
    ]
    text = "\n".join(lines) + "\n"
    for dest in (RUN / "llama-plan.env",):
        try:
            dest.write_text(text, encoding="utf-8")
            os.chmod(dest, 0o644)
        except OSError:
            pass
    try:
        (RUN / "llama-fit.json").write_text(json.dumps(plan) + "\n", encoding="utf-8")
    except OSError:
        pass
    plan["shell"] = text
    return plan


def emit_offload_plan() -> int:
    plan = write_offload_plan(build_offload_plan())
    sys.stdout.write(plan.get("shell") or "")
    if not plan.get("ok", True) and plan.get("error"):
        print(f"stickllm-plan: {plan['error']}", file=sys.stderr)
        return 1
    return 0


def llama_journal_error() -> str:
    """Short CUDA/llama error from the unit journal. Never a password line."""
    try:
        p = subprocess.run(
            ["journalctl", "-u", "stickllm-llama", "-n", "160", "--no-pager", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    picked: list[str] = []
    for line in (p.stdout or "").splitlines():
        s = line.strip()
        if not s or _SECRET_LINE.search(s):
            continue
        if re.search(r"backend registered|stickllm-cuda-register", s, re.I):
            continue
        if _CUDA_ERR_LINE.search(s) or "stickllm-llama-start:" in s:
            picked.append(s)
    if not picked:
        return ""
    for s in reversed(picked):
        if _CUDA_ERR_LINE.search(s):
            return s[:220]
    return picked[-1][:220]


def llama_service_snapshot(*, stop_loop: bool = True) -> dict:
    """systemd start count, exit code, VRAM progress, and the last CUDA line."""
    snap = {
        "n_restarts": 0,
        "active_state": "",
        "sub_state": "",
        "result": "",
        "exec_main_status": 0,
        "exec_main_code": 0,
        "started_at": "",
        "error": "",
        "stopped": False,
        "progress_pct": 0,
        "process_alive": False,
        "fail_count": 0,
    }
    try:
        snap["fail_count"] = int((RUN / "llama-fail-count").read_text(encoding="utf-8").strip() or "0")
    except (OSError, ValueError):
        snap["fail_count"] = 0
    try:
        p = subprocess.run(
            [
                "systemctl",
                "show",
                "stickllm-llama.service",
                "-p",
                "NRestarts",
                "-p",
                "ActiveState",
                "-p",
                "SubState",
                "-p",
                "Result",
                "-p",
                "ExecMainStatus",
                "-p",
                "ExecMainCode",
                "-p",
                "ExecMainStartTimestamp",
                "--no-pager",
            ],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
        vals = {}
        for line in (p.stdout or "").splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                vals[k] = v.strip()
        snap["n_restarts"] = int(vals.get("NRestarts") or 0)
        snap["active_state"] = vals.get("ActiveState") or ""
        snap["sub_state"] = vals.get("SubState") or ""
        snap["result"] = vals.get("Result") or ""
        snap["exec_main_status"] = int(vals.get("ExecMainStatus") or 0)
        snap["exec_main_code"] = int(vals.get("ExecMainCode") or 0)
        snap["started_at"] = vals.get("ExecMainStartTimestamp") or ""
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    alive = snap["active_state"] == "active" and snap["sub_state"] == "running"
    snap["process_alive"] = alive
    err = ""
    fail_path = RUN / "llama-fail.txt"
    if fail_path.is_file():
        try:
            err = fail_path.read_text(encoding="utf-8", errors="replace").strip().splitlines()[-1][:220]
        except OSError:
            err = ""
    if _SECRET_LINE.search(err):
        err = ""
    if not alive and (snap["n_restarts"] or snap["result"] not in ("", "success")):
        journal = llama_journal_error()
        if journal:
            err = journal
            try:
                RUN.mkdir(parents=True, exist_ok=True)
                fail_path.write_text(err + "\n", encoding="utf-8")
            except OSError:
                pass
    snap["error"] = err
    fit = read_json(RUN / "llama-fit.json")
    if fit:
        snap["fit"] = fit.get("fit") or ""
        snap["caption"] = fit.get("caption") or ""
        snap["n_gpu_layers"] = fit.get("n_gpu_layers")
        snap["gpu_count"] = fit.get("gpu_count")
        snap["tok_s"] = fit.get("tok_s")
        snap["devices"] = fit.get("devices") or ""
    expected = int(fit.get("expected_gpu_mib") or 0) if fit else 0
    if alive and expected > 0:
        devices = set()
        raw_dev = str((fit or {}).get("devices") or "")
        for part in raw_dev.split(","):
            part = part.strip()
            if part.isdigit():
                devices.add(int(part))
        used = 0
        for g in nvidia_gpu_rows():
            if not devices or g["index"] in devices:
                used += int(g.get("used_mib") or 0)
        # Driver baseline is a few hundred MiB; don't treat that as weights loaded.
        used = max(0, used - 400 * max(1, len(devices) or 1))
        snap["progress_pct"] = int(max(0, min(90, round(100 * used / expected))))
    else:
        snap["progress_pct"] = 0
    # Two failed starts and the process is not the one actually loading: stop
    # Restart=on-failure from hammering. A live running PID is left alone so a
    # large GGUF can finish loading.
    if (
        stop_loop
        and not alive
        and (snap["n_restarts"] >= 2 or snap["result"] == "start-limit-hit")
        and snap["active_state"] in ("activating", "active")
    ):
        sh(["systemctl", "stop", "stickllm-llama.service"], timeout=30)
        snap["stopped"] = True
        snap["active_state"] = "inactive"
        snap["sub_state"] = "dead"
    elif snap["result"] == "start-limit-hit" or (
        not alive and snap["n_restarts"] >= 2 and snap["active_state"] in ("failed", "inactive")
    ):
        snap["stopped"] = True
    return snap


def llama_fewer_layers() -> dict:
    """Relaunch with about half the current -ngl. Clears the crash-loop limit."""
    plan = build_offload_plan(honor_override=True)
    current = int(plan.get("n_gpu_layers") or 0)
    if current <= 1:
        base = build_offload_plan(honor_override=False)
        current = int(base.get("n_gpu_layers") or 1)
    nxt = max(1, current // 2)
    try:
        RUN.mkdir(parents=True, exist_ok=True)
        (RUN / "ngl.env").write_text(f"STICKLLM_N_GPU_LAYERS={nxt}\n", encoding="utf-8")
        os.chmod(RUN / "ngl.env", 0o644)
    except OSError as e:
        return {"ok": False, "error": f"cannot write ngl override: {e}"}
    try:
        (RUN / "llama-fail-count").write_text("0\n", encoding="utf-8")
    except OSError:
        pass
    sh(["systemctl", "reset-failed", "stickllm-llama.service"], timeout=30)
    r = sh(["systemctl", "restart", "stickllm-llama.service"], timeout=60)
    r["ok"] = r.get("code", 1) == 0
    r["n_gpu_layers"] = nxt
    r["previous_n_gpu_layers"] = current
    fresh = build_offload_plan(honor_override=True)
    write_offload_plan(fresh)
    r["caption"] = fresh.get("caption") or ""
    r["fit"] = fresh.get("fit") or ""
    r["llama_service"] = llama_service_snapshot(stop_loop=False)
    return r


def estimate_context_budget(
    *,
    vram_gb: float,
    ram_gb: float,
    approx_size_gb: float,
    backend: str,
    model_max_ctx: int = 0,
    dims: dict | None = None,
) -> dict:
    """Suggest a max context size from free memory after loading weights.

    Formula (documented for UI/ops):
      free_mem_after ≈ mem_gb - approx_size_gb * 1.05   # weights + small overhead
      If GGUF dims known (n_kv_layer, n_kv_head, head_dim):
        kv_bytes/token ≈ 2 * n_kv_layer * n_kv_head * head_dim * 2  # K+V, f16
        n_kv_layer is block_count, or block_count / full_attention_interval
        for hybrid models whose other layers are recurrent.
      Else ballpark from weight size (calibrated ~7B @ ~56 KiB/token):
        kv_bytes/token ≈ 56000 * (approx_size_gb / 5.1)
      max_ctx_mem = floor(free_mem_after_bytes / kv_bytes_per_token)
      Clamp to [2048, model_max_ctx] (GGUF context_length when available).
      GPU hosts are not capped at 32K. A CPU host stays at 8K.
    """
    dims = dims or {}
    size = max(0.1, float(approx_size_gb or 0) or 2.0)
    gpu = backend in ("cuda", "vulkan") and vram_gb > 0.5
    mem_gb = float(vram_gb if gpu else ram_gb) or 0.0
    free_after = max(0.0, mem_gb - size * 1.05)
    # Leave a little headroom for runtime / fragmentation.
    free_after *= 0.85

    n_layer = int(dims.get("n_kv_layer") or dims.get("n_layer") or 0)
    n_kv = int(dims.get("n_kv_head") or 0)
    head_dim = int(dims.get("head_dim") or 0)
    if n_layer > 0 and n_kv > 0 and head_dim > 0:
        kv_bpt = 2 * n_layer * n_kv * head_dim * 2  # K+V f16
    else:
        kv_bpt = int(56000 * (size / 5.1))
    kv_bpt = max(8192, kv_bpt)

    max_from_mem = int((free_after * (1024**3)) // kv_bpt) if free_after > 0 else 2048
    train_ctx = int(model_max_ctx or dims.get("n_ctx_train") or 0)
    if train_ctx <= 0:
        train_ctx = 32768
    # CPU hosts stay small. GPU hosts follow the GGUF context length.
    ceiling = train_ctx if gpu else min(train_ctx, 8192)
    hi = max(2048, min(ceiling, max(2048, max_from_mem)))
    # Snap down to a friendly step.
    step = 1024 if hi <= 8192 else 2048
    hi = max(2048, (hi // step) * step)
    # Default suggestion: prefer 8k when it fits, else half of hi, else hi.
    suggested = 8192 if hi >= 8192 else (4096 if hi >= 4096 else hi)
    if suggested > hi:
        suggested = hi
    return {
        "ctx_min": 2048,
        "ctx_max": hi,
        "ctx_suggested": suggested,
        "ctx_model_max": train_ctx,
        "free_mem_after_gb": round(free_after, 2),
        "kv_bytes_per_token": kv_bpt,
    }


def detect_backend() -> str:
    """Prefer runtime breadcrumb from pick-gpus / llama-start over nvidia-smi."""
    for path in (RUN / "llama-runtime.env", RUN / "cuda.env"):
        try:
            if not path.is_file():
                continue
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith("backend="):
                    b = line.split("=", 1)[1].strip().lower()
                    if b in ("cuda", "vulkan", "cpu"):
                        return b
                if line.startswith("STICKLLM_BACKEND="):
                    b = line.split("=", 1)[1].strip().lower()
                    if b in ("cuda", "vulkan", "cpu"):
                        return b
        except Exception:
            pass
    if has_nvidia():
        return "cuda"
    return "cpu"


def llama_health_ok() -> tuple[bool, str]:
    try:
        p = subprocess.run(
            ["curl", "-fsS", "--max-time", "2", "http://127.0.0.1:8080/health"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if p.returncode != 0:
            return False, (p.stderr or p.stdout or "llama /health failed").strip()[:200]
        try:
            data = json.loads(p.stdout or "{}")
        except Exception:
            return True, "ok"
        err = data.get("error")
        if err:
            return False, str(err)[:200]
        st = str(data.get("status") or "ok").lower()
        if st in ("ok", "healthy", ""):
            return True, st or "ok"
        return False, st
    except Exception as e:
        return False, str(e)[:200]


# stickllm-llama-start raises any smaller context to this (Agent Zero needs it).
LLAMA_CTX_FLOOR = 32768
KV_TYPES = {"f16": "f16", "q8": "q8_0", "q8_0": "q8_0", "q4": "q4_0", "q4_0": "q4_0"}


def active_kv_type() -> str:
    """KV cache type Activate wrote to model.env (f16 when unset)."""
    env = RUN / "model.env"
    try:
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_KV_TYPE="):
                return KV_TYPES.get(line.split("=", 1)[1].strip(), "f16")
    except OSError:
        pass
    return "f16"


def active_ctx_size() -> int | None:
    """Context llama-server really runs with: model.env (raised to the
    llama-start floor), else the running llama-server --ctx-size."""
    env = RUN / "model.env"
    if env.is_file():
        try:
            for line in env.read_text(encoding="utf-8").splitlines():
                if line.startswith("STICKLLM_CTX_SIZE="):
                    return max(LLAMA_CTX_FLOOR, int(line.split("=", 1)[1].strip()))
        except (OSError, ValueError, TypeError):
            pass
    # Older Activate writes omitted STICKLLM_CTX_SIZE — read live process args.
    try:
        for proc in Path("/proc").iterdir():
            if not proc.name.isdigit():
                continue
            try:
                raw = (proc / "cmdline").read_bytes()
            except OSError:
                continue
            if b"llama-server" not in raw:
                continue
            parts = raw.split(b"\0")
            for i, p in enumerate(parts):
                if p in (b"--ctx-size", b"-c") and i + 1 < len(parts):
                    try:
                        return int(parts[i + 1].decode("utf-8", "replace"))
                    except ValueError:
                        break
                if p.startswith(b"--ctx-size="):
                    try:
                        return int(p.split(b"=", 1)[1].decode("utf-8", "replace"))
                    except ValueError:
                        break
    except OSError:
        pass
    return None


def active_model_identity() -> dict:
    path = active_model_path()
    mid = ""
    name = ""
    env = RUN / "model.env"
    if env.is_file():
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MODEL_ID="):
                mid = line.split("=", 1)[1].strip()
            elif line.startswith("STICKLLM_MODEL_NAME="):
                name = line.split("=", 1)[1].strip()
    # A missing id/name stays the file Activate selected. Never invent the
    # baked 3B (or 7B) from a substring — "27b" contains "7b", and a load of
    # another id must not be reported as the default 3B.
    if not name and path:
        name = os.path.basename(path)
    healthy, health_msg = llama_health_ok()
    ctx = active_ctx_size()
    out = {
        "path": path,
        "id": mid,
        "name": name or (os.path.basename(path) if path else ""),
        "running": healthy,
        "health": health_msg,
    }
    if ctx is not None:
        out["ctx_size"] = ctx
    out["kv_type"] = active_kv_type()
    return out


def find_mmproj(model_path: str) -> str:
    """Vision projector GGUF sitting next to the weights. Empty if this model is text-only."""
    p = Path(model_path)
    if not p.is_file():
        return ""
    cands: list[Path] = []
    try:
        for f in p.parent.iterdir():
            if not f.is_file() or f.resolve() == p.resolve():
                continue
            low = f.name.lower()
            if low.endswith(".gguf") and "mmproj" in low:
                cands.append(f)
    except OSError:
        return ""
    if not cands:
        return ""
    cands.sort(key=lambda f: f.stat().st_size if f.is_file() else 0, reverse=True)
    return str(cands[0])


def active_model_path() -> str:
    """Path from explicit Activate only — never invent a baked default at boot."""
    env = RUN / "model.env"
    if env.is_file():
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MODEL="):
                return line.split("=", 1)[1].strip()
    cur = RUN / "current.gguf"
    if cur.is_symlink() or cur.is_file():
        try:
            return str(cur.resolve())
        except Exception:
            pass
    return ""


_HF_COMMUNITY = {
    "qwen", "bartowski", "unsloth", "lmstudio-community", "thebloke", "ggml-org",
    "microsoft", "meta-llama", "mistralai", "google", "nvidia", "hugging-quants",
    "maziyarpanahi", "second-state", "quantfactory", "librai", "nousresearch",
}
_QUANT_RE = re.compile(
    r"(IQ\d+_[A-Z0-9]+|Q\d+_K_[A-Z0-9]+|Q\d+_K|Q\d+_0|Q\d+_1|F16|F32|BF16)",
    re.I,
)


# Same text as stickllm_verify.UNVERIFIED_WARNING and the UI confirm box.
UNVERIFIED_WARNING = "Not verified by StickLLM: this hasn't been checked and may be unsafe"


def _catalog_sha_index() -> dict[tuple[str, str], str]:
    idx: dict[tuple[str, str], str] = {}
    for m in parse_catalog():
        repo = str(m.get("hf_repo") or "")
        files = m.get("hf_files") or []
        hashes = m.get("sha256") or []
        for i, name in enumerate(files):
            sha = ""
            if i < len(hashes):
                sha = str(hashes[i] or "").lower()
            if repo and name and re.fullmatch(r"[0-9a-f]{64}", sha):
                idx[(repo, name)] = sha
    return idx


def _hf_get_json(url: str, timeout: float = 12) -> object:
    headers = {"User-Agent": "StickLLM/0.4 (local model search)", "Accept": "application/json"}
    token = read_hf_token()
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8", "replace"))


def _is_abliterated(*parts: str) -> bool:
    blob = " ".join(parts).lower()
    return any(k in blob for k in ("abliterat", "uncensor", "jailbreak"))


_VISION_RE = re.compile(
    r"(?:^|[^a-z0-9])(?:vl|vision)(?:[^a-z0-9]|$)"
    r"|qwen\d*(?:\.\d+)?-?vl|llava|moondream|minicpm-?v|internvl|pixtral|smolvlm|glm-?4v|kimi-?vl|idefics",
    re.I,
)


def _pick_mmproj(files: list[tuple[str, int]]) -> tuple[str, int] | None:
    """Prefer an f16/bf16 projector. One projector does not fit a different model."""
    if not files:
        return None

    def score(pair: tuple[str, int]) -> tuple[int, int]:
        low = pair[0].lower()
        pref = 0 if ("f16" in low or "bf16" in low) else 1
        return (pref, -pair[1])

    return sorted(files, key=score)[0]


def _sidecar_repo(model_path: str) -> str:
    p = Path(model_path)
    sc = Path(str(p) + ".stickllm.json")
    if not sc.is_file():
        return ""
    try:
        doc = json.loads(sc.read_text(encoding="utf-8"))
    except Exception:
        return ""
    repo = str(doc.get("repo") or "").strip()
    return repo if "/" in repo else ""


def looks_vision(*parts: str) -> bool:
    blob = " ".join(p for p in parts if p).replace("_", "-")
    return bool(_VISION_RE.search(blob))


def hf_search(query: str, abl: str = "include", vision: str = "any") -> dict:
    """Search Hugging Face for GGUF files. Catalog hash hits are Verified."""
    q = " ".join(str(query or "").split())
    if len(q) < 2:
        return {"ok": False, "error": "type at least 2 characters"}
    abl = str(abl or "include").lower()
    if abl not in ("include", "only", "exclude"):
        abl = "include"
    # "Only" must ask HF for abliterated repos. Filtering the popular Qwen list
    # locally finds none, because those top hits are the normal instruct models.
    vision = str(vision or "any").lower()
    if vision not in ("any", "only"):
        vision = "any"
    search_q = q
    if abl == "only" and "abliterat" not in q.lower() and "uncensor" not in q.lower():
        search_q = q + " abliterated"
    if vision == "only" and not looks_vision(q):
        search_q = search_q + " VL"
    search_url = "https://huggingface.co/api/models?" + urllib.parse.urlencode(
        {
            "search": search_q,
            "filter": "gguf",
            "sort": "downloads",
            "direction": "-1",
            "limit": "8",
        }
    )
    try:
        listing = _hf_get_json(search_url, timeout=15)
    except urllib.error.URLError as exc:
        return {"ok": False, "error": f"Hugging Face unreachable: {exc.reason if hasattr(exc, 'reason') else exc}"}
    except Exception as exc:
        return {"ok": False, "error": f"Hugging Face search failed: {exc}"}
    if not isinstance(listing, list):
        return {"ok": False, "error": "unexpected Hugging Face response"}
    sha_idx = _catalog_sha_index()
    installed_names: set[str] = set()
    for folder in model_dirs():
        try:
            for p in gguf_index([Path(folder)]).get(Path(folder), []):
                installed_names.add(p.name.lower())
        except OSError:
            continue
    prefer = ("Q4_K_M", "Q5_K_M", "Q6_K", "Q8_0", "Q4_K_S", "Q3_K_M", "IQ4_XS")
    models: list[dict] = []
    for item in listing:
        if len(models) >= 24:
            break
        if not isinstance(item, dict):
            continue
        repo = str(item.get("id") or item.get("modelId") or "").strip()
        if not repo or "/" not in repo:
            continue
        try:
            tree = _hf_get_json(
                "https://huggingface.co/api/models/"
                + urllib.parse.quote(repo, safe="/")
                + "/tree/main",
                timeout=12,
            )
        except Exception:
            continue
        if not isinstance(tree, list):
            continue
        files = []
        mmproj_files: list[tuple[str, int]] = []
        lfs_sha: dict[str, str] = {}
        for sib in tree:
            if not isinstance(sib, dict) or sib.get("type") not in (None, "file"):
                continue
            name = str(sib.get("path") or sib.get("rfilename") or "")
            if not name.lower().endswith(".gguf"):
                continue
            low = name.lower()
            try:
                size = int(sib.get("size") or 0)
            except (TypeError, ValueError):
                size = 0
            if "mmproj" in low:
                mmproj_files.append((name, size))
                continue
            oid = str((sib.get("lfs") or {}).get("oid") or "").lower() if isinstance(sib.get("lfs"), dict) else ""
            if re.fullmatch(r"[0-9a-f]{64}", oid):
                lfs_sha[name] = oid
            files.append((name, size))
        def rank(pair: tuple[str, int]) -> tuple[int, int, int]:
            qm = _QUANT_RE.search(pair[0])
            quant = qm.group(1).upper() if qm else ""
            try:
                pri = prefer.index(quant)
            except ValueError:
                pri = 50
            split = 1 if "-of-" in pair[0].lower() else 0
            return (pri, split, -pair[1])
        files.sort(key=rank)
        org = repo.split("/", 1)[0].lower()
        downloads = int(item.get("downloads") or 0)
        for name, size in files[:4]:
            if len(models) >= 24:
                break
            ablit = _is_abliterated(repo, name)
            picked = _pick_mmproj(mmproj_files)
            sees = bool(picked) or looks_vision(repo, name)
            if vision == "only" and not sees:
                continue
            if abl == "only" and not ablit:
                continue
            if abl == "exclude" and ablit:
                continue
            sha = sha_idx.get((repo, name), "")
            if sha:
                trust = "verified"
            elif org in _HF_COMMUNITY:
                trust = "community"
            else:
                trust = "untrusted"
            qm = _QUANT_RE.search(name)
            quant = qm.group(1).upper() if qm else ""
            base = Path(name).name
            mid = "hf:" + repo.replace("/", "__") + ":" + base
            models.append(
                {
                    "id": mid,
                    "name": base.replace(".gguf", ""),
                    "repo": repo,
                    "file": name,
                    "hf_repo": repo,
                    "hf_file": name,
                    "sha256": sha,
                    # Hugging Face's own LFS sha256: checks the download is the
                    # file HF serves, not that StickLLM reviewed it.
                    "lfs_sha256": lfs_sha.get(name, ""),
                    "verified": bool(sha),
                    "trust": trust,
                    "quant": quant,
                    "bytes": size,
                    "approx_size_gb": round(size / (1024 ** 3), 2) if size else 0,
                    "downloads": downloads,
                    "installed": base.lower() in installed_names,
                    "source": "huggingface",
                    "format": "GGUF",
                    "hf": True,
                    "pinned": bool(sha),
                    "abliterated": ablit,
                    "vision": sees,
                    "mmproj_file": picked[0] if picked else "",
                    "mmproj_bytes": picked[1] if picked else 0,
                    "mmproj_ready": bool(picked) and Path(picked[0]).name.lower() in installed_names,
                }
            )
    return {"ok": True, "query": q, "models": models}


def parse_catalog() -> list[dict]:
    if not CATALOG.is_file():
        return []
    text = CATALOG.read_text(encoding="utf-8")
    out = []
    for b in re.split(r"\n\[\[model\]\]\n", text)[1:]:
        def g(key: str, default: str = "") -> str:
            m = re.search(rf"^{key}\s*=\s*(.+)$", b, re.M)
            if not m:
                return default
            return m.group(1).strip().strip('"')

        mid = g("id")
        if not mid:
            continue
        repo = g("hf_repo", "")
        fm = re.search(r"^hf_files\s*=\s*\[(.*?)\]", b, re.M | re.S)
        files = re.findall(r'"([^"]*)"', fm.group(1)) if fm else []
        # Baked 7B may have no need to re-download but is installed
        if mid == "qwen25-7b-q5km" and not files:
            files = [
                "qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf",
                "qwen2.5-7b-instruct-q5_k_m-00002-of-00002.gguf",
            ]
        out.append(
            {
                "id": mid,
                "name": g("name", mid),
                "tier": g("tier"),
                "approx_size_gb": float(g("approx_size_gb", "0") or 0),
                "min_vram_gb": float(g("min_vram_gb", "0") or 0),
                "quality_rank": int(float(g("quality_rank", "0") or 0)),
                "vision": g("vision", "false").lower() == "true",
                "pinned": bool(repo) and bool(files),
                "hf_repo": repo,
                "hf_files": files,
                "notes": g("notes"),
            }
        )
    out.sort(key=lambda m: -m["quality_rank"])
    return out


def _fmt_gb(n: int) -> str:
    return f"{max(0, int(n)) / (1024 ** 3):.1f} GB"


QUEUE_DISK_NAME = ".stickllm-download-queue.json"
VAULT_MNT = Path("/var/lib/stickllm/vault")
SETTINGS_MNT = Path("/mnt/stickllm-settings")
SPEECH_DIR = Path("/opt/stickllm/speech")
HF_TOKEN_NAME = "hf-token"


def _queue_disk_path() -> Path | None:
    dest = get_preferred_models_dir()
    if dest is None:
        return None
    return dest / QUEUE_DISK_NAME


def _queue_doc(path: Path) -> dict:
    doc = read_json(path)
    return doc if isinstance(doc, dict) else {}


def _queue_items(doc: dict) -> list[dict]:
    raw = doc.get("items")
    if not isinstance(raw, list):
        return []
    return [i for i in raw if isinstance(i, dict)]


def _queue_load() -> list[dict]:
    """Live /run copy, or the models-folder copy after a reboot."""
    run_doc = _queue_doc(QUEUE_PATH) if QUEUE_PATH.is_file() else {}
    disk = _queue_disk_path()
    disk_doc = _queue_doc(disk) if disk is not None and disk.is_file() else {}
    run_items = _queue_items(run_doc)
    disk_items = _queue_items(disk_doc)
    try:
        run_u = int(run_doc.get("updated") or 0)
    except (TypeError, ValueError):
        run_u = 0
    try:
        disk_u = int(disk_doc.get("updated") or 0)
    except (TypeError, ValueError):
        disk_u = 0
    if run_items and (not disk_items or run_u >= disk_u):
        return run_items
    return disk_items or run_items


def _queue_save(items: list[dict]) -> None:
    # Never persist a token. The queue file sits in the models folder in the clear.
    clean = []
    for item in items:
        row = {k: v for k, v in item.items() if k not in ("token", "hf_token", "authorization")}
        clean.append(row)
    doc = {"updated": int(time.time()), "items": clean}
    text = json.dumps(doc, indent=2) + "\n"
    RUN.mkdir(parents=True, exist_ok=True)
    tmp = QUEUE_PATH.with_suffix(".json.tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(QUEUE_PATH)
    disk = _queue_disk_path()
    if disk is None:
        return
    try:
        disk.parent.mkdir(parents=True, exist_ok=True)
        dtmp = disk.with_suffix(".json.tmp")
        dtmp.write_text(text, encoding="utf-8")
        dtmp.replace(disk)
    except OSError:
        pass


def vault_settings_dir() -> Path | None:
    if not os.path.ismount(str(VAULT_MNT)):
        return None
    d = VAULT_MNT / "settings"
    try:
        d.mkdir(parents=True, exist_ok=True)
        os.chmod(d, 0o700)
    except OSError:
        return None
    return d


def _settings_api():
    cached = getattr(_settings_api, "_mod", None)
    if cached is not None:
        return cached
    lib = Path("/usr/local/lib/stickllm_usb_settings.py")
    if not lib.is_file():
        return None
    import importlib.util

    spec = importlib.util.spec_from_file_location("stickllm_usb_settings", lib)
    if spec is None or spec.loader is None:
        return None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    _settings_api._mod = mod
    return mod


def portable_secrets_dir() -> Path | None:
    """Encrypted USB settings secrets dir. Never the speech tree or an unmounted path."""
    if SETTINGS_MNT == SPEECH_DIR or SETTINGS_MNT == VAULT_MNT:
        return None
    if not os.path.ismount(str(SETTINGS_MNT)):
        return None
    mod = _settings_api()
    if mod is not None:
        try:
            mod.assert_settings_mount(SETTINGS_MNT)
        except ValueError:
            return None
    d = SETTINGS_MNT / "secrets"
    try:
        d.mkdir(parents=True, exist_ok=True)
        os.chmod(d, 0o700)
    except OSError:
        return None
    return d


def _clean_token(raw: str) -> str:
    raw = str(raw or "").strip()
    if not raw or len(raw) > 400 or any(c.isspace() for c in raw):
        return ""
    return raw


def _read_token_file(path: Path) -> str:
    try:
        return _clean_token(path.read_text(encoding="utf-8"))
    except OSError:
        return ""


def _write_token_file(path: Path, token: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(token + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    os.chmod(path, 0o600)


def _vault_token_path() -> Path | None:
    d = vault_settings_dir()
    if d is None:
        return None
    return d / HF_TOKEN_NAME


def read_hf_token() -> str:
    secrets = portable_secrets_dir()
    if secrets is not None:
        current = _read_token_file(secrets / HF_TOKEN_NAME)
        legacy_path = _vault_token_path()
        legacy = _read_token_file(legacy_path) if legacy_path is not None else ""
        if current:
            if legacy_path is not None and legacy:
                try:
                    legacy_path.unlink()
                except OSError:
                    pass
            return current
        if legacy:
            try:
                _write_token_file(secrets / HF_TOKEN_NAME, legacy)
                if legacy_path is not None:
                    legacy_path.unlink()
            except OSError:
                return legacy
            return legacy
        return ""
    legacy_path = _vault_token_path()
    if legacy_path is None:
        return ""
    return _read_token_file(legacy_path)


def write_hf_token(token: str) -> dict:
    token = _clean_token(token)
    secrets = portable_secrets_dir()
    settings_open = secrets is not None
    if secrets is None:
        d = vault_settings_dir()
        if d is None:
            return {
                "ok": False,
                "saved": False,
                "settings_mounted": False,
                "error": "Unlock the vault to save the Hugging Face token",
            }
        path = d / HF_TOKEN_NAME
        if not token:
            try:
                path.unlink()
            except OSError:
                pass
            return {
                "ok": True,
                "saved": False,
                "settings_mounted": False,
                "note": "Hugging Face token removed from the vault",
            }
        if not token.startswith("hf_") or len(token) < 10:
            return {"ok": False, "saved": False, "settings_mounted": False, "error": "Token should look like hf_…"}
        _write_token_file(path, token)
        return {
            "ok": True,
            "saved": True,
            "settings_mounted": False,
            "note": "USB settings partition is not open; token saved in the vault until that partition is available",
        }
    path = secrets / HF_TOKEN_NAME
    legacy = _vault_token_path()
    if not token:
        try:
            path.unlink()
        except OSError:
            pass
        if legacy is not None:
            try:
                legacy.unlink()
            except OSError:
                pass
        return {
            "ok": True,
            "saved": False,
            "settings_mounted": True,
            "note": "Hugging Face token removed from USB stick settings",
        }
    if not token.startswith("hf_") or len(token) < 10:
        return {"ok": False, "saved": False, "settings_mounted": True, "error": "Token should look like hf_…"}
    mod = _settings_api()
    if mod is not None:
        ok, why = mod.validate_secret_name(HF_TOKEN_NAME)
        if not ok:
            return {"ok": False, "saved": False, "settings_mounted": True, "error": why}
    _write_token_file(path, token)
    if legacy is not None:
        try:
            legacy.unlink()
        except OSError:
            pass
    return {
        "ok": True,
        "saved": True,
        "settings_mounted": settings_open,
        "note": "Hugging Face token saved on the USB stick settings partition",
    }


def _public_queue(items: list[dict]) -> list[dict]:
    out = []
    for j in items:
        state = str(j.get("state") or "pending")
        if state == "done":
            continue
        done = _bytes_on_disk(j)
        total = int(j.get("bytes") or 0)
        pct = None
        prog = read_json(RUN / "download-progress.json")
        if state == "active" and str(prog.get("id") or "") == str(j.get("id") or ""):
            try:
                done = int(prog.get("bytes_done") or done)
            except (TypeError, ValueError):
                pass
            try:
                total = int(prog.get("bytes_total") or total) or total
            except (TypeError, ValueError):
                pass
            pct = prog.get("percent")
        if pct is None and total > 0:
            pct = round(min(99.9, 100.0 * done / total), 1)
        out.append(
            {
                "id": j.get("id") or "",
                "name": j.get("name") or j.get("file") or j.get("id") or "model",
                "file": Path(str(j.get("file") or "")).name,
                "bytes": total,
                "bytes_done": done,
                "percent": pct,
                "state": state,
                "error": j.get("error") or "",
            }
        )
    return out


def _job_base(job: dict) -> str:
    return Path(str(job.get("file") or "")).name


def _same_job(a: dict, b: dict) -> bool:
    aid, bid = str(a.get("id") or ""), str(b.get("id") or "")
    if aid and aid == bid:
        return True
    af, bf = _job_base(a), _job_base(b)
    if not af or not bf or af != bf:
        return False
    return str(a.get("repo") or "") == str(b.get("repo") or "")


def _final_path(job: dict) -> Path:
    return Path(str(job.get("dest") or "")) / _job_base(job)


def _bytes_on_disk(job: dict) -> int:
    final = _final_path(job)
    partial = Path(str(final) + ".partial")
    try:
        if final.is_file():
            return final.stat().st_size
        if partial.is_file():
            return partial.stat().st_size
    except OSError:
        return 0
    return 0


def _job_remaining(job: dict) -> int:
    need = int(job.get("bytes") or 0)
    if need <= 0:
        return 0
    return max(0, need - _bytes_on_disk(job))


def _job_complete(job: dict) -> bool:
    final = _final_path(job)
    try:
        if not final.is_file():
            return False
        need = int(job.get("bytes") or 0)
        if need <= 0:
            return True
        return final.stat().st_size >= int(need * 0.98)
    except OSError:
        return False


def _has_partial(job: dict) -> bool:
    try:
        return Path(str(_final_path(job)) + ".partial").is_file()
    except OSError:
        return False


def write_download_sidecar(job: dict) -> None:
    dest = Path(str(job.get("dest") or ""))
    base = _job_base(job)
    if not dest or not base:
        return
    try:
        dest.mkdir(parents=True, exist_ok=True)
        doc = {
            "id": job.get("id") or "",
            "name": job.get("name") or base,
            "repo": job.get("repo") or "",
            "file": job.get("file") or base,
            "sha256": job.get("sha256") or "",
            "bytes": int(job.get("bytes") or 0),
            "dest": str(dest),
        }
        (dest / f"{base}.stickllm.json").write_text(json.dumps(doc) + "\n", encoding="utf-8")
    except OSError:
        pass


def _discover_partial_jobs() -> list[dict]:
    """Sidecars next to unfinished files so an interrupted download can resume."""
    found: list[dict] = []
    seen: set[str] = set()
    for d in model_dirs():
        try:
            sidecars = list(d.glob("*.gguf.stickllm.json"))
        except OSError:
            continue
        for sc in sidecars:
            job = read_json(sc)
            if not job.get("file") and not job.get("id"):
                continue
            job.setdefault("dest", str(d))
            job.setdefault("state", "pending")
            job.setdefault("source", "partial")
            key = str(job.get("id") or "") + "|" + _job_base(job)
            if key in seen or _job_complete(job):
                continue
            if not _has_partial(job) and not _final_path(job).is_file():
                # Sidecar with nothing on disk yet is only useful if already queued.
                continue
            if not _has_partial(job):
                continue
            seen.add(key)
            found.append(job)
    return found


def _order_queue(items: list[dict]) -> list[dict]:
    active = [j for j in items if j.get("state") == "active"]
    failed = [j for j in items if j.get("state") == "failed"]
    paused = [j for j in items if j.get("state") == "paused"]
    pending = [j for j in items if j.get("state") not in ("active", "failed", "done", "paused")]
    # Clicks stay in order. Interrupted partials resume after those.
    user = [j for j in pending if j.get("source") != "partial"]
    resumed = [j for j in pending if j.get("source") == "partial"]
    return active + user + resumed + paused + failed


def _merge_discovered(items: list[dict]) -> list[dict]:
    for job in _discover_partial_jobs():
        if any(_same_job(job, existing) for existing in items):
            continue
        job["state"] = "pending"
        items.append(job)
    return _order_queue(items)


def _drop_finished(items: list[dict]) -> list[dict]:
    prog = read_json(RUN / "download-progress.json")
    prog_id = str(prog.get("id") or "")
    prog_state = str(prog.get("state") or "")
    kept = []
    for j in items:
        if _job_complete(j):
            continue
        if prog_id and _same_job(j, {"id": prog_id, "file": prog.get("file") or ""}) and prog_state == "done":
            continue
        if j.get("state") == "active" and prog_state == "failed" and prog_id and str(j.get("id") or "") == prog_id:
            j["state"] = "failed"
            j["error"] = str(prog.get("note") or "download failed")
        kept.append(j)
    return kept


def _fs_free(path: Path) -> tuple[int, int]:
    probe = path if path.exists() else path.parent
    st = os.stat(probe)
    vfs = os.statvfs(probe)
    return st.st_dev, vfs.f_bavail * vfs.f_frsize


def _space_error(items: list[dict]) -> str:
    """Refuse a queue that would fill the models disk. 5% padding plus 2 GB spare."""
    groups: dict[int, dict] = {}
    for j in items:
        if j.get("state") == "failed":
            continue
        dest = Path(str(j.get("dest") or ""))
        if not str(dest):
            continue
        try:
            dev, free = _fs_free(dest if dest.exists() else dest.parent)
        except OSError:
            return f"Cannot check free space on {dest}"
        bucket = groups.setdefault(dev, {"free": free, "need": 0, "path": str(dest)})
        bucket["need"] += _job_remaining(j)
    spare = DOWNLOAD_SPARE_BYTES
    for bucket in groups.values():
        padded = int(bucket["need"] * 1.05)
        if padded + spare > bucket["free"]:
            return (
                f"Not enough free space on {bucket['path']}. "
                f"Queued downloads need {_fmt_gb(padded)} plus {_fmt_gb(spare)} spare, "
                f"and {_fmt_gb(bucket['free'])} is free."
            )
    return ""


def _pid_alive_download() -> bool:
    try:
        pid = int((RUN / "download.pid").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return False
    return "stickllm-download-model" in cmd


def _lock_held() -> bool:
    path = RUN / "download.lock"
    try:
        RUN.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o644)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        except OSError:
            return False
        else:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
            return False
    finally:
        os.close(fd)


def download_running() -> bool:
    if _pid_alive_download() or _live_downloader_pid() is not None:
        return True
    prog = read_json(RUN / "download-progress.json")
    if prog.get("state") in ("downloading", "verifying", "starting"):
        try:
            updated = int(prog.get("updated") or 0)
        except (TypeError, ValueError):
            updated = 0
        if updated and (time.time() - updated) < 25:
            return True
    try:
        started = json.loads((RUN / "download.starting").read_text(encoding="utf-8") or "{}")
        if time.time() - float(started.get("t") or 0) < 20 and _live_downloader_pid() is not None:
            return True
    except (OSError, ValueError, TypeError):
        pass
    return False


def _live_downloader_pid() -> int | None:
    """Pid of stickllm-download-model. Ignores shells that merely mention the name."""
    try:
        p = subprocess.run(
            ["pgrep", "-f", "/usr/local/bin/stickllm-download-model"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    for line in (p.stdout or "").split():
        if not line.isdigit():
            continue
        pid = int(line)
        try:
            cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
        except OSError:
            continue
        if "/usr/local/bin/stickllm-download-model" in cmd and "pgrep" not in cmd:
            return pid
    return None


def _running_job_from_proc() -> dict | None:
    pid = _live_downloader_pid()
    if pid is None:
        return None
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return None

    def grab(flag: str) -> str:
        m = re.search(rf"(?:^|\s){re.escape(flag)} (\S+)", cmd)
        return m.group(1) if m else ""

    hf_file = grab("--file")
    mid = grab("--id")
    if not mid and not hf_file:
        return None
    try:
        nbytes = int(grab("--bytes") or 0)
    except ValueError:
        nbytes = 0
    return {
        "id": mid or hf_file,
        "name": grab("--name") or (Path(hf_file).name if hf_file else mid),
        "repo": grab("--repo"),
        "file": hf_file,
        "sha256": grab("--sha256"),
        "bytes": nbytes,
        "dest": grab("--dest"),
        "state": "active",
        "source": "user",
        "starts": 1,
    }


def _mark_active(items: list[dict]) -> None:
    running = download_running()
    prog = read_json(RUN / "download-progress.json")
    prog_id = str(prog.get("id") or "")
    for j in items:
        if j.get("state") in ("failed", "paused"):
            continue
        if running and prog_id and str(j.get("id") or "") == prog_id:
            j["state"] = "active"
        elif j.get("state") == "active":
            j["state"] = "pending"


def _start_download_job(job: dict) -> None:
    write_download_sidecar(job)
    dest = str(job.get("dest") or "")
    cmd = ["/usr/local/bin/stickllm-download-model", "--i-understand"]
    repo = str(job.get("repo") or "")
    hf_file = str(job.get("file") or "")
    mid = str(job.get("id") or "hf")
    if repo and hf_file and not job.get("catalog"):
        cmd += ["--repo", repo, "--file", hf_file, "--id", mid]
        sha = str(job.get("sha256") or "").strip().lower()
        if re.fullmatch(r"[0-9a-f]{64}", sha):
            cmd += ["--sha256", sha]
        else:
            cmd += ["--allow-unpinned"]
        nbytes = int(job.get("bytes") or 0)
        if nbytes > 0:
            cmd += ["--bytes", str(nbytes)]
        name = str(job.get("name") or hf_file)[:160]
        if name:
            cmd += ["--name", name]
    else:
        cmd += ["--id", mid]
    if dest:
        cmd += ["--dest", dest]
    env = os.environ.copy()
    env["STICKLLM_SESSION_MODE"] = session_mode()
    if dest:
        env["STICKLLM_MODELS_DIR"] = dest
    token = read_hf_token()
    if token:
        env["STICKLLM_HF_TOKEN"] = token
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / "download.starting").write_text(
        json.dumps({"id": mid, "t": time.time()}) + "\n", encoding="utf-8"
    )
    now = int(time.time())
    (RUN / "download-progress.json").write_text(
        json.dumps(
            {
                "state": "starting",
                "id": mid,
                "name": job.get("name") or mid,
                "file": _job_base(job),
                "percent": 0,
                "bytes_done": _bytes_on_disk(job),
                "bytes_total": int(job.get("bytes") or 0),
                "note": "starting download",
                "started": now,
                "updated": now,
            }
        )
        + "\n",
        encoding="utf-8",
    )
    logf = open(RUN / "download.log", "a", encoding="utf-8")
    subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, start_new_session=True, env=env)
    job["state"] = "active"
    job["error"] = ""
    job["starts"] = int(job.get("starts") or 0) + 1
    job["last_start"] = time.time()


def _adopt_running(items: list[dict]) -> list[dict]:
    """A live downloader always shows in the queue, even if the file was empty."""
    live = _running_job_from_proc()
    if live is not None and not any(_same_job(live, existing) for existing in items):
        items.append(live)
    return items


def _pump_download_queue() -> dict:
    """Start the next queued model when nothing is already downloading."""
    items = _drop_finished(_queue_load())
    items = _merge_discovered(items)
    items = _adopt_running(items)
    _mark_active(items)
    if download_running():
        _queue_save(items)
        return {"started": False, "busy": True, "queue": _public_queue(items)}
    pending = [j for j in items if j.get("state") not in ("failed", "done", "active", "paused")]
    # A stale "active" mark with no process should be retried, unless it keeps dying.
    if not pending:
        pending = [j for j in items if j.get("state") == "active"]
    nxt = None
    for cand in pending:
        if int(cand.get("starts") or 0) >= 3:
            cand["state"] = "failed"
            cand["error"] = cand.get("error") or "stopped after repeated failures"
            continue
        nxt = cand
        break
    if nxt is None:
        _queue_save(_order_queue(items))
        return {"started": False, "busy": False, "queue": _public_queue(items)}
    err = _space_error([j for j in items if j.get("state") != "failed"])
    if err:
        nxt["error"] = err
        _queue_save(_order_queue(items))
        return {"started": False, "busy": False, "error": err, "queue": _public_queue(items)}
    _start_download_job(nxt)
    _queue_save(_order_queue(items))
    return {"started": True, "busy": True, "id": nxt.get("id") or "", "queue": _public_queue(items)}


def pump_download_queue() -> dict:
    with QUEUE_LOCK:
        return _pump_download_queue()


def _build_download_job(params: dict) -> dict:
    mid = str(params.get("id") or "").strip()
    repo = str(params.get("repo") or "").strip()
    hf_file = str(params.get("file") or "").strip()
    dest_param = str(params.get("dest") or params.get("path") or "").strip()
    if dest_param:
        set_r = set_preferred_models_dir(dest_param)
        if not set_r.get("ok"):
            return {"ok": False, "error": set_r.get("error") or "invalid models folder"}
    dest = get_preferred_models_dir() or vault_download_models_dir()
    beside = str(params.get("beside") or "").strip()
    if beside and Path(beside).is_dir():
        dest = Path(beside)
    if dest is None:
        return {"ok": False, "error": "choose a models folder before downloading"}
    sha = str(params.get("sha256") or "").strip().lower()
    try:
        nbytes = int(params.get("bytes") or 0)
    except (TypeError, ValueError):
        nbytes = 0
    name = str(params.get("name") or "").strip()
    if repo or hf_file:
        if not repo or not hf_file:
            return {"ok": False, "error": "repo and file are both required"}
        if not hf_file.lower().endswith(".gguf") or ".." in hf_file or hf_file.startswith("/"):
            return {"ok": False, "error": "only a GGUF file path is allowed"}
        if "/" not in repo:
            return {"ok": False, "error": "repo must look like org/name"}
        if nbytes <= 0:
            return {"ok": False, "error": "model size is unknown, so it cannot be queued safely"}
        # Verified models list = catalog.toml sha256 (docs/VERIFIED.md).
        pinned = _catalog_sha_index().get((repo, hf_file), "")
        if pinned and re.fullmatch(r"[0-9a-f]{64}", sha) and sha != pinned:
            return {"ok": False, "error": "blocked",
                    "message": "This file's hash does not match StickLLM's verified hash. Not downloaded."}
        if not pinned and params.get("accept_unverified") is not True:
            return {"ok": False, "error": "unverified", "message": UNVERIFIED_WARNING + ". Confirm on screen to download."}
        if pinned:
            sha = pinned
        return {
            "ok": True,
            "verified": bool(pinned),
            "id": mid or ("hf:" + repo.replace("/", "__") + ":" + Path(hf_file).name),
            "name": (name or Path(hf_file).name)[:160],
            "repo": repo,
            "file": hf_file,
            "sha256": sha if re.fullmatch(r"[0-9a-f]{64}", sha) else "",
            "bytes": nbytes,
            "dest": str(dest),
            "state": "pending",
            "starts": 0,
            "source": "user",
        }
    if not mid:
        return {"ok": False, "error": "id required"}
    match = next((m for m in parse_catalog() if m.get("id") == mid), None)
    if not match:
        return {"ok": False, "error": f"unknown model id: {mid}"}
    files = match.get("hf_files") or []
    if not files:
        return {"ok": False, "error": "model has no downloadable file"}
    nbytes = int(float(match.get("approx_size_gb") or 0) * (1024 ** 3))
    if nbytes <= 0:
        return {"ok": False, "error": "model size is unknown, so it cannot be queued safely"}
    return {
        "ok": True,
        "id": mid,
        "name": match.get("name") or mid,
        "repo": match.get("hf_repo") or "",
        "file": files[0],
        "sha256": "",
        "bytes": nbytes,
        "dest": str(dest),
        "state": "pending",
        "starts": 0,
        "source": "user",
        "catalog": True,
    }


def _enqueue_download(params: dict) -> dict:
    built = _build_download_job(params)
    if not built.get("ok"):
        return built
    job = {k: v for k, v in built.items() if k != "ok"}
    items = _drop_finished(_queue_load())
    items = _merge_discovered(items)
    for existing in items:
        if not _same_job(existing, job):
            continue
        if existing.get("state") == "active":
            return {
                "ok": True,
                "queued": False,
                "started": False,
                "note": "Already downloading",
                "download_dir": existing.get("dest") or "",
                "download": download_progress(),
                "queue": _public_queue(items),
                "catalog": enrich_models(),
            }
        if existing.get("state") == "failed" or existing.get("source") == "partial":
            existing.update({k: job[k] for k in ("name", "repo", "file", "sha256", "bytes", "dest")})
            existing["state"] = "pending"
            existing["source"] = "user"
            existing["error"] = ""
            existing["starts"] = 0
            items = _order_queue(items)
            err = _space_error(items)
            if err:
                return {"ok": False, "error": err, "queue": _public_queue(items)}
            write_download_sidecar(existing)
            _queue_save(items)
            pumped = _pump_download_queue()
            return {
                "ok": True,
                "queued": True,
                "started": bool(pumped.get("started")),
                "note": "Back in the download queue",
                "download_dir": job.get("dest") or "",
                "download": download_progress(),
                "queue": pumped.get("queue") or [],
                "catalog": enrich_models(),
            }
        state = "downloading" if existing.get("state") == "active" else "queued"
        return {
            "ok": True,
            "queued": state == "queued",
            "started": False,
            "note": "Already downloading" if state == "downloading" else "Already in the download queue",
            "download_dir": existing.get("dest") or "",
            "download": download_progress(),
            "queue": _public_queue(items),
            "catalog": enrich_models(),
        }
    if _job_complete(job):
        return {"ok": True, "started": False, "queued": False, "note": "Already downloaded", "queue": _public_queue(items)}
    if sum(1 for j in items if j.get("state") != "failed") >= DOWNLOAD_QUEUE_MAX:
        return {"ok": False, "error": f"Download queue is full ({DOWNLOAD_QUEUE_MAX})"}
    trial = items + [job]
    err = _space_error(trial)
    if err:
        return {"ok": False, "error": err, "queue": _public_queue(items)}
    write_download_sidecar(job)
    items.append(job)
    items = _order_queue(items)
    _queue_save(items)
    pending = [j for j in items if j.get("state") not in ("failed", "done")]
    pos = next((i + 1 for i, j in enumerate(pending) if _same_job(j, job)), len(pending))
    pumped = _pump_download_queue()
    started = bool(pumped.get("started")) and str(pumped.get("id") or "") == str(job.get("id") or "")
    if started:
        note = "Download started"
    else:
        note = f"Queued ({pos} of {len(pending)}). The current download keeps going."
    return {
        "ok": True,
        "queued": not started,
        "started": started,
        "position": pos,
        "note": note,
        "session_mode": session_mode(),
        "download_dir": job.get("dest") or "",
        "download": download_progress(),
        "queue": pumped.get("queue") or _public_queue(items),
        "catalog": enrich_models(),
    }


def download_mmproj(params: dict) -> dict:
    """Queue the mmproj that belongs to this model. It is not shared with other models."""
    repo = str(params.get("repo") or "").strip()
    model_path = str(params.get("path") or "").strip()
    hf_file = str(params.get("file") or "").strip()
    try:
        nbytes = int(params.get("bytes") or 0)
    except (TypeError, ValueError):
        nbytes = 0
    if not repo and model_path:
        repo = _sidecar_repo(model_path)
    if not repo or "/" not in repo:
        return {
            "ok": False,
            "error": "No Hugging Face repo is known for this file. Search for the model, then click its vision tag.",
        }
    if not hf_file or nbytes <= 0 or "mmproj" not in hf_file.lower():
        try:
            tree = _hf_get_json(
                "https://huggingface.co/api/models/"
                + urllib.parse.quote(repo, safe="/")
                + "/tree/main",
                timeout=20,
            )
        except Exception as exc:
            return {"ok": False, "error": f"Could not read that repo: {exc}"}
        cands: list[tuple[str, int]] = []
        if isinstance(tree, list):
            for sib in tree:
                if not isinstance(sib, dict):
                    continue
                name = str(sib.get("path") or sib.get("rfilename") or "")
                if "mmproj" not in name.lower() or not name.lower().endswith(".gguf"):
                    continue
                try:
                    size = int(sib.get("size") or 0)
                except (TypeError, ValueError):
                    size = 0
                if size > 0:
                    cands.append((name, size))
        picked = _pick_mmproj(cands)
        if not picked:
            return {"ok": False, "error": "That Hugging Face repo has no mmproj file for this model."}
        hf_file, nbytes = picked
    dest = ""
    if model_path and Path(model_path).is_file():
        dest = str(Path(model_path).parent)
        already = Path(dest) / Path(hf_file).name
        try:
            if already.is_file() and already.stat().st_size >= int(nbytes * 0.98):
                return {"ok": True, "already": True, "note": "This model's mmproj is already next to it."}
        except OSError:
            pass
    payload = {
        "id": str(params.get("id") or "") or ("mmproj:" + repo.replace("/", "__") + ":" + Path(hf_file).name),
        "repo": repo,
        "file": hf_file,
        "bytes": nbytes,
        "name": "mmproj · " + Path(hf_file).name,
    }
    if dest:
        payload["beside"] = dest
    return enqueue_download(payload)


def enqueue_download(params: dict) -> dict:
    with QUEUE_LOCK:
        return _enqueue_download(params)


def _find_queued(items: list[dict], mid: str) -> dict | None:
    mid = str(mid or "").strip()
    if not mid:
        return None
    for j in items:
        if str(j.get("id") or "") == mid:
            return j
    return None


def _stop_download_processes() -> None:
    """Stop the active downloader and its curl child. Leaves the .partial file."""
    pids: set[int] = set()
    try:
        pids.add(int((RUN / "download.pid").read_text(encoding="utf-8").strip()))
    except (OSError, ValueError):
        pass
    try:
        p = subprocess.run(
            ["pgrep", "-f", "/usr/local/bin/stickllm-download-model"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        for line in (p.stdout or "").split():
            if line.isdigit():
                pids.add(int(line))
    except (OSError, subprocess.SubprocessError):
        pass
    kids: set[int] = set()
    for pid in list(pids):
        try:
            raw = Path(f"/proc/{pid}/task/{pid}/children").read_text(encoding="utf-8")
        except OSError:
            continue
        kids.update(int(part) for part in raw.split() if part.isdigit())
    pids |= kids
    me = os.getpid()
    pids = {pid for pid in pids if pid > 1 and pid != me}
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(0.4)
    for pid in pids:
        try:
            os.kill(pid, 0)
        except OSError:
            continue
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    for name in ("download.pid", "download.starting"):
        try:
            (RUN / name).unlink()
        except OSError:
            pass
    now = int(time.time())
    try:
        (RUN / "download-progress.json").write_text(
            json.dumps(
                {
                    "state": "idle",
                    "id": "",
                    "name": "",
                    "note": "stopped",
                    "percent": 0,
                    "bytes_done": 0,
                    "bytes_total": 0,
                    "started": now,
                    "updated": now,
                }
            )
            + "\n",
            encoding="utf-8",
        )
    except OSError:
        pass


def _load_queue_now() -> list[dict]:
    items = _drop_finished(_queue_load())
    items = _merge_discovered(items)
    items = _adopt_running(items)
    _mark_active(items)
    return items


def _queue_stop(mid: str) -> dict:
    items = _load_queue_now()
    job = _find_queued(items, mid)
    if job is None:
        return {"ok": False, "error": "not in the download queue"}
    was_active = job.get("state") == "active" or (
        download_running() and str(read_json(RUN / "download-progress.json").get("id") or "") == str(job.get("id") or "")
    )
    job["state"] = "paused"
    job["error"] = ""
    _queue_save(_order_queue(items))
    if was_active:
        _stop_download_processes()
        items = _queue_load()
        again = _find_queued(items, mid)
        if again is not None:
            again["state"] = "paused"
            again["error"] = ""
        _queue_save(_order_queue(items))
        pumped = _pump_download_queue()
        return {
            "ok": True,
            "note": "Stopped. The partial file is kept.",
            "download": download_progress(),
            "queue": pumped.get("queue") or [],
        }
    return {
        "ok": True,
        "note": "Paused",
        "download": download_progress(),
        "queue": _public_queue(_order_queue(items)),
    }


def _queue_start(mid: str) -> dict:
    items = _load_queue_now()
    job = _find_queued(items, mid)
    if job is None:
        return {"ok": False, "error": "not in the download queue"}
    if download_running():
        for other in items:
            if other.get("state") == "active" and not _same_job(other, job):
                other["state"] = "paused"
                other["error"] = ""
        _queue_save(_order_queue(items))
        _stop_download_processes()
        items = _queue_load()
        job = _find_queued(items, mid)
        if job is None:
            return {"ok": False, "error": "not in the download queue"}
    job["state"] = "pending"
    job["source"] = "user"
    job["starts"] = 0
    job["error"] = ""
    rest = [j for j in items if not _same_job(j, job)]
    items = _order_queue([job] + rest)
    _queue_save(items)
    pumped = _pump_download_queue()
    return {
        "ok": True,
        "note": "Download started" if pumped.get("started") else "Queued to start",
        "started": bool(pumped.get("started")),
        "download": download_progress(),
        "queue": pumped.get("queue") or [],
    }


def _queue_remove(mid: str) -> dict:
    items = _load_queue_now()
    job = _find_queued(items, mid)
    if job is None:
        return {"ok": False, "error": "not in the download queue"}
    if job.get("state") == "active" or (
        download_running() and str(read_json(RUN / "download-progress.json").get("id") or "") == str(job.get("id") or "")
    ):
        _stop_download_processes()
    sidecar = Path(str(job.get("dest") or "")) / f"{_job_base(job)}.stickllm.json"
    try:
        sidecar.unlink()
    except OSError:
        pass
    items = [j for j in _queue_load() if not _same_job(j, job)]
    _queue_save(_order_queue(items))
    pumped = _pump_download_queue()
    return {
        "ok": True,
        "note": "Removed from the queue. The partial file is still on disk.",
        "download": download_progress(),
        "queue": pumped.get("queue") or [],
    }


def queue_stop(mid: str) -> dict:
    with QUEUE_LOCK:
        return _queue_stop(mid)


def queue_start(mid: str) -> dict:
    with QUEUE_LOCK:
        return _queue_start(mid)


def queue_remove(mid: str) -> dict:
    with QUEUE_LOCK:
        return _queue_remove(mid)


def download_progress() -> dict:
    """Best-effort download progress from progress file or *.partial sizes."""
    prog = read_json(RUN / "download-progress.json")
    if prog.get("state") in ("downloading", "verifying", "starting"):
        mid = prog.get("id") or ""
        still_partial = False
        for d in model_dirs():
            try:
                if any(d.glob("*.partial")):
                    still_partial = True
                    break
            except OSError:
                pass
        if not still_partial and mid and not download_running():
            for m in parse_catalog():
                if m.get("id") == mid:
                    files = m.get("hf_files") or []
                    if files and all(find_file(f) for f in files):
                        return {
                            "state": "done",
                            "id": mid,
                            "name": m.get("name", mid),
                            "percent": 100.0,
                            "bytes_done": prog.get("bytes_total") or 0,
                            "bytes_total": prog.get("bytes_total") or 0,
                            "note": "complete",
                        }
        return prog

    if prog.get("state") == "failed":
        return prog
    if prog.get("state") == "done":
        return prog

    partials: list[tuple[Path, int]] = []
    for d in model_dirs():
        try:
            for p in d.glob("*.partial"):
                try:
                    partials.append((p, p.stat().st_size))
                except OSError:
                    pass
        except OSError:
            pass
    if not partials:
        if _live_downloader_pid() is not None:
            return {
                "state": "downloading",
                "id": prog.get("id") or "",
                "name": prog.get("name") or "model download",
                "percent": None,
                "bytes_done": 0,
                "bytes_total": 0,
                "note": "download running (size unknown yet)",
            }
        return {"state": "idle"}

    partials.sort(key=lambda x: -x[1])
    path, done = partials[0]
    base = path.name[: -len(".partial")] if path.name.endswith(".partial") else path.name
    match = None
    for m in parse_catalog():
        files = m.get("hf_files") or []
        if base in files or any(base == f or f.endswith(base) for f in files):
            match = m
            break
    total = int(float((match or {}).get("approx_size_gb") or 0) * (1024**3))
    pct = None
    if total > 0:
        pct = max(0.0, min(99.9, round(100.0 * done / total, 1)))
    return {
        "state": "downloading",
        "id": (match or {}).get("id", prog.get("id") or ""),
        "name": (match or {}).get("name", prog.get("name") or base),
        "file": base,
        "percent": pct,
        "bytes_done": done,
        "bytes_total": total,
        "path": str(path),
        "note": "partial on disk",
        "updated": int(time.time()),
    }


def maybe_resume_stalled_download() -> dict:
    """Restart download if a .partial exists and the downloader died."""
    if download_running():
        return {"resumed": False}
    partial = None
    for d in model_dirs():
        try:
            for p in sorted(d.glob("*.partial"), key=lambda x: -x.stat().st_size):
                partial = p
                break
        except OSError:
            pass
        if partial:
            break
    if not partial:
        return {"resumed": False}
    prog = read_json(RUN / "download-progress.json")
    base = partial.name[: -len(".partial")] if partial.name.endswith(".partial") else partial.name
    mid = str(prog.get("id") or "").strip()
    if not mid:
        for m in parse_catalog():
            if base in (m.get("hf_files") or []):
                mid = m["id"]
                break
    if not mid:
        return {"resumed": False, "note": "partial without catalog match"}
    updated = int(prog.get("updated") or 0)
    stale = (time.time() - updated) > 180 if updated else True
    state = prog.get("state") or ""
    if state not in ("failed", "idle", "downloading", "starting", "verifying", "") and not stale:
        return {"resumed": False}
    if state in ("downloading", "starting", "verifying") and not stale:
        return {"resumed": False}
    RUN.mkdir(parents=True, exist_ok=True)
    logf = open(RUN / "download.log", "a", encoding="utf-8")
    subprocess.Popen(
        ["/usr/local/bin/stickllm-download-model", "--i-understand", "--id", mid],
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    return {"resumed": True, "id": mid}


def enrich_models(vram_gb: float | None = None) -> list[dict]:
    if vram_gb is None:
        vram_gb = detect_vram_gb()
    ram_gb = detect_ram_gb()
    gpu = has_nvidia()
    active = active_model_path()
    healthy, _ = llama_health_ok()
    loaded_ctx = active_ctx_size()
    models = parse_catalog() + discover_local_ggufs()
    gpu_rows = nvidia_gpu_rows() if gpu else []
    for m in models:
        files = m.get("hf_files") or []
        local = str(m.get("local_path") or "").strip()
        if local and Path(local).is_file():
            paths = [Path(local)]
            installed = True
        else:
            paths = [find_file(f) for f in files] if files else []
            installed = bool(files) and all(p is not None for p in paths)
        if not installed and m["id"] == "qwen25-7b-q5km" and BAKED_7B.is_file():
            installed = True
            paths = [BAKED_7B]
        if not installed and m["id"] == "qwen25-3b-q4km" and BAKED_3B.is_file():
            installed = True
            paths = [BAKED_3B]
        first = next((str(p) for p in paths if p), "")
        need = float(m.get("min_vram_gb") or 0)
        size_gb = float(m.get("approx_size_gb") or need or 0)
        if gpu:
            fits = vram_gb + 0.01 >= need if need > 0 else True
            fit_note = f"VRAM ~{vram_gb:.1f} GB"
        else:
            # CPU path: model weights must fit in available system RAM (ISS-018).
            budget = max(size_gb, need) * 1.15 + 1.5
            fits = ram_gb + 0.01 >= budget or need == 0 and size_gb <= ram_gb
            fit_note = f"RAM ~{ram_gb:.1f} GB available (CPU)"
        if need == 0 and gpu:
            fits = True
        # Local SSD GGUFs: allow Use when installed; VRAM fit is best-effort.
        if m.get("source") == "host_ssd" and installed:
            fits = True
            fit_note = (fit_note + " · host SSD").strip(" ·")
        runnable = installed and fits
        is_active = False
        if active and first:
            try:
                is_active = Path(active).resolve() == Path(first).resolve()
            except Exception:
                is_active = os.path.basename(active) == os.path.basename(first)
        elif active and m["id"] == "qwen25-7b-q5km" and "qwen2.5-7b" in active.lower():
            is_active = True
        elif (
            active
            and m["id"] == "qwen25-3b-q4km"
            and os.path.basename(active).lower() == BAKED_3B.name.lower()
        ):
            is_active = True
        # "Running" only when this model is active AND llama /health is ok.
        running = bool(is_active and healthy)
        # Baked /opt models stay protected; host SSD / vault / stick installs may be deleted.
        deletable = bool(
            installed
            and first
            and not str(first).startswith("/opt/stickllm/models/")
        )
        backend = "cuda" if gpu else "cpu"
        dims: dict = {}
        model_max_ctx = 0
        meta: dict = {}
        if first and Path(first).is_file():
            meta = read_gguf_meta(first)
            dims = gguf_arch_dims(meta)
            model_max_ctx = int(dims.get("n_ctx_train") or 0)
        budget = estimate_context_budget(
            vram_gb=vram_gb,
            ram_gb=ram_gb,
            approx_size_gb=size_gb,
            backend=backend,
            model_max_ctx=model_max_ctx,
            dims=dims,
        )
        offload_caption = ""
        offload_ngl = None
        offload_fit = ""
        if first and Path(first).is_file():
            try:
                nbytes = gguf_weight_bytes(Path(first))
            except OSError:
                nbytes = int(max(size_gb, 0.1) * 1e9)
            preview_ctx = int(budget.get("ctx_suggested") or 8192)
            preview = plan_gpu_fit(
                file_bytes=nbytes,
                ctx=preview_ctx,
                meta=meta if first else {},
                gpus=gpu_rows,
            )
            offload_caption = str(preview.get("caption") or "")
            offload_ngl = preview.get("n_gpu_layers")
            offload_fit = str(preview.get("fit") or "")
        entry = {
            "installed": installed,
            "runnable": runnable,
            "active": is_active,
            "running": running,
            "fits_vram": fits,
            "fits": fits,
            "fit_note": fit_note,
            "path": first,
            "vram_gb": round(vram_gb, 1),
            "ram_gb": round(ram_gb, 1),
            "backend": backend,
            "deletable": deletable,
            "max_context": budget["ctx_model_max"],
            "ctx_min": budget["ctx_min"],
            "ctx_max": budget["ctx_max"],
            "ctx_suggested": budget["ctx_suggested"],
            "free_mem_after_gb": budget["free_mem_after_gb"],
            "architecture": dims.get("architecture") or "",
            "offload_caption": offload_caption,
            "offload_ngl": offload_ngl,
            "offload_fit": offload_fit,
            "vision": bool(m.get("vision")) or looks_vision(
                str(m.get("name") or ""),
                str(m.get("id") or ""),
                str(dims.get("architecture") or ""),
                first,
            ) or bool(find_mmproj(first) if first else ""),
            "mmproj": find_mmproj(first) if first else "",
        }
        if is_active and loaded_ctx is not None:
            entry["ctx_loaded"] = loaded_ctx
        m.update(entry)
    return models


def activate_model(model_id: str, ctx_size: int | None = None, kv_type: str | None = None) -> dict:
    models = enrich_models()
    m = next((x for x in models if x["id"] == model_id), None)
    if not m:
        return {"ok": False, "error": f"unknown model: {model_id}"}
    if not m.get("installed"):
        return {"ok": False, "error": "model not downloaded yet"}
    if not m.get("fits") and m.get("source") != "host_ssd":
        if m.get("backend") == "cpu":
            return {
                "ok": False,
                "error": (
                    f"needs ~{m.get('approx_size_gb')} GB RAM on CPU; "
                    f"this host has ~{m.get('ram_gb')} GB available"
                ),
            }
        return {
            "ok": False,
            "error": f"needs {m['min_vram_gb']} GB VRAM; this host has ~{m['vram_gb']} GB",
        }
    path = m.get("path") or m.get("local_path") or ""
    if not path or not Path(path).is_file():
        return {"ok": False, "error": "model file missing"}
    ctx_lo = int(m.get("ctx_min") or 2048)
    ctx_hi = int(m.get("ctx_max") or 8192)
    if ctx_size is None:
        ctx = int(m.get("ctx_suggested") or min(8192, ctx_hi))
    else:
        try:
            ctx = int(ctx_size)
        except (TypeError, ValueError):
            return {"ok": False, "error": "ctx_size must be an integer"}
    ctx = max(ctx_lo, min(ctx_hi, ctx))
    kv = KV_TYPES.get(str(kv_type or "f16").strip().lower())
    if kv is None:
        return {"ok": False, "error": "kv_type must be f16, q8_0 or q4_0"}
    RUN.mkdir(parents=True, exist_ok=True)
    # A normal Load uses the VRAM fit. "Fewer GPU layers" is a separate override.
    try:
        (RUN / "ngl.env").unlink(missing_ok=True)
    except Exception:
        pass
    mmproj = "" if m.get("backend") == "cpu" else str(m.get("mmproj") or find_mmproj(path) or "")
    env_txt = (
        f"STICKLLM_MODEL={path}\n"
        f"STICKLLM_MODEL_ID={model_id}\n"
        f"STICKLLM_MODEL_NAME={m.get('name') or model_id}\n"
        f"STICKLLM_CTX_SIZE={ctx}\n"
        f"STICKLLM_KV_TYPE={kv}\n"
    )
    if mmproj and Path(mmproj).is_file():
        env_txt += f"STICKLLM_MMPROJ={mmproj}\n"
    (RUN / "model.env").write_text(env_txt, encoding="utf-8")
    try:
        os.chmod(RUN / "model.env", 0o644)
    except Exception:
        pass
    try:
        cur = RUN / "current.gguf"
        if cur.exists() or cur.is_symlink():
            cur.unlink()
        cur.symlink_to(path)
    except Exception:
        pass
    sh(["systemctl", "reset-failed", "stickllm-llama.service"], timeout=30)
    # model.env now exists → ConditionPathExists passes; start/restart loads on demand.
    r = sh(["systemctl", "restart", "stickllm-llama.service"], timeout=60)
    # Brief health peek only — large GGUFs take minutes; UI polls Loading → Running.
    # (Previously waited ~20s and blocked the Activate response / Loading paint.)
    healthy = False
    health_msg = "starting"
    for _ in range(4):
        time.sleep(0.35)
        healthy, health_msg = llama_health_ok()
        if healthy:
            break
    r["ok"] = r.get("code", 1) == 0
    r["active_model"] = path
    r["id"] = model_id
    r["name"] = m.get("name") or model_id
    r["ctx_size"] = max(LLAMA_CTX_FLOOR, ctx)
    r["ctx_requested"] = ctx
    r["kv_type"] = kv
    r["running"] = healthy
    r["health"] = health_msg
    r["load_state"] = "running" if healthy else "loading"
    r["offload"] = write_offload_plan(build_offload_plan())
    r["llama_service"] = llama_service_snapshot(stop_loop=False)
    r["models"] = enrich_models()
    return r


def delete_model(model_id: str) -> dict:
    models = enrich_models()
    m = next((x for x in models if x["id"] == model_id), None)
    if not m:
        return {"ok": False, "error": f"unknown model: {model_id}"}
    if not m.get("installed"):
        return {"ok": False, "error": "model not installed"}
    files = m.get("hf_files") or []
    # Prefer known absolute paths (local host SSD entries) before basename search.
    targets: list[Path] = []
    seen: set[str] = set()
    for key in ("local_path", "path"):
        raw = m.get(key)
        if not raw:
            continue
        try:
            p = Path(str(raw))
            if p.is_file() and str(p) not in seen:
                targets.append(p)
                seen.add(str(p))
        except Exception:
            pass
    for f in files:
        p = find_file(f)
        if p and str(p) not in seen:
            targets.append(p)
            seen.add(str(p))
    removed: list[str] = []
    blocked: list[str] = []
    for p in targets:
        if str(p).startswith("/opt/stickllm/models/"):
            blocked.append(str(p))
            continue
        try:
            p.unlink()
            removed.append(str(p))
        except Exception as e:
            return {"ok": False, "error": f"failed to delete {p}: {e}", "removed": removed}
        # Also drop sibling .partial
        try:
            partial = Path(str(p) + ".partial")
            if partial.is_file():
                partial.unlink()
        except Exception:
            pass
    if blocked and not removed:
        return {"ok": False, "error": "baked-in models cannot be deleted", "blocked": blocked}
    if not removed and not blocked:
        return {"ok": False, "error": "no model files found to delete"}
    # If we deleted the active model, unload — do not auto-load another.
    active = active_model_path()
    if active and any(active == r or active.endswith(os.path.basename(r)) for r in removed):
        sh(["systemctl", "stop", "stickllm-llama.service"], timeout=60)
        try:
            (RUN / "model.env").unlink(missing_ok=True)
        except Exception:
            pass
        try:
            cur = RUN / "current.gguf"
            if cur.exists() or cur.is_symlink():
                cur.unlink()
        except Exception:
            pass
    return {
        "ok": True,
        "removed": removed,
        "blocked": blocked,
        "catalog": enrich_models(),
        "loaded": active_model_identity(),
    }


def wifi_connect(ssid: str, password: str) -> dict:
    ssid = (ssid or "").strip()
    if not ssid:
        return {"ok": False, "error": "ssid required"}
    r = sh(["/usr/local/bin/stickllm-wifi-apply", ssid, password or ""], timeout=120)
    online = False
    try:
        p = subprocess.run(
            ["curl", "-fsS", "--max-time", "3", "-o", "/dev/null",
             "https://connectivitycheck.gstatic.com/generate_204"],
            capture_output=True,
            timeout=6,
            check=False,
        )
        online = p.returncode == 0
    except Exception:
        online = False
    r["online"] = online
    r["ssid"] = ssid
    wifi_doc = read_json(RUN / "wifi.json") if (RUN / "wifi.json").is_file() else {"ssid": ssid}
    # wifi.json is key=value; also expose simple fields
    r["wifi"] = {"ssid": ssid, "online": online}
    if not r.get("ok"):
        r["ok"] = r.get("code", 1) == 0
    return r


_GGUF_INVALIDATE_ACTIONS = {
    "model_delete", "set_models_dir", "set_session_mode", "vault_unlock", "vault_lock",
    "vault_use", "vault_attach", "vault_setup", "vault_move_model", "vault_find_models",
    "model_download", "mmproj_download",
}


def handle(action: str, params: dict) -> dict:
    if action in _GGUF_INVALIDATE_ACTIONS:
        gguf_index_invalidate()
    if action == "status":
        inv = gpu_inventory()
        vram = float(inv.get("vram_gb") or 0)
        ram = detect_ram_gb()
        models = enrich_models(vram)
        watchdog = pump_download_queue()
        loaded = active_model_identity()
        online = False
        try:
            p = subprocess.run(
                [
                    "curl",
                    "-fsS",
                    "--max-time",
                    "2",
                    "-o",
                    "/dev/null",
                    "https://connectivitycheck.gstatic.com/generate_204",
                ],
                capture_output=True,
                timeout=4,
                check=False,
            )
            online = p.returncode == 0
        except Exception:
            online = False
        wifi_ssid = ""
        try:
            for line in (RUN / "wifi.json").read_text(encoding="utf-8").splitlines():
                if line.startswith("ssid="):
                    wifi_ssid = line.split("=", 1)[1].strip()
        except Exception:
            pass
        vault = vault_action("status", {})
        dl_dir = vault_download_models_dir()
        if session_mode() != "vault" and dl_dir is None:
            data_models = MNT / "models"
            dl_dir = data_models if data_models.is_dir() or MNT.is_dir() else None
        preferred = get_preferred_models_dir()
        return {
            "ok": True,
            "session_mode": session_mode(),
            "storage": read_json(RUN / "storage.json"),
            "vault": vault,
            "probe": read_json(RUN / "model-probe.json"),
            "boot_phase": (RUN / "boot-phase.txt").read_text(encoding="utf-8").strip()
            if (RUN / "boot-phase.txt").is_file()
            else "",
            "vram_gb": round(vram, 1),
            "vram_each_gb": round(float(inv.get("each_gb") or 0), 1),
            "gpu_count": int(inv.get("count") or 0),
            "gpu": inv.get("name") or "",
            "gpus": inv.get("gpus") or [],
            "hf_token": read_hf_token(),
            "hf_token_saved": bool(read_hf_token()),
            "settings_mounted": portable_secrets_dir() is not None,
            "vault_unlocked": vault_settings_dir() is not None,
            "ram_gb": round(ram, 1),
            "backend": detect_backend(),
            "active_model": loaded.get("path") or "",
            "loaded": loaded,
            "online": online,
            "wifi": {"ssid": wifi_ssid, "online": online},
            "catalog": models,
            "download": download_progress(),
            "download_queue": watchdog.get("queue") or [],
            "watchdog": watchdog,
            "llama_service": llama_service_snapshot(),
            "offload": read_json(RUN / "llama-fit.json"),
            "models_dirs": [str(p) for p in model_dirs()],
            "download_dir": str(dl_dir) if dl_dir else (str(preferred) if preferred else ""),
            "models_dir_preferred": str(preferred) if preferred else "",
            "discovered_models_dirs": [str(p) for p in get_discovered_model_dirs()],
            "vault_host_root": vault_host_root(),
        }
    if action == "usb_claim":
        r = sh(["/usr/local/bin/stickllm-usb-claim", "--auto", "--yes"], timeout=180)
        r["storage"] = read_json(RUN / "storage.json")
        return r
    if action == "model_probe":
        r = sh(["/usr/local/bin/stickllm-model-probe"], timeout=60)
        r["probe"] = read_json(RUN / "model-probe.json")
        r["catalog"] = enrich_models()
        return r
    if action == "session_mode":
        return {"ok": True, "mode": session_mode(), "modes": sorted(SESSION_MODES)}
    if action == "set_session_mode":
        return set_session_mode(str(params.get("mode") or ""))
    if action == "set_models_dir":
        return set_preferred_models_dir(str(params.get("path") or ""))
    if action == "hf_search":
        return hf_search(
            str(params.get("q") or params.get("query") or ""),
            str(params.get("abl") or "include"),
            str(params.get("vision") or "any"),
        )
    if action == "model_download":
        return enqueue_download(params)
    if action == "mmproj_download":
        return download_mmproj(params)
    if action == "queue_stop":
        return queue_stop(str(params.get("id") or ""))
    if action == "queue_start":
        return queue_start(str(params.get("id") or ""))
    if action == "queue_remove":
        return queue_remove(str(params.get("id") or ""))
    if action == "set_hf_token":
        return write_hf_token(str(params.get("token") or ""))
    if action == "model_activate":
        mid = str(params.get("id") or "").strip()
        if not mid:
            return {"ok": False, "error": "id required"}
        raw_ctx = params.get("ctx_size", params.get("ctx", params.get("n_ctx")))
        ctx_arg = None
        if raw_ctx is not None and str(raw_ctx).strip() != "":
            try:
                ctx_arg = int(raw_ctx)
            except (TypeError, ValueError):
                return {"ok": False, "error": "ctx_size must be an integer"}
        return activate_model(mid, ctx_arg, params.get("kv_type"))
    if action == "llama_fewer_layers":
        return llama_fewer_layers()
    if action == "model_delete":
        mid = str(params.get("id") or "").strip()
        if not mid:
            return {"ok": False, "error": "id required"}
        return delete_model(mid)
    if action == "wifi_connect":
        return wifi_connect(str(params.get("ssid") or ""), str(params.get("password") or ""))
    if action == "catalog":
        return {"ok": True, "models": enrich_models()}
    if action == "ssd_status":
        return vault_action("status", params)
    if action == "vault_status":
        return vault_action("status", params)
    if action == "vault_disks":
        return vault_action("list-disks", params)
    if action == "vault_devices":
        return vault_action("list-devices", params)
    if action == "vault_list_dirs":
        return vault_action("list-dirs", params)
    if action == "vault_browse_start":
        return vault_action("browse-start", params)
    if action == "vault_find_models":
        return vault_action("find-models", params)
    if action == "vault_mkdir":
        return vault_action("mkdir", params)
    if action == "vault_mount":
        return vault_action("mount-host", params)
    if action == "vault_setup":
        return vault_action("setup", params)
    if action == "vault_use" or action == "vault_attach":
        return vault_action("use", params)
    if action == "vault_find" or action == "vault_find_existing":
        return vault_action("find-vault", params)
    if action == "vault_create_file":
        return vault_action("setup", params)
    if action == "vault_create_partition":
        # Hard refuse — never partition/format host disks (v0.3.3).
        return {
            "ok": False,
            "error": (
                "Partition/format flows are disabled. Vault creates a file in a "
                "folder you choose — never formats your drive. Unlock BitLocker/"
                "host LUKS in the host OS first if needed, then: "
                "sudo stickllm-vault setup /path/to/dir"
            ),
        }
    if action == "vault_unlock":
        return vault_action("unlock", params)
    if action == "vault_lock":
        return vault_action("lock", params)
    if action == "vault_move_model":
        return vault_action("move-model", params)
    if action == "vault_list_movable":
        return vault_action("list-movable", params)
    if action == "vault_set_wipe":
        return vault_action("set-wipe-after", params)
    if action == "vault_grow":
        return vault_action("grow", params)
    return {"ok": False, "error": f"unknown action: {action}"}


def _looks_like_block_device(path: str) -> bool:
    p = (path or "").strip()
    if p.startswith("/dev/"):
        return True
    if p.startswith("\\\\.\\PhysicalDrive") or p.startswith("//./PhysicalDrive"):
        return True
    return False


def vault_action(cmd: str, params: dict) -> dict:
    """Drive stickllm-vault; fail-closed — never invent destructive defaults."""
    script = "/usr/local/bin/stickllm-vault"
    if cmd == "status":
        r = sh([script, "status"], timeout=30)
        st = read_json(RUN / "vault.json")
        r.update(st)
        r["ok"] = True
        return r
    if cmd == "list-disks":
        # Read-only probe only (mounted folders + informational disk list).
        data = parse_vault_json(
            [script, "list-disks"], timeout=30, parse_error="list-disks parse failed"
        )
        if data.get("ok") is False and data.get("error") == "list-disks parse failed":
            return data
        data["ok"] = True
        data.setdefault(
            "safety",
            "Creates a file in a folder you choose. Never formats your drive.",
        )
        return data
    if cmd == "list-devices":
        data = parse_vault_json(
            [script, "list-devices"], timeout=30, parse_error="list-devices parse failed"
        )
        if data.get("ok") is False and data.get("error") == "list-devices parse failed":
            return data
        data["ok"] = bool(data.get("ok", True))
        return data
    if cmd == "list-dirs":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        return parse_vault_json(
            [script, "list-dirs", path], timeout=30, parse_error="list-dirs parse failed"
        )
    if cmd == "browse-start":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        return parse_vault_json(
            [script, "browse-start", path],
            timeout=30,
            parse_error="browse-start parse failed",
        )
    if cmd == "find-models":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        data = parse_vault_json(
            [script, "find-models", path],
            timeout=45,
            parse_error="find-models parse failed",
        )
        # UI accepts models || hits; vault emits hits (collapsed roots).
        if isinstance(data, dict):
            hits = data.get("hits") or data.get("roots") or data.get("models") or []
            if "hits" in data and "models" not in data:
                data["models"] = data["hits"]
            if data.get("ok") and isinstance(hits, list):
                remembered = remember_discovered_models(hits)
                data["discovered_dirs"] = remembered
                data["note_load"] = (
                    "Discovered roots remembered for Load. "
                    "Downloads use Models › Change… only."
                )
        return data
    if cmd == "mkdir":
        parent = str(params.get("path") or params.get("parent") or "").strip()
        name = str(params.get("name") or "").strip()
        if not parent or not name:
            return {"ok": False, "error": "path and name required"}
        if _looks_like_block_device(parent):
            return {"ok": False, "error": "refusing block device path"}
        data = parse_vault_json(
            [script, "mkdir", parent, name], timeout=30, parse_error="mkdir failed"
        )
        if data.get("ok") is False and data.get("error") == "mkdir failed":
            err = (data.get("stderr") or data.get("error") or "mkdir failed").strip()
            data["error"] = err
        return data
    if cmd == "mount-host":
        device = str(params.get("device") or params.get("path") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not device:
            return {"ok": False, "error": "device required (e.g. /dev/nvme0n1p2)"}
        if not _looks_like_block_device(device):
            return {"ok": False, "error": "device must be a /dev/… partition"}
        if confirm != "MOUNT-HOST":
            return {"ok": False, "error": "confirm must be MOUNT-HOST"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "MOUNT-HOST"
        try:
            p = subprocess.run(
                [script, "mount-host", device],
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
                env=env,
            )
            lines = [ln for ln in (p.stdout or "").strip().splitlines() if ln.strip()]
            try:
                data = json.loads(lines[-1] if lines else "{}")
            except Exception:
                data = {
                    "ok": p.returncode == 0,
                    "stdout": (p.stdout or "")[-2000:],
                    "stderr": (p.stderr or "")[-2000:],
                }
            if p.returncode != 0:
                data["ok"] = False
                if not data.get("error"):
                    data["error"] = (p.stderr or data.get("stderr") or "mount failed").strip()[:500]
            return data
        except Exception as e:
            return {"ok": False, "error": str(e)}
    if cmd == "lock":
        sh(["systemctl", "stop", "stickllm-llama.service"], timeout=60)
        r = sh([script, "lock"], timeout=120)
        return merge_vault_run(r)
    if cmd == "find-vault":
        data = parse_vault_json(
            [script, "find-vault"], timeout=45, parse_error="find-vault parse failed"
        )
        if data.get("ok") is False and data.get("error") == "find-vault parse failed":
            return data
        data["ok"] = bool(data.get("ok", True))
        return data
    if cmd == "use":
        # Bind meta to an existing stickllm-vault.img — never CREATE / luksFormat.
        path = str(params.get("path") or params.get("dir") or "").strip()
        if not path:
            return {"ok": False, "error": "path (directory or stickllm-vault.img) required"}
        if _looks_like_block_device(path):
            return {
                "ok": False,
                "error": (
                    "Refusing block device path. Pick the mounted folder that "
                    "contains stickllm-vault.img (or the .img path itself)."
                ),
            }
        try:
            p = subprocess.run(
                [script, "use", path],
                capture_output=True,
                text=True,
                timeout=60,
                check=False,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
                "path": path,
            }
            if p.returncode != 0 and not r.get("error"):
                err = (p.stderr or "").strip().splitlines()
                r["error"] = (err[-1] if err else "use existing vault failed")[:500]
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "unlock":
        passcode = str(params.get("passcode") or "")
        # Optional path: bind existing blob first only when meta is missing (reflash).
        bind_path = str(params.get("path") or params.get("dir") or "").strip()
        env = os.environ.copy()
        if passcode:
            env["STICKLLM_VAULT_PASS"] = passcode

        def _vault_meta_blob() -> str:
            for meta in (Path("/var/lib/stickllm/vault-meta"), MNT / "vault-meta"):
                c = meta / "container"
                if c.is_file():
                    try:
                        p = c.read_text(encoding="utf-8").strip()
                    except Exception:
                        p = ""
                    if p and Path(p).is_file():
                        return p
            st = read_json(RUN / "vault.json")
            blob = str(st.get("blob") or "").strip()
            if blob and Path(blob).is_file():
                return blob
            return ""

        need_bind = bind_path and not _vault_meta_blob()
        if need_bind:
            if _looks_like_block_device(bind_path):
                return {"ok": False, "error": "refusing block device path for unlock bind"}
            try:
                b = subprocess.run(
                    [script, "use", bind_path],
                    capture_output=True,
                    text=True,
                    timeout=60,
                    check=False,
                    env=env,
                )
                if b.returncode != 0:
                    err_lines = (b.stderr or "").strip().splitlines()
                    return merge_vault_run(
                        {
                            "ok": False,
                            "code": b.returncode,
                            "stdout": (b.stdout or "")[-2000:],
                            "stderr": (b.stderr or "")[-2000:],
                            "error": (err_lines[-1] if err_lines else "could not bind existing vault")[
                                :500
                            ],
                        }
                    )
            except Exception as e:
                return {"ok": False, "error": str(e)}
        try:
            p = subprocess.run(
                [script, "unlock"],
                capture_output=True,
                text=True,
                timeout=180,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "setup":
        path = str(params.get("path") or params.get("dir") or "").strip()
        size_gb = str(params.get("size_gb") or "8").strip()
        confirm = str(params.get("confirm") or "")
        saved = str(params.get("saved_confirm") or params.get("recovery_confirm") or "")
        passcode = str(params.get("passcode") or "")
        passcode2 = str(params.get("passcode2") or passcode)
        space_ok = str(params.get("space_confirm") or "")
        if _looks_like_block_device(path):
            return {
                "ok": False,
                "error": (
                    "Refusing block device path. Pick a mounted folder on the host "
                    "SSD. If BitLocker/LUKS is locked, unlock it in the host OS first "
                    "— StickLLM will not unlock or wipe host encryption."
                ),
            }
        if confirm != "CREATE-VAULT":
            return {
                "ok": False,
                "error": "typed confirm must be CREATE-VAULT",
            }
        # UI must show recovery_phrase once and require local SAVED ack after.
        # Backend accepts SAVED or SHOW-ONCE (API) so create can return the phrase.
        if saved not in ("SAVED", "SHOW-ONCE"):
            return {
                "ok": False,
                "error": "recovery_confirm must be SAVED or SHOW-ONCE",
            }
        if not path:
            return {"ok": False, "error": "path (directory) required"}
        if len(passcode) < 8:
            return {"ok": False, "error": "passcode must be at least 8 characters"}
        if passcode != passcode2:
            return {"ok": False, "error": "passcodes do not match"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "CREATE-VAULT"
        env["STICKLLM_VAULT_CONFIRM_SAVED"] = "SAVED"
        env["STICKLLM_VAULT_PASS"] = passcode
        env["STICKLLM_VAULT_PASS2"] = passcode2
        # Sparse logical size may exceed free; UI CREATE-VAULT implies SPACE-OK awareness.
        env["STICKLLM_VAULT_CONFIRM_SPACE"] = (
            "SPACE-OK" if space_ok in ("", "SPACE-OK") else space_ok
        )
        # Wipe stays off unless explicitly requested at setup.
        env.setdefault("STICKLLM_VAULT_WIPE_AFTER", "0")
        try:
            p = subprocess.run(
                [script, "setup", path, size_gb],
                capture_output=True,
                text=True,
                timeout=600,
                check=False,
                env=env,
            )
            out = (p.stdout or "")
            recovery = ""
            for line in out.splitlines():
                if line.startswith("RECOVERY_PHRASE:"):
                    recovery = line.split(":", 1)[1].strip()
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": out[-6000:],
                "stderr": (p.stderr or "")[-3000:],
                "recovery_phrase": recovery if p.returncode == 0 else "",
                "path": path,
                "size_gb": size_gb,
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "grow":
        add_gb = str(params.get("add_gb") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not add_gb:
            return {"ok": False, "error": "add_gb required"}
        if confirm != "GROW-VAULT":
            return {"ok": False, "error": "typed confirm must be GROW-VAULT"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "GROW-VAULT"
        try:
            p = subprocess.run(
                [script, "grow", add_gb],
                capture_output=True,
                text=True,
                timeout=600,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "list-movable":
        data = parse_vault_json(
            [script, "list-movable"], timeout=30, parse_error="list-movable parse failed"
        )
        if data.get("ok") is False and data.get("error") == "list-movable parse failed":
            return data
        data["ok"] = True
        return data
    if cmd == "set-wipe-after":
        n = str(params.get("n") or params.get("wipe_after") or "0").strip()
        confirm = str(params.get("confirm") or "")
        if n not in ("0",) and confirm != "WIPE-OK":
            return {
                "ok": False,
                "error": "enabling wipe-after-N requires confirm=WIPE-OK (destroys blob LUKS header after N fails; default is off)",
            }
        env = os.environ.copy()
        if confirm == "WIPE-OK":
            env["STICKLLM_VAULT_CONFIRM"] = "WIPE-OK"
        try:
            p = subprocess.run(
                [script, "set-wipe-after", n],
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-2000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "move-model":
        src = str(params.get("path") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not src:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(src):
            return {"ok": False, "error": "refusing block device path"}
        if confirm != "MOVE-MODEL":
            return {"ok": False, "error": "confirm must be MOVE-MODEL"}
        if session_mode() != "vault":
            return {"ok": False, "error": "switch Mode to Vault before moving models"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "MOVE-MODEL"
        try:
            p = subprocess.run(
                [script, "move-model", src],
                capture_output=True,
                text=True,
                timeout=7200,
                check=False,
                env=env,
            )
            return {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            return {"ok": False, "error": str(e)}
    return {"ok": False, "error": f"unknown vault cmd: {cmd}"}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _send(self, code: int, obj: dict) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:  # noqa: N802
        if self.path not in ("/", "/action"):
            self._send(404, {"ok": False, "error": "not found"})
            return
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            req = json.loads(raw.decode() or "{}")
        except Exception:
            self._send(400, {"ok": False, "error": "bad json"})
            return
        action = str(req.get("action") or "")
        params = req.get("params") or {}
        if not isinstance(params, dict):
            params = {}
        result = handle(action, params)
        self._send(200 if result.get("ok", True) or "code" in result else 500, result)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--plan-offload":
        return emit_offload_plan()
    RUN.mkdir(parents=True, exist_ok=True)
    httpd = ThreadedHTTPServer((HOST, PORT), Handler)
    print(f"stickllm-control on http://{HOST}:{PORT}", flush=True)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
