[Unit]
Description=StickLLM claim/mount USB STICKLLM-DATA and reserve settings partition
DefaultDependencies=no
After=local-fs.target
Before=stickllm-llama.service stickllm-bootstatus.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/stickllm-usb-claim --auto --yes
# Soft-fail: DATA claim is best-effort (tiny sticks / isohybrid / mount race).
# 0=ok, 1=soft miss, 2=usage, 32=mount errno — never fail the boot UX.
SuccessExitStatus=0 1 2 32

[Install]
WantedBy=multi-user.target
