#!/bin/bash
# DEVELOPMENT ONLY — Milestone A isolated Method C grant.
# NOT production trusted-device authorization (see METHODC-STANDALONE-MIGRATION.md).
#
# Requires METHODC_DEV_AUTH=1. Writes /run/stickllm/sticklink-lab-grant and
# enables sticklink-lab.enabled for the gateway redeem path.
set -euo pipefail
if [[ "${METHODC_DEV_AUTH:-0}" != "1" ]]; then
  echo "REFUSE: METHODC_DEV_AUTH=1 required (development grant; not production auth)" >&2
  exit 2
fi
RUN=/run/stickllm
mkdir -p "$RUN"
chmod 755 "$RUN"
touch "$RUN/sticklink-lab.enabled"
chmod 644 "$RUN/sticklink-lab.enabled"
# Marker so operators can audit that this was a DEV grant.
printf '%s\n' "methodc-dev-auth" >"$RUN/sticklink-lab-dev.flag"
chmod 644 "$RUN/sticklink-lab-dev.flag"
GRANT="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(32))
PY
)"
# Boot-scoped redeem window (was 600s / 10 min — remint after idle hit grant_expired).
# Gateway Bearer itself has no TTL; this only bounds the one-shot grant file.
EXP="$(( $(date +%s) + 604800 ))"
umask 077
printf '%s\n' "{\"grant\":\"${GRANT}\",\"exp\":${EXP},\"dev\":true}" >"$RUN/sticklink-lab-grant"
chmod 600 "$RUN/sticklink-lab-grant"
printf '%s\n' "$GRANT"
