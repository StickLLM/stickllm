#!/usr/bin/env python3
"""Root control daemon — USB claim, model probe/download/activate, status."""
from __future__ import annotations

import json
import os
import re
import struct
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from socketserver import ThreadingMixIn

RUN = Path(os.environ.get("STICKLLM_RUN", "/run/stickllm"))
CATALOG = Path(os.environ.get("STICKLLM_CATALOG", "/etc/stickllm/models/catalog.toml"))
MNT = Path(os.environ.get("STICKLLM_DATA_MNT", "/mnt/stickllm-data"))
SESSION_MODE_PATH = RUN / "session-mode.json"
HOST = "127.0.0.1"
PORT = int(os.environ.get("STICKLLM_CONTROL_PORT", "8091"))
BAKED_3B = Path("/opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf")
BAKED_7B = Path("/opt/stickllm/models/qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf")
SESSION_MODES = frozenset({"ephemeral", "vault"})


def session_mode() -> str:
    """UI header mode: ephemeral (default) or vault. Gates SSD/vault writes."""
    doc = read_json(SESSION_MODE_PATH)
    mode = str(doc.get("mode") or "ephemeral").strip().lower()
    return mode if mode in SESSION_MODES else "ephemeral"


def set_session_mode(mode: str) -> dict:
    mode = str(mode or "").strip().lower()
    if mode not in SESSION_MODES:
        return {"ok": False, "error": "mode must be ephemeral or vault"}
    prev = session_mode()
    RUN.mkdir(parents=True, exist_ok=True)
    doc = {
        "ok": True,
        "mode": mode,
        "updated": int(time.time()),
    }
    # Switching to Ephemeral locks the vault (unload model + unmount LUKS).
    if mode == "ephemeral" and (
        prev == "vault" or os.path.ismount("/var/lib/stickllm/vault")
    ):
        lock_r = vault_action("lock", {})
        doc["vault_locked"] = bool(lock_r.get("ok"))
        if not lock_r.get("ok"):
            doc["vault_lock_error"] = (
                lock_r.get("error") or lock_r.get("stderr") or "lock failed"
            )
    SESSION_MODE_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    return doc


def vault_host_root() -> str:
    """Vault setup folder on the host SSD (may hold stickllm-vault.img)."""
    st = read_json(RUN / "vault.json")
    root = str(st.get("root") or "").strip()
    if root and not root.startswith("/dev/") and Path(root).is_dir():
        return root
    for meta in (Path("/var/lib/stickllm/vault-meta"), MNT / "vault-meta"):
        root_file = meta / "root"
        if not root_file.is_file():
            continue
        try:
            root = root_file.read_text(encoding="utf-8").strip()
        except Exception:
            continue
        if root and not root.startswith("/dev/") and Path(root).is_dir():
            return root
    return ""


def vault_clear_models_dirs() -> list[Path]:
    """Clear-text host model folders to list/load in Vault mode (never chats)."""
    root = vault_host_root()
    if not root:
        return []
    rp = Path(root)
    dirs: list[Path] = []
    # User often chooses …/models as vault root; GGUFs sit beside the blob.
    if rp.is_dir():
        dirs.append(rp)
    nested = rp / "models"
    if nested.is_dir() and nested not in dirs:
        dirs.append(nested)
    # Common host library beside …/home/<user>/models (list/load only).
    sibling_lm = rp.parent / ".lmstudio" / "models"
    if sibling_lm.is_dir() and sibling_lm not in dirs:
        dirs.append(sibling_lm)
    return dirs


def vault_download_models_dir() -> Path | None:
    """Where Vault-mode catalog downloads land (clear SSD models folder)."""
    root = vault_host_root()
    if not root:
        return None
    rp = Path(root)
    # Prefer the folder they chose when it is already a models directory.
    if rp.is_dir() and rp.name.lower() == "models":
        return rp
    nested = rp / "models"
    return nested


def sh(cmd: list[str], timeout: int = 600) -> dict:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return {
            "ok": p.returncode == 0,
            "code": p.returncode,
            "stdout": (p.stdout or "")[-8000:],
            "stderr": (p.stderr or "")[-4000:],
        }
    except Exception as e:
        return {"ok": False, "error": str(e)}


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def merge_vault_run(r: dict) -> dict:
    """Merge /run vault.json without letting status ok=True hide a failed command."""
    cmd_ok = bool(r.get("ok"))
    prior_err = str(r.get("error") or "").strip()
    prior_stderr = str(r.get("stderr") or "").strip()
    st = read_json(RUN / "vault.json")
    st.pop("ok", None)
    r.update(st)
    r["ok"] = cmd_ok
    if not cmd_ok and not str(r.get("error") or "").strip():
        r["error"] = prior_err or prior_stderr or "vault command failed"
    return r


def model_dirs() -> list[Path]:
    dirs: list[Path] = []
    # Vault / SSD models only when user consciously selected Vault mode.
    if session_mode() == "vault":
        vault_mnt = Path("/var/lib/stickllm/vault")
        vault_models = vault_mnt / "models"
        if vault_models.is_dir() and os.path.ismount(str(vault_mnt)):
            dirs.append(vault_models)
        for d in vault_clear_models_dirs():
            if d not in dirs:
                dirs.append(d)
    # USB DATA models: ephemeral listing/download; also visible as fallback.
    if session_mode() != "vault":
        data = MNT / "models"
        if data.is_dir() and data not in dirs:
            dirs.append(data)
    baked = Path("/opt/stickllm/models")
    if baked.is_dir() and baked not in dirs:
        dirs.append(baked)
    return dirs


def _gguf_search_roots() -> list[Path]:
    """Dirs to search for GGUF files (shallow recurse under host trees)."""
    return model_dirs()


def find_file(name: str) -> Path | None:
    want = name
    for d in _gguf_search_roots():
        p = d / want
        if p.is_file() and p.stat().st_size > 1_000_000:
            return p
        # Shallow recurse (LM Studio / HF layout: vendor/model/*.gguf)
        try:
            for p in d.rglob(want):
                if p.is_file() and p.stat().st_size > 1_000_000:
                    # Cap depth under d to 4 path parts
                    try:
                        rel = p.relative_to(d)
                    except ValueError:
                        continue
                    if len(rel.parts) <= 4:
                        return p
        except OSError:
            pass
    return None


def discover_local_ggufs() -> list[dict]:
    """Surface on-disk GGUFs not already represented by catalog filenames."""
    if session_mode() != "vault":
        return []
    catalog_files: set[str] = set()
    for m in parse_catalog():
        for f in m.get("hf_files") or []:
            catalog_files.add(os.path.basename(f).lower())
    # Also treat baked names as catalog-covered
    catalog_files.add(BAKED_3B.name.lower())
    catalog_files.add(BAKED_7B.name.lower())

    found: dict[str, Path] = {}
    for d in _gguf_search_roots():
        if str(d).startswith("/opt/stickllm/models"):
            continue
        try:
            for p in d.rglob("*.gguf"):
                if not p.is_file():
                    continue
                try:
                    if p.stat().st_size < 1_000_000:
                        continue
                    rel = p.relative_to(d)
                except (OSError, ValueError):
                    continue
                if len(rel.parts) > 4:
                    continue
                name = p.name
                # Skip projector / mmproj helpers as standalone "models"
                low = name.lower()
                if low.startswith("mmproj") or "mmproj-" in low:
                    continue
                if low in catalog_files:
                    continue
                # Multipart: keep shard 00001 (or unsharded)
                m = re.search(r"-(\d{5})-of-(\d{5})\.gguf$", low)
                if m and m.group(1) != "00001":
                    continue
                key = low
                prev = found.get(key)
                if prev is None or p.stat().st_size > prev.stat().st_size:
                    found[key] = p
        except OSError:
            pass

    out: list[dict] = []
    for low, path in sorted(found.items(), key=lambda kv: kv[0]):
        stem = path.name
        if re.search(r"-\d{5}-of-\d{5}\.gguf$", stem, re.I):
            stem = re.sub(r"-\d{5}-of-\d{5}\.gguf$", "", stem, flags=re.I)
        else:
            stem = stem[: -len(".gguf")] if stem.lower().endswith(".gguf") else stem
        mid = "local-" + re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")[:80]
        size_gb = round(path.stat().st_size / (1024**3), 2)
        out.append(
            {
                "id": mid,
                "name": stem.replace("-", " ").replace("_", " "),
                "tier": "local",
                "approx_size_gb": size_gb,
                "min_vram_gb": 0,
                "quality_rank": 10,
                "vision": False,
                "pinned": False,
                "hf_repo": "",
                "hf_files": [path.name],
                "notes": f"On SSD: {path}",
                "local_path": str(path),
                "source": "host_ssd",
            }
        )
    return out


def detect_vram_gb() -> float:
    try:
        p = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=memory.total",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        vals = [float(x.strip()) for x in p.stdout.splitlines() if x.strip()]
        if not vals:
            return 0.0
        return max(vals) / 1024.0
    except Exception:
        return 0.0


def detect_ram_gb() -> float:
    try:
        meminfo = Path("/proc/meminfo").read_text(encoding="utf-8")
        for line in meminfo.splitlines():
            if line.startswith("MemAvailable:"):
                kb = float(line.split()[1])
                return kb / (1024.0 * 1024.0)
            if line.startswith("MemTotal:"):
                kb = float(line.split()[1])
                # Prefer Available; fall back to ~85% of total.
                return (kb / (1024.0 * 1024.0)) * 0.85
    except Exception:
        pass
    return 0.0


def has_nvidia() -> bool:
    if detect_vram_gb() > 0.5:
        return True
    return Path("/dev/nvidia0").exists() or Path("/dev/nvidiactl").exists()


def _gguf_read_string(f) -> str:
    (n,) = struct.unpack("<Q", f.read(8))
    if n > 1_000_000:
        raise ValueError("gguf string too large")
    return f.read(n).decode("utf-8", errors="replace")


def read_gguf_meta(path: str | Path, max_keys: int = 256) -> dict:
    """Read scalar/string KV metadata from a GGUF header (skips tensors/arrays)."""
    p = Path(path)
    if not p.is_file():
        return {}
    out: dict = {}
    try:
        with p.open("rb") as f:
            magic = f.read(4)
            if magic != b"GGUF":
                return {}
            (version,) = struct.unpack("<I", f.read(4))
            if version not in (2, 3):
                return {}
            _tensor_count, kv_count = struct.unpack("<QQ", f.read(16))
            kv_count = min(int(kv_count), max_keys)
            for _ in range(kv_count):
                key = _gguf_read_string(f)
                (vtype,) = struct.unpack("<I", f.read(4))
                if vtype == 0:  # UINT8
                    (val,) = struct.unpack("<B", f.read(1))
                elif vtype == 1:  # INT8
                    (val,) = struct.unpack("<b", f.read(1))
                elif vtype == 2:  # UINT16
                    (val,) = struct.unpack("<H", f.read(2))
                elif vtype == 3:  # INT16
                    (val,) = struct.unpack("<h", f.read(2))
                elif vtype == 4:  # UINT32
                    (val,) = struct.unpack("<I", f.read(4))
                elif vtype == 5:  # INT32
                    (val,) = struct.unpack("<i", f.read(4))
                elif vtype == 6:  # FLOAT32
                    (val,) = struct.unpack("<f", f.read(4))
                elif vtype == 7:  # BOOL
                    (val,) = struct.unpack("<?", f.read(1))
                elif vtype == 8:  # STRING
                    val = _gguf_read_string(f)
                elif vtype == 9:  # ARRAY — skip
                    (atype,) = struct.unpack("<I", f.read(4))
                    (alen,) = struct.unpack("<Q", f.read(8))
                    sizes = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
                    if atype == 8:
                        for _a in range(int(alen)):
                            _gguf_read_string(f)
                    else:
                        esz = sizes.get(atype)
                        if esz is None:
                            return out
                        f.seek(int(alen) * esz, os.SEEK_CUR)
                    continue
                elif vtype == 10:  # UINT64
                    (val,) = struct.unpack("<Q", f.read(8))
                elif vtype == 11:  # INT64
                    (val,) = struct.unpack("<q", f.read(8))
                elif vtype == 12:  # FLOAT64
                    (val,) = struct.unpack("<d", f.read(8))
                else:
                    return out
                out[key] = val
    except Exception:
        return out
    return out


def gguf_arch_dims(meta: dict) -> dict:
    """Pull architecture dims used for KV-cache sizing from GGUF metadata."""
    arch = str(meta.get("general.architecture") or "").strip()
    if not arch:
        return {}
    def num(*keys: str) -> int:
        for k in keys:
            v = meta.get(k)
            if isinstance(v, (int, float)) and v > 0:
                return int(v)
        return 0

    n_layer = num(f"{arch}.block_count")
    n_ctx = num(f"{arch}.context_length")
    n_embd = num(f"{arch}.embedding_length")
    n_head = num(f"{arch}.attention.head_count")
    n_kv = num(f"{arch}.attention.head_count_kv", f"{arch}.attention.head_count")
    head_dim = num(f"{arch}.attention.key_length")
    if not head_dim and n_embd and n_head:
        head_dim = max(1, n_embd // n_head)
    return {
        "architecture": arch,
        "n_layer": n_layer,
        "n_ctx_train": n_ctx,
        "n_embd": n_embd,
        "n_head": n_head,
        "n_kv_head": n_kv,
        "head_dim": head_dim,
    }


def estimate_context_budget(
    *,
    vram_gb: float,
    ram_gb: float,
    approx_size_gb: float,
    backend: str,
    model_max_ctx: int = 0,
    dims: dict | None = None,
) -> dict:
    """Suggest a max context size from free memory after loading weights.

    Formula (documented for UI/ops):
      free_mem_after ≈ mem_gb - approx_size_gb * 1.05   # weights + small overhead
      If GGUF dims known (n_layer, n_kv_head, head_dim):
        kv_bytes/token ≈ 2 * n_layer * n_kv_head * head_dim * 2  # K+V, f16
      Else ballpark from weight size (calibrated ~7B @ ~56 KiB/token):
        kv_bytes/token ≈ 56000 * (approx_size_gb / 5.1)
      max_ctx_mem = floor(free_mem_after_bytes / kv_bytes_per_token)
      Clamp to [2048, model_max_ctx] (GGUF context_length when available).
    """
    dims = dims or {}
    size = max(0.1, float(approx_size_gb or 0) or 2.0)
    gpu = backend in ("cuda", "vulkan") and vram_gb > 0.5
    mem_gb = float(vram_gb if gpu else ram_gb) or 0.0
    free_after = max(0.0, mem_gb - size * 1.05)
    # Leave a little headroom for runtime / fragmentation.
    free_after *= 0.85

    n_layer = int(dims.get("n_layer") or 0)
    n_kv = int(dims.get("n_kv_head") or 0)
    head_dim = int(dims.get("head_dim") or 0)
    if n_layer > 0 and n_kv > 0 and head_dim > 0:
        kv_bpt = 2 * n_layer * n_kv * head_dim * 2  # K+V f16
    else:
        kv_bpt = int(56000 * (size / 5.1))
    kv_bpt = max(8192, kv_bpt)

    max_from_mem = int((free_after * (1024**3)) // kv_bpt) if free_after > 0 else 2048
    train_ctx = int(model_max_ctx or dims.get("n_ctx_train") or 0)
    if train_ctx <= 0:
        train_ctx = 32768 if size >= 4 else 32768
    # Hard ceiling for live stick UX (llama-server comfort).
    hard_cap = 32768 if gpu else 8192
    hi = max(2048, min(train_ctx, hard_cap, max(2048, max_from_mem)))
    # Snap down to a friendly step.
    step = 1024 if hi <= 8192 else 2048
    hi = max(2048, (hi // step) * step)
    # Default suggestion: prefer 8k when it fits, else half of hi, else hi.
    suggested = 8192 if hi >= 8192 else (4096 if hi >= 4096 else hi)
    if suggested > hi:
        suggested = hi
    return {
        "ctx_min": 2048,
        "ctx_max": hi,
        "ctx_suggested": suggested,
        "ctx_model_max": train_ctx,
        "free_mem_after_gb": round(free_after, 2),
        "kv_bytes_per_token": kv_bpt,
    }


def detect_backend() -> str:
    """Prefer runtime breadcrumb from pick-gpus / llama-start over nvidia-smi."""
    for path in (RUN / "llama-runtime.env", RUN / "cuda.env"):
        try:
            if not path.is_file():
                continue
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith("backend="):
                    b = line.split("=", 1)[1].strip().lower()
                    if b in ("cuda", "vulkan", "cpu"):
                        return b
                if line.startswith("STICKLLM_BACKEND="):
                    b = line.split("=", 1)[1].strip().lower()
                    if b in ("cuda", "vulkan", "cpu"):
                        return b
        except Exception:
            pass
    if has_nvidia():
        return "cuda"
    return "cpu"


def llama_health_ok() -> tuple[bool, str]:
    try:
        p = subprocess.run(
            ["curl", "-fsS", "--max-time", "2", "http://127.0.0.1:8080/health"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if p.returncode != 0:
            return False, (p.stderr or p.stdout or "llama /health failed").strip()[:200]
        try:
            data = json.loads(p.stdout or "{}")
        except Exception:
            return True, "ok"
        err = data.get("error")
        if err:
            return False, str(err)[:200]
        st = str(data.get("status") or "ok").lower()
        if st in ("ok", "healthy", ""):
            return True, st or "ok"
        return False, st
    except Exception as e:
        return False, str(e)[:200]


def active_model_identity() -> dict:
    path = active_model_path()
    mid = ""
    name = ""
    env = RUN / "model.env"
    if env.is_file():
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MODEL_ID="):
                mid = line.split("=", 1)[1].strip()
            elif line.startswith("STICKLLM_MODEL_NAME="):
                name = line.split("=", 1)[1].strip()
    if not mid and path:
        base = os.path.basename(path).lower()
        if "3b" in base:
            mid, name = "qwen25-3b-q4km", "Qwen2.5 3B Instruct (baked)"
        elif "7b" in base:
            mid, name = "qwen25-7b-q5km", "Qwen2.5 7B Instruct"
    healthy, health_msg = llama_health_ok()
    return {
        "path": path,
        "id": mid,
        "name": name or (os.path.basename(path) if path else ""),
        "running": healthy,
        "health": health_msg,
    }


def active_model_path() -> str:
    """Path from explicit Activate only — never invent a baked default at boot."""
    env = RUN / "model.env"
    if env.is_file():
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MODEL="):
                return line.split("=", 1)[1].strip()
    cur = RUN / "current.gguf"
    if cur.is_symlink() or cur.is_file():
        try:
            return str(cur.resolve())
        except Exception:
            pass
    return ""


def parse_catalog() -> list[dict]:
    if not CATALOG.is_file():
        return []
    text = CATALOG.read_text(encoding="utf-8")
    out = []
    for b in re.split(r"\n\[\[model\]\]\n", text)[1:]:
        def g(key: str, default: str = "") -> str:
            m = re.search(rf"^{key}\s*=\s*(.+)$", b, re.M)
            if not m:
                return default
            return m.group(1).strip().strip('"')

        mid = g("id")
        if not mid:
            continue
        repo = g("hf_repo", "")
        fm = re.search(r"^hf_files\s*=\s*\[(.*?)\]", b, re.M | re.S)
        files = re.findall(r'"([^"]*)"', fm.group(1)) if fm else []
        # Baked 7B may have no need to re-download but is installed
        if mid == "qwen25-7b-q5km" and not files:
            files = [
                "qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf",
                "qwen2.5-7b-instruct-q5_k_m-00002-of-00002.gguf",
            ]
        out.append(
            {
                "id": mid,
                "name": g("name", mid),
                "tier": g("tier"),
                "approx_size_gb": float(g("approx_size_gb", "0") or 0),
                "min_vram_gb": float(g("min_vram_gb", "0") or 0),
                "quality_rank": int(float(g("quality_rank", "0") or 0)),
                "vision": g("vision", "false").lower() == "true",
                "pinned": bool(repo) and bool(files),
                "hf_repo": repo,
                "hf_files": files,
                "notes": g("notes"),
            }
        )
    out.sort(key=lambda m: -m["quality_rank"])
    return out


def download_running() -> bool:
    try:
        p = subprocess.run(
            ["pgrep", "-f", "stickllm-download-model|curl.*huggingface"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        return p.returncode == 0 and bool(p.stdout.strip())
    except Exception:
        return False


def download_progress() -> dict:
    """Best-effort download progress from progress file or *.partial sizes."""
    prog = read_json(RUN / "download-progress.json")
    if prog.get("state") in ("downloading", "verifying", "starting"):
        mid = prog.get("id") or ""
        still_partial = False
        for d in model_dirs():
            try:
                if any(d.glob("*.partial")):
                    still_partial = True
                    break
            except OSError:
                pass
        if not still_partial and mid and not download_running():
            for m in parse_catalog():
                if m.get("id") == mid:
                    files = m.get("hf_files") or []
                    if files and all(find_file(f) for f in files):
                        return {
                            "state": "done",
                            "id": mid,
                            "name": m.get("name", mid),
                            "percent": 100.0,
                            "bytes_done": prog.get("bytes_total") or 0,
                            "bytes_total": prog.get("bytes_total") or 0,
                            "note": "complete",
                        }
        return prog

    if prog.get("state") == "failed":
        return prog
    if prog.get("state") == "done":
        return prog

    partials: list[tuple[Path, int]] = []
    for d in model_dirs():
        try:
            for p in d.glob("*.partial"):
                try:
                    partials.append((p, p.stat().st_size))
                except OSError:
                    pass
        except OSError:
            pass
    if not partials:
        if download_running():
            return {
                "state": "downloading",
                "id": prog.get("id") or "",
                "name": prog.get("name") or "model download",
                "percent": None,
                "bytes_done": 0,
                "bytes_total": 0,
                "note": "download running (size unknown yet)",
            }
        return {"state": "idle"}

    partials.sort(key=lambda x: -x[1])
    path, done = partials[0]
    base = path.name[: -len(".partial")] if path.name.endswith(".partial") else path.name
    match = None
    for m in parse_catalog():
        files = m.get("hf_files") or []
        if base in files or any(base == f or f.endswith(base) for f in files):
            match = m
            break
    total = int(float((match or {}).get("approx_size_gb") or 0) * (1024**3))
    pct = None
    if total > 0:
        pct = max(0.0, min(99.9, round(100.0 * done / total, 1)))
    return {
        "state": "downloading",
        "id": (match or {}).get("id", prog.get("id") or ""),
        "name": (match or {}).get("name", prog.get("name") or base),
        "file": base,
        "percent": pct,
        "bytes_done": done,
        "bytes_total": total,
        "path": str(path),
        "note": "partial on disk",
        "updated": int(time.time()),
    }


def maybe_resume_stalled_download() -> dict:
    """Restart download if a .partial exists and the downloader died."""
    if download_running():
        return {"resumed": False}
    partial = None
    for d in model_dirs():
        try:
            for p in sorted(d.glob("*.partial"), key=lambda x: -x.stat().st_size):
                partial = p
                break
        except OSError:
            pass
        if partial:
            break
    if not partial:
        return {"resumed": False}
    prog = read_json(RUN / "download-progress.json")
    base = partial.name[: -len(".partial")] if partial.name.endswith(".partial") else partial.name
    mid = str(prog.get("id") or "").strip()
    if not mid:
        for m in parse_catalog():
            if base in (m.get("hf_files") or []):
                mid = m["id"]
                break
    if not mid:
        return {"resumed": False, "note": "partial without catalog match"}
    updated = int(prog.get("updated") or 0)
    stale = (time.time() - updated) > 180 if updated else True
    state = prog.get("state") or ""
    if state not in ("failed", "idle", "downloading", "starting", "verifying", "") and not stale:
        return {"resumed": False}
    if state in ("downloading", "starting", "verifying") and not stale:
        return {"resumed": False}
    RUN.mkdir(parents=True, exist_ok=True)
    logf = open(RUN / "download.log", "a", encoding="utf-8")
    subprocess.Popen(
        ["/usr/local/bin/stickllm-download-model", "--i-understand", "--id", mid],
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    return {"resumed": True, "id": mid}


def enrich_models(vram_gb: float | None = None) -> list[dict]:
    if vram_gb is None:
        vram_gb = detect_vram_gb()
    ram_gb = detect_ram_gb()
    gpu = has_nvidia()
    active = active_model_path()
    healthy, _ = llama_health_ok()
    models = parse_catalog() + discover_local_ggufs()
    for m in models:
        files = m.get("hf_files") or []
        local = str(m.get("local_path") or "").strip()
        if local and Path(local).is_file():
            paths = [Path(local)]
            installed = True
        else:
            paths = [find_file(f) for f in files] if files else []
            installed = bool(files) and all(p is not None for p in paths)
        if not installed and m["id"] == "qwen25-7b-q5km" and BAKED_7B.is_file():
            installed = True
            paths = [BAKED_7B]
        if not installed and m["id"] == "qwen25-3b-q4km" and BAKED_3B.is_file():
            installed = True
            paths = [BAKED_3B]
        first = next((str(p) for p in paths if p), "")
        need = float(m.get("min_vram_gb") or 0)
        size_gb = float(m.get("approx_size_gb") or need or 0)
        if gpu:
            fits = vram_gb + 0.01 >= need if need > 0 else True
            fit_note = f"VRAM ~{vram_gb:.1f} GB"
        else:
            # CPU path: model weights must fit in available system RAM (ISS-018).
            budget = max(size_gb, need) * 1.15 + 1.5
            fits = ram_gb + 0.01 >= budget or need == 0 and size_gb <= ram_gb
            fit_note = f"RAM ~{ram_gb:.1f} GB available (CPU)"
        if need == 0 and gpu:
            fits = True
        # Local SSD GGUFs: allow Use when installed; VRAM fit is best-effort.
        if m.get("source") == "host_ssd" and installed:
            fits = True
            fit_note = (fit_note + " · host SSD").strip(" ·")
        runnable = installed and fits
        is_active = False
        if active and first:
            try:
                is_active = Path(active).resolve() == Path(first).resolve()
            except Exception:
                is_active = os.path.basename(active) == os.path.basename(first)
        elif active and m["id"] == "qwen25-7b-q5km" and "qwen2.5-7b" in active:
            is_active = True
        elif active and m["id"] == "qwen25-3b-q4km" and "3b" in active.lower():
            is_active = True
        # "Running" only when this model is active AND llama /health is ok.
        running = bool(is_active and healthy)
        deletable = (
            installed
            and not str(first).startswith("/opt/stickllm/models/")
            and m.get("source") != "host_ssd"
        )
        backend = "cuda" if gpu else "cpu"
        dims: dict = {}
        model_max_ctx = 0
        if first and Path(first).is_file():
            meta = read_gguf_meta(first)
            dims = gguf_arch_dims(meta)
            model_max_ctx = int(dims.get("n_ctx_train") or 0)
        budget = estimate_context_budget(
            vram_gb=vram_gb,
            ram_gb=ram_gb,
            approx_size_gb=size_gb,
            backend=backend,
            model_max_ctx=model_max_ctx,
            dims=dims,
        )
        m.update(
            {
                "installed": installed,
                "runnable": runnable,
                "active": is_active,
                "running": running,
                "fits_vram": fits,
                "fits": fits,
                "fit_note": fit_note,
                "path": first,
                "vram_gb": round(vram_gb, 1),
                "ram_gb": round(ram_gb, 1),
                "backend": backend,
                "deletable": deletable,
                "max_context": budget["ctx_model_max"],
                "ctx_min": budget["ctx_min"],
                "ctx_max": budget["ctx_max"],
                "ctx_suggested": budget["ctx_suggested"],
                "free_mem_after_gb": budget["free_mem_after_gb"],
                "architecture": dims.get("architecture") or "",
            }
        )
    return models


def activate_model(model_id: str, ctx_size: int | None = None) -> dict:
    models = enrich_models()
    m = next((x for x in models if x["id"] == model_id), None)
    if not m:
        return {"ok": False, "error": f"unknown model: {model_id}"}
    if not m.get("installed"):
        return {"ok": False, "error": "model not downloaded yet"}
    if not m.get("fits") and m.get("source") != "host_ssd":
        if m.get("backend") == "cpu":
            return {
                "ok": False,
                "error": (
                    f"needs ~{m.get('approx_size_gb')} GB RAM on CPU; "
                    f"this host has ~{m.get('ram_gb')} GB available"
                ),
            }
        return {
            "ok": False,
            "error": f"needs {m['min_vram_gb']} GB VRAM; this host has ~{m['vram_gb']} GB",
        }
    path = m.get("path") or m.get("local_path") or ""
    if not path or not Path(path).is_file():
        return {"ok": False, "error": "model file missing"}
    ctx_lo = int(m.get("ctx_min") or 2048)
    ctx_hi = int(m.get("ctx_max") or 8192)
    if ctx_size is None:
        ctx = int(m.get("ctx_suggested") or min(8192, ctx_hi))
    else:
        try:
            ctx = int(ctx_size)
        except (TypeError, ValueError):
            return {"ok": False, "error": "ctx_size must be an integer"}
    ctx = max(ctx_lo, min(ctx_hi, ctx))
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / "model.env").write_text(
        f"STICKLLM_MODEL={path}\n"
        f"STICKLLM_MODEL_ID={model_id}\n"
        f"STICKLLM_MODEL_NAME={m.get('name') or model_id}\n"
        f"STICKLLM_CTX_SIZE={ctx}\n",
        encoding="utf-8",
    )
    try:
        os.chmod(RUN / "model.env", 0o644)
    except Exception:
        pass
    try:
        cur = RUN / "current.gguf"
        if cur.exists() or cur.is_symlink():
            cur.unlink()
        cur.symlink_to(path)
    except Exception:
        pass
    sh(["systemctl", "reset-failed", "stickllm-llama.service"], timeout=30)
    # model.env now exists → ConditionPathExists passes; start/restart loads on demand.
    r = sh(["systemctl", "restart", "stickllm-llama.service"], timeout=60)
    # Wait briefly for /health so UI can show Loading vs Running.
    healthy = False
    health_msg = "starting"
    for _ in range(40):
        time.sleep(0.5)
        healthy, health_msg = llama_health_ok()
        if healthy:
            break
    r["ok"] = r.get("code", 1) == 0
    r["active_model"] = path
    r["id"] = model_id
    r["name"] = m.get("name") or model_id
    r["ctx_size"] = ctx
    r["running"] = healthy
    r["health"] = health_msg
    r["load_state"] = "running" if healthy else "loading"
    r["models"] = enrich_models()
    return r


def delete_model(model_id: str) -> dict:
    models = enrich_models()
    m = next((x for x in models if x["id"] == model_id), None)
    if not m:
        return {"ok": False, "error": f"unknown model: {model_id}"}
    if not m.get("installed"):
        return {"ok": False, "error": "model not installed"}
    files = m.get("hf_files") or []
    removed: list[str] = []
    blocked: list[str] = []
    for f in files:
        p = find_file(f)
        if not p:
            continue
        if str(p).startswith("/opt/stickllm/models/"):
            blocked.append(str(p))
            continue
        try:
            p.unlink()
            removed.append(str(p))
        except Exception as e:
            return {"ok": False, "error": f"failed to delete {p}: {e}", "removed": removed}
        # Also drop sibling .partial
        try:
            partial = Path(str(p) + ".partial")
            if partial.is_file():
                partial.unlink()
        except Exception:
            pass
    if blocked and not removed:
        return {"ok": False, "error": "baked-in models cannot be deleted", "blocked": blocked}
    # If we deleted the active model, unload — do not auto-load another.
    active = active_model_path()
    if active and any(active == r or active.endswith(os.path.basename(r)) for r in removed):
        sh(["systemctl", "stop", "stickllm-llama.service"], timeout=60)
        try:
            (RUN / "model.env").unlink(missing_ok=True)
        except Exception:
            pass
        try:
            cur = RUN / "current.gguf"
            if cur.exists() or cur.is_symlink():
                cur.unlink()
        except Exception:
            pass
    return {
        "ok": True,
        "removed": removed,
        "blocked": blocked,
        "catalog": enrich_models(),
        "loaded": active_model_identity(),
    }


def wifi_connect(ssid: str, password: str) -> dict:
    ssid = (ssid or "").strip()
    if not ssid:
        return {"ok": False, "error": "ssid required"}
    r = sh(["/usr/local/bin/stickllm-wifi-apply", ssid, password or ""], timeout=120)
    online = False
    try:
        p = subprocess.run(
            ["curl", "-fsS", "--max-time", "3", "-o", "/dev/null",
             "https://connectivitycheck.gstatic.com/generate_204"],
            capture_output=True,
            timeout=6,
            check=False,
        )
        online = p.returncode == 0
    except Exception:
        online = False
    r["online"] = online
    r["ssid"] = ssid
    wifi_doc = read_json(RUN / "wifi.json") if (RUN / "wifi.json").is_file() else {"ssid": ssid}
    # wifi.json is key=value; also expose simple fields
    r["wifi"] = {"ssid": ssid, "online": online}
    if not r.get("ok"):
        r["ok"] = r.get("code", 1) == 0
    return r


def handle(action: str, params: dict) -> dict:
    if action == "status":
        vram = detect_vram_gb()
        ram = detect_ram_gb()
        models = enrich_models(vram)
        watchdog = maybe_resume_stalled_download()
        loaded = active_model_identity()
        online = False
        try:
            p = subprocess.run(
                [
                    "curl",
                    "-fsS",
                    "--max-time",
                    "2",
                    "-o",
                    "/dev/null",
                    "https://connectivitycheck.gstatic.com/generate_204",
                ],
                capture_output=True,
                timeout=4,
                check=False,
            )
            online = p.returncode == 0
        except Exception:
            online = False
        wifi_ssid = ""
        try:
            for line in (RUN / "wifi.json").read_text(encoding="utf-8").splitlines():
                if line.startswith("ssid="):
                    wifi_ssid = line.split("=", 1)[1].strip()
        except Exception:
            pass
        vault = vault_action("status", {})
        dl_dir = vault_download_models_dir()
        return {
            "ok": True,
            "session_mode": session_mode(),
            "storage": read_json(RUN / "storage.json"),
            "vault": vault,
            "probe": read_json(RUN / "model-probe.json"),
            "boot_phase": (RUN / "boot-phase.txt").read_text(encoding="utf-8").strip()
            if (RUN / "boot-phase.txt").is_file()
            else "",
            "vram_gb": round(vram, 1),
            "ram_gb": round(ram, 1),
            "backend": detect_backend(),
            "active_model": loaded.get("path") or "",
            "loaded": loaded,
            "online": online,
            "wifi": {"ssid": wifi_ssid, "online": online},
            "catalog": models,
            "download": download_progress(),
            "watchdog": watchdog,
            "models_dirs": [str(p) for p in model_dirs()],
            "download_dir": str(dl_dir) if dl_dir else "",
            "vault_host_root": vault_host_root(),
        }
    if action == "usb_claim":
        r = sh(["/usr/local/bin/stickllm-usb-claim", "--auto", "--yes"], timeout=180)
        r["storage"] = read_json(RUN / "storage.json")
        return r
    if action == "model_probe":
        r = sh(["/usr/local/bin/stickllm-model-probe"], timeout=60)
        r["probe"] = read_json(RUN / "model-probe.json")
        r["catalog"] = enrich_models()
        return r
    if action == "session_mode":
        return {"ok": True, "mode": session_mode(), "modes": sorted(SESSION_MODES)}
    if action == "set_session_mode":
        return set_session_mode(str(params.get("mode") or ""))
    if action == "model_download":
        mid = str(params.get("id") or "").strip()
        if download_running():
            return {
                "ok": True,
                "started": False,
                "note": "download already running",
                "download": download_progress(),
                "catalog": enrich_models(),
            }
        cmd = ["/usr/local/bin/stickllm-download-model", "--i-understand"]
        if mid:
            cmd += ["--id", mid]
        # Pass session mode so downloader never writes vault paths in ephemeral.
        env = os.environ.copy()
        env["STICKLLM_SESSION_MODE"] = session_mode()
        RUN.mkdir(parents=True, exist_ok=True)
        logf = open(RUN / "download.log", "a", encoding="utf-8")
        subprocess.Popen(
            cmd, stdout=logf, stderr=subprocess.STDOUT, start_new_session=True, env=env
        )
        time.sleep(0.4)
        return {
            "ok": True,
            "started": True,
            "session_mode": session_mode(),
            "download": download_progress(),
            "catalog": enrich_models(),
        }
    if action == "model_activate":
        mid = str(params.get("id") or "").strip()
        if not mid:
            return {"ok": False, "error": "id required"}
        raw_ctx = params.get("ctx_size", params.get("ctx", params.get("n_ctx")))
        ctx_arg = None
        if raw_ctx is not None and str(raw_ctx).strip() != "":
            try:
                ctx_arg = int(raw_ctx)
            except (TypeError, ValueError):
                return {"ok": False, "error": "ctx_size must be an integer"}
        return activate_model(mid, ctx_arg)
    if action == "model_delete":
        mid = str(params.get("id") or "").strip()
        if not mid:
            return {"ok": False, "error": "id required"}
        return delete_model(mid)
    if action == "wifi_connect":
        return wifi_connect(str(params.get("ssid") or ""), str(params.get("password") or ""))
    if action == "catalog":
        return {"ok": True, "models": enrich_models()}
    if action == "ssd_status":
        return vault_action("status", params)
    if action == "vault_status":
        return vault_action("status", params)
    if action == "vault_disks":
        return vault_action("list-disks", params)
    if action == "vault_devices":
        return vault_action("list-devices", params)
    if action == "vault_list_dirs":
        return vault_action("list-dirs", params)
    if action == "vault_browse_start":
        return vault_action("browse-start", params)
    if action == "vault_find_models":
        return vault_action("find-models", params)
    if action == "vault_mkdir":
        return vault_action("mkdir", params)
    if action == "vault_mount":
        return vault_action("mount-host", params)
    if action == "vault_setup":
        return vault_action("setup", params)
    if action == "vault_create_file":
        return vault_action("setup", params)
    if action == "vault_create_partition":
        # Hard refuse — never partition/format host disks (v0.3.3).
        return {
            "ok": False,
            "error": (
                "Partition/format flows are disabled. Vault creates a file in a "
                "folder you choose — never formats your drive. Unlock BitLocker/"
                "host LUKS in the host OS first if needed, then: "
                "sudo stickllm-vault setup /path/to/dir"
            ),
        }
    if action == "vault_unlock":
        return vault_action("unlock", params)
    if action == "vault_lock":
        return vault_action("lock", params)
    if action == "vault_move_model":
        return vault_action("move-model", params)
    if action == "vault_list_movable":
        return vault_action("list-movable", params)
    if action == "vault_set_wipe":
        return vault_action("set-wipe-after", params)
    if action == "vault_grow":
        return vault_action("grow", params)
    return {"ok": False, "error": f"unknown action: {action}"}


def _looks_like_block_device(path: str) -> bool:
    p = (path or "").strip()
    if p.startswith("/dev/"):
        return True
    if p.startswith("\\\\.\\PhysicalDrive") or p.startswith("//./PhysicalDrive"):
        return True
    return False


def vault_action(cmd: str, params: dict) -> dict:
    """Drive stickllm-vault; fail-closed — never invent destructive defaults."""
    script = "/usr/local/bin/stickllm-vault"
    if cmd == "status":
        r = sh([script, "status"], timeout=30)
        st = read_json(RUN / "vault.json")
        r.update(st)
        r["ok"] = True
        return r
    if cmd == "list-disks":
        # Read-only probe only (mounted folders + informational disk list).
        r = sh([script, "list-disks"], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            data["ok"] = True
            data.setdefault(
                "safety",
                "Creates a file in a folder you choose. Never formats your drive.",
            )
            return data
        except Exception:
            return {**r, "ok": False, "error": "list-disks parse failed"}
    if cmd == "list-devices":
        r = sh([script, "list-devices"], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            data["ok"] = bool(data.get("ok", True))
            return data
        except Exception:
            return {**r, "ok": False, "error": "list-devices parse failed"}
    if cmd == "list-dirs":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        r = sh([script, "list-dirs", path], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            return data
        except Exception:
            return {**r, "ok": False, "error": "list-dirs parse failed"}
    if cmd == "browse-start":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        r = sh([script, "browse-start", path], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            return data
        except Exception:
            return {**r, "ok": False, "error": "browse-start parse failed"}
    if cmd == "find-models":
        path = str(params.get("path") or "").strip()
        if not path:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(path):
            return {"ok": False, "error": "refusing block device path"}
        r = sh([script, "find-models", path], timeout=45)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            return data
        except Exception:
            return {**r, "ok": False, "error": "find-models parse failed"}
    if cmd == "mkdir":
        parent = str(params.get("path") or params.get("parent") or "").strip()
        name = str(params.get("name") or "").strip()
        if not parent or not name:
            return {"ok": False, "error": "path and name required"}
        if _looks_like_block_device(parent):
            return {"ok": False, "error": "refusing block device path"}
        r = sh([script, "mkdir", parent, name], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            return data
        except Exception:
            err = (r.get("stderr") or r.get("error") or "mkdir failed").strip()
            return {**r, "ok": False, "error": err}
    if cmd == "mount-host":
        device = str(params.get("device") or params.get("path") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not device:
            return {"ok": False, "error": "device required (e.g. /dev/nvme0n1p2)"}
        if not _looks_like_block_device(device):
            return {"ok": False, "error": "device must be a /dev/… partition"}
        if confirm != "MOUNT-HOST":
            return {"ok": False, "error": "confirm must be MOUNT-HOST"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "MOUNT-HOST"
        try:
            p = subprocess.run(
                [script, "mount-host", device],
                capture_output=True,
                text=True,
                timeout=120,
                check=False,
                env=env,
            )
            lines = [ln for ln in (p.stdout or "").strip().splitlines() if ln.strip()]
            try:
                data = json.loads(lines[-1] if lines else "{}")
            except Exception:
                data = {
                    "ok": p.returncode == 0,
                    "stdout": (p.stdout or "")[-2000:],
                    "stderr": (p.stderr or "")[-2000:],
                }
            if p.returncode != 0:
                data["ok"] = False
                if not data.get("error"):
                    data["error"] = (p.stderr or data.get("stderr") or "mount failed").strip()[:500]
            return data
        except Exception as e:
            return {"ok": False, "error": str(e)}
    if cmd == "lock":
        sh(["systemctl", "stop", "stickllm-llama.service"], timeout=60)
        r = sh([script, "lock"], timeout=120)
        return merge_vault_run(r)
    if cmd == "unlock":
        passcode = str(params.get("passcode") or "")
        env = os.environ.copy()
        if passcode:
            env["STICKLLM_VAULT_PASS"] = passcode
        try:
            p = subprocess.run(
                [script, "unlock"],
                capture_output=True,
                text=True,
                timeout=180,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "setup":
        path = str(params.get("path") or params.get("dir") or "").strip()
        size_gb = str(params.get("size_gb") or "8").strip()
        confirm = str(params.get("confirm") or "")
        saved = str(params.get("saved_confirm") or params.get("recovery_confirm") or "")
        passcode = str(params.get("passcode") or "")
        passcode2 = str(params.get("passcode2") or passcode)
        space_ok = str(params.get("space_confirm") or "")
        if _looks_like_block_device(path):
            return {
                "ok": False,
                "error": (
                    "Refusing block device path. Pick a mounted folder on the host "
                    "SSD. If BitLocker/LUKS is locked, unlock it in the host OS first "
                    "— StickLLM will not unlock or wipe host encryption."
                ),
            }
        if confirm != "CREATE-VAULT":
            return {
                "ok": False,
                "error": "typed confirm must be CREATE-VAULT",
            }
        # UI must show recovery_phrase once and require local SAVED ack after.
        # Backend accepts SAVED or SHOW-ONCE (API) so create can return the phrase.
        if saved not in ("SAVED", "SHOW-ONCE"):
            return {
                "ok": False,
                "error": "recovery_confirm must be SAVED or SHOW-ONCE",
            }
        if not path:
            return {"ok": False, "error": "path (directory) required"}
        if len(passcode) < 8:
            return {"ok": False, "error": "passcode must be at least 8 characters"}
        if passcode != passcode2:
            return {"ok": False, "error": "passcodes do not match"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "CREATE-VAULT"
        env["STICKLLM_VAULT_CONFIRM_SAVED"] = "SAVED"
        env["STICKLLM_VAULT_PASS"] = passcode
        env["STICKLLM_VAULT_PASS2"] = passcode2
        # Sparse logical size may exceed free; UI CREATE-VAULT implies SPACE-OK awareness.
        env["STICKLLM_VAULT_CONFIRM_SPACE"] = (
            "SPACE-OK" if space_ok in ("", "SPACE-OK") else space_ok
        )
        # Wipe stays off unless explicitly requested at setup.
        env.setdefault("STICKLLM_VAULT_WIPE_AFTER", "0")
        try:
            p = subprocess.run(
                [script, "setup", path, size_gb],
                capture_output=True,
                text=True,
                timeout=600,
                check=False,
                env=env,
            )
            out = (p.stdout or "")
            recovery = ""
            for line in out.splitlines():
                if line.startswith("RECOVERY_PHRASE:"):
                    recovery = line.split(":", 1)[1].strip()
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": out[-6000:],
                "stderr": (p.stderr or "")[-3000:],
                "recovery_phrase": recovery if p.returncode == 0 else "",
                "path": path,
                "size_gb": size_gb,
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "grow":
        add_gb = str(params.get("add_gb") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not add_gb:
            return {"ok": False, "error": "add_gb required"}
        if confirm != "GROW-VAULT":
            return {"ok": False, "error": "typed confirm must be GROW-VAULT"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "GROW-VAULT"
        try:
            p = subprocess.run(
                [script, "grow", add_gb],
                capture_output=True,
                text=True,
                timeout=600,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "list-movable":
        r = sh([script, "list-movable"], timeout=30)
        try:
            lines = [ln for ln in (r.get("stdout") or "").strip().splitlines() if ln.strip()]
            data = json.loads(lines[-1] if lines else "{}")
            data["ok"] = True
            return data
        except Exception:
            return {**r, "ok": False, "error": "list-movable parse failed"}
    if cmd == "set-wipe-after":
        n = str(params.get("n") or params.get("wipe_after") or "0").strip()
        confirm = str(params.get("confirm") or "")
        if n not in ("0",) and confirm != "WIPE-OK":
            return {
                "ok": False,
                "error": "enabling wipe-after-N requires confirm=WIPE-OK (destroys blob LUKS header after N fails; default is off)",
            }
        env = os.environ.copy()
        if confirm == "WIPE-OK":
            env["STICKLLM_VAULT_CONFIRM"] = "WIPE-OK"
        try:
            p = subprocess.run(
                [script, "set-wipe-after", n],
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
                env=env,
            )
            r = {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-2000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            r = {"ok": False, "error": str(e)}
        return merge_vault_run(r)
    if cmd == "move-model":
        src = str(params.get("path") or "").strip()
        confirm = str(params.get("confirm") or "")
        if not src:
            return {"ok": False, "error": "path required"}
        if _looks_like_block_device(src):
            return {"ok": False, "error": "refusing block device path"}
        if confirm != "MOVE-MODEL":
            return {"ok": False, "error": "confirm must be MOVE-MODEL"}
        if session_mode() != "vault":
            return {"ok": False, "error": "switch Mode to Vault before moving models"}
        env = os.environ.copy()
        env["STICKLLM_VAULT_CONFIRM"] = "MOVE-MODEL"
        try:
            p = subprocess.run(
                [script, "move-model", src],
                capture_output=True,
                text=True,
                timeout=7200,
                check=False,
                env=env,
            )
            return {
                "ok": p.returncode == 0,
                "code": p.returncode,
                "stdout": (p.stdout or "")[-4000:],
                "stderr": (p.stderr or "")[-2000:],
            }
        except Exception as e:
            return {"ok": False, "error": str(e)}
    return {"ok": False, "error": f"unknown vault cmd: {cmd}"}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _send(self, code: int, obj: dict) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:  # noqa: N802
        if self.path not in ("/", "/action"):
            self._send(404, {"ok": False, "error": "not found"})
            return
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            req = json.loads(raw.decode() or "{}")
        except Exception:
            self._send(400, {"ok": False, "error": "bad json"})
            return
        action = str(req.get("action") or "")
        params = req.get("params") or {}
        if not isinstance(params, dict):
            params = {}
        result = handle(action, params)
        self._send(200 if result.get("ok", True) or "code" in result else 500, result)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True


def main() -> int:
    RUN.mkdir(parents=True, exist_ok=True)
    httpd = ThreadedHTTPServer((HOST, PORT), Handler)
    print(f"stickllm-control on http://{HOST}:{PORT}", flush=True)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
