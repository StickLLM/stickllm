#!/bin/bash
# 0.6.1: F10 / F9 in Terminal mode (bound in /etc/profile.d/stickllm-terminal.sh)
# and on the loading screen. Prints the SSH login and the pair code to the
# terminal it is called from only. Never logs.
RUN="${STICKLLM_RUN:-/run/stickllm}"
what="${1:-all}"
ip="$(/usr/local/bin/stickllm-lan-ip 2>/dev/null | tr -d '[:space:]')"
pass="$(tr -d '[:space:]' <"$RUN/ssh-password.txt" 2>/dev/null)"
code="$(tr -d '[:space:]' <"$RUN/pair-code.txt" 2>/dev/null)"
printf '\n'
if [[ "$what" == all || "$what" == ssh ]]; then
  if [[ -n "$pass" ]]; then
    printf '  SSH:       ssh stickllm@%s\n' "${ip:-<lan-ip: no network yet>}"
    printf '  password:  %s\n' "$pass"
  else
    printf '  SSH:       off on this boot (or the password is still being set)\n'
  fi
fi
if [[ "$what" == all || "$what" == pair ]]; then
  if [[ "$code" =~ ^[0-9]{4,8}$ ]]; then
    printf '  Pair code: %s   (browser: http://%s/)\n' "$code" "${ip:-<lan-ip>}"
  else
    printf '  Pair code: none (already paired, or the web UI is not up)\n'
  fi
fi
printf '\n'
