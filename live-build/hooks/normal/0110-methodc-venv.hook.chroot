#!/bin/bash
# Build Method C peer venv from vendored wheelhouse (no network / no first-boot pip).
set -euo pipefail

echo "[stickllm] chroot hook: methodc venv"

WHEELHOUSE=/opt/stickllm/methodc-wheelhouse
REQ=/usr/local/lib/stickllm-methodc-requirements.txt
VENV=/opt/stickllm/methodc-venv

if [[ ! -d "$WHEELHOUSE" ]]; then
  echo "STICKLLM ERROR: missing $WHEELHOUSE (run scripts/vendor-methodc-wheels.sh before build)" >&2
  exit 1
fi
if [[ ! -f "$REQ" ]]; then
  echo "STICKLLM ERROR: missing $REQ" >&2
  exit 1
fi
whl_count="$(find "$WHEELHOUSE" -type f -name '*.whl' | wc -l | tr -d ' ')"
if [[ "${whl_count}" -lt 5 ]]; then
  echo "STICKLLM ERROR: wheelhouse too small (${whl_count} whl)" >&2
  exit 1
fi

# Ensure venv module + pip bootstrap from apt (already in package list).
# Default is no system site-packages (do not pass --system-site-packages=false;
# argparse treats that flag as store_true and rejects an explicit false value).
python3 -m venv "$VENV"
# Install ONLY from local wheelhouse — fail if anything would hit the network.
"$VENV/bin/pip" install --no-index --find-links="$WHEELHOUSE" -r "$REQ"

# Prove imports inside the baked venv (aiortc pulls cryptography 44+ here).
"$VENV/bin/python" - <<'PY'
import aiortc, av, cryptography, websockets
print("methodc-venv ok", aiortc.__version__, av.__version__, cryptography.__version__, websockets.__version__)
PY

chmod 755 /usr/local/bin/stickllm-methodc-peer
chmod 755 /usr/local/bin/stickllm-sticklink-lab-grant
chmod 755 /usr/local/bin/stickllm-sticklink-ensure-identity
chmod 755 /usr/local/bin/stickllm-methodc-remint
chmod 644 /etc/systemd/system/stickllm-methodc-peer.service
chmod 644 /etc/systemd/system/stickllm-sticklink-ensure-identity.service

# First-boot: generate StickLink device identity + register with link.stickllm.com
# before methodc-peer starts. Token comes from bake host env (lab images only).
mkdir -p /etc/stickllm
if [[ -n "${STICKLINK_LAB_PROVISION_TOKEN:-}" ]]; then
  umask 077
  {
    echo "# Lab factory token for StickLink first-boot provision (do not commit)."
    echo "STICKLINK_LAB_PROVISION_TOKEN=${STICKLINK_LAB_PROVISION_TOKEN}"
    echo "STICKLINK_LAB_PROVISION_URL=${STICKLINK_LAB_PROVISION_URL:-https://link.stickllm.com/v1/lab/device-provision}"
  } >/etc/stickllm/sticklink-factory.env
  chmod 600 /etc/stickllm/sticklink-factory.env
  echo "[stickllm] chroot hook: wrote sticklink-factory.env (token present)"
else
  echo "[stickllm] chroot hook: STICKLINK_LAB_PROVISION_TOKEN unset — ensure-identity will fail until set"
fi
systemctl enable stickllm-sticklink-ensure-identity.service

# Auto-start Method C peer (recovers via Restart=always). A0 is loopback-only.
systemctl enable stickllm-methodc-peer.service

# Public join host on StickLink signalling (CF static /browser/* only; no A0 proxy).
# Preserve overlay methodc-peer.env (keepalive / transport / expiry); only ensure base URL.
mkdir -p /etc/stickllm
if [[ -f /etc/stickllm/methodc-peer.env ]]; then
  if ! grep -q '^SL_JOIN_PUBLIC_BASE=' /etc/stickllm/methodc-peer.env; then
    printf '\nSL_JOIN_PUBLIC_BASE=https://link.stickllm.com\n' >>/etc/stickllm/methodc-peer.env
  fi
  # Strip BOM/CRLF so systemd EnvironmentFile accepts the file.
  tr -d '\r' </etc/stickllm/methodc-peer.env | sed '1s/^\xEF\xBB\xBF//' >/etc/stickllm/methodc-peer.env.nobom
  mv /etc/stickllm/methodc-peer.env.nobom /etc/stickllm/methodc-peer.env
else
  cat >/etc/stickllm/methodc-peer.env <<'EOF'
# Milestone A: public HTTPS join host (Worker static assets). Not the lab PC.
SL_JOIN_PUBLIC_BASE=https://link.stickllm.com
EOF
fi
chmod 644 /etc/stickllm/methodc-peer.env
# Ensure unit drop-in stays aligned after upgrades.
mkdir -p /etc/systemd/system/stickllm-methodc-peer.service.d
cat >/etc/systemd/system/stickllm-methodc-peer.service.d/join.conf <<'EOF'
[Service]
Environment=SL_JOIN_PUBLIC_BASE=https://link.stickllm.com
EOF
chmod 644 /etc/systemd/system/stickllm-methodc-peer.service.d/join.conf
# Keep unit ExecStart on venv python (Debian venv is a symlink; argv0 selects site-packages).
if ! grep -q 'methodc-venv/bin/python' /etc/systemd/system/stickllm-methodc-peer.service; then
  sed -i 's|^ExecStart=.*|ExecStart=/opt/stickllm/methodc-venv/bin/python /usr/local/bin/stickllm-methodc-peer|' \
    /etc/systemd/system/stickllm-methodc-peer.service
fi


echo "[stickllm] chroot hook: methodc venv done (${whl_count} wheels)"
