#!/bin/bash
# Launch llama-server: localhost-only; CUDA when NVIDIA present, else CPU (-ngl 0).
set -euo pipefail

MODEL="${STICKLLM_MODEL:-/opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf}"
HOST="${STICKLLM_LLAMA_HOST:-127.0.0.1}"
PORT="${STICKLLM_LLAMA_PORT:-8080}"
CTX="${STICKLLM_CTX_SIZE:-8192}"
CUDA_BIN="${STICKLLM_LLAMA_CUDA:-/opt/stickllm/bin/llama-server}"
CPU_BIN="${STICKLLM_LLAMA_CPU:-/opt/stickllm/bin/llama-server-cpu}"
RUN="${STICKLLM_RUN:-/run/stickllm}"
mkdir -p "$RUN"

phys_threads() {
  local n
  n="$(nproc --all 2>/dev/null || nproc 2>/dev/null || echo 4)"
  # Prefer physical cores when lscpu reports them.
  if command -v lscpu >/dev/null 2>&1; then
    local cores
    cores="$(lscpu -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l | tr -d ' ')"
    if [[ "${cores:-0}" =~ ^[0-9]+$ ]] && [[ "$cores" -ge 1 ]]; then
      n="$cores"
    fi
  fi
  [[ "$n" -lt 1 ]] && n=1
  [[ "$n" -gt 64 ]] && n=64
  echo "$n"
}

has_nvidia() {
  [[ -e /dev/nvidia0 || -e /dev/nvidiactl ]] || return 1
  command -v nvidia-smi >/dev/null 2>&1 || return 1
  nvidia-smi -L >/dev/null 2>&1 || return 1
  return 0
}

THREADS="$(phys_threads)"
export LD_LIBRARY_PATH="/opt/stickllm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if has_nvidia && [[ -x "$CUDA_BIN" ]]; then
  echo "stickllm-llama-start: CUDA mode threads=$THREADS host=$HOST:$PORT model=$MODEL" >&2
  printf 'backend=cuda\nthreads=%s\nhost=%s\nport=%s\nmodel=%s\n' \
    "$THREADS" "$HOST" "$PORT" "$MODEL" >"$RUN/llama-runtime.env"
  exec "$CUDA_BIN" \
    --model "$MODEL" \
    --host "$HOST" \
    --port "$PORT" \
    --ctx-size "$CTX" \
    --n-gpu-layers "${STICKLLM_N_GPU_LAYERS:-999}" \
    --threads "$THREADS" \
    --metrics
fi

BIN="$CPU_BIN"
if [[ ! -x "$BIN" ]]; then
  # Fall back to CUDA binary with -ngl 0 if CPU build missing (may still need libcuda).
  BIN="$CUDA_BIN"
fi
if [[ ! -x "$BIN" ]]; then
  echo "stickllm-llama-start: no llama-server binary found" >&2
  exit 1
fi

echo "stickllm-llama-start: CPU mode (-ngl 0) threads=$THREADS host=$HOST:$PORT model=$MODEL bin=$BIN" >&2
printf 'backend=cpu\nthreads=%s\nhost=%s\nport=%s\nmodel=%s\n' \
  "$THREADS" "$HOST" "$PORT" "$MODEL" >"$RUN/llama-runtime.env"
exec "$BIN" \
  --model "$MODEL" \
  --host "$HOST" \
  --port "$PORT" \
  --ctx-size "$CTX" \
  --n-gpu-layers 0 \
  --threads "$THREADS" \
  --metrics
