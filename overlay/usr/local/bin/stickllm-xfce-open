#!/bin/bash
# StickLLM (MIT, (c) Nink Inc.). Opens StickLLM windows on the Xfce desktop.
#   stickllm-xfce-open home      the StickLLM desktop: full screen, below all
#                                other windows, no frame, no taskbar entry.
#                                Same page and layout as 0.5.6's sway desktop
#                                (bottom bar with vault + model, launcher,
#                                Agent, settings windows). Restarts if closed.
#   stickllm-xfce-open browser   a normal Chromium window
#   stickllm-xfce-open <app-id>  a StickLLM web app (/apps/<id>/)
# The desktop and app windows share ONE Chromium profile (same origin; the
# app agent talks to the apps over BroadcastChannel inside one profile).
set -u
BROWSER="${STICKLLM_SESSION_BROWSER:-chromium}"
BASE="${STICKLLM_SESSION_URL:-http://127.0.0.1/}"
BASE="${BASE%/}"
PROFILE="${STICKLLM_SESSION_PROFILE:-$HOME/.config/stickllm-kiosk}"
id="${1:-home}"
# X11 + amdgpu/i915: use real GL (ANGLE/GL). SwiftShader pegs the gpu-process
# at 400%+ CPU whenever Agent Zero streams DOM updates and the HDMI kiosk
# flickers. (SwiftShader was for opaque menus on Wayland; Xfce/X11 does not
# need it. Override Debian's --enable-gpu-rasterization when software GL is
# forced via STICKLLM_KIOSK_SW_GL=1.)
if [[ "${STICKLLM_KIOSK_SW_GL:-0}" == "1" ]]; then
  common=(
    --ozone-platform=x11
    --use-gl=angle --use-angle=swiftshader
    --disable-gpu-rasterization
    --num-raster-threads=1
  )
else
  common=(
    --ozone-platform=x11
    --use-gl=angle --use-angle=gl
    --disable-gpu-driver-bug-workarounds
  )
fi
common+=(
  --no-first-run
  --disable-infobars
  --disable-session-crashed-bubble
  --hide-crash-restore-bubble
  --check-for-update-interval=31536000
  --user-data-dir="$PROFILE"
  --disk-cache-dir="$PROFILE/cache"
)

# Make the desktop window the backdrop: no frame, full screen, kept below the
# Browser and app windows, out of Alt+Tab and taskbars; then give it focus.
dress_desktop() {
  local wid="" i
  for i in $(seq 1 120); do
    wid="$(wmctrl -lx 2>/dev/null | awk 'tolower($3) ~ /stickllm-desktop/ {print $1; exit}')"
    [[ -n "$wid" ]] && break
    sleep 0.5
  done
  [[ -n "$wid" ]] || return 0
  bare_desktop "$wid"
  wmctrl -i -a "$wid" 2>/dev/null || true
}

# 0.6.0 (B6): 0.5.9 set the MWM hints first and maximised afterwards. Chromium
# rewrites _MOTIF_WM_HINTS itself when its window state changes (maximise,
# restore, frame-type change), so xfwm4 put the title bar back. Now the state
# changes come first, the hints last, and keep_desktop_bare re-applies them
# whenever xfwm4 reports a frame again (_NET_FRAME_EXTENTS not all zero).
bare_desktop() {
  local wid="$1" sw sh
  read -r sw sh < <(xdotool getdisplaygeometry 2>/dev/null || echo "1920 1080")
  wmctrl -i -r "$wid" -b add,below,skip_taskbar,skip_pager 2>/dev/null || true
  wmctrl -i -r "$wid" -b add,maximized_vert,maximized_horz 2>/dev/null || true
  wmctrl -i -r "$wid" -e "0,0,0,${sw},${sh}" 2>/dev/null || true
  sleep 0.3
  # MWM functions=0 + decorations=0: xfwm4 drops the frame and refuses
  # minimise/close/move/resize for this window.
  xprop -id "$wid" -f _MOTIF_WM_HINTS 32c -set _MOTIF_WM_HINTS "0x3, 0x0, 0x0, 0x0, 0x0" 2>/dev/null || true
}

frame_extents_zero() {
  local ext
  ext="$(xprop -id "$1" _NET_FRAME_EXTENTS 2>/dev/null || true)"
  # Not reported (yet) counts as bare; xfwm4 sets it on every managed window.
  [[ "$ext" == *"="* ]] || return 0
  [[ "$(printf '%s' "${ext#*=}" | tr -d ' ,0')" == "" ]]
}

keep_desktop_bare() {
  # 0.6.1: xfwm4 titleless_maximize (xfwm4.xml) removes the frame; this is only
  # a short safety net now. Check for 30 s after the window maps, re-apply at
  # most 3 times, then stop (0.6.0 polled every 2 s forever to no effect).
  # Log to /run/stickllm (XDG_RUNTIME_DIR was not writable at that point).
  local wid="$1" pid="$2" fixes=0 i log=/run/stickllm/desktop-frame.log
  ( : >>"$log" ) 2>/dev/null || log="${XDG_RUNTIME_DIR:-/tmp}/stickllm-desktop-frame.log"
  for i in $(seq 1 15); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 2
    xprop -id "$wid" WM_CLASS >/dev/null 2>&1 || return 0
    frame_extents_zero "$wid" && continue
    bare_desktop "$wid"
    fixes=$((fixes + 1))
    echo "STICKLLM_DESKTOP_FRAME_REAPPLIED n=$fixes" >>"$log" 2>/dev/null || true
    (( fixes >= 3 )) && break
  done
  frame_extents_zero "$wid" || echo "STICKLLM_DESKTOP_FRAME_STILL_SET (titleless_maximize off?)" >>"$log" 2>/dev/null || true
}

system_frame_pref() {
  pgrep -u "$(id -u)" -f -- "--user-data-dir=$PROFILE" >/dev/null 2>&1 && return 0
  mkdir -p "$PROFILE/Default" 2>/dev/null || return 0
  python3 - "$PROFILE/Default/Preferences" <<'PY' 2>/dev/null || true
import json, os, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
d.setdefault("browser", {})["custom_chrome_frame"] = False
tmp = p + ".stickllm"
with open(tmp, "w") as f:
    json.dump(d, f)
os.replace(tmp, p)
PY
}

case "$id" in
  home)
    # Plain BASE/ (no ?shell=xfce): the page uses its desktop layout.
    # 0.5.9: Chromium draws its own title bar (with minimise/close) on xfwm4
    # unless "Use system title bar" is set; set it so the WM hints above make
    # the desktop window borderless with no buttons.
    system_frame_pref
    while true; do
      "$BROWSER" "${common[@]}" --class=stickllm-desktop --start-maximized --app="$BASE/" &
      pid=$!
      dress_desktop
      _wid="$(wmctrl -lx 2>/dev/null | awk 'tolower($3) ~ /stickllm-desktop/ {print $1; exit}')"
      [[ -n "$_wid" ]] && { keep_desktop_bare "$_wid" "$pid" & }
      wait "$pid"
      sleep 2
      system_frame_pref
    done ;;
  browser)
    bp="${XDG_RUNTIME_DIR:-/tmp}/stickllm-web"
    mkdir -p "$bp/cache" && chmod 700 "$bp"
    web=("${common[@]}")
    web=("${web[@]/--user-data-dir=*/--user-data-dir=$bp}")
    web=("${web[@]/--disk-cache-dir=*/--disk-cache-dir=$bp/cache}")
    exec "$BROWSER" "${web[@]}" --class=stickllm-browser --new-window ;;
  *)
    [[ "$id" =~ ^[a-z0-9-]{1,32}$ ]] || exit 2
    exec "$BROWSER" "${common[@]}" --class="stickllm-$id" --app="$BASE/apps/$id/" ;;
esac
