#
# Replaces derp-admit.service (the deny-all stub). Same listen address, so
# derper's DERP_VERIFY_URL=http://127.0.0.1:9099/derp/admit stays unchanged.
# Unlike the stub, this needs outbound HTTPS to the signalling Worker.
[Unit]
Description=sticklink relay admission controller for derper
After=network-online.target
Wants=network-online.target
Before=derper.service

[Service]
ExecStart=/usr/local/bin/sticklink-admit -listen 127.0.0.1:9099 -base https://link.stickllm.com -region tor1 -token-file ${CREDENTIALS_DIRECTORY}/admit-token -keys /etc/sticklink/admit-keys -state /var/lib/sticklink-admit
LoadCredential=admit-token:/etc/sticklink/admit-token
DynamicUser=yes
StateDirectory=sticklink-admit
StateDirectoryMode=0700
Restart=always
RestartSec=2

# Sandboxing (as strict as the stub, but with egress allowed).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=64M
TasksMax=64

[Install]
WantedBy=multi-user.target
