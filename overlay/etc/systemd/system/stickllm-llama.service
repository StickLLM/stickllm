[Unit]
Description=StickLLM llama.cpp server (loopback only)
# NVIDIA prep is best-effort; do not hard-require GPU devices (CPU fallback).
After=network.target
Wants=network.target
ConditionPathExists=/opt/stickllm/bin/llama-server

[Service]
Type=simple
User=stickllm-llama
Group=stickllm-llama
SupplementaryGroups=video render
EnvironmentFile=-/etc/stickllm/runtime.env
EnvironmentFile=-/run/stickllm/cuda.env
EnvironmentFile=-/etc/stickllm/default-model.env
EnvironmentFile=-/run/stickllm/model.env
Environment=LD_LIBRARY_PATH=/opt/stickllm/lib
Environment=STICKLLM_LLAMA_HOST=127.0.0.1
Environment=STICKLLM_LLAMA_PORT=8080
# Prep needs root (modprobe); + ignores User=. No-ops cleanly without NVIDIA.
ExecStartPre=+/usr/local/bin/stickllm-nvidia-prep
ExecStartPre=+/usr/local/bin/stickllm-pick-gpus
ExecStart=/usr/local/bin/stickllm-llama-start
Restart=on-failure
RestartSec=5
# Optional NVIDIA device access when present; unit must still start without them.
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
ReadWritePaths=/tmp /run /var/tmp /mnt/stickllm-data /opt/stickllm
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
