#!/bin/bash
# Random per-boot SSH password for user stickllm (shown on Terminal / Test console).
set -euo pipefail
RUN="${STICKLLM_RUN:-/run/stickllm}"
mkdir -p "$RUN"
# No look-alike characters: 0 O o 1 l I i J j are left out so the password
# can be read off the console and typed without guessing.
ALPHABET='ABCDEFGHKLMNPQRSTUVWXYZabcdefghkmnpqrstuvwxyz23456789'
PASS="$(tr -dc "$ALPHABET" </dev/urandom | head -c 16 || true)"
if [[ ${#PASS} -lt 16 ]]; then
  PASS="$(openssl rand 512 | tr -dc "$ALPHABET" | head -c 16)"
fi
echo "stickllm:${PASS}" | chpasswd
umask 077
printf '%s\n' "$PASS" >"$RUN/ssh-password.txt"
chmod 600 "$RUN/ssh-password.txt"
# Drop any stale world-readable copies.
rm -f /etc/stickllm/ssh-password.txt 2>/dev/null || true
echo "stickllm-ssh-bootstrap: password written to $RUN/ssh-password.txt" >&2
