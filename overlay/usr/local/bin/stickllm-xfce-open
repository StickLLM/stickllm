#!/bin/bash
# StickLLM (MIT, (c) Nink Inc.). Opens StickLLM windows on the Xfce desktop.
#   stickllm-xfce-open home      the StickLLM desktop: full screen, below all
#                                other windows, no frame, no taskbar entry.
#                                Same page and layout as 0.5.6's sway desktop
#                                (bottom bar with vault + model, launcher,
#                                Agent, settings windows). Restarts if closed.
#   stickllm-xfce-open browser   a normal Chromium window
#   stickllm-xfce-open <app-id>  a StickLLM web app (/apps/<id>/)
# The desktop and app windows share ONE Chromium profile (same origin; the
# app agent talks to the apps over BroadcastChannel inside one profile).
set -u
BROWSER="${STICKLLM_SESSION_BROWSER:-chromium}"
BASE="${STICKLLM_SESSION_URL:-http://127.0.0.1/}"
BASE="${BASE%/}"
PROFILE="${STICKLLM_SESSION_PROFILE:-$HOME/.config/stickllm-kiosk}"
id="${1:-home}"
common=(
  --ozone-platform=x11
  --use-gl=angle --use-angle=swiftshader
  --no-first-run
  --disable-infobars
  --disable-session-crashed-bubble
  --hide-crash-restore-bubble
  --check-for-update-interval=31536000
  --user-data-dir="$PROFILE"
  --disk-cache-dir="$PROFILE/cache"
)

# Make the desktop window the backdrop: no frame, full screen, kept below the
# Browser and app windows, out of Alt+Tab and taskbars; then give it focus.
dress_desktop() {
  local wid="" i
  for i in $(seq 1 120); do
    wid="$(wmctrl -lx 2>/dev/null | awk 'tolower($3) ~ /stickllm-desktop/ {print $1; exit}')"
    [[ -n "$wid" ]] && break
    sleep 0.5
  done
  [[ -n "$wid" ]] || return 0
  xprop -id "$wid" -f _MOTIF_WM_HINTS 32c -set _MOTIF_WM_HINTS "0x2, 0x0, 0x0, 0x0, 0x0" 2>/dev/null || true
  read -r sw sh < <(xdotool getdisplaygeometry 2>/dev/null || echo "1920 1080")
  wmctrl -i -r "$wid" -b add,below,skip_taskbar,skip_pager 2>/dev/null || true
  wmctrl -i -r "$wid" -e "0,0,0,${sw},${sh}" 2>/dev/null || true
  wmctrl -i -r "$wid" -b add,maximized_vert,maximized_horz 2>/dev/null || true
  wmctrl -i -a "$wid" 2>/dev/null || true
}

case "$id" in
  home)
    # Plain BASE/ (no ?shell=xfce): the page uses its desktop layout.
    while true; do
      "$BROWSER" "${common[@]}" --class=stickllm-desktop --start-maximized --app="$BASE/" &
      pid=$!
      dress_desktop
      wait "$pid"
      sleep 2
    done ;;
  browser)
    bp="${XDG_RUNTIME_DIR:-/tmp}/stickllm-web"
    mkdir -p "$bp/cache" && chmod 700 "$bp"
    web=("${common[@]}")
    web=("${web[@]/--user-data-dir=*/--user-data-dir=$bp}")
    web=("${web[@]/--disk-cache-dir=*/--disk-cache-dir=$bp/cache}")
    exec "$BROWSER" "${web[@]}" --class=stickllm-browser --new-window ;;
  *)
    [[ "$id" =~ ^[a-z0-9-]{1,32}$ ]] || exit 2
    exec "$BROWSER" "${common[@]}" --class="stickllm-$id" --app="$BASE/apps/$id/" ;;
esac
