#!/bin/bash
# Pick GPU backend for llama.cpp: NVIDIA CUDA → AMD/Intel Vulkan → CPU.
# Always exit 0: QEMU Local blacklists nvidia; nvidia-smi exit 9 must never
# block stickllm-llama. No set -e / pipefail around GPU probes.
set -u

RUN_DIR="${STICKLLM_RUN:-/run/stickllm}"
mkdir -p "$RUN_DIR" 2>/dev/null || echo "stickllm-pick-gpus: WARN cannot create $RUN_DIR" >&2
OUT="$RUN_DIR/cuda.env"
LIB="${STICKLLM_LIB:-/opt/stickllm/lib}"
LIB_VK="${STICKLLM_LIB_VULKAN:-/opt/stickllm/lib-vulkan}"
CUDA_BIN="${STICKLLM_LLAMA_CUDA:-/opt/stickllm/bin/llama-server}"
VULKAN_BIN="${STICKLLM_LLAMA_VULKAN:-/opt/stickllm/bin/llama-server-vulkan}"
REGISTER_SO="${STICKLLM_CUDA_REGISTER:-$LIB/stickllm-cuda-register.so}"

# Filled by the CUDA picker: all suitable GPUs, split by free VRAM.
STICKLLM_TENSOR_SPLIT=""
STICKLLM_GPU_COUNT=0
STICKLLM_VRAM_FREE_MIB=0

write_env() {
  # $1 = CUDA_VISIBLE_DEVICES; $2 = STICKLLM_BACKEND; optional $3 = reason
  # Atomic: temp file in the same dir, then rename. Works when OUT is owned by
  # another user (dir is root:stickllm-llama 775). Errors are logged, not hidden.
  local tmp
  mkdir -p "$(dirname "$OUT")" 2>/dev/null || true
  if ! tmp="$(mktemp "$(dirname "$OUT")/.cuda.env.XXXXXX" 2>&1)"; then
    echo "stickllm-pick-gpus: ERROR cannot create temp file next to $OUT: $tmp" >&2
    return 1
  fi
  if ! {
    printf 'CUDA_DEVICE_ORDER=PCI_BUS_ID\n'
    printf 'CUDA_VISIBLE_DEVICES=%s\n' "$1"
    printf 'STICKLLM_BACKEND=%s\n' "$2"
    printf 'STICKLLM_GPU_COUNT=%s\n' "${STICKLLM_GPU_COUNT:-0}"
    printf 'STICKLLM_VRAM_FREE_MIB=%s\n' "${STICKLLM_VRAM_FREE_MIB:-0}"
    if [[ -n "${STICKLLM_TENSOR_SPLIT:-}" ]]; then
      printf 'STICKLLM_TENSOR_SPLIT=%s\n' "$STICKLLM_TENSOR_SPLIT"
    fi
    if [[ "$2" == "vulkan" ]]; then
      printf 'STICKLLM_VULKAN_DEVICE=%s\n' "${STICKLLM_VULKAN_DEVICE:-}"
      printf 'STICKLLM_VULKAN_GPUS=%s\n' "${STICKLLM_VULKAN_GPUS:-}"
      printf 'STICKLLM_VULKAN_PCI=%s\n' "${STICKLLM_VULKAN_PCI:-}"
      printf 'STICKLLM_VULKAN_NAMES=%s\n' "${STICKLLM_VULKAN_NAMES:-}"
      printf 'STICKLLM_VULKAN_LINK=%s\n' "${STICKLLM_VULKAN_LINK:-}"
      printf 'STICKLLM_VRAM_TOTAL_MIB=%s\n' "${STICKLLM_VRAM_TOTAL_MIB:-0}"
      printf 'GGML_BACKEND_DIR=%s\n' "$LIB_VK"
      printf 'LD_PRELOAD=\n'
    else
      printf 'GGML_BACKEND_DIR=%s\n' "$LIB"
      if [[ "$2" == "cuda" && -f "$REGISTER_SO" ]]; then
        printf 'LD_PRELOAD=%s\n' "$REGISTER_SO"
      else
        printf 'LD_PRELOAD=\n'
      fi
    fi
  } >"$tmp"; then
    echo "stickllm-pick-gpus: ERROR writing $tmp" >&2
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  chmod 644 "$tmp" 2>/dev/null || echo "stickllm-pick-gpus: WARN chmod 644 $tmp failed" >&2
  chgrp stickllm-llama "$tmp" 2>/dev/null || true
  if ! mv -f "$tmp" "$OUT"; then
    echo "stickllm-pick-gpus: ERROR cannot replace $OUT (running as $(id -un 2>/dev/null || id -u)); llama-start will see stale values" >&2
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  return 0
}

fallback_cpu() {
  local reason="$1"
  write_env "" cpu
  echo "stickllm-pick-gpus: ${reason}; STICKLLM_BACKEND=cpu CUDA_VISIBLE_DEVICES=" >&2
  exit 0
}

list_devices_has_cuda() {
  local ids="$1"
  local out
  local -a envcmd
  [[ -x "$CUDA_BIN" ]] || return 1
  envcmd=(
    env "LD_LIBRARY_PATH=$LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    "GGML_BACKEND_DIR=$LIB"
    "CUDA_DEVICE_ORDER=PCI_BUS_ID"
    "CUDA_VISIBLE_DEVICES=$ids"
  )
  if [[ -f "$REGISTER_SO" ]]; then
    envcmd+=("LD_PRELOAD=$REGISTER_SO")
  fi
  out="$("${envcmd[@]}" "$CUDA_BIN" --list-devices 2>/dev/null || true)"
  echo "$out" | grep -qE '^[[:space:]]*CUDA[0-9]'
}

list_devices_has_vulkan() {
  local out
  [[ -x "$VULKAN_BIN" ]] || return 1
  out="$(
    env "LD_LIBRARY_PATH=$LIB_VK${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
      "GGML_BACKEND_DIR=$LIB_VK" \
      "$VULKAN_BIN" --list-devices 2>/dev/null || true
  )"
  echo "$out" | grep -qE '^[[:space:]]*Vulkan[0-9]'
}

has_amd_or_intel_gpu() {
  # Prefer discrete/iGPU class display devices that are not NVIDIA.
  if command -v lspci >/dev/null 2>&1; then
    if lspci -nn 2>/dev/null | grep -qiE 'VGA|3D|Display'; then
      if lspci -nn 2>/dev/null | grep -iE 'VGA|3D|Display' | grep -qiE 'AMD|ATI|Advanced Micro Devices|Intel'; then
        return 0
      fi
    fi
  fi
  # Sysfs DRM drivers are enough when lspci is sparse (some live images).
  local card driver
  for card in /sys/class/drm/card[0-9]; do
    [[ -d "$card" ]] || continue
    driver="$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)" 2>/dev/null || true)"
    case "$driver" in
      amdgpu|radeon|i915|xe) return 0 ;;
    esac
  done
  return 1
}

# --- Vulkan (AMD/Intel) inventory ---------------------------------------
# Rows "vk_index:total_mib:free_mib:link_width:link_mts" for every Vulkan GPU
# llama.cpp will see. VRAM comes from amdgpu sysfs (mem_info_vram_total/used);
# vulkaninfo's DEVICE_LOCAL heap is the fallback (no "used" figure → free = total).
# PCIe link from sysfs current_link_width/current_link_speed (max_link_* fallback).
# Vulkan index order = vulkaninfo GPU order minus CPU devices (llvmpipe), which is
# what ggml-vulkan enumerates. Matched to sysfs by PCI address (domain:bus:dev.fn).
# Choice: among cards with >= STICKLLM_VK_MIN_FREE_MIB free, the widest/fastest
# PCIe link wins, then most free VRAM (an x1 riser card is far slower).
DRM_ROOT="${STICKLLM_DRM_ROOT:-/sys/class/drm}"
VULKANINFO="${STICKLLM_VULKANINFO:-vulkaninfo}"
VK_MIN_FREE_MIB="${STICKLLM_VK_MIN_FREE_MIB:-3000}"
# 0.6.2: a PCI address set by the user (e.g. 10:00.0) wins over the ranking.
VK_USER_PCI="${STICKLLM_VULKAN_PCI:-}"
STICKLLM_VULKAN_GPUS=""
STICKLLM_VULKAN_NAMES=""
STICKLLM_VULKAN_DEVICE=""
STICKLLM_VULKAN_PCI=""
STICKLLM_VULKAN_LINK=""
STICKLLM_VRAM_TOTAL_MIB=0
VK_CHOSEN_SYSFS=""

# "16x 8.0 GT/s PCIe" pieces → MT/s integer (8000). Empty/unknown → 0.
link_mts() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+)?$/) { printf "%d", $i * 1000; exit } } END {}' <<<"${1:-}" 2>/dev/null
}

# stdout: "dom bus dev fn total_mib used_mib link_width link_mts card" per amdgpu card.
sysfs_vram_rows() {
  local card dev driver pci dom bus pdev fn tot used w s
  for card in "$DRM_ROOT"/card[0-9]*; do
    [[ "$(basename "$card")" =~ ^card[0-9]+$ ]] || continue
    dev="$card/device"
    [[ -r "$dev/mem_info_vram_total" ]] || continue
    driver="$(basename "$(readlink -f "$dev/driver" 2>/dev/null)" 2>/dev/null || true)"
    [[ -z "$driver" || "$driver" == "amdgpu" ]] || continue
    pci="$(basename "$(readlink -f "$dev" 2>/dev/null)" 2>/dev/null || true)"
    dom=-1; bus=-1; pdev=-1; fn=-1
    if [[ "$pci" =~ ^([0-9a-fA-F]{4}):([0-9a-fA-F]{2}):([0-9a-fA-F]{2})\.([0-7])$ ]]; then
      dom=$((16#${BASH_REMATCH[1]})); bus=$((16#${BASH_REMATCH[2]}))
      pdev=$((16#${BASH_REMATCH[3]})); fn=${BASH_REMATCH[4]}
    fi
    tot="$(tr -cd '0-9' <"$dev/mem_info_vram_total" 2>/dev/null)"
    used="$(tr -cd '0-9' <"$dev/mem_info_vram_used" 2>/dev/null)"
    [[ -n "$tot" ]] || continue
    [[ -n "$used" ]] || used=0
    w="$(tr -cd '0-9' <"$dev/current_link_width" 2>/dev/null)"
    s="$(link_mts "$(cat "$dev/current_link_speed" 2>/dev/null)")"
    if [[ -z "$w" || "$w" == 0 || -z "$s" || "$s" == 0 ]]; then
      w="$(tr -cd '0-9' <"$dev/max_link_width" 2>/dev/null)"
      s="$(link_mts "$(cat "$dev/max_link_speed" 2>/dev/null)")"
    fi
    printf '%s %s %s %s %s %s %s %s %s\n' "$dom" "$bus" "$pdev" "$fn" \
      $((tot / 1048576)) $((used / 1048576)) "${w:-0}" "${s:-0}" "$(basename "$card")"
  done
}

# stdout: "type dom bus dev fn heap_mib" per vulkaninfo device, in Vulkan order.
vulkaninfo_rows() {
  command -v "$VULKANINFO" >/dev/null 2>&1 || [[ -x "$VULKANINFO" ]] || return 0
  "$VULKANINFO" 2>/dev/null | awk '
    function v(x) { return (x == "" ? -1 : x) }
    function flush() { if (have) printf "%s %s %s %s %s %d\n", type, v(dom), v(bus), v(pdev), v(fn), heap; }
    /deviceType[[:space:]]*=/ {
      flush(); have = 1; type = $NF; dom = ""; bus = ""; pdev = ""; fn = ""; heap = 0; next
    }
    have && /pciDomain[[:space:]]*=/ { dom = $NF; next }
    have && /pciBus[[:space:]]*=/ { bus = $NF; next }
    have && /pciDevice[[:space:]]*=/ { pdev = $NF; next }
    have && /pciFunction[[:space:]]*=/ { fn = $NF; next }
    have && /size[[:space:]]*=[[:space:]]*[0-9]+/ {
      for (i = 1; i <= NF; i++) if ($i == "=") { sz = $(i + 1); break }
      cand = int(sz / 1048576); next
    }
    have && /MEMORY_HEAP_DEVICE_LOCAL_BIT/ { if (cand > heap) heap = cand; next }
    END { flush() }
  '
}

# stdout: free MiB per VulkanN from llama-server --list-devices (index order).
list_devices_free() {
  [[ -x "$VULKAN_BIN" ]] || return 0
  env "LD_LIBRARY_PATH=$LIB_VK${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    "GGML_BACKEND_DIR=$LIB_VK" \
    "$VULKAN_BIN" --list-devices 2>/dev/null |
    sed -nE 's/^[[:space:]]*Vulkan([0-9]+):.*\(([0-9]+) MiB, ([0-9]+) MiB free\).*/\1 \3/p'
}

# Fills STICKLLM_GPU_COUNT / STICKLLM_VRAM_FREE_MIB / STICKLLM_VRAM_TOTAL_MIB /
# STICKLLM_VULKAN_GPUS / STICKLLM_VULKAN_DEVICE / STICKLLM_VULKAN_PCI / _LINK.
probe_vulkan_gpus() {
  local -a vk_type=() vk_dom=() vk_bus=() vk_dev=() vk_fn=() vk_heap=()
  local -a sy_dom=() sy_bus=() sy_dev=() sy_fn=() sy_tot=() sy_used=() sy_w=() sy_s=() sy_card=()
  local -a ld_free=()
  local t d b p f h tot used w s c i j idx free rows=""
  local vk_all has_discrete=0
  vk_all="$(vulkaninfo_rows)"
  grep -q 'DISCRETE_GPU' <<<"$vk_all" && has_discrete=1
  while read -r t d b p f h; do
    [[ -n "$t" ]] || continue
    case "$t" in *CPU*) continue ;; esac
    if (( has_discrete )) && [[ "$t" != *DISCRETE_GPU* ]]; then
      continue
    fi
    vk_type+=("$t"); vk_dom+=("$d"); vk_bus+=("$b"); vk_dev+=("$p"); vk_fn+=("$f"); vk_heap+=("$h")
  done <<<"$vk_all"
  while read -r d b p f tot used w s c; do
    [[ -n "$d" ]] || continue
    sy_dom+=("$d"); sy_bus+=("$b"); sy_dev+=("$p"); sy_fn+=("$f")
    sy_tot+=("$tot"); sy_used+=("$used"); sy_w+=("$w"); sy_s+=("$s"); sy_card+=("$c")
  done < <(sysfs_vram_rows | sort -n -k1,1 -k2,2 -k3,3 -k4,4)
  while read -r i free; do
    [[ -n "$i" ]] && ld_free[$i]=$free
  done < <(list_devices_free)

  local n_vk=${#vk_type[@]} n_sy=${#sy_bus[@]}
  if (( n_vk == 0 && n_sy == 0 )); then
    echo "stickllm-pick-gpus: Vulkan inventory empty (no amdgpu sysfs VRAM, no vulkaninfo GPU)" >&2
    return 1
  fi
  if (( n_vk == 0 )); then
    # vulkaninfo missing: assume Vulkan order follows PCI order (Mesa RADV does);
    # the --list-devices cross-check below warns when free VRAM disagrees.
    for ((i = 0; i < n_sy; i++)); do
      vk_type+=("PHYSICAL_DEVICE_TYPE_DISCRETE_GPU"); vk_dom+=(-1); vk_bus+=(-1); vk_dev+=(-1); vk_fn+=(-1); vk_heap+=(0)
    done
    n_vk=$n_sy
  fi

  local best="" best_key="" best_free=0 best_tot=0 best_pci="" best_link="" best_card=""
  local best_ok=0 ok key src pci_s
  for ((idx = 0; idx < n_vk; idx++)); do
    tot=0; used=0; w=0; s=0; c=""; pci_s=""; src="none"
    if [[ "${vk_bus[$idx]}" != "-1" ]]; then
      for ((j = 0; j < n_sy; j++)); do
        [[ "${sy_bus[$j]}" == "${vk_bus[$idx]}" ]] || continue
        [[ "${vk_dom[$idx]}" == "-1" || "${vk_dom[$idx]}" == "${sy_dom[$j]}" ]] || continue
        [[ "${vk_dev[$idx]}" == "-1" || "${vk_dev[$idx]}" == "${sy_dev[$j]}" ]] || continue
        [[ "${vk_fn[$idx]}" == "-1" || "${vk_fn[$idx]}" == "${sy_fn[$j]}" ]] || continue
        src=sysfs; break
      done
    elif (( n_sy == n_vk )); then
      j=$idx; src=sysfs-order  # no PCI info from vulkaninfo: pair by position
    fi
    if [[ "$src" != "none" ]]; then
      tot=${sy_tot[$j]}; used=${sy_used[$j]}; w=${sy_w[$j]}; s=${sy_s[$j]}; c=${sy_card[$j]}
      pci_s="$(printf '%04x:%02x:%02x.%x' "${sy_dom[$j]}" "${sy_bus[$j]}" "${sy_dev[$j]}" "${sy_fn[$j]}" 2>/dev/null)"
    else
      tot=${vk_heap[$idx]:-0}; used=0; src=vulkaninfo
    fi
    (( tot > 0 )) || continue
    free=$((tot - used)); (( free < 0 )) && free=0
    rows+="${rows:+,}${idx}:${tot}:${free}:${w}:${s}"
    STICKLLM_VULKAN_NAMES+="${STICKLLM_VULKAN_NAMES:+,}${idx}=${pci_s:-?}=${c:-?}"
    echo "stickllm-pick-gpus: Vulkan${idx} ${c:-?} pci=${pci_s:-?} link=x${w}@${s}MT/s total=${tot}MiB used=${used}MiB free=${free}MiB (${src})" >&2
    if [[ -n "${ld_free[$idx]:-}" && "$src" != vulkaninfo ]]; then
      local diff=$(( ld_free[idx] - free )); (( diff < 0 )) && diff=$(( -diff ))
      if (( diff > 256 )); then
        echo "stickllm-pick-gpus: WARN Vulkan${idx} --list-devices free=${ld_free[$idx]}MiB vs sysfs ${free}MiB; card mapping may be wrong" >&2
      fi
    fi
    ok=0; (( free >= VK_MIN_FREE_MIB )) && ok=1
    if [[ -n "$VK_USER_PCI" && -n "$pci_s" && "$pci_s" == *"$VK_USER_PCI" ]]; then
      ok=2
      echo "stickllm-pick-gpus: Vulkan${idx} pinned by STICKLLM_VULKAN_PCI=${VK_USER_PCI}" >&2
    fi
    # Rank: enough free VRAM, then PCIe bandwidth (width x MT/s), then free VRAM.
    key="$(printf '%d %012d %08d' "$ok" $(( w * s )) "$free")"
    if [[ -z "$best_key" || "$key" > "$best_key" ]]; then
      best_key="$key"; best="Vulkan${idx}"; best_free=$free; best_tot=$tot
      best_pci="$pci_s"; best_link="x${w}@${s}MT/s"; best_card="$c"; best_ok=$ok
    fi
  done
  if [[ -z "$rows" ]]; then
    echo "stickllm-pick-gpus: Vulkan devices found but no VRAM size readable" >&2
    return 1
  fi
  STICKLLM_VULKAN_GPUS="$rows"
  STICKLLM_GPU_COUNT=$(awk -F, '{print NF}' <<<"$rows")
  STICKLLM_VULKAN_DEVICE="$best"
  STICKLLM_VULKAN_PCI="$best_pci"
  STICKLLM_VULKAN_LINK="$best_link"
  STICKLLM_VRAM_FREE_MIB=$best_free
  STICKLLM_VRAM_TOTAL_MIB=$best_tot
  VK_CHOSEN_SYSFS="${best_card:+$DRM_ROOT/$best_card/device}"
  echo "stickllm-pick-gpus: chose ${best} ${best_card:-?} pci=${best_pci:-?} link=${best_link} free=${best_free}MiB (min ${VK_MIN_FREE_MIB}MiB met=${best_ok})" >&2
  pin_runtime_pm
  return 0
}

# amdgpu runtime PM suspends a headless card after ~5 s idle (BACO) and moves
# its VRAM buffers to system RAM (GTT); llama-server then runs from GTT over
# PCIe. Keep the chosen card powered while it serves the model. Root only
# (ExecStartPre=+); resets at reboot. STICKLLM_VK_PM_PIN=0 disables.
pin_runtime_pm() {
  local ctl
  [[ "${STICKLLM_VK_PM_PIN:-1}" == "1" && -n "$VK_CHOSEN_SYSFS" ]] || return 0
  ctl="$VK_CHOSEN_SYSFS/power/control"
  [[ -f "$ctl" ]] || return 0
  if [[ "$(cat "$ctl" 2>/dev/null)" == "on" ]]; then
    return 0
  fi
  if echo on >"$ctl" 2>/dev/null; then
    echo "stickllm-pick-gpus: runtime PM pinned on for ${VK_CHOSEN_SYSFS} (was auto)" >&2
  else
    echo "stickllm-pick-gpus: WARN cannot set $ctl=on (running as $(id -un 2>/dev/null || id -u)); card may runtime-suspend and evict VRAM" >&2
  fi
}

try_vulkan() {
  local reason="$1"
  if [[ ! -x "$VULKAN_BIN" ]]; then
    fallback_cpu "CUDA unavailable and Vulkan binary missing (${reason})"
  fi
  if ! list_devices_has_vulkan; then
    # Still try Vulkan on AMD/Intel even if list-devices is quirky — llama-start
    # will fall back to CPU if launch fails. Prefer explicit list-devices proof.
    if has_amd_or_intel_gpu; then
      echo "stickllm-pick-gpus: Vulkan list-devices empty but AMD/Intel GPU present — trying vulkan (${reason})" >&2
      probe_vulkan_gpus || true
      write_env "" vulkan
      echo "stickllm-pick-gpus: STICKLLM_BACKEND=vulkan gpus=${STICKLLM_GPU_COUNT} best=${STICKLLM_VULKAN_DEVICE:-none} (${reason})" >&2
      exit 0
    fi
    fallback_cpu "CUDA unavailable and no Vulkan device (${reason})"
  fi
  probe_vulkan_gpus || true
  write_env "" vulkan
  echo "stickllm-pick-gpus: STICKLLM_BACKEND=vulkan gpus=${STICKLLM_GPU_COUNT} best=${STICKLLM_VULKAN_DEVICE:-none} free=${STICKLLM_VRAM_FREE_MIB}MiB (list-devices OK; ${reason})" >&2
  exit 0
}

# --- CUDA path (NVIDIA default) ---
if ! command -v nvidia-smi >/dev/null 2>&1; then
  try_vulkan "nvidia-smi missing"
fi

# Do not use set -e/pipefail here — nvidia-smi returns 9 with no usable GPU.
if ! nvidia-smi -L >/dev/null 2>&1; then
  try_vulkan "nvidia-smi failed (no GPU / blacklisted)"
fi

# Every GPU with >= 16 GiB. An 8GB display card is skipped; two 24GB 3090s
# are both selected. tensor-split proportions follow free VRAM (total if free is 0).
declare -a LARGE_IDS=() LARGE_SHARES=()
STICKLLM_VRAM_FREE_MIB=0
while IFS=',' read -r idx total free; do
  idx="${idx// /}"
  total="${total// /}"
  free="${free// /}"
  [[ "$idx" =~ ^[0-9]+$ ]] || continue
  [[ "$total" =~ ^[0-9]+$ ]] || continue
  [[ "$free" =~ ^[0-9]+$ ]] || free=0
  if (( total >= 16000 )); then
    LARGE_IDS+=("$idx")
    share="$free"
    if (( share < 1 )); then
      share="$total"
    fi
    LARGE_SHARES+=("$share")
    STICKLLM_VRAM_FREE_MIB=$((STICKLLM_VRAM_FREE_MIB + share))
  fi
done < <(nvidia-smi --query-gpu=index,memory.total,memory.free --format=csv,noheader,nounits 2>/dev/null || true)

ids=""
STICKLLM_GPU_COUNT=${#LARGE_IDS[@]}
if (( STICKLLM_GPU_COUNT >= 1 )); then
  ids="$(IFS=,; echo "${LARGE_IDS[*]}")"
  if (( STICKLLM_GPU_COUNT > 1 )); then
    STICKLLM_TENSOR_SPLIT="$(IFS=,; echo "${LARGE_SHARES[*]}")"
  fi
else
  ids="$(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | tr -d ' ' | head -1 || true)"
  STICKLLM_GPU_COUNT=0
  [[ -n "$ids" ]] && STICKLLM_GPU_COUNT=1
fi

if [[ -z "${ids}" ]]; then
  try_vulkan "no NVIDIA GPUs listed"
fi

# Verify llama actually sees a CUDA device (not just nvidia-smi).
if ! list_devices_has_cuda "$ids"; then
  # Retry with all GPUs visible in case index remap confuses enumeration.
  if list_devices_has_cuda ""; then
    # Keep the suitable-GPU set. Falling back to every index would pull in an 8GB card.
    if (( ${#LARGE_IDS[@]} >= 1 )); then
      ids="$(IFS=,; echo "${LARGE_IDS[*]}")"
    else
      ids="$(nvidia-smi --query-gpu=index --format=csv,noheader 2>/dev/null | tr -d ' ' | paste -sd, - || true)"
    fi
  else
    try_vulkan "llama-server --list-devices shows no CUDA (backend not registered / libs broken)"
  fi
fi

write_env "$ids" cuda
echo "stickllm-pick-gpus: STICKLLM_BACKEND=cuda CUDA_VISIBLE_DEVICES=${ids} gpus=${STICKLLM_GPU_COUNT} split=${STICKLLM_TENSOR_SPLIT:-none} (list-devices OK)" >&2
exit 0
