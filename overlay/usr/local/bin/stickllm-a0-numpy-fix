#!/bin/bash
# Diagnose + repair scipy/numpy ABI break that blocks A0 VectorDB/memory
# (ValueError: All ufuncs must have type numpy.ufunc / sph_legendre_p).
# Runs docker exec against the LIVE stickllm-agent-zero container.
# Does NOT stop/restart stickllm-agent, the container, llama, or run_ui.
set -euo pipefail

SOCK="${STICKLLM_AGENT_DOCKER_SOCK:-/run/stickllm/agent-docker.sock}"
CONTAINER="${STICKLLM_A0_CONTAINER:-stickllm-agent-zero}"
LOG="${STICKLLM_A0_NUMPY_FIX_LOG:-/run/stickllm/a0-numpy-fix.log}"
PY=/opt/venv-a0/bin/python
PIP=/opt/venv-a0/bin/pip

mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1
echo "=== stickllm-a0-numpy-fix $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

if [[ ! -S "$SOCK" ]]; then
  echo "ERROR: docker sock missing: $SOCK"
  exit 1
fi

docker_cli() { DOCKER_HOST="unix://${SOCK}" docker "$@"; }
dexec() { DOCKER_HOST="unix://${SOCK}" docker exec -i "$CONTAINER" "$@"; }

if ! docker_cli inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -qx true; then
  echo "ERROR: container $CONTAINER not running"
  docker_cli ps -a --filter "name=$CONTAINER" --format '{{.ID}} {{.Names}} {{.Status}}' || true
  exit 1
fi

echo "-- before --"
dexec "$PY" -c "import sys; print('exe', sys.executable); import numpy as np; print('numpy', np.__version__, np.__file__); import scipy; print('scipy', scipy.__version__)" || echo "before-import-failed"
dexec "$PY" -c "import scipy.special; print('scipy.special OK')" || echo "scipy.special FAIL before"
echo "-- repair --"
docker_cli exec "$CONTAINER" bash -lc "
set -e
$PIP uninstall -y numpy 2>/dev/null || true
$PIP uninstall -y numpy 2>/dev/null || true
$PIP install --no-cache-dir 'numpy>=2.0,<2.3'
if ! $PY -c 'import scipy.special' >/dev/null 2>&1; then
  echo 'numpy reinstall insufficient; pinning scipy==1.14.1'
  $PIP install --no-cache-dir 'scipy==1.14.1'
fi
"

echo "-- after --"
dexec "$PY" -c "import numpy,scipy,scipy.special,sklearn; print('OK numpy', numpy.__version__, 'scipy', scipy.__version__, 'sklearn', sklearn.__version__)"
echo "=== fix complete (container files only; run_ui not restarted) ==="
